{
  "name": "realtime-review",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "os": [
    "linux",
    "darwin"
  ],
  "files": [
    "bin/launch.sh",
    "dist/**/*.js",
    "native/prebuilt",
    "README.md",
    "docs/codex-installation.md",
    "docs/npm-quickstart.md",
    "docs/direct-event-v1-supported-profile.md",
    "docs/installed-release-compatibility.md",
    "docs/status.md",
    "package-runtime.json"
  ],
  "bin": {
    "realtime-review": "bin/launch.sh",
    "review-tool": "bin/launch.sh",
    "review-tool-doctor": "bin/launch.sh",
    "review-tool-parser": "bin/launch.sh",
    "review-tool-resident": "bin/launch.sh"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./parser": "./dist/direct-event/analyzer.js",
    "./resident": "./dist/resident/main.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-capture-helper.mjs",
    "prepack": "npm run build",
    "verify:release-native": "node scripts/verify-native-release.mjs",
    "pack:release": "npm run build && npm run verify:release-native && npm pack --ignore-scripts=true",
    "audit:release": "node scripts/audit-release-tarball.mjs",
    "hello": "bun run src/hello.ts",
    "test": "npm run config:check && vitest run --maxWorkers=1",
    "test:live": "RUN_LIVE_JEV=1 vitest run src/jev-live.test.ts",
    "benchmark:live": "node evidence/codex/0.155.1/probe/benchmark-live.mjs --runs=100",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "config:generate": "node --experimental-strip-types scripts/generate-configuration.ts --update",
    "config:check": "node --experimental-strip-types scripts/generate-configuration.ts --check",
    "e0": "bun run src/e0.ts",
    "scan": "bun run src/scan.ts",
    "review": "node src/cli.ts",
    "review:codex": "node src/cli.ts --codex-hook --controlled-writer",
    "conformance:direct-event": "vitest run --maxWorkers=1 src/conformance/live-evidence-outcome.test.ts src/conformance/live-runner-policy.test.ts src/direct-event/adapter.test.ts src/direct-event/selection-capture.test.ts src/direct-event/analyzer.test.ts src/direct-event/pipeline.test.ts src/resident/capacity.test.ts src/resident/collection.test.ts src/resident/dispatch.test.ts src/resident/evaluation-reuse.test.ts src/resident/operational-notices.test.ts src/resident/client.test.ts src/resident/protocol.test.ts src/resident/server.test.ts src/resident/subprocess.test.ts src/cli.test.ts && node scripts/validate-direct-event-conformance.mjs",
    "conformance:host": "node scripts/run-direct-event-host-conformance.mjs",
    "conformance:package": "node scripts/run-clean-package-conformance.mjs",
    "conformance:setup-package": "node scripts/run-setup-package-conformance.mjs",
    "conformance:first-review-package": "node scripts/run-setup-package-conformance.mjs",
    "conformance:first-review-live": "node scripts/run-first-review-live-milestone.mjs",
    "conformance:installed-release": "node scripts/verify-installed-release.mjs",
    "conformance:live": "node scripts/run-direct-event-live-milestone.mjs",
    "experiment:extract": "node experiments/declaration-extraction/extract.ts",
    "experiment:extract:evidence": "node experiments/declaration-extraction/generate-evidence.ts",
    "experiment:shell-write-detection": "node --experimental-strip-types experiments/shell-write-detection/run.ts",
    "experiment:shell-write-detection:evidence": "node --experimental-strip-types experiments/shell-write-detection/run.ts --write-evidence",
    "test:extract": "vitest run --config experiments/declaration-extraction/vitest.config.ts",
    "test:input-contract": "vitest run --config experiments/input-contract-comparison/vitest.config.ts",
    "typecheck:input-contract": "tsc -p experiments/input-contract-comparison/tsconfig.json --noEmit",
    "experiment:input-contract": "node --experimental-strip-types experiments/input-contract-comparison/run.ts"
  },
  "dependencies": {
    "@effect/ai-typesafe": "4.0.0-rc.116",
    "effect": "4.0.0-rc.116",
    "smol-toml": "1.8.0",
    "tree-sitter": "0.25.1",
    "tree-sitter-typescript": "0.23.2"
  },
  "optionalDependencies": {
    "node-bin-darwin-arm64": "24.20.0",
    "node-linux-arm64": "24.20.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.116",
    "@types/bun": "1.3.14",
    "fast-check": "4.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  },
  "allowScripts": {
    "tree-sitter@0.25.1": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-typescript@0.23.2": true
  }
}
