{
  "name": "realtime-review-prototype",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "hello": "bun run src/hello.ts",
    "test": "vitest run",
    "test:live": "RUN_LIVE_JEV=1 vitest run src/jev-live.test.ts",
    "benchmark:live": "node evidence/codex/0.155.1/probe/benchmark-live.mjs --runs=100",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e0": "bun run src/e0.ts",
    "scan": "bun run src/scan.ts",
    "review": "node src/cli.ts",
    "review:codex": "node src/cli.ts --codex-hook"
  },
  "dependencies": {
    "@effect/ai-typesafe": "4.0.0-rc.116",
    "effect": "4.0.0-rc.116"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.116",
    "@types/bun": "1.3.14",
    "typescript": "^5.9",
    "vitest": "5.0.1"
  }
}
