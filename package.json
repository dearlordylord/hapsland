{
  "name": "@hapsland/hapsland",
  "version": "0.1.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dearlordylord/hapsland.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "os": [
    "linux",
    "darwin"
  ],
  "files": [
    "bin/launch.sh",
    "native/prebuilt",
    "README.md",
    "docs/codex-installation.md",
    "docs/claude-installation.md",
    "docs/opencode-installation.md",
    "docs/direct-event-v1-supported-profile.md",
    "docs/installed-release-compatibility.md",
    "docs/status.md",
    "docs/configuration.md",
    "docs/review-providers.md",
    "docs/installation-workflows.md",
    "docs/npm-publishing.md",
    "schemas/review-config-v1.schema.json",
    "schemas/review-rule-v1.schema.json",
    "package-runtime.json",
    "docs/pi-installation.md",
    "dist/bin",
    "dist/runtime/hook-catalog.js",
    "dist/pi/**/*.js",
    "src/rules/defaults/*.json"
  ],
  "bin": {
    "hapsland": "bin/launch.sh",
    "hapsland-doctor": "bin/launch.sh",
    "hapsland-parser": "bin/launch.sh",
    "hapsland-resident": "bin/launch.sh"
  },
  "exports": {
    "./pi-extension": "./dist/pi/extension.js"
  },
  "scripts": {
    "docs:install": "node scripts/install-doc-link-checker.mjs && node scripts/install-bend-toolchain.mjs --github-actions",
    "docs:check": "node --test scripts/check-doc-links.test.mjs && node scripts/check-doc-links.mjs && node scripts/generate-hook-index.mjs --check",
    "build": "node scripts/verify-bend-artifacts.mjs && node scripts/check-canonical-authority.mjs && node scripts/check-production-authority.mjs && node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-bend-policy.mjs && node scripts/build-capture-helper.mjs && node scripts/build-standalone.mjs && node scripts/prune-distribution.mjs",
    "prepack": "npm run build",
    "verify:release-native": "node scripts/verify-native-release.mjs",
    "pack:release": "npm run build && npm run verify:release-native && npm pack --ignore-scripts=true",
    "audit:release": "node scripts/audit-release-tarball.mjs",
    "local-release": "node scripts/local-release.mjs",
    "dev-install": "node --experimental-strip-types scripts/dev-install.mjs",
    "dev:inspection": "node --experimental-strip-types scripts/dev-inspection.mjs",
    "test": "node scripts/test-harness/run-checks.mjs test",
    "test:native:preflight": "node scripts/run-native-preflight-tests.mjs",
    "test:live": "RUN_LIVE_JEV=1 vitest run src/jev-live.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "config:generate": "node --experimental-strip-types scripts/generate-configuration.ts --update",
    "config:check": "node --experimental-strip-types scripts/generate-configuration.ts --check",
    "conformance:direct-event": "vitest run --maxWorkers=1 src/conformance/live-evidence-outcome.test.ts src/conformance/live-runner-policy.test.ts src/direct-event/adapter.test.ts src/direct-event/selection-capture.test.ts src/direct-event/analyzer.test.ts src/direct-event/pipeline.test.ts src/direct-event/security-wire-prototype.test.ts src/resident/capacity.test.ts src/resident/collection.test.ts src/resident/dispatch.test.ts src/resident/evaluation-reuse.test.ts src/resident/operational-notices.test.ts src/resident/client.test.ts src/resident/protocol.test.ts src/resident/server.test.ts src/resident/subprocess.test.ts src/resident/security-queued.test.ts src/resident/security-sinks.test.ts src/cli.test.ts && node scripts/validate-direct-event-conformance.mjs",
    "conformance:host": "node scripts/run-direct-event-host-conformance.mjs",
    "conformance:package": "node scripts/run-clean-package-conformance.mjs",
    "conformance:client-lifecycle": "npm run build && node scripts/run-client-lifecycle-conformance.mjs",
    "conformance:setup-package": "node scripts/run-setup-package-conformance.mjs",
    "conformance:first-review-live": "node scripts/run-first-review-live-milestone.mjs",
    "conformance:installed-release": "node scripts/verify-installed-release.mjs",
    "conformance:live": "node scripts/run-direct-event-live-milestone.mjs",
    "test:coverage": "npm test -- --coverage",
    "quality:check": "node scripts/test-harness/run-checks.mjs quality",
    "test:harness:inventory": "node scripts/test-harness/inventory.mjs",
    "test:contention": "node scripts/test-harness/contention.mjs",
    "test:focused": "node scripts/test-harness/run-checks.mjs focused",
    "test:status": "node scripts/test-harness/run-checks.mjs status",
    "verify": "node scripts/test-harness/verify.mjs",
    "check:fast": "npm run typecheck && npm run config:check && npm run lint:changed",
    "test:harness": "node --test --test-concurrency=1 scripts/test-harness/*.test.mjs",
    "hooks:generate": "node scripts/generate-hook-index.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "lint": "npm run lint:code",
    "lint:code": "node scripts/run-quality-lint.mjs",
    "lint:fix": "node scripts/run-quality-lint.mjs --fix",
    "lint:changed": "node scripts/run-quality-lint.mjs --changed",
    "format": "node scripts/run-quality-lint.mjs --fix",
    "check:format": "node scripts/run-quality-lint.mjs --format-only",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "test:game": "node scripts/run-optional-development.mjs game",
    "test:simulation": "node scripts/run-optional-development.mjs simulation",
    "test:content-isolation": "node packages/agent-flow-bend/scripts/check-content-isolation.mjs && node scripts/check-content-wire-mutants.mjs"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "1.0.2",
    "@crap4ts/crap4ts": "1.0.5",
    "@effect/ai-typesafe": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "5.0.1",
    "bun": "1.3.14",
    "dprint": "0.55.2",
    "effect": "4.0.0",
    "fast-check": "4.2.0",
    "lint-staged": "17.3.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "smol-toml": "1.8.0",
    "tree-sitter": "0.25.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5",
    "istanbul-lib-instrument": "6.0.3"
  },
  "allowScripts": {
    "tree-sitter@0.25.1": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-typescript@0.23.2": true
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": "node scripts/run-quality-lint.mjs --staged --fix"
  }
}
