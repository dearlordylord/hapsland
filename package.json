{
  "name": "@hapsland/hapsland",
  "version": "0.1.1",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dearlordylord/hapsland.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "os": [
    "linux",
    "darwin"
  ],
  "files": [
    "bin/launch.sh",
    "native/prebuilt",
    "README.md",
    "docs/README.md",
    "docs/codex-installation.md",
    "docs/claude-installation.md",
    "docs/opencode-installation.md",
    "docs/direct-event-v1-supported-profile.md",
    "docs/installed-release-compatibility.md",
    "docs/status.md",
    "docs/configuration.md",
    "docs/rules.md",
    "docs/write-first-rule.md",
    "docs/review-providers.md",
    "docs/installation-workflows.md",
    "docs/npm-publishing.md",
    "schemas/review-config-v1.schema.json",
    "schemas/review-rule-v1.schema.json",
    "package-runtime.json",
    "docs/pi-installation.md",
    "dist/bin",
    "dist/runtime/**/*.js",
    "dist/pi/**/*.js",
    "dist/rules/defaults/*.json"
  ],
  "bin": {
    "hapsland": "bin/launch.sh",
    "hapsland-doctor": "bin/launch.sh",
    "hapsland-parser": "bin/launch.sh",
    "hapsland-resident": "bin/launch.sh",
    "hapsland-hook": "bin/launch.sh"
  },
  "exports": {
    "./pi-extension": "./dist/pi/extension.js"
  },
  "scripts": {
    "docs:install": "node scripts/install-doc-link-checker.mjs && node scripts/install-bend-toolchain.mjs --github-actions",
    "docs:generate": "node scripts/generate-documentation.mjs --update",
    "docs:generated:check": "node scripts/generate-documentation.mjs --check",
    "docs:check": "node --experimental-strip-types --test scripts/check-doc-links.test.mjs scripts/generate-architecture-diagram.test.mjs scripts/generate-documentation.test.mjs scripts/generate-module-architecture.test.mjs && npm run docs:generated:check && node --experimental-strip-types --test scripts/generate-decision-boundary-ledger.test.mts && node scripts/check-doc-links.mjs",
    "architecture:generate": "node scripts/generate-architecture-diagram.mjs",
    "build": "node scripts/build-product.mjs",
    "prepack": "npm run build",
    "native:inputs": "node scripts/native-inputs.mjs",
    "verify:release-native": "node scripts/verify-native-release.mjs",
    "pack:release": "npm run build && npm run verify:release-native && npm pack --ignore-scripts=true",
    "audit:release": "node scripts/audit-release-tarball.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "local-release": "node scripts/local-release.mjs",
    "dev-install": "node --experimental-strip-types scripts/dev-install.mjs",
    "dev:inspection": "node --experimental-strip-types scripts/dev-inspection.mjs",
    "test": "node scripts/test-harness/run-checks.mjs test",
    "test:native:preflight": "node scripts/run-native-preflight-tests.mjs",
    "test:live": "RUN_LIVE_JEV=1 vitest run --config scripts/vitest.config.ts src/jev-live.test.ts",
    "test:watch": "vitest --config scripts/vitest.config.ts",
    "test:unit": "vitest run --config scripts/vitest.unit.config.ts",
    "typecheck": "node scripts/build-workspaces.mjs && npm run typecheck:source",
    "config:generate": "node --experimental-strip-types scripts/generate-configuration.ts --update",
    "config:check": "node --experimental-strip-types scripts/generate-configuration.ts --check",
    "conformance:direct-event": "vitest run --config scripts/vitest.config.ts --maxWorkers=1 src/conformance/live-evidence-outcome.test.ts src/conformance/live-runner-policy.test.ts src/direct-event/adapter.test.ts src/direct-event/selection-capture.test.ts src/direct-event/analyzer.test.ts src/direct-event/pipeline.test.ts src/direct-event/security-wire-prototype.test.ts src/resident/capacity.test.ts src/resident/collection.test.ts src/resident/dispatch.test.ts src/resident/evaluation-reuse.test.ts src/resident/operational-notices.test.ts src/resident/client.test.ts src/resident/protocol.test.ts src/resident/server.test.ts src/resident/subprocess.test.ts src/resident/security-queued.test.ts src/resident/security-sinks.test.ts src/cli.test.ts && node scripts/validate-direct-event-conformance.mjs",
    "conformance:host": "node scripts/run-direct-event-host-conformance.mjs",
    "conformance:package": "node scripts/run-clean-package-conformance.mjs",
    "conformance:client-lifecycle": "npm run build && node scripts/run-client-lifecycle-conformance.mjs",
    "conformance:setup-package": "node scripts/run-setup-package-conformance.mjs",
    "conformance:first-review-live": "node scripts/run-first-review-live-milestone.mjs",
    "conformance:installed-release": "node scripts/verify-installed-release.mjs",
    "conformance:live": "node scripts/run-direct-event-live-milestone.mjs",
    "test:coverage": "npm test -- --coverage",
    "quality:check": "node scripts/test-harness/run-checks.mjs quality",
    "test:harness:inventory": "node scripts/test-harness/inventory.mjs",
    "test:contention": "node scripts/test-harness/contention.mjs",
    "test:focused": "node scripts/test-harness/run-checks.mjs focused",
    "test:status": "node scripts/test-harness/run-checks.mjs status",
    "verify": "node scripts/test-harness/verify.mjs",
    "check:fast": "npm run test:unit && node scripts/check-repository-assets.mjs && npm run typecheck:source && npm run lint:changed",
    "test:harness": "node --test --test-concurrency=1 scripts/test-harness/*.test.mjs",
    "hooks:generate": "node scripts/generate-hook-index.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "lint": "npm run lint:code",
    "lint:code": "node scripts/run-quality-lint.mjs",
    "lint:fix": "node scripts/run-quality-lint.mjs --fix",
    "lint:changed": "node scripts/run-quality-lint.mjs --changed",
    "format": "node scripts/run-quality-lint.mjs --fix",
    "check:format": "node scripts/run-quality-lint.mjs --format-only",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "test:game": "node scripts/run-optional-development.mjs game",
    "test:simulation": "node scripts/run-optional-development.mjs simulation",
    "analysis:packages": "node scripts/package-impact.mjs",
    "build:configure": "node scripts/package-graph.mjs && node scripts/generate-release-identity.mjs && node scripts/generate-turbo-config.mjs",
    "build:watch": "node scripts/build-watch.mjs",
    "test:content-isolation": "node packages/agent-flow-bend/scripts/check-content-isolation.mjs && node scripts/check-content-wire-mutants.mjs",
    "format:fix": "python3 scripts/bend-format.py fix",
    "format:check": "python3 scripts/bend-format.py check",
    "interaction:diagrams:write": "npm run docs:generate",
    "interaction:diagrams:check": "npm run docs:generated:check",
    "typecheck:source": "node scripts/pinned-typescript.mjs -p tsconfig.json --noEmit && node scripts/package-graph.mjs --check && node scripts/generate-release-identity.mjs --check && node scripts/check-development-imports.mjs",
    "bend:base:generate": "node scripts/generate-bend-base-evidence.mjs --update",
    "bend:base:check": "node scripts/generate-bend-base-evidence.mjs --check",
    "release:prepare:distribution": "node scripts/prepare-platform-distribution.mjs"
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "@bcoe/v8-coverage": "catalog:",
    "@crap4ts/crap4ts": "1.0.5",
    "@effect/ai-typesafe": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bun": "catalog:",
    "dprint": "0.55.2",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "istanbul-lib-instrument": "catalog:",
    "lint-staged": "17.3.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "smol-toml": "catalog:",
    "tree-sitter": "catalog:",
    "tree-sitter-rust": "catalog:",
    "tree-sitter-typescript": "catalog:",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "allowScripts": {
    "tree-sitter@0.25.1": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-typescript@0.23.2": true
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": "node scripts/run-quality-lint.mjs --staged --fix"
  },
  "workspaces": [
    "packages/activity-observation",
    "packages/administration",
    "packages/canonical-policy",
    "packages/cli-entry",
    "packages/credential-storage",
    "packages/delivery-output",
    "packages/doctor-entry",
    "packages/hook-entry",
    "packages/hook-runtime",
    "packages/inspection-records",
    "packages/native-observation",
    "packages/parser-entry",
    "packages/pi-extension",
    "packages/resident-entry",
    "packages/resident-runtime",
    "packages/resident-transport",
    "packages/review-definition",
    "packages/review-execution",
    "packages/runtime-environment",
    "packages/runtime-inputs",
    "packages/source-analysis",
    "packages/source-artifacts",
    "scripts",
    "src",
    "packages/agent-flow-bend",
    "packages/agent-flow-viz",
    "packages/monkey-business",
    "packages/monkey-business-bend",
    "prototypes/canonical-defense",
    "packages/agent-flow-projection"
  ],
  "hapsland": {
    "buildBoundaries": {
      "standalone-hook": {
        "entry": "@hapsland/hook-entry/hook-main",
        "forbiddenCapabilities": [
          "administration",
          "credential-mutation",
          "provider-execution",
          "review-orchestration",
          "source-analysis"
        ],
        "forbiddenExternalPackages": [
          "@effect/ai-typesafe",
          "@effect/ai",
          "tree-sitter",
          "tree-sitter-typescript",
          "tree-sitter-rust"
        ]
      },
      "pi-extension": {
        "entry": "@hapsland/pi-extension/pi/extension",
        "forbiddenCapabilities": [
          "administration",
          "credential-mutation",
          "provider-execution",
          "review-orchestration",
          "source-analysis"
        ],
        "forbiddenExternalPackages": [
          "@effect/ai-typesafe",
          "@effect/ai",
          "tree-sitter",
          "tree-sitter-typescript",
          "tree-sitter-rust"
        ]
      }
    }
  },
  "catalog": {
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.8",
    "@bcoe/v8-coverage": "1.0.2",
    "@effect/ai-typesafe": "4.0.0",
    "@effect/platform-browser": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "5.0.1",
    "bun": "1.3.14",
    "effect": "4.0.0",
    "fast-check": "4.2.0",
    "istanbul-lib-instrument": "6.0.3",
    "smol-toml": "1.8.0",
    "tree-sitter": "0.25.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
