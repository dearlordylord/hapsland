{
  "version": 1,
  "sessionAnalytics": true,
  "sessionInspection": true,
  "includes": [
    "**/*",
    ".scratch/**"
  ],
  "rules": [
    {
      "id": "meaningless_combinations"
    },
    {
      "id": "split_correlations"
    },
    {
      "id": "absence_confusion"
    },
    {
      "id": "bare_domain_value"
    },
    {
      "id": "name_wider_than_type"
    },
    {
      "id": "name_claims_resource"
    },
    {
      "id": "body_reaches_undeclared"
    }
  ]
}
