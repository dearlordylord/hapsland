{
  "name": "@hapsland/source-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./direct-event/analyzer": {
      "types": "./dist/direct-event/analyzer.d.ts",
      "default": "./dist/direct-event/analyzer.js"
    },
    "./direct-event/function-analyzer": {
      "types": "./dist/direct-event/function-analyzer.d.ts",
      "default": "./dist/direct-event/function-analyzer.js"
    },
    "./direct-event/graph-resolver": {
      "types": "./dist/direct-event/graph-resolver.d.ts",
      "default": "./dist/direct-event/graph-resolver.js"
    },
    "./direct-event/languages/bend/adapter": {
      "types": "./dist/direct-event/languages/bend/adapter.d.ts",
      "default": "./dist/direct-event/languages/bend/adapter.js"
    },
    "./direct-event/languages/bend/extractor": {
      "types": "./dist/direct-event/languages/bend/extractor.d.ts",
      "default": "./dist/direct-event/languages/bend/extractor.js"
    },
    "./direct-event/languages/contracts": {
      "types": "./dist/direct-event/languages/contracts.d.ts",
      "default": "./dist/direct-event/languages/contracts.js"
    },
    "./direct-event/languages/function-facts": {
      "types": "./dist/direct-event/languages/function-facts.d.ts",
      "default": "./dist/direct-event/languages/function-facts.js"
    },
    "./direct-event/languages/native-parser": {
      "types": "./dist/direct-event/languages/native-parser.d.ts",
      "default": "./dist/direct-event/languages/native-parser.js"
    },
    "./direct-event/languages/registry": {
      "types": "./dist/direct-event/languages/registry.d.ts",
      "default": "./dist/direct-event/languages/registry.js"
    },
    "./direct-event/languages/rust-adapter": {
      "types": "./dist/direct-event/languages/rust-adapter.d.ts",
      "default": "./dist/direct-event/languages/rust-adapter.js"
    },
    "./direct-event/languages/rust-module-context": {
      "types": "./dist/direct-event/languages/rust-module-context.d.ts",
      "default": "./dist/direct-event/languages/rust-module-context.js"
    },
    "./direct-event/languages/rust": {
      "types": "./dist/direct-event/languages/rust.d.ts",
      "default": "./dist/direct-event/languages/rust.js"
    },
    "./direct-event/languages/typescript-functions": {
      "types": "./dist/direct-event/languages/typescript-functions.d.ts",
      "default": "./dist/direct-event/languages/typescript-functions.js"
    },
    "./direct-event/languages/typescript": {
      "types": "./dist/direct-event/languages/typescript.d.ts",
      "default": "./dist/direct-event/languages/typescript.js"
    },
    "./direct-event/demo-validation": {
      "types": "./dist/direct-event/demo-validation.d.ts",
      "default": "./dist/direct-event/demo-validation.js"
    },
    "./direct-event/function-resolver": {
      "types": "./dist/direct-event/function-resolver.d.ts",
      "default": "./dist/direct-event/function-resolver.js"
    },
    "./direct-event/languages/native-bindings": {
      "types": "./dist/direct-event/languages/native-bindings.d.ts",
      "default": "./dist/direct-event/languages/native-bindings.js"
    },
    "./direct-event/languages/bend/bundled-evidence": {
      "types": "./dist/direct-event/languages/bend/bundled-evidence.d.ts",
      "default": "./dist/direct-event/languages/bend/bundled-evidence.js"
    },
    "./direct-event/languages/bend/lexical": {
      "types": "./dist/direct-event/languages/bend/lexical.d.ts",
      "default": "./dist/direct-event/languages/bend/lexical.js"
    },
    "./direct-event/languages/go-build-context": {
      "types": "./dist/direct-event/languages/go-build-context.d.ts",
      "default": "./dist/direct-event/languages/go-build-context.js"
    },
    "./direct-event/languages/go": {
      "types": "./dist/direct-event/languages/go.d.ts",
      "default": "./dist/direct-event/languages/go.js"
    },
    "./direct-event/languages/go-adapter": {
      "types": "./dist/direct-event/languages/go-adapter.d.ts",
      "default": "./dist/direct-event/languages/go-adapter.js"
    }
  },
  "dependencies": {
    "@hapsland/canonical-policy": "workspace:*",
    "@hapsland/native-observation": "workspace:*",
    "@hapsland/runtime-environment": "workspace:*",
    "@hapsland/source-artifacts": "workspace:*",
    "effect": "catalog:",
    "smol-toml": "catalog:",
    "tree-sitter": "catalog:",
    "tree-sitter-rust": "catalog:",
    "tree-sitter-typescript": "catalog:",
    "bun": "catalog:",
    "tree-sitter-go": "catalog:"
  },
  "scripts": {
    "build": "node ../../scripts/compile-package.mjs",
    "native:linux-arm64": "node ../../scripts/native-task.mjs linux-arm64",
    "native:darwin-arm64": "node ../../scripts/native-task.mjs darwin-arm64",
    "clean:compiler": "node ../../scripts/clean-compiler-output.mjs"
  },
  "hapsland": {
    "domain": "source-analysis",
    "host": "bun",
    "capabilities": [
      "source-analysis"
    ],
    "loaderPolicies": {
      "src/direct-event/demo-validation.ts": "demo-session"
    },
    "nativeAssets": [
      {
        "source": "src/direct-event/languages/native-bindings.ts",
        "path": "native/prebuilt/{profile}/tree-sitter/build/Release/tree_sitter_runtime_binding.node",
        "producer": {
          "kind": "package-binding",
          "package": "tree-sitter",
          "localBuild": "build/Release/tree_sitter_runtime_binding.node",
          "publishedPrebuild": "prebuilds/{profile}/tree-sitter.node",
          "profiles": {
            "linux-arm64": {
              "sourceBuild": true
            },
            "darwin-arm64": {}
          }
        }
      },
      {
        "source": "src/direct-event/languages/native-bindings.ts",
        "path": "native/prebuilt/{profile}/tree-sitter-typescript/build/Release/tree_sitter_typescript_binding.node",
        "producer": {
          "kind": "package-binding",
          "package": "tree-sitter-typescript",
          "localBuild": "build/Release/tree_sitter_typescript_binding.node",
          "publishedPrebuild": "prebuilds/{profile}/tree-sitter-typescript.node",
          "profiles": {
            "linux-arm64": {
              "sourceBuild": true
            },
            "darwin-arm64": {}
          }
        }
      },
      {
        "source": "src/direct-event/languages/native-bindings.ts",
        "path": "native/prebuilt/{profile}/tree-sitter-rust/build/Release/tree_sitter_rust_binding.node",
        "producer": {
          "kind": "package-binding",
          "package": "tree-sitter-rust",
          "localBuild": "build/Release/tree_sitter_rust_binding.node",
          "publishedPrebuild": "prebuilds/{profile}/tree-sitter-rust.node",
          "profiles": {
            "linux-arm64": {
              "sourceBuild": true
            },
            "darwin-arm64": {}
          }
        }
      },
      {
        "source": "src/direct-event/languages/native-bindings.ts",
        "path": "native/prebuilt/{profile}/tree-sitter-go/build/Release/tree_sitter_go_binding.node",
        "producer": {
          "kind": "package-binding",
          "package": "tree-sitter-go",
          "localBuild": "build/Release/tree_sitter_go_binding.node",
          "publishedPrebuild": "prebuilds/{profile}/tree-sitter-go.node",
          "profiles": {
            "linux-arm64": {
              "sourceBuild": true
            },
            "darwin-arm64": {}
          }
        }
      }
    ]
  }
}
