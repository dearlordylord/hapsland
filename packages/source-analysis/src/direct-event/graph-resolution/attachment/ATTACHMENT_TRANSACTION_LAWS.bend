    ready_selected_parent(child, history, child_history, phase, state, frame, edge, known, ready))

def ready_original_staged_result(+state: T.ResolverState, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase) -> Type:
  Exists(T.ResolverFrame, frame => Exists(T.TentativeChild, child => Exists(Local.Pending, edge =>
    {S.state_frame(state) == Some{frame} : Maybe<&2, T.ResolverFrame>} &
    {S.scratch_tentative(S.state_scratch(state)) == Some{child} : Maybe<&2, T.TentativeChild>} &
    {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>} &
    ready_staged_parent_result(child, history, child_history, phase, frame, edge,
      Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(child))))))))

def ready_original_staged(+state: T.ResolverState, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> ready_original_staged_result(state, history, child_history, phase):
  ready_actual_inputs(ready_original_staged_result(state, history, child_history, phase), state, history, child_history, phase, ready,
    frame => child => edge => frame_present => child_present => edge_present => selected =>
    +frame = frame
    +child = child
    +edge = edge
    +frame_present = frame_present
    +child_present = child_present
    +edge_present = edge_present
    Tuple{frame, Tuple{child, Tuple{edge, Tuple{frame_present, Tuple{child_present, Tuple{edge_present,
      ready_selected_staged(child, history, child_history, phase, state, frame, edge,
        Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(child)))),
        ready_actual_parts_installed(state, history, child_history, phase, frame, child, edge, frame_present, child_present, edge_present, ready), coherent)}}}}}})

def candidate_request_staged(+product: ArtifactValue.ProductValue, +child: T.TentativeChild, +ids: List<&2, Nat>, +previous: Nat, +state: T.ResolverState, +history: V.History, +view: V.Frame, projected: {Contract.actual_frame(S.state_frame(state), history) == Some{view} : Maybe<&2, V.Frame>}) -> Exists(T.ResolverState, measured => Exists(T.Request, request => {Attach.request_candidate(Some{product}, child, ids, previous, state) == Loop.ServiceStep{T.AwaitService{measured, request}} : Loop.Continuation} & {Contract.operation(request) == T.EncodeProduct{product} : T.Operation} & {S.state_stage(measured) == T.MeasuringCandidateTree{} : T.ResolverStage} & {Contract.actual_frame(S.state_frame(measured), history) == Some{view} : Maybe<&2, V.Frame>})):
  match child state:
    case T.TentativeChild{target, path, capture, bytes, file, artifact, identity, before, plan, _, _, _}
      T.ResolverState{_, _, _, _, _, _, _, _, _, _, _, _, _}:
      +prepared = S.with_state_scratch(state, S.with_scratch_tentative(S.state_scratch(state),
        Some{T.TentativeChild{target, path, capture, bytes, file, artifact, identity, before, plan, previous, product, ids}}))
      +measured = S.with_state_next_request(S.with_state_stage(prepared, T.MeasuringCandidateTree{}),
        (S.state_next_request(prepared) + 1n : Nat))
      +request: T.Request = T.Request{S.input_invocation(S.state_input(prepared)), S.state_next_request(prepared), T.EncodeProduct{product}}
      Tuple{measured, Tuple{request, Tuple{{==}, Tuple{{==}, Tuple{{==}, projected}}}}}

def ready_measurement_staged_result(+continuation: Loop.Continuation, +product: ArtifactValue.ProductValue, +history: V.History, +view: V.Frame) -> Type:
  Exists(T.ResolverState, measured => Exists(T.Request, request =>
    {continuation == Loop.ServiceStep{T.AwaitService{measured, request}} : Loop.Continuation} &
    {Contract.operation(request) == T.EncodeProduct{product} : T.Operation} &
    {S.state_stage(measured) == T.MeasuringCandidateTree{} : T.ResolverStage} &
    {Contract.actual_frame(S.state_frame(measured), history) == Some{view} : Maybe<&2, V.Frame>}))

def ready_attachment_staged_measurement(+attachment: Compose.Attachment, +frame: T.ResolverFrame, +child: T.TentativeChild, +state: T.ResolverState, +previous: Nat, +product: ArtifactValue.ProductValue, +history: V.History, +view: V.Frame, available: {PreparedRoot.prepared_unit(Attach.attached_frame(attachment, frame), S.state_prepared(state)) == Some{product} : Maybe<&2, ArtifactValue.ProductValue>}, projected: {ActualFrame.project(Attach.attached_frame(attachment, frame), history) == Some{view} : Maybe<&2, V.Frame>}) -> ready_measurement_staged_result(Attach.attachment(Some{attachment}, child, previous, state, frame), product, history, view):
  match attachment state:
    case Compose.Attachment{_, _, _, _, _, _, +ids, _, _} T.ResolverState{_, _, _, _, _, _, _, _, _, _, _, _, _}:
      %Equal.sym(Maybe<&2, ArtifactValue.ProductValue>, PreparedRoot.prepared_unit(Attach.attached_frame(attachment, frame), S.state_prepared(state)), Some{product}, available):
        ready_measurement_staged_result(Attach.request_candidate(_, child, ids, previous, S.with_state_frame(state, Some{Attach.attached_frame(attachment, frame)})), product, history, view)
      candidate_request_staged(product, child, ids, previous, S.with_state_frame(state, Some{Attach.attached_frame(attachment, frame)}), history, view, projected)

def ready_frame_view_materialization_result(+frame: T.ResolverFrame, +prepared: T.PreparedLanguage, view: V.Frame) -> Type:
  match view:
    case V.Frame{_, _, _, _, _, +forest, _, _, _, _, _, _, _, _, _, _, _, _, _, _}:
      Exists(ArtifactValue.ProductValue, value =>
        {PreparedRoot.prepared_unit(frame, prepared) == Some{value} : Maybe<&2, ArtifactValue.ProductValue>} &
        {F.prepared_unit(Allowance.materialization(forest), forest, S.frame_dependencies(frame), ready_prepared_fingerprint(prepared)) == F.Materialized{value} : F.Materialization})

def ready_frame_view_materialized(+frame: T.ResolverFrame, +prepared: T.PreparedLanguage, +history: V.History, +view: V.Frame, +ready: {ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>}) -> ready_frame_view_materialization_result(frame, prepared, view):
  match history view:
    case V.History{+addresses, +order, _, _, _, _, +episode}
        V.Frame{_, _, _, _, _, +forest, _, _, _, _, _, _, _, _, _, _, _, _, _, _}:
      +checks: {frame_checks(frame, history) == True{} : Bool} = Pair.fst({frame_checks(frame, history) == True{} : Bool}, {ActualFrame.projected(frame, history) == Some{view} : Maybe<&2, V.Frame>}, actual_frame_contents(frame, history, view, ready))
      +projected: {ActualFrame.projected(frame, history) == Some{view} : Maybe<&2, V.Frame>} = Pair.snd({frame_checks(frame, history) == True{} : Bool}, {ActualFrame.projected(frame, history) == Some{view} : Maybe<&2, V.Frame>}, actual_frame_contents(frame, history, view, ready))
      ready_frame_materialized_total(frame, prepared, forest, addresses, episode,
        Pair.fst({P.project(S.frame_root(frame), S.frame_nodes(frame), S.frame_references(frame), S.frame_artifacts(frame), addresses) == Some{forest} : Maybe<&2, F.Forest>}, {Relation.frame_forest(forest, episode) == True{} : Bool}, projected_frame_semantics(frame, history, view, projected)),
        BoolFacts.eq_true_of_and_right(Nat.is_eq(S.frame_next_node(frame), List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), ActualFrame.catalog_valid(S.frame_artifacts(frame)),
          BoolFacts.eq_true_of_and_right(ActualFrame.dense(S.frame_nodes(frame), 0n), Bool.and(Nat.is_eq(S.frame_next_node(frame), List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), ActualFrame.catalog_valid(S.frame_artifacts(frame))),
            BoolFacts.eq_true_of_and_right(ActualFrame.coverage(order, frame), Bool.and(ActualFrame.dense(S.frame_nodes(frame), 0n), Bool.and(Nat.is_eq(S.frame_next_node(frame), List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), ActualFrame.catalog_valid(S.frame_artifacts(frame)))), checks))),
        Pair.snd({P.project(S.frame_root(frame), S.frame_nodes(frame), S.frame_references(frame), S.frame_artifacts(frame), addresses) == Some{forest} : Maybe<&2, F.Forest>}, {Relation.frame_forest(forest, episode) == True{} : Bool}, projected_frame_semantics(frame, history, view, projected)))

def ready_staged_forest(view: V.Frame) -> F.Forest:
  match view:
    case V.Frame{_, _, _, _, _, forest, _, _, _, _, _, _, _, _, _, _, _, _, _, _}: forest

def ready_attachment_staged_total_result(+attachment: Compose.Attachment, +frame: T.ResolverFrame, +child: T.TentativeChild, +state: T.ResolverState, +previous: Nat, +history: V.History, +view: V.Frame) -> Type:
  Exists(ArtifactValue.ProductValue, product =>
    {F.prepared_unit(Allowance.materialization(ready_staged_forest(view)), ready_staged_forest(view), S.frame_dependencies(Attach.attached_frame(attachment, frame)), ready_prepared_fingerprint(S.state_prepared(state))) == F.Materialized{product} : F.Materialization} &
    {ready_loop_request(Attach.attachment(Some{attachment}, child, previous, state, frame)) == Some{ready_actual_request(state, product)} : Maybe<&2, T.Request>} &
    ready_measurement_staged_result(Attach.attachment(Some{attachment}, child, previous, state, frame), product, history, view))

def ready_attachment_staged_total_witness(+attachment: Compose.Attachment, +frame: T.ResolverFrame, +child: T.TentativeChild, +state: T.ResolverState, +previous: Nat, +history: V.History, +view: V.Frame, projected: {ActualFrame.project(Attach.attached_frame(attachment, frame), history) == Some{view} : Maybe<&2, V.Frame>}, materialized: ready_frame_view_materialization_result(Attach.attached_frame(attachment, frame), S.state_prepared(state), view)) -> ready_attachment_staged_total_result(attachment, frame, child, state, previous, history, view):
  match view:
    case V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}:
      match materialized:
        case (+product, (actual, reference)):
          +actual: {PreparedRoot.prepared_unit(Attach.attached_frame(attachment, frame), S.state_prepared(state)) == Some{product} : Maybe<&2, ArtifactValue.ProductValue>} = actual
          Tuple{product, Tuple{reference, Tuple{ready_attachment_request_identity(attachment, frame, child, state, previous, product, actual),
            ready_attachment_staged_measurement(attachment, frame, child, state, previous, product, history, view, actual, projected)}}}

def ready_attachment_staged_total(+attachment: Compose.Attachment, +frame: T.ResolverFrame, +child: T.TentativeChild, +state: T.ResolverState, +previous: Nat, +history: V.History, +view: V.Frame, +projected: {ActualFrame.project(Attach.attached_frame(attachment, frame), history) == Some{view} : Maybe<&2, V.Frame>}) -> ready_attachment_staged_total_result(attachment, frame, child, state, previous, history, view):
  ready_attachment_staged_total_witness(attachment, frame, child, state, previous, history, view, projected,
    ready_frame_view_materialized(Attach.attached_frame(attachment, frame), S.state_prepared(state), history, view, projected))

def ready_previous_selected(+state: T.ResolverState, +frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +previous: Nat, frame_present: {S.state_frame(state) == Some{frame} : Maybe<&2, T.ResolverFrame>}, child_present: {S.scratch_tentative(S.state_scratch(state)) == Some{child} : Maybe<&2, T.TentativeChild>}, edge_present: {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>}) -> {Attach.previous(previous, state) == Attach.previous_child(child, frame, edge, previous, state) : Loop.Continuation}:
  Equal.trans(Loop.Continuation, Attach.previous(previous, state), Attach.previous_parts(Some{child}, S.state_frame(state), S.scratch_pending_edge(S.state_scratch(state)), previous, state), Attach.previous_child(child, frame, edge, previous, state),
    Equal.cong(Maybe<&2, T.TentativeChild>, Loop.Continuation, value => Attach.previous_parts(value, S.state_frame(state), S.scratch_pending_edge(S.state_scratch(state)), previous, state), S.scratch_tentative(S.state_scratch(state)), Some{child}, child_present),
    Equal.trans(Loop.Continuation, Attach.previous_parts(Some{child}, S.state_frame(state), S.scratch_pending_edge(S.state_scratch(state)), previous, state), Attach.previous_parts(Some{child}, Some{frame}, S.scratch_pending_edge(S.state_scratch(state)), previous, state), Attach.previous_child(child, frame, edge, previous, state),
      Equal.cong(Maybe<&2, T.ResolverFrame>, Loop.Continuation, value => Attach.previous_parts(Some{child}, value, S.scratch_pending_edge(S.state_scratch(state)), previous, state), S.state_frame(state), Some{frame}, frame_present),
      Equal.cong(Maybe<&2, Local.Pending>, Loop.Continuation, value => Attach.previous_parts(Some{child}, Some{frame}, value, previous, state), S.scratch_pending_edge(S.state_scratch(state)), Some{edge}, edge_present)))

def ready_selected_attachment_result(child: T.TentativeChild, +frame: T.ResolverFrame, edge: Local.Pending, +attachment: Compose.Attachment) -> Type:
  match child edge:
    case T.TentativeChild{_, _, _, _, _, _, +identity, _, +plan, _, _, _} Local.Pending{owner, index, _, _, _, _, _, _}:
      {Compose.tentative_attachment(Compose.remap(plan, List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), S.frame_nodes(frame), S.frame_references(frame), owner, index,
        Bool.pick(Maybe<&2, String>, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), identity))), Some{identity}, None{}),
        S.frame_next_edge(frame), S.frame_pending(frame)) == Some{attachment} : Maybe<&2, Compose.Attachment>}

def ready_previous_child_attachment(+child: T.TentativeChild, +frame: T.ResolverFrame, +edge: Local.Pending, +state: T.ResolverState, +previous: Nat, +attachment: Compose.Attachment, offset: {S.frame_next_node(frame) == List.length(&2, Local.PlannedNode, S.frame_nodes(frame)) : Nat}, edge_present: {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>}, attached: ready_selected_attachment_result(child, frame, edge, attachment)) -> {Attach.previous_child(child, frame, edge, previous, state) == Attach.attachment(Some{attachment}, child, previous, state, frame) : Loop.Continuation}:
  match child edge:
    case T.TentativeChild{_, _, _, _, _, _, +identity, _, +plan, _, _, _} Local.Pending{+owner, +index, _, _, _, _, _, _}:
      +seen: Bool = Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), identity))
      +by_state: Maybe<&2, String> = Bool.pick(Maybe<&2, String>, Bool.and(Bool.not(Attach.bundled_state(state)), seen), Some{identity}, None{})
      +by_edge: Maybe<&2, String> = Bool.pick(Maybe<&2, String>, Bool.and(Bool.not(Attach.bundled_edge(edge)), seen), Some{identity}, None{})
      +shifted: Compose.RemappedPlan = Compose.remap(plan, List.length(&2, Local.PlannedNode, S.frame_nodes(frame)))
      Equal.trans(Loop.Continuation, Attach.previous_child(child, frame, edge, previous, state),
        Attach.attachment(Compose.tentative_attachment(shifted, S.frame_nodes(frame), S.frame_references(frame), owner, index, by_state, S.frame_next_edge(frame), S.frame_pending(frame)), child, previous, state, frame),
        Attach.attachment(Some{attachment}, child, previous, state, frame),
        Equal.cong(Nat, Loop.Continuation, count => Attach.attachment(Compose.tentative_attachment(Compose.remap(plan, count), S.frame_nodes(frame), S.frame_references(frame), owner, index, by_state, S.frame_next_edge(frame), S.frame_pending(frame)), child, previous, state, frame),
          S.frame_next_node(frame), List.length(&2, Local.PlannedNode, S.frame_nodes(frame)), offset),
        Equal.trans(Loop.Continuation,
          Attach.attachment(Compose.tentative_attachment(shifted, S.frame_nodes(frame), S.frame_references(frame), owner, index, by_state, S.frame_next_edge(frame), S.frame_pending(frame)), child, previous, state, frame),
          Attach.attachment(Compose.tentative_attachment(shifted, S.frame_nodes(frame), S.frame_references(frame), owner, index, by_edge, S.frame_next_edge(frame), S.frame_pending(frame)), child, previous, state, frame),
          Attach.attachment(Some{attachment}, child, previous, state, frame),
          Equal.cong(Bool, Loop.Continuation, bundled => Attach.attachment(Compose.tentative_attachment(shifted, S.frame_nodes(frame), S.frame_references(frame), owner, index,
            Bool.pick(Maybe<&2, String>, Bool.and(Bool.not(bundled), seen), Some{identity}, None{}), S.frame_next_edge(frame), S.frame_pending(frame)), child, previous, state, frame),
            Attach.bundled_state(state), Attach.bundled_edge(edge), Equal.cong(Maybe<&2, Local.Pending>, Bool, value => Attach.bundled_optional(value), S.scratch_pending_edge(S.state_scratch(state)), Some{edge}, edge_present)),
          Equal.cong(Maybe<&2, Compose.Attachment>, Loop.Continuation, value => Attach.attachment(value, child, previous, state, frame),
            Compose.tentative_attachment(shifted, S.frame_nodes(frame), S.frame_references(frame), owner, index, by_edge, S.frame_next_edge(frame), S.frame_pending(frame)), Some{attachment}, attached)))

def ready_previous_attached(+state: T.ResolverState, +frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, +attachment: Compose.Attachment, ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +frame_present: {S.state_frame(state) == Some{frame} : Maybe<&2, T.ResolverFrame>}, +child_present: {S.scratch_tentative(S.state_scratch(state)) == Some{child} : Maybe<&2, T.TentativeChild>}, +edge_present: {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>}, attached: ready_selected_attachment_result(child, frame, edge, attachment)) -> {Attach.previous(previous, state) == Attach.attachment(Some{attachment}, child, previous, state, frame) : Loop.Continuation}:
  Equal.trans(Loop.Continuation, Attach.previous(previous, state), Attach.previous_child(child, frame, edge, previous, state), Attach.attachment(Some{attachment}, child, previous, state, frame),
    ready_previous_selected(state, frame, child, edge, previous, frame_present, child_present, edge_present),
    ready_previous_child_attachment(child, frame, edge, state, previous, attachment,
      ready_selected_offset(child, history, child_history, phase, state, frame, edge,
        ready_actual_parts_installed(state, history, child_history, phase, frame, child, edge, frame_present, child_present, edge_present, ready)), edge_present, attached))

# Preserve the independently projected registration rows while entering the
# exact common measurement history; this discharges the reference staged join.
def ready_reference_edge(state: D.State) -> Nat:
  match state:
    case D.State{_, X.Frame{_, _, _, _, _, _, _, edge, _, _, _, _}, _, _, _, _, _, _, _}: edge

def ready_view_edge(view: V.Frame) -> Nat:
  match view:
    case V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, edge, _, _, _, _, _}: edge

def ready_child_rows(view: Phase.Child, next: Nat) -> List<&2, V.PendingEntry>:
  match view:
    case Phase.Child{_, _, _, _, _, _, _, _, _, _, _, payloads, _, _, source, catalog}:
      ready_payload_rows(payloads, next, source, catalog)

def ready_reference_child_registration(child: X.Child, next: Nat) -> X.Registration:
  match child:
    case X.Child{X.Attempt{_, _, _, source, _, _, _, _, catalog, _}, _, _, pending}:
      X.register(pending, source, catalog, next)

def ready_reference_edge_assembled(+state: D.State, +history: V.History, +projected_targets: Maybe<&2, List<&2, V.TargetEntry>>, +projected_captured: Maybe<&2, List<&2, V.CapturedEntry>>, +projected_visited: Maybe<&2, List<&2, String>>, +view: V.Frame, ready: {ReferenceFrame.assembled(state, history, projected_targets, projected_captured, projected_visited) == Some{view} : Maybe<&2, V.Frame>}) -> {ready_reference_edge(state) == ready_view_edge(view) : Nat}:
  match state history projected_targets projected_captured projected_visited:
    case D.State{D.Config{_, _, _, context, _, _},
      X.Frame{G.Bounded{+graph, remaining}, command, +forest,
        Signed.State{Recursive.State{_, budget, _, _}, signed}, edges, _, artifacts_by_target,
        next_edge, episode, next_artifact, dependencies, _}, _, target_ids, next_target, _, _, _, _}
      V.History{_, _, _, _, artifacts, _, _}
      Some{targets} Some{captures} Some{+seen}:
      %Count.some_equal(V.Frame,
        V.Frame{ReferenceFrame.branch(context), ReferenceFrame.graph_limits(graph), graph, command, dependencies, forest,
          ReferenceFrame.pending(edges), targets, ReferenceFrame.ids(target_ids), captures, ReferenceFrame.identities(artifacts_by_target),
          seen, V.budget(budget, signed), ReferenceFrame.node_count(forest), next_edge,
          next_target, next_artifact, artifacts, remaining, episode}, view, ready):
        {ready_reference_edge(state) == ready_view_edge(_) : Nat}
      {==}
    case _ _ None{} _ _:
      Empty.absurd({ready_reference_edge(state) == ready_view_edge(view) : Nat}, Contents.none_some(V.Frame, view, ready))
    case _ _ Some{_} None{} _:
      Empty.absurd({ready_reference_edge(state) == ready_view_edge(view) : Nat}, Contents.none_some(V.Frame, view, ready))
    case _ _ Some{_} Some{_} None{}:
      Empty.absurd({ready_reference_edge(state) == ready_view_edge(view) : Nat}, Contents.none_some(V.Frame, view, ready))

def ready_reference_edge_projected(+state: D.State, +history: V.History, +view: V.Frame, ready: {ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>}) -> {ready_reference_edge(state) == ready_view_edge(view) : Nat}:
  match state history:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{+values, _, _, _}, _},
      _, +captures, _, _, _, _, _, _}, +target_values, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, +seen}, _, +sources, _, _, _}:
      ready_reference_edge_assembled(state, history, ReferenceFrame.targets(target_values),
        ReferenceFrame.captured(captures, sources), ReferenceFrame.visited(seen, values), view, ready)

def ready_reference_rows_view(+child: X.Child, +history: Phase.ChildHistory, +visited: Maybe<&2, List<&2, String>>, +view: Phase.Child, +next: Nat, ready: {ReferenceReady.child_view(child, history, visited) == Some{view} : Maybe<&2, Phase.Child>}) -> {ReferenceFrame.pending(ready_registration_more(ready_reference_child_registration(child, next))) == ready_child_rows(view, next) : List<&2, V.PendingEntry>}:
  match child history visited:
    case X.Child{
      X.Attempt{
        +target,
        edge,
        +kind,
        +source,
        +bytes,
        name,
        expected,
        Local.Declaration{+handle, +identity, function, bundled, references, +source_path},
        +catalog,
        +before
      },
      F.Created{root, nodes, addresses},
      Signed.State{Recursive.State{_, budget, _, _}, signed},
      +edges
    }
      Phase.ChildHistory{_, _, _, capture, _} Some{+visited}:
      %Count.some_equal(Phase.Child,
        Phase.Child{
          target,
          X.attempt_path(
            X.Attempt{
              target,
              edge,
              kind,
              source,
              bytes,
              name,
              expected,
              Local.Declaration{handle, identity, function, bundled, references, source_path},
              catalog,
              before
            }
          ),
          kind,
          capture,
          bytes,
          T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceReady.file_exports(kind, source), bytes},
          handle,
          identity,
          before,
          F.Forest{Some{root}, nodes},
          addresses,
          ReferenceReady.pending(edges),
          visited,
          V.budget(budget, signed),
          source,
          catalog
        }, view, ready):
        {ReferenceFrame.pending(ready_registration_more(ready_reference_child_registration(child, next))) == ready_child_rows(_, next) : List<&2, V.PendingEntry>}
      ready_reference_pending_registered(edges, source, catalog, next)
    case _ _ None{}:
      Empty.absurd({ReferenceFrame.pending(ready_registration_more(ready_reference_child_registration(child, next))) == ready_child_rows(view, next) : List<&2, V.PendingEntry>}, Contents.none_some(Phase.Child, view, ready))

def ready_reference_child_rows(+child: X.Child, +history: Phase.ChildHistory, +view: Phase.Child, +next: Nat, ready: {ReferenceReady.child_project(child, history) == Some{view} : Maybe<&2, Phase.Child>}) -> {ReferenceFrame.pending(ready_registration_more(ready_reference_child_registration(child, next))) == ready_child_rows(view, next) : List<&2, V.PendingEntry>}:
  match child history:
    case X.Child{_, _, Signed.State{Recursive.State{+values, _, _, _}, _}, _}
      Phase.ChildHistory{_, _, _, _, +order}:
      ready_reference_rows_view(child, history, ReferenceFrame.visited(order, values), view, next, ready)

def ready_reference_registration_rows(+state: D.State, +child: X.Child) -> {ready_reference_registration(state, child) == ready_reference_child_registration(child, ready_reference_edge(state)) : X.Registration}:
  match state child:
    case D.State{_, X.Frame{_, _, _, _, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}
      X.Child{X.Attempt{_, _, _, _, _, _, _, _, _, _}, _, _, _}: {==}

def ready_reference_phase_rows(+state: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, ready: {ReferenceReady.project(state, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {ReferenceFrame.pending(ready_registration_more(ready_reference_registration(state, child))) == ready_child_rows(ready_phase_child(phase), ready_view_edge(ready_phase_frame(phase))) : List<&2, V.PendingEntry>}:
  match phase:
    case Phase.Phase{+view, +child_view, +capsule}:
      Parent.eliminate_pair({ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>},
        {ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>} &
        {Some{ReferenceReady.capsule(state, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>},
        {ReferenceFrame.pending(ready_registration_more(ready_reference_registration(state, child))) == ready_child_rows(child_view, ready_view_edge(view)) : List<&2, V.PendingEntry>},
        reference_ready_contents(state, child, history, child_history, phase, ready),
        frame_ready => child_observations =>
        Parent.eliminate_pair({ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>},
          {Some{ReferenceReady.capsule(state, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>},
          {ReferenceFrame.pending(ready_registration_more(ready_reference_registration(state, child))) == ready_child_rows(child_view, ready_view_edge(view)) : List<&2, V.PendingEntry>},
          child_observations, child_ready => capsule_ready =>
          Equal.trans(List<&2, V.PendingEntry>, ReferenceFrame.pending(ready_registration_more(ready_reference_registration(state, child))),
            ready_child_rows(child_view, ready_reference_edge(state)), ready_child_rows(child_view, ready_view_edge(view)),
            Equal.trans(List<&2, V.PendingEntry>, ReferenceFrame.pending(ready_registration_more(ready_reference_registration(state, child))),
              ReferenceFrame.pending(ready_registration_more(ready_reference_child_registration(child, ready_reference_edge(state)))),
              ready_child_rows(child_view, ready_reference_edge(state)),
              Equal.cong(X.Registration, List<&2, V.PendingEntry>, value => ReferenceFrame.pending(ready_registration_more(value)),
                ready_reference_registration(state, child), ready_reference_child_registration(child, ready_reference_edge(state)), ready_reference_registration_rows(state, child)),
              ready_reference_child_rows(child, child_history, child_view, ready_reference_edge(state), child_ready)),
            Equal.cong(Nat, List<&2, V.PendingEntry>, next => ready_child_rows(child_view, next), ready_reference_edge(state), ready_view_edge(view),
              ready_reference_edge_projected(state, history, view, frame_ready)))))

def ready_reference_staged_measured(+state: D.State, +child: X.Child, +previous: Nat, +forest: F.Forest, +product: ArtifactValue.ProductValue, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +ready: {ReferenceReady.project(state, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, replaced: {X.attachment(D.frame(state), child) == F.Replaced{forest} : F.Replacement}, materialized: {F.prepared_unit(Allowance.materialization(forest), forest, ready_reference_dependencies(D.frame(state)), ready_reference_fingerprint(D.frame(state))) == F.Materialized{product} : F.Materialization}) -> {Staged.project(ReferenceBoundary.enter(state, child, previous), History.measurement(phase, history)) == Some{ready_staged_frame(ready_phase_frame(phase), forest, ready_child_rows(ready_phase_child(phase), ready_view_edge(ready_phase_frame(phase))), ready_registration_next(ready_reference_registration(state, child)))} : Maybe<&2, V.Frame>}:
  match phase:
    case Phase.Phase{V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, +node, +edge, _, _, _, _, _},
      Phase.Child{_, _, _, _, _, _, _, _, _, _, +addresses, +payloads, _, _, +source, +catalog}, +capsule}:
      Equal.trans(Maybe<&2, V.Frame>,
        Staged.project(ReferenceBoundary.enter(state, child, previous), History.measurement(phase, history)),
        Some{ready_staged_frame(ready_phase_frame(phase), forest,
          ReferenceFrame.pending(ready_registration_more(ready_reference_registration(state, child))),
          ready_registration_next(ready_reference_registration(state, child)))},
        Some{ready_staged_frame(ready_phase_frame(phase), forest,
          ready_child_rows(ready_phase_child(phase), edge), ready_registration_next(ready_reference_registration(state, child)))},
        ready_reference_staged_enter(state, child, previous, forest, product, history,
          addresses, node, History.ids(payloads, edge), source, catalog, ready_phase_frame(phase),
          Pair.fst({ReferenceFrame.project(state, history) == Some{ready_phase_frame(phase)} : Maybe<&2, V.Frame>},
            {ReferenceReady.child_project(child, child_history) == Some{ready_phase_child(phase)} : Maybe<&2, Phase.Child>} &
            {Some{ReferenceReady.capsule(state, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>},
            reference_ready_contents(state, child, history, child_history, phase, ready)), replaced, materialized),
        Equal.cong(List<&2, V.PendingEntry>, Maybe<&2, V.Frame>, rows =>
          Some{ready_staged_frame(ready_phase_frame(phase), forest, rows, ready_registration_next(ready_reference_registration(state, child)))},
          ReferenceFrame.pending(ready_registration_more(ready_reference_registration(state, child))),
          ready_child_rows(ready_phase_child(phase), edge), ready_reference_phase_rows(state, child, history, child_history, phase, ready)))

def ready_payload_rows_length(+items: List<&2, V.PendingPayload>, +next: Nat, +source: T.SourceFacts, +catalog: RootSpec.Source) -> {List.length(&2, V.PendingEntry, ready_payload_rows(items, next, source, catalog)) == List.length(&2, V.PendingPayload, items) : Nat}:
  match items:
    case []: {==}
    case _ <> +tail:
      Equal.cong(Nat, Nat, size => (1n + size : Nat), List.length(&2, V.PendingEntry, ready_payload_rows(tail, (next + 1n : Nat), source, catalog)),
        List.length(&2, V.PendingPayload, tail), ready_payload_rows_length(tail, (next + 1n : Nat), source, catalog))

def ready_reference_registered_count(+items: List<&2, F.Pending>, +source: T.SourceFacts, +catalog: RootSpec.Source, +next: Nat) -> {ready_registration_next(X.register(items, source, catalog, next)) == (next + List.length(&2, V.PendingEntry, ReferenceFrame.pending(ready_registration_more(X.register(items, source, catalog, next)))) : Nat) : Nat}:
  Equal.trans(Nat, ready_registration_next(X.register(items, source, catalog, next)),
    (next + List.length(&2, F.Pending, items) : Nat),
    (next + List.length(&2, V.PendingEntry, ReferenceFrame.pending(ready_registration_more(X.register(items, source, catalog, next)))) : Nat),
    ready_reference_next_exact(items, source, catalog, next),
    Equal.cong(Nat, Nat, size => (next + size : Nat), List.length(&2, F.Pending, items),
      List.length(&2, V.PendingEntry, ReferenceFrame.pending(ready_registration_more(X.register(items, source, catalog, next)))),
      Equal.trans(Nat, List.length(&2, F.Pending, items), List.length(&2, V.PendingPayload, ReferenceReady.pending(items)),
        List.length(&2, V.PendingEntry, ReferenceFrame.pending(ready_registration_more(X.register(items, source, catalog, next)))),
        ready_reference_payload_length(items),
        Equal.sym(Nat, List.length(&2, V.PendingEntry, ReferenceFrame.pending(ready_registration_more(X.register(items, source, catalog, next)))),
          List.length(&2, V.PendingPayload, ReferenceReady.pending(items)),
          Equal.trans(Nat, List.length(&2, V.PendingEntry, ReferenceFrame.pending(ready_registration_more(X.register(items, source, catalog, next)))),
            List.length(&2, V.PendingEntry, ready_payload_rows(ReferenceReady.pending(items), next, source, catalog)), List.length(&2, V.PendingPayload, ReferenceReady.pending(items)),
            Equal.cong(List<&2, V.PendingEntry>, Nat, rows => List.length(&2, V.PendingEntry, rows),
              ReferenceFrame.pending(ready_registration_more(X.register(items, source, catalog, next))), ready_payload_rows(ReferenceReady.pending(items), next, source, catalog),
              ready_reference_pending_registered(items, source, catalog, next)),
            ready_payload_rows_length(ReferenceReady.pending(items), next, source, catalog))))))

def ready_reference_registration_count(+state: D.State, +child: X.Child) -> {ready_registration_next(ready_reference_registration(state, child)) == (ready_reference_edge(state) + List.length(&2, V.PendingEntry, ReferenceFrame.pending(ready_registration_more(ready_reference_registration(state, child)))) : Nat) : Nat}:
  match state child:
    case D.State{_, X.Frame{_, _, _, _, _, _, _, +next, _, _, _, _}, _, _, _, _, _, _, _}
      X.Child{X.Attempt{_, _, _, +source, _, _, _, _, +catalog, _}, _, _, +pending}:
      ready_reference_registered_count(pending, source, catalog, next)

def ready_reference_phase_next(+state: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +ready: {ReferenceReady.project(state, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {ready_registration_next(ready_reference_registration(state, child)) == (ready_view_edge(ready_phase_frame(phase)) + List.length(&2, V.PendingEntry, ready_child_rows(ready_phase_child(phase), ready_view_edge(ready_phase_frame(phase)))) : Nat) : Nat}:
  match phase:
    case Phase.Phase{+view, +child_view, +capsule}:
      +rows: List<&2, V.PendingEntry> = ReferenceFrame.pending(ready_registration_more(ready_reference_registration(state, child)))
      +new_rows: List<&2, V.PendingEntry> = ready_child_rows(child_view, ready_view_edge(view))
      Equal.trans(Nat, ready_registration_next(ready_reference_registration(state, child)),
        (ready_reference_edge(state) + List.length(&2, V.PendingEntry, rows) : Nat), (ready_view_edge(view) + List.length(&2, V.PendingEntry, new_rows) : Nat),
        ready_reference_registration_count(state, child),
        Equal.trans(Nat, (ready_reference_edge(state) + List.length(&2, V.PendingEntry, rows) : Nat),
          (ready_view_edge(view) + List.length(&2, V.PendingEntry, rows) : Nat), (ready_view_edge(view) + List.length(&2, V.PendingEntry, new_rows) : Nat),
          Equal.cong(Nat, Nat, edge => (edge + List.length(&2, V.PendingEntry, rows) : Nat), ready_reference_edge(state), ready_view_edge(view),
            ready_reference_edge_projected(state, history, view,
              Pair.fst({ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>},
                {ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>} &
                {Some{ReferenceReady.capsule(state, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}, reference_ready_contents(state, child, history, child_history, phase, ready)))),
          Equal.cong(List<&2, V.PendingEntry>, Nat, entries => (ready_view_edge(view) + List.length(&2, V.PendingEntry, entries) : Nat), rows, new_rows,
            ready_reference_phase_rows(state, child, history, child_history, phase, ready))))

def ready_reference_staged_common(+state: D.State, +child: X.Child, +previous: Nat, +forest: F.Forest, +product: ArtifactValue.ProductValue, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +ready: {ReferenceReady.project(state, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, replaced: {X.attachment(D.frame(state), child) == F.Replaced{forest} : F.Replacement}, materialized: {F.prepared_unit(Allowance.materialization(forest), forest, ready_reference_dependencies(D.frame(state)), ready_reference_fingerprint(D.frame(state))) == F.Materialized{product} : F.Materialization}) -> {Staged.project(ReferenceBoundary.enter(state, child, previous), History.measurement(phase, history)) == Some{ready_staged_frame(ready_phase_frame(phase), forest, ready_child_rows(ready_phase_child(phase), ready_view_edge(ready_phase_frame(phase))), (ready_view_edge(ready_phase_frame(phase)) + List.length(&2, V.PendingEntry, ready_child_rows(ready_phase_child(phase), ready_view_edge(ready_phase_frame(phase)))) : Nat))} : Maybe<&2, V.Frame>}:
  +rows: List<&2, V.PendingEntry> = ready_child_rows(ready_phase_child(phase), ready_view_edge(ready_phase_frame(phase)))
  Equal.trans(Maybe<&2, V.Frame>, Staged.project(ReferenceBoundary.enter(state, child, previous), History.measurement(phase, history)),
    Some{ready_staged_frame(ready_phase_frame(phase), forest, rows, ready_registration_next(ready_reference_registration(state, child)))},
    Some{ready_staged_frame(ready_phase_frame(phase), forest, rows, (ready_view_edge(ready_phase_frame(phase)) + List.length(&2, V.PendingEntry, rows) : Nat))},
    ready_reference_staged_measured(state, child, previous, forest, product, history, child_history, phase, ready, replaced, materialized),
    Equal.cong(Nat, Maybe<&2, V.Frame>, next => Some{ready_staged_frame(ready_phase_frame(phase), forest, rows, next)},
      ready_registration_next(ready_reference_registration(state, child)), (ready_view_edge(ready_phase_frame(phase)) + List.length(&2, V.PendingEntry, rows) : Nat),
      ready_reference_phase_next(state, child, history, child_history, phase, ready)))

def ready_actual_child_plan(child: T.TentativeChild) -> Local.Plan:
  match child:
    case T.TentativeChild{_, _, _, _, _, _, _, _, plan, _, _, _}: plan

def ready_attachment_edge(value: Compose.Attachment) -> Nat:
  match value:
    case Compose.Attachment{_, _, next, _, _, _, _, _, _}: next

def ready_attached_frame_edge(+attachment: Compose.Attachment, +frame: T.ResolverFrame) -> {S.frame_next_edge(Attach.attached_frame(attachment, frame)) == ready_attachment_edge(attachment) : Nat}:
  match attachment frame:
    case Compose.Attachment{_, _, _, _, _, _, _, _, _} T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}: {==}

def ready_registered_attachment_edge(+registration: Compose.RegisteredPending, +plan: Compose.RemappedPlan, +nodes: List<&2, Local.PlannedNode>, +references: List<&2, Local.ReferenceSlot>) -> {ready_attachment_edge(Compose.attachment_registered(registration, plan, nodes, references)) == ready_registered_next(registration) : Nat}:
  match registration plan:
    case Compose.RegisteredPending{_, _, _} Compose.RemappedPlan{_, _, _, _, _, _, _}: {==}

def ready_remapped_pending(plan: Compose.RemappedPlan) -> List<&2, Local.Pending>:
  match plan:
    case Compose.RemappedPlan{_, _, _, _, items, _, _}: items

def ready_attach_replaced_edge(+replaced: Maybe<&2, List<&2, Local.ReferenceSlot>>, +plan: Compose.RemappedPlan, +nodes: List<&2, Local.PlannedNode>, +next: Nat, +pending: Map<&2, Maybe<&2, Local.Pending>>, +attachment: Compose.Attachment, attached: {Compose.attach_replaced(replaced, plan, nodes, next, pending) == Some{attachment} : Maybe<&2, Compose.Attachment>}) -> {ready_attachment_edge(attachment) == ready_registered_next(Compose.register_pending(ready_remapped_pending(plan), next, pending)) : Nat}:
  match replaced plan:
    case Some{+references} Compose.RemappedPlan{_, _, _, _, +items, _, _}:
      %Count.some_equal(Compose.Attachment, Compose.attachment_registered(Compose.register_pending(items, next, pending), plan, nodes, references), attachment, attached):
        {ready_attachment_edge(_) == ready_registered_next(Compose.register_pending(items, next, pending)) : Nat}
      ready_registered_attachment_edge(Compose.register_pending(items, next, pending), plan, nodes, references)
    case None{} _:
      Empty.absurd({ready_attachment_edge(attachment) == ready_registered_next(Compose.register_pending(ready_remapped_pending(plan), next, pending)) : Nat}, Contents.none_some(Compose.Attachment, attachment, attached))

def ready_tentative_attachment_edge(+plan: Compose.RemappedPlan, +nodes: List<&2, Local.PlannedNode>, +references: List<&2, Local.ReferenceSlot>, +owner: Nat, +index: Nat, +include: Maybe<&2, String>, +next: Nat, +pending: Map<&2, Maybe<&2, Local.Pending>>, +attachment: Compose.Attachment, attached: {Compose.tentative_attachment(plan, nodes, references, owner, index, include, next, pending) == Some{attachment} : Maybe<&2, Compose.Attachment>}) -> {ready_attachment_edge(attachment) == ready_registered_next(Compose.register_pending(ready_remapped_pending(plan), next, pending)) : Nat}:
  match plan include:
    case Compose.RemappedPlan{+root, _, _, _, _, _, _} None{}:
      ready_attach_replaced_edge(Compose.replacement(Compose.replace_slot(references, owner, index, Local.Expanded{root})), plan, nodes, next, pending, attachment, attached)
    case Compose.RemappedPlan{_, _, _, _, _, _, _} Some{+identity}:
      ready_attach_replaced_edge(Compose.replacement(Compose.replace_slot(references, owner, index, Local.Included{identity})), plan, nodes, next, pending, attachment, attached)

def ready_selected_attachment_edge(+child: T.TentativeChild, +frame: T.ResolverFrame, +edge: Local.Pending, +attachment: Compose.Attachment, attached: ready_selected_attachment_result(child, frame, edge, attachment)) -> {S.frame_next_edge(Attach.attached_frame(attachment, frame)) == ready_registered_next(Compose.register_pending( ready_remapped_pending(Compose.remap(ready_actual_child_plan(child), List.length(&2, Local.PlannedNode, S.frame_nodes(frame)))), S.frame_next_edge(frame), S.frame_pending(frame))) : Nat}:
  match child edge:
    case T.TentativeChild{_, _, _, _, _, _, +identity, _, +plan, _, _, _} Local.Pending{+owner, +index, _, _, _, _, _, _}:
      Equal.trans(Nat, S.frame_next_edge(Attach.attached_frame(attachment, frame)), ready_attachment_edge(attachment),
        ready_registered_next(Compose.register_pending(ready_remapped_pending(Compose.remap(plan, List.length(&2, Local.PlannedNode, S.frame_nodes(frame)))), S.frame_next_edge(frame), S.frame_pending(frame))),
        ready_attached_frame_edge(attachment, frame),
        ready_tentative_attachment_edge(Compose.remap(plan, List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), S.frame_nodes(frame), S.frame_references(frame), owner, index,
          Bool.pick(Maybe<&2, String>, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), identity))), Some{identity}, None{}),
          S.frame_next_edge(frame), S.frame_pending(frame), attachment, attached))

def ready_plan_pending(plan: Local.Plan) -> List<&2, Local.Pending>:
  match plan:
    case Local.Plan{_, _, _, pending, _, _}: pending

def ready_selected_attachment_count(+child: T.TentativeChild, +frame: T.ResolverFrame, +edge: Local.Pending, +attachment: Compose.Attachment, +addresses: List<&2, F.AddressEntry>, +payloads: List<&2, V.PendingPayload>, attached: ready_selected_attachment_result(child, frame, edge, attachment), projected: {ActualReady.pending(ready_plan_pending(ready_actual_child_plan(child)), addresses) == Some{payloads} : Maybe<&2, List<&2, V.PendingPayload>>}) -> {S.frame_next_edge(Attach.attached_frame(attachment, frame)) == (S.frame_next_edge(frame) + List.length(&2, V.PendingPayload, payloads) : Nat) : Nat}:
  match child:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, +items, _, _}, _, _, _}:
      +offset: Nat = List.length(&2, Local.PlannedNode, S.frame_nodes(frame))
      +next: Nat = S.frame_next_edge(frame)
      Equal.trans(Nat, S.frame_next_edge(Attach.attached_frame(attachment, frame)),
        ready_registered_next(Compose.register_pending(Compose.shift_pending(items, offset), next, S.frame_pending(frame))),
        (next + List.length(&2, V.PendingPayload, payloads) : Nat),
        ready_selected_attachment_edge(child, frame, edge, attachment, attached),
        Equal.trans(Nat, ready_registered_next(Compose.register_pending(Compose.shift_pending(items, offset), next, S.frame_pending(frame))),
          (next + List.length(&2, Local.Pending, Compose.shift_pending(items, offset)) : Nat), (next + List.length(&2, V.PendingPayload, payloads) : Nat),
          ready_registered_next_exact(Compose.shift_pending(items, offset), next, S.frame_pending(frame)),
          Equal.cong(Nat, Nat, size => (next + size : Nat), List.length(&2, Local.Pending, Compose.shift_pending(items, offset)), List.length(&2, V.PendingPayload, payloads),
            Equal.trans(Nat, List.length(&2, Local.Pending, Compose.shift_pending(items, offset)), List.length(&2, Local.Pending, items), List.length(&2, V.PendingPayload, payloads),
              ready_shifted_pending_length(items, offset), ready_payload_length(items, addresses, payloads, projected)))))

# Invert the original successful reference phase once. The conclusion is the
# very forest replacement used by the parent witness, not a second algorithm.
def ready_reference_replacement_result(+state: D.State, +child: X.Child, phase: Phase.Phase, +known: Bool) -> Type:
  match phase:
    case Phase.Phase{V.Frame{_, _, _, _, _, +forest, _, _, _, _, _, _, _, _, _, _, _, _, _, _},
      Phase.Child{_, _, _, _, _, _, _, +identity, _, F.Forest{Some{+root}, +nodes}, +addresses, _, _, _, _, _},
      Phase.Capsule{_, _, _, _, _, _, _, _, _, V.PendingPayload{+owner, +index, _, +symbol, _, _, _, _}, _}}:
      {X.attachment_kind(D.frame(state), child, known)
        == F.replace(F.append(forest, F.Created{root, nodes, addresses}), owner, index,
          X.attachment_reference(known, F.Created{root, nodes, addresses}, symbol, identity)) : F.Replacement}
    case Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{None{}, _}, _, _, _, _, _, _}, _}: Empty

def ready_reference_replacement_assembled(+state: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +known: Bool, +targets: Maybe<&2, List<&2, V.TargetEntry>>, +captured: Maybe<&2, List<&2, V.CapturedEntry>>, +visited: Maybe<&2, List<&2, String>>, +child_visited: Maybe<&2, List<&2, String>>, ready: {ReferenceReady.assembled(ReferenceFrame.assembled(state, history, targets, captured, visited), ReferenceReady.child_view(child, child_history, child_visited), ReferenceReady.capsule(state, child)) == Some{phase} : Maybe<&2, Phase.Phase>}) -> ready_reference_replacement_result(state, child, phase, known):
  match state child history child_history targets captured visited child_visited:
    case D.State{D.Config{+invocation, +path, +language, +context, +clock, +cache},
      X.Frame{G.Bounded{+graph, +remaining}, +command, +forest,
        Signed.State{Recursive.State{_, +budget, _, _}, +signed}, +edges, _, +identities,
        +next_edge, +episode, +next_artifact, +dependencies, +fingerprint}, _, +target_ids, +next_target, +next, +iterations, _, _}
      X.Child{X.Attempt{+target,
        X.Edge{_, F.Pending{_, Local.Pending{_, _, _, _, _, _, _, _}}, _, _},
        +kind, +source, +bytes, +name, +expected, Local.Declaration{+handle, +identity, +function, +bundled, +references, +source_path}, +catalog, +before},
        F.Created{+root, +nodes, +addresses}, Signed.State{Recursive.State{_, +child_budget, _, _}, +child_signed}, +pending}
      V.History{_, _, _, _, +artifacts, _, _}
      Phase.ChildHistory{_, _, _, +capture, _}
      Some{+target_rows} Some{+capture_rows} Some{+seen} Some{+child_seen}:
      %Count.some_equal(Phase.Phase,
        Phase.Phase{
          V.Frame{ReferenceFrame.branch(context), ReferenceFrame.graph_limits(graph), graph, command, dependencies, forest,
            ReferenceFrame.pending(edges), target_rows, ReferenceFrame.ids(target_ids), capture_rows, ReferenceFrame.identities(identities), seen,
            V.budget(budget, signed), ReferenceFrame.node_count(forest), next_edge, next_target, next_artifact, artifacts, remaining, episode},
          Phase.Child{target, X.attempt_path(ready_reference_attempt(child)), kind, capture, bytes,
            T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceReady.file_exports(kind, source), bytes}, handle, identity, before,
            F.Forest{Some{root}, nodes}, addresses, ReferenceReady.pending(pending), child_seen, V.budget(child_budget, child_signed), source, catalog},
          ReferenceReady.capsule(state, child)}, phase, ready):
        ready_reference_replacement_result(state, child, _, known)
      {==}
    case _ _ _ _ None{} _ _ _:
      Empty.absurd(ready_reference_replacement_result(state, child, phase, known), Contents.none_some(Phase.Phase, phase, ready))
    case _ _ _ _ Some{_} None{} _ _:
      Empty.absurd(ready_reference_replacement_result(state, child, phase, known), Contents.none_some(Phase.Phase, phase, ready))
    case _ _ _ _ Some{_} Some{_} None{} _:
      Empty.absurd(ready_reference_replacement_result(state, child, phase, known), Contents.none_some(Phase.Phase, phase, ready))
    case _ _ _ _ Some{_} Some{_} Some{_} None{}:
      Empty.absurd(ready_reference_replacement_result(state, child, phase, known), Contents.none_some(Phase.Phase, phase, ready))

def ready_reference_replacement(+state: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +known: Bool, ready: {ReferenceReady.project(state, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> ready_reference_replacement_result(state, child, phase, known):
  match state child history child_history:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{+values, _, _, _}, _}, _, +captures, _, _, _, _, _, _}, +targets, _, _, _, _, _, _}
      X.Child{_, _, Signed.State{Recursive.State{+child_values, _, _, _}, _}, _}
      V.History{_, V.Order{_, _, _, _, _, +seen}, _, +sources, _, _, _}
      Phase.ChildHistory{_, _, _, _, +child_seen}:
      ready_reference_replacement_assembled(state, child, history, child_history, phase, known,
        ReferenceFrame.targets(targets), ReferenceFrame.captured(captures, sources), ReferenceFrame.visited(seen, values), ReferenceFrame.visited(child_seen, child_values), ready)

def ready_original_measured_result(+state: T.ResolverState, +history: V.History, +phase: Phase.Phase, +previous: Nat) -> Type:
  Exists(T.ResolverState, measured => Exists(T.Request, request => Exists(ArtifactValue.ProductValue, product => Exists(V.Frame, staged =>
    {Attach.previous(previous, state) == Loop.ServiceStep{T.AwaitService{measured, request}} : Loop.Continuation} &
    {Contract.operation(request) == T.EncodeProduct{product} : T.Operation} &
    {S.state_stage(measured) == T.MeasuringCandidateTree{} : T.ResolverStage} &
    {Contract.actual_frame(S.state_frame(measured), History.measurement(phase, history)) == Some{staged} : Maybe<&2, V.Frame>}))))

def ready_original_measured_product(+attachment: Compose.Attachment, +frame: T.ResolverFrame, +child: T.TentativeChild, +state: T.ResolverState, +previous: Nat, +history: V.History, +phase: Phase.Phase, +view: V.Frame, continued: {Attach.previous(previous, state) == Attach.attachment(Some{attachment}, child, previous, state, frame) : Loop.Continuation}, evidence: ready_attachment_staged_total_result(attachment, frame, child, state, previous, History.measurement(phase, history), view)) -> ready_original_measured_result(state, history, phase, previous):
  match evidence:
    case (+product, (_, (_, (+measured, (+request, (awaited, (operation, (stage, observed)))))))):
      Tuple{measured, Tuple{request, Tuple{product, Tuple{view, Tuple{
        Equal.trans(Loop.Continuation, Attach.previous(previous, state), Attach.attachment(Some{attachment}, child, previous, state, frame),
          Loop.ServiceStep{T.AwaitService{measured, request}}, continued, awaited), Tuple{operation, Tuple{stage, observed}}}}}}}

def ready_original_measured_parent(+state: T.ResolverState, +frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, +ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +frame_present: {S.state_frame(state) == Some{frame} : Maybe<&2, T.ResolverFrame>}, +child_present: {S.scratch_tentative(S.state_scratch(state)) == Some{child} : Maybe<&2, T.TentativeChild>}, +edge_present: {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>}, evidence: ready_staged_parent_result(child, history, child_history, phase, frame, edge, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(child)))))) -> ready_original_measured_result(state, history, phase, previous):
  match child edge history child_history phase:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Local.Pending{_, _, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _}
      Phase.ChildHistory{F.Created{_, _, _}, +source, +catalog, _, _}
      Phase.Phase{V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _},
        Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{Some{_}, _}, _, +payloads, _, _, _, _}, _}:
      match evidence:
        case (+attachment, (+forest, (attached, (_, projected)))):
          +view: V.Frame = ready_staged_frame(ready_phase_frame(phase), forest,
            ready_payload_rows(payloads, S.frame_next_edge(frame), source, catalog), S.frame_next_edge(Attach.attached_frame(attachment, frame)))
          continued: {Attach.previous(previous, state) == Attach.attachment(Some{attachment}, child, previous, state, frame) : Loop.Continuation} =
            ready_previous_attached(state, frame, child, edge, history, child_history, phase, previous, attachment,
              ready, frame_present, child_present, edge_present, attached)
          materialized: ready_attachment_staged_total_result(attachment, frame, child, state, previous, History.measurement(phase, history), view) =
            ready_attachment_staged_total(attachment, frame, child, state, previous, History.measurement(phase, history), view, projected)
          ready_original_measured_product(attachment, frame, child, state, previous, history, phase, view, continued, materialized)
    case _ _ _ _ Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{None{}, _}, _, _, _, _, _, _}, _}:
      Empty.absurd(ready_original_measured_result(state, history, phase, previous), evidence)

def ready_parent_materialized(+attachment: Compose.Attachment, +frame: T.ResolverFrame, +prepared: T.PreparedLanguage, +forest: F.Forest, +addresses: List<&2, F.AddressEntry>, +episode: Nat, projected: {P.project(S.frame_root(frame), Parent.attachment_nodes(attachment), Parent.attachment_slots(attachment), S.frame_artifacts(frame), addresses) == Some{forest} : Maybe<&2, F.Forest>}, catalog: {ActualFrame.catalog_valid(S.frame_artifacts(Attach.attached_frame(attachment, frame))) == True{} : Bool}, valid: {Relation.frame_forest(forest, episode) == True{} : Bool}) -> Exists(ArtifactValue.ProductValue, value => {PreparedRoot.prepared_unit(Attach.attached_frame(attachment, frame), prepared) == Some{value} : Maybe<&2, ArtifactValue.ProductValue>} & {F.prepared_unit(Allowance.materialization(forest), forest, S.frame_dependencies(Attach.attached_frame(attachment, frame)), ready_prepared_fingerprint(prepared)) == F.Materialized{value} : F.Materialization}):
  match attachment frame:
    case Compose.Attachment{_, _, _, _, _, _, _, _, _} T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}:
      ready_frame_materialized_total(Attach.attached_frame(attachment, frame), prepared, forest, addresses, episode, projected, catalog, valid)

def ready_parent_measured_result(+child: T.TentativeChild, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +frame: T.ResolverFrame, +edge: Local.Pending, +known: Bool, +state: T.ResolverState, +previous: Nat) -> Type:
  match child history child_history phase edge:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{+root, +nodes, +slots, +items, +visited, +budget}, _, _, _}
        V.History{+addresses, _, _, _, _, _, +episode}
        Phase.ChildHistory{F.Created{_, _, +child_addresses}, +source, +catalog, _, _}
        Phase.Phase{V.Frame{_, _, _, _, _, +parent_forest, _, _, _, _, _, _, _, _, _, _, _, _, _, _},
          Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{Some{+birth}, +semantic_nodes}, _, +payloads, _, _, _, _}, _}
        Local.Pending{+owner, +index, _, +symbol, _, _, _, _}:
      Exists(Compose.Attachment, attachment => Exists(F.Forest, forest =>
        {Compose.tentative_attachment(Compose.remap(Local.Plan{root, nodes, slots, items, visited, budget}, List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), S.frame_nodes(frame), S.frame_references(frame), owner, index,
          Bool.pick(Maybe<&2, String>, known, Some{ready_actual_identity(child)}, None{}), S.frame_next_edge(frame), S.frame_pending(frame)) == Some{attachment} : Maybe<&2, Compose.Attachment>} &
        {F.replace(F.append(parent_forest, F.Created{birth, semantic_nodes, child_addresses}), ready_payload_owner(ready_capsule_payload(ready_phase_capsule(phase))), index,
          X.attachment_reference(known, F.Created{birth, semantic_nodes, child_addresses}, symbol, ready_actual_identity(child))) == F.Replaced{forest} : F.Replacement} &
        ready_attachment_staged_total_result(attachment, frame, child, state, previous, History.measurement(phase, history),
          ready_staged_frame(ready_phase_frame(phase), forest, ready_payload_rows(payloads, S.frame_next_edge(frame), source, catalog), S.frame_next_edge(Attach.attached_frame(attachment, frame))))
      ))
    case _ _ _ Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{None{}, _}, _, _, _, _, _, _}, _} _: Empty

def ready_selected_parent_measured(+state: T.ResolverState, +frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, +known: Bool, +selected: {ActualReady.parts(state, Some{frame}, Some{child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}, evidence: ready_selected_parent_result(child, history, child_history, phase, frame, edge, known)) -> ready_parent_measured_result(child, history, child_history, phase, frame, edge, known, state, previous):
  match child edge history child_history phase:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Local.Pending{_, _, _, _, _, _, _, _}
      V.History{+addresses, V.Order{_, _, _, _, _, _}, _, _, _, _, +episode}
      Phase.ChildHistory{F.Created{_, _, +children}, +source, +catalog, _, _}
      Phase.Phase{V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _},
        Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{Some{_}, _}, _, +payloads, _, _, _, _}, _}:
      match evidence:
        case (+references, (+attachment, (+forest, (replacement, (attached, (+shape, (replaced, (projected, (valid, (node, dense)))))))))):
          +projected: {P.project(S.frame_root(frame), Parent.attachment_nodes(attachment), Parent.attachment_slots(attachment), S.frame_artifacts(frame), List.append(&2, F.AddressEntry, addresses, Mapping.shifted(children, List.length(&2, Local.PlannedNode, S.frame_nodes(frame))))) == Some{forest} : Maybe<&2, F.Forest>} = projected
          +valid: {Relation.frame_forest(forest, (episode + 1n : Nat)) == True{} : Bool} = valid
          +view: V.Frame = ready_staged_frame(ready_phase_frame(phase), forest,
            ready_payload_rows(payloads, S.frame_next_edge(frame), source, catalog), S.frame_next_edge(Attach.attached_frame(attachment, frame)))
          observed: {ActualFrame.project(Attach.attached_frame(attachment, frame), History.measurement(phase, history)) == Some{view} : Maybe<&2, V.Frame>} =
            %Equal.sym(Compose.Attachment, attachment, ready_actual_registration(child, frame, references), shape):
              {ActualFrame.project(Attach.attached_frame(_, frame), History.measurement(phase, history))
                == Some{ready_staged_frame(ready_phase_frame(phase), forest, ready_payload_rows(payloads, S.frame_next_edge(frame), source, catalog), S.frame_next_edge(Attach.attached_frame(_, frame)))} : Maybe<&2, V.Frame>}
            ready_selected_frame_from_parent(child, history, child_history, phase, state, frame, edge, references, forest, selected, coherent,
              ready_parent_projection_to_measured(child, history, child_history, phase, state, frame, edge, references, attachment, forest, selected, shape, projected), valid,
              ready_parent_dense_to_frame(child, frame, references, attachment, shape, dense))
          materialized: ready_frame_view_materialization_result(Attach.attached_frame(attachment, frame), S.state_prepared(state), view) =
            ready_parent_materialized(attachment, frame, S.state_prepared(state), forest,
              List.append(&2, F.AddressEntry, addresses, Mapping.shifted(children, List.length(&2, Local.PlannedNode, S.frame_nodes(frame)))), (episode + 1n : Nat), projected,
              ready_updated_catalog_valid(attachment, frame, history,
                Pair.fst({frame_checks(frame, history) == True{} : Bool}, {ActualFrame.projected(frame, history) == Some{ready_phase_frame(phase)} : Maybe<&2, V.Frame>}, ready_selected_frame_observed(child, history, child_history, phase, state, frame, edge, selected))), valid)
          Tuple{attachment, Tuple{forest, Tuple{attached, Tuple{replaced,
            ready_attachment_staged_total_witness(attachment, frame, child, state, previous, History.measurement(phase, history), view, observed, materialized)}}}}

    case _ _ _ _ Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{None{}, _}, _, _, _, _, _, _}, _}:
      Empty.absurd(ready_parent_measured_result(child, history, child_history, phase, frame, edge, known, state, previous), evidence)

def ready_original_measured_from_parent(+state: T.ResolverState, +frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, +ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +frame_present: {S.state_frame(state) == Some{frame} : Maybe<&2, T.ResolverFrame>}, +child_present: {S.scratch_tentative(S.state_scratch(state)) == Some{child} : Maybe<&2, T.TentativeChild>}, +edge_present: {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>}, evidence: ready_parent_measured_result(child, history, child_history, phase, frame, edge, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(child)))), state, previous)) -> ready_original_measured_result(state, history, phase, previous):
  match child edge history child_history phase:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Local.Pending{_, _, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _}
      Phase.ChildHistory{F.Created{_, _, _}, +source, +catalog, _, _}
      Phase.Phase{V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _},
        Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{Some{_}, _}, _, +payloads, _, _, _, _}, _}:
      match evidence:
        case (+attachment, (+forest, (attached, (_, materialized)))):
          +view: V.Frame = ready_staged_frame(ready_phase_frame(phase), forest,
            ready_payload_rows(payloads, S.frame_next_edge(frame), source, catalog), S.frame_next_edge(Attach.attached_frame(attachment, frame)))
          continued: {Attach.previous(previous, state) == Attach.attachment(Some{attachment}, child, previous, state, frame) : Loop.Continuation} =
            ready_previous_attached(state, frame, child, edge, history, child_history, phase, previous, attachment,
              ready, frame_present, child_present, edge_present, attached)
          ready_original_measured_product(attachment, frame, child, state, previous, history, phase, view, continued, materialized)
    case _ _ _ _ Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{None{}, _}, _, _, _, _, _, _}, _}:
      Empty.absurd(ready_original_measured_result(state, history, phase, previous), evidence)

def ready_original_measured_inputs(+state: T.ResolverState, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, evidence: ready_original_staged_result(state, history, child_history, phase)) -> ready_original_measured_result(state, history, phase, previous):
  match evidence:
    case (+frame, (+child, (+edge, (frame_present, (child_present, (edge_present, staged)))))):
      ready_original_measured_parent(state, frame, child, edge, history, child_history, phase, previous, ready, frame_present, child_present, edge_present, staged)

def ready_original_measured_parts(+state: T.ResolverState, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, +ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}, evidence: actual_parts_result(S.state_frame(state), S.scratch_tentative(S.state_scratch(state)), S.scratch_pending_edge(S.state_scratch(state)))) -> ready_original_measured_result(state, history, phase, previous):
  match evidence:
    case (+frame, (+child, (+edge, (frame_present, (child_present, edge_present))))):
      +frame_present: {S.state_frame(state) == Some{frame} : Maybe<&2, T.ResolverFrame>} = frame_present
      +child_present: {S.scratch_tentative(S.state_scratch(state)) == Some{child} : Maybe<&2, T.TentativeChild>} = child_present
      +edge_present: {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>} = edge_present
      +selected: {ActualReady.parts(state, Some{frame}, Some{child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>} =
        ready_actual_parts_installed(state, history, child_history, phase, frame, child, edge, frame_present, child_present, edge_present, ready)
      +known: Bool = Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(child))))
      ready_original_measured_from_parent(state, frame, child, edge, history, child_history, phase, previous, ready,
        frame_present, child_present, edge_present,
        ready_selected_parent_measured(state, frame, child, edge, history, child_history, phase, previous, known, selected, coherent,
          ready_selected_parent(child, history, child_history, phase, state, frame, edge, known, selected)))

def ready_original_measured(+state: T.ResolverState, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, +ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> ready_original_measured_result(state, history, phase, previous):
  ready_original_measured_parts(state, history, child_history, phase, previous, ready, coherent,
    actual_ready_parts(state, history, child_history, phase, ready))

def ready_capsule_fingerprint_value(capsule: Phase.Capsule) -> Maybe<&2, String>:
  match capsule:
    case Phase.Capsule{_, _, _, _, _, _, _, _, _, _, fingerprint}: fingerprint

def ready_capsule_fingerprint(+clock: Maybe<&2, T.ClockToken>, +language: Maybe<&2, T.Language>, +active: Maybe<&2, Nat>, +edge: Maybe<&2, V.PendingPayload>, +state: T.ResolverState, +capsule: Phase.Capsule, ready: {ActualReady.capsule(clock, language, active, edge, state) == Some{capsule} : Maybe<&2, Phase.Capsule>}) -> {ActualReady.fingerprint(S.state_prepared(state)) == ready_capsule_fingerprint_value(capsule) : Maybe<&2, String>}:
  match clock language active edge state:
    case Some{clock_value} Some{+language_value} Some{active_value} Some{edge_value}
      T.ResolverState{T.ResolverInput{+invocation, path, _, _, _, _, branch, cache, _}, _, _, +next, iterations, _, _, rust, _, _, _, _, _}:
      %Count.some_equal(Phase.Capsule,
        Phase.Capsule{invocation, path, language_value, ActualReady.context(language_value, branch, rust),
          clock_value, cache, next, iterations, active_value, edge_value, ActualReady.fingerprint(S.state_prepared(state))}, capsule, ready):
        {ActualReady.fingerprint(S.state_prepared(state)) == ready_capsule_fingerprint_value(_) : Maybe<&2, String>}
      {==}
    case None{} _ _ _ _:
      Empty.absurd({ActualReady.fingerprint(S.state_prepared(state)) == ready_capsule_fingerprint_value(capsule) : Maybe<&2, String>}, Contents.none_some(Phase.Capsule, capsule, ready))
    case Some{_} None{} _ _ _:
      Empty.absurd({ActualReady.fingerprint(S.state_prepared(state)) == ready_capsule_fingerprint_value(capsule) : Maybe<&2, String>}, Contents.none_some(Phase.Capsule, capsule, ready))
    case Some{_} Some{_} None{} _ _:
      Empty.absurd({ActualReady.fingerprint(S.state_prepared(state)) == ready_capsule_fingerprint_value(capsule) : Maybe<&2, String>}, Contents.none_some(Phase.Capsule, capsule, ready))
    case Some{_} Some{_} Some{_} None{} _:
      Empty.absurd({ActualReady.fingerprint(S.state_prepared(state)) == ready_capsule_fingerprint_value(capsule) : Maybe<&2, String>}, Contents.none_some(Phase.Capsule, capsule, ready))

def ready_reference_capsule_fingerprint(+state: D.State, +child: X.Child) -> {ready_reference_fingerprint(D.frame(state)) == ready_capsule_fingerprint_value(ReferenceReady.capsule(state, child)) : Maybe<&2, String>}:
  match state child:
    case D.State{D.Config{_, _, _, _, _, _}, X.Frame{_, _, _, _, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}
      X.Child{X.Attempt{_, _, _, _, _, _, _, _, _, _}, _, _, _}: {==}

def ready_product_fingerprint(+prepared: T.PreparedLanguage) -> {ready_prepared_fingerprint(prepared) == ActualReady.fingerprint(prepared) : Maybe<&2, String>}:
  match prepared:
    case T.PreparedLanguage{_, _, _}: {==}

def ready_common_product_fingerprint(+state: T.ResolverState, +reference: D.State, +child: X.Child, +clock: Maybe<&2, T.ClockToken>, +language: Maybe<&2, T.Language>, +active: Maybe<&2, Nat>, +edge: Maybe<&2, V.PendingPayload>, +capsule: Phase.Capsule, actual: {ActualReady.capsule(clock, language, active, edge, state) == Some{capsule} : Maybe<&2, Phase.Capsule>}, reference_ready: {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}) -> {ready_prepared_fingerprint(S.state_prepared(state)) == ready_reference_fingerprint(D.frame(reference)) : Maybe<&2, String>}:
  Equal.trans(Maybe<&2, String>, ready_prepared_fingerprint(S.state_prepared(state)), ActualReady.fingerprint(S.state_prepared(state)), ready_reference_fingerprint(D.frame(reference)),
    ready_product_fingerprint(S.state_prepared(state)),
    Equal.trans(Maybe<&2, String>, ActualReady.fingerprint(S.state_prepared(state)), ready_capsule_fingerprint_value(capsule), ready_reference_fingerprint(D.frame(reference)),
      ready_capsule_fingerprint(clock, language, active, edge, state, capsule, actual),
      Equal.sym(Maybe<&2, String>, ready_reference_fingerprint(D.frame(reference)), ready_capsule_fingerprint_value(capsule),
        Equal.trans(Maybe<&2, String>, ready_reference_fingerprint(D.frame(reference)), ready_capsule_fingerprint_value(ReferenceReady.capsule(reference, child)), ready_capsule_fingerprint_value(capsule),
          ready_reference_capsule_fingerprint(reference, child),
          Equal.cong(Phase.Capsule, Maybe<&2, String>, value => ready_capsule_fingerprint_value(value), ReferenceReady.capsule(reference, child), capsule,
            Count.some_equal(Phase.Capsule, ReferenceReady.capsule(reference, child), capsule, reference_ready))))))

def ready_common_materialization(+state: T.ResolverState, +reference: D.State, +child: X.Child, +attachment: Compose.Attachment, +frame: T.ResolverFrame, +forest: F.Forest, +product: ArtifactValue.ProductValue, +clock: Maybe<&2, T.ClockToken>, +language: Maybe<&2, T.Language>, +active: Maybe<&2, Nat>, +edge: Maybe<&2, V.PendingPayload>, +capsule: Phase.Capsule, actual: {ActualReady.capsule(clock, language, active, edge, state) == Some{capsule} : Maybe<&2, Phase.Capsule>}, reference_ready: {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}, dependencies: {S.frame_dependencies(Attach.attached_frame(attachment, frame)) == ready_reference_dependencies(D.frame(reference)) : List<&2, String>}, materialized: {F.prepared_unit(Allowance.materialization(forest), forest, S.frame_dependencies(Attach.attached_frame(attachment, frame)), ready_prepared_fingerprint(S.state_prepared(state))) == F.Materialized{product} : F.Materialization}) -> {F.prepared_unit(Allowance.materialization(forest), forest, ready_reference_dependencies(D.frame(reference)), ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization}:
  %dependencies:
    {F.prepared_unit(Allowance.materialization(forest), forest, _, ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization}
  %ready_common_product_fingerprint(state, reference, child, clock, language, active, edge, capsule, actual, reference_ready):
    {F.prepared_unit(Allowance.materialization(forest), forest, S.frame_dependencies(Attach.attached_frame(attachment, frame)), _) == F.Materialized{product} : F.Materialization}
  materialized


def ready_view_dependencies(view: V.Frame) -> List<&2, String>:
  match view:
    case V.Frame{_, _, _, _, dependencies, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}: dependencies

def ready_frame_view_dependencies(+forest: Maybe<&2, F.Forest>, +pending: Maybe<&2, List<&2, V.PendingEntry>>, +targets: Maybe<&2, List<&2, V.TargetEntry>>, +ids: Maybe<&2, List<&2, V.TargetId>>, +captured: Maybe<&2, List<&2, V.CapturedEntry>>, +identities: Maybe<&2, List<&2, V.TargetArtifact>>, +visited: Maybe<&2, List<&2, String>>, +actual: T.ResolverFrame, +remaining: Nat, +episode: Nat, +view: V.Frame, ready: {ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, actual, remaining, episode) == Some{view} : Maybe<&2, V.Frame>}) -> {S.frame_dependencies(actual) == ready_view_dependencies(view) : List<&2, String>}:
  match forest pending targets ids captured identities visited actual:
    case Some{+forest_value} Some{+pending_value} Some{+targets_value} Some{+ids_value} Some{+captured_value} Some{+identities_value} Some{+visited_value}
      T.ResolverFrame{branch, limits, graph, command, deps, _, _, _, _, budget, node, edge, target, artifact, _, _, _, _, _, artifacts}:
      %Count.some_equal(V.Frame, V.Frame{branch, limits, graph, command, deps, forest_value, pending_value, targets_value, ids_value, captured_value, identities_value, visited_value, V.actual_budget(budget), node, edge, target, artifact, artifacts, remaining, episode}, view, ready):
        {S.frame_dependencies(actual) == ready_view_dependencies(_) : List<&2, String>}
      {==}
    case None{} _ _ _ _ _ _ _:
      Empty.absurd({S.frame_dependencies(actual) == ready_view_dependencies(view) : List<&2, String>}, Contents.none_some(V.Frame, view, ready))
    case Some{_} None{} _ _ _ _ _ _:
      Empty.absurd({S.frame_dependencies(actual) == ready_view_dependencies(view) : List<&2, String>}, Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} None{} _ _ _ _ _:
      Empty.absurd({S.frame_dependencies(actual) == ready_view_dependencies(view) : List<&2, String>}, Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} None{} _ _ _ _:
      Empty.absurd({S.frame_dependencies(actual) == ready_view_dependencies(view) : List<&2, String>}, Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} Some{_} None{} _ _ _:
      Empty.absurd({S.frame_dependencies(actual) == ready_view_dependencies(view) : List<&2, String>}, Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} Some{_} Some{_} None{} _ _:
      Empty.absurd({S.frame_dependencies(actual) == ready_view_dependencies(view) : List<&2, String>}, Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} Some{_} Some{_} Some{_} None{} _:
      Empty.absurd({S.frame_dependencies(actual) == ready_view_dependencies(view) : List<&2, String>}, Contents.none_some(V.Frame, view, ready))

def ready_projected_frame_dependencies(+frame: T.ResolverFrame, +history: V.History, +view: V.Frame, ready: {ActualFrame.projected(frame, history) == Some{view} : Maybe<&2, V.Frame>}) -> {S.frame_dependencies(frame) == ready_view_dependencies(view) : List<&2, String>}:
  match history:
    case V.History{+addresses, V.Order{+pending_order, +target_order, +id_order, +capture_order, +identity_order, +visited_order}, +sources, +captures, _, +remaining, +episode}:
      ready_frame_view_dependencies(ActualFrame.forest_valid(P.project(S.frame_root(frame), S.frame_nodes(frame), S.frame_references(frame), S.frame_artifacts(frame), addresses), episode), ActualFrame.pending(pending_order, S.frame_pending(frame), sources, addresses), ActualFrame.targets(target_order, S.frame_target_paths(frame), addresses), ActualFrame.ids(id_order, S.frame_target_ids(frame)), ActualFrame.captured(capture_order, S.frame_captured(frame), captures), ActualFrame.identities(identity_order, S.frame_target_artifacts(frame)), ActualFrame.visited(visited_order, S.frame_visited(frame)), frame, remaining, episode, view, ready)

def ready_reference_dependencies_assembled(+state: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +known: Bool, +targets: Maybe<&2, List<&2, V.TargetEntry>>, +captured: Maybe<&2, List<&2, V.CapturedEntry>>, +visited: Maybe<&2, List<&2, String>>, +child_visited: Maybe<&2, List<&2, String>>, ready: {ReferenceReady.assembled(ReferenceFrame.assembled(state, history, targets, captured, visited), ReferenceReady.child_view(child, child_history, child_visited), ReferenceReady.capsule(state, child)) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {ready_reference_dependencies(D.frame(state)) == ready_view_dependencies(ready_phase_frame(phase)) : List<&2, String>}:
  match state child history child_history targets captured visited child_visited:
    case D.State{D.Config{+invocation, +path, +language, +context, +clock, +cache},
      X.Frame{G.Bounded{+graph, +remaining}, +command, +forest,
        Signed.State{Recursive.State{_, +budget, _, _}, +signed}, +edges, _, +identities,
        +next_edge, +episode, +next_artifact, +dependencies, +fingerprint}, _, +target_ids, +next_target, +next, +iterations, _, _}
      X.Child{X.Attempt{+target,
        X.Edge{_, F.Pending{_, Local.Pending{_, _, _, _, _, _, _, _}}, _, _},
        +kind, +source, +bytes, +name, +expected, Local.Declaration{+handle, +identity, +function, +bundled, +references, +source_path}, +catalog, +before},
        F.Created{+root, +nodes, +addresses}, Signed.State{Recursive.State{_, +child_budget, _, _}, +child_signed}, +pending}
      V.History{_, _, _, _, +artifacts, _, _}
      Phase.ChildHistory{_, _, _, +capture, _}
      Some{+target_rows} Some{+capture_rows} Some{+seen} Some{+child_seen}:
      %Count.some_equal(Phase.Phase,
        Phase.Phase{
          V.Frame{ReferenceFrame.branch(context), ReferenceFrame.graph_limits(graph), graph, command, dependencies, forest,
            ReferenceFrame.pending(edges), target_rows, ReferenceFrame.ids(target_ids), capture_rows, ReferenceFrame.identities(identities), seen,
            V.budget(budget, signed), ReferenceFrame.node_count(forest), next_edge, next_target, next_artifact, artifacts, remaining, episode},
          Phase.Child{target, X.attempt_path(ready_reference_attempt(child)), kind, capture, bytes,
            T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceReady.file_exports(kind, source), bytes}, handle, identity, before,
            F.Forest{Some{root}, nodes}, addresses, ReferenceReady.pending(pending), child_seen, V.budget(child_budget, child_signed), source, catalog},
          ReferenceReady.capsule(state, child)}, phase, ready):
        {ready_reference_dependencies(D.frame(state)) == ready_view_dependencies(ready_phase_frame(_)) : List<&2, String>}
      {==}
    case _ _ _ _ None{} _ _ _:
      Empty.absurd({ready_reference_dependencies(D.frame(state)) == ready_view_dependencies(ready_phase_frame(phase)) : List<&2, String>}, Contents.none_some(Phase.Phase, phase, ready))
    case _ _ _ _ Some{_} None{} _ _:
      Empty.absurd({ready_reference_dependencies(D.frame(state)) == ready_view_dependencies(ready_phase_frame(phase)) : List<&2, String>}, Contents.none_some(Phase.Phase, phase, ready))
    case _ _ _ _ Some{_} Some{_} None{} _:
      Empty.absurd({ready_reference_dependencies(D.frame(state)) == ready_view_dependencies(ready_phase_frame(phase)) : List<&2, String>}, Contents.none_some(Phase.Phase, phase, ready))
    case _ _ _ _ Some{_} Some{_} Some{_} None{}:
      Empty.absurd({ready_reference_dependencies(D.frame(state)) == ready_view_dependencies(ready_phase_frame(phase)) : List<&2, String>}, Contents.none_some(Phase.Phase, phase, ready))

def ready_reference_dependencies_phase(+state: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +known: Bool, ready: {ReferenceReady.project(state, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {ready_reference_dependencies(D.frame(state)) == ready_view_dependencies(ready_phase_frame(phase)) : List<&2, String>}:
  match state child history child_history:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{+values, _, _, _}, _}, _, +captures, _, _, _, _, _, _}, +targets, _, _, _, _, _, _}
      X.Child{_, _, Signed.State{Recursive.State{+child_values, _, _, _}, _}, _}
      V.History{_, V.Order{_, _, _, _, _, +seen}, _, +sources, _, _, _}
      Phase.ChildHistory{_, _, _, _, +child_seen}:
      ready_reference_dependencies_assembled(state, child, history, child_history, phase, known,
        ReferenceFrame.targets(targets), ReferenceFrame.captured(captures, sources), ReferenceFrame.visited(seen, values), ReferenceFrame.visited(child_seen, child_values), ready)

def ready_attached_dependencies(+attachment: Compose.Attachment, +frame: T.ResolverFrame) -> {S.frame_dependencies(Attach.attached_frame(attachment, frame)) == S.frame_dependencies(frame) : List<&2, String>}:
  match attachment frame:
    case Compose.Attachment{_, _, _, _, _, _, _, _, _} T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}: {==}

def ready_common_dependencies(+attachment: Compose.Attachment, +frame: T.ResolverFrame, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, actual: {ActualFrame.project(frame, history) == Some{ready_phase_frame(phase)} : Maybe<&2, V.Frame>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {S.frame_dependencies(Attach.attached_frame(attachment, frame)) == ready_reference_dependencies(D.frame(reference)) : List<&2, String>}:
  Equal.trans(List<&2, String>, S.frame_dependencies(Attach.attached_frame(attachment, frame)), S.frame_dependencies(frame), ready_reference_dependencies(D.frame(reference)),
    ready_attached_dependencies(attachment, frame),
    Equal.trans(List<&2, String>, S.frame_dependencies(frame), ready_view_dependencies(ready_phase_frame(phase)), ready_reference_dependencies(D.frame(reference)),
      ready_projected_frame_dependencies(frame, history, ready_phase_frame(phase),
        Pair.snd({frame_checks(frame, history) == True{} : Bool}, {ActualFrame.projected(frame, history) == Some{ready_phase_frame(phase)} : Maybe<&2, V.Frame>}, actual_frame_contents(frame, history, ready_phase_frame(phase), actual))),
      Equal.sym(List<&2, String>, ready_reference_dependencies(D.frame(reference)), ready_view_dependencies(ready_phase_frame(phase)),
        ready_reference_dependencies_phase(reference, child, history, child_history, phase, False{}, reference_ready))))


def ready_reference_same_product(+state: T.ResolverState, +reference: D.State, +child: X.Child, +attachment: Compose.Attachment, +frame: T.ResolverFrame, +forest: F.Forest, +product: ArtifactValue.ProductValue, +clock: Maybe<&2, T.ClockToken>, +language: Maybe<&2, T.Language>, +active: Maybe<&2, Nat>, +edge: Maybe<&2, V.PendingPayload>, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, actual_frame: {ActualFrame.project(frame, history) == Some{ready_phase_frame(phase)} : Maybe<&2, V.Frame>}, actual_capsule: {ActualReady.capsule(clock, language, active, edge, state) == Some{ready_phase_capsule(phase)} : Maybe<&2, Phase.Capsule>}, +reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, materialized: {F.prepared_unit(Allowance.materialization(forest), forest, S.frame_dependencies(Attach.attached_frame(attachment, frame)), ready_prepared_fingerprint(S.state_prepared(state))) == F.Materialized{product} : F.Materialization}) -> {F.prepared_unit(Allowance.materialization(forest), forest, ready_reference_dependencies(D.frame(reference)), ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization}:
  match phase:
    case Phase.Phase{+view, +child_view, +capsule}:
      ready_common_materialization(state, reference, child, attachment, frame, forest, product, clock, language, active, edge, capsule, actual_capsule,
        Pair.snd({ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>}, {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>},
          Pair.snd({ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, {ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>} & {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}, reference_ready_contents(reference, child, history, child_history, phase, reference_ready))),
        ready_common_dependencies(attachment, frame, reference, child, history, child_history, phase, actual_frame, reference_ready), materialized)


def ready_payload_replace(+parent: F.Forest, +created: F.Created, +known: Bool, +identity: String, payload: V.PendingPayload) -> F.Replacement:
  match payload:
    case V.PendingPayload{owner, index, _, symbol, _, _, _, _}:
      F.replace(F.append(parent, created), owner, index, X.attachment_reference(known, created, symbol, identity))

def ready_raw_replace(+parent: F.Forest, +created: F.Created, +known: Bool, +identity: String, +payload: V.PendingPayload, edge: Local.Pending) -> F.Replacement:
  match edge:
    case Local.Pending{_, index, _, symbol, _, _, _, _}:
      F.replace(F.append(parent, created), ready_payload_owner(payload), index, X.attachment_reference(known, created, symbol, identity))

def ready_payload_replace_exact(+address: Maybe<&2, O.NodeAddress>, +edge: Local.Pending, +payload: V.PendingPayload, +parent: F.Forest, +created: F.Created, +known: Bool, +identity: String, ready: {V.payload_at(address, edge) == Some{payload} : Maybe<&2, V.PendingPayload>}) -> {ready_raw_replace(parent, created, known, identity, payload, edge) == ready_payload_replace(parent, created, known, identity, payload) : F.Replacement}:
  match address edge:
    case Some{+owner} Local.Pending{_, +index, +from, +symbol, +name, +depth, +expected, +target}:
      %Count.some_equal(V.PendingPayload, V.PendingPayload{owner, index, from, symbol, name, depth, expected, target}, payload, ready):
        {ready_raw_replace(parent, created, known, identity, _, edge) == ready_payload_replace(parent, created, known, identity, _) : F.Replacement}
      {==}
    case None{} _:
      Empty.absurd({ready_raw_replace(parent, created, known, identity, payload, edge) == ready_payload_replace(parent, created, known, identity, payload) : F.Replacement}, Contents.none_some(V.PendingPayload, payload, ready))

def ready_pending_replace_exact(+edge: Local.Pending, +addresses: List<&2, F.AddressEntry>, +payload: V.PendingPayload, +parent: F.Forest, +created: F.Created, +known: Bool, +identity: String, ready: {V.pending_payload(edge, addresses) == Some{payload} : Maybe<&2, V.PendingPayload>}) -> {ready_raw_replace(parent, created, known, identity, payload, edge) == ready_payload_replace(parent, created, known, identity, payload) : F.Replacement}:
  match edge:
    case Local.Pending{+owner, _, _, _, _, _, _, _}:
      ready_payload_replace_exact(F.address_at(addresses, owner), edge, payload, parent, created, known, identity, ready)

def ready_child_address_result(history: Phase.ChildHistory, view: Phase.Child) -> Type:
  match history view:
    case Phase.ChildHistory{F.Created{_, _, addresses}, _, _, _, _} Phase.Child{_, _, _, _, _, _, _, _, _, _, observed, _, _, _, _, _}:
      {addresses == observed : List<&2, F.AddressEntry>}

def ready_child_address_coordinates(+child: T.TentativeChild, +history: Phase.ChildHistory, +view: Phase.Child, evidence: ready_child_coordinates(child, history, view)) -> ready_child_address_result(history, view):
  match child history view:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Phase.ChildHistory{F.Created{_, _, _}, _, _, _, _} Phase.Child{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}:
      match evidence:
        case (_, (addresses, (_, _))): addresses

def ready_child_address_exact(+child: T.TentativeChild, +edge: Local.Pending, +history: Phase.ChildHistory, +artifacts: List<&2, T.ArtifactEntry>, +episode: Nat, +view: Phase.Child, ready: {ActualReady.child_project(child, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}) -> ready_child_address_result(history, view):
  ready_child_address_coordinates(child, history, view,
    ready_projected_child_coordinates(child, edge, history, artifacts, episode, view,
      Pair.snd({child_checks(child) == True{} : Bool}, {ActualReady.child_projected(child, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}, actual_child_contents(child, edge, history, artifacts, episode, view, ready))))

def ready_phase_parent_replace(child: T.TentativeChild, edge: Local.Pending, child_history: Phase.ChildHistory, phase: Phase.Phase, known: Bool) -> F.Replacement:
  match child_history phase:
    case Phase.ChildHistory{F.Created{_, _, +addresses}, _, _, _, _}
      Phase.Phase{V.Frame{_, _, _, _, _, +parent, _, _, _, _, _, _, _, _, _, _, _, _, _, _},
        Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{Some{root}, nodes}, _, _, _, _, _, _}, +capsule}:
      ready_raw_replace(parent, F.Created{root, nodes, addresses}, known, ready_actual_identity(child), ready_capsule_payload(capsule), edge)
    case _ Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{None{}, _}, _, _, _, _, _, _}, _}: F.ReplacementInvalid{}

def ready_parent_reference_replacement(+actual_child: T.TentativeChild, +edge: Local.Pending, +frame: T.ResolverFrame, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +known: Bool, +child_ready: {ActualReady.child_project(actual_child, edge, child_history, S.frame_artifacts(frame), ready_history_episode(history)) == Some{ready_phase_child(phase)} : Maybe<&2, Phase.Child>}, pending_ready: {V.pending_payload(edge, ready_history_addresses(history)) == Some{ready_capsule_payload(ready_phase_capsule(phase))} : Maybe<&2, V.PendingPayload>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {ready_phase_parent_replace(actual_child, edge, child_history, phase, known) == X.attachment_kind(D.frame(reference), child, known) : F.Replacement}:
  match child_history phase:
    case Phase.ChildHistory{F.Created{_, _, +addresses}, _, _, _, _}
      Phase.Phase{V.Frame{_, _, _, _, _, +parent, _, _, _, _, _, _, _, _, _, _, _, _, _, _},
        Phase.Child{_, _, _, _, _, _, _, +identity, _, F.Forest{Some{+root}, +nodes}, +observed_addresses, _, _, _, _, _},
        Phase.Capsule{_, _, _, _, _, _, _, _, _, V.PendingPayload{_, _, _, _, _, _, _, _}, _}}:
      +created: F.Created = F.Created{root, nodes, addresses}
      Equal.trans(F.Replacement, ready_phase_parent_replace(actual_child, edge, child_history, phase, known),
        ready_payload_replace(parent, created, known, ready_actual_identity(actual_child), ready_capsule_payload(ready_phase_capsule(phase))), X.attachment_kind(D.frame(reference), child, known),
        ready_pending_replace_exact(edge, ready_history_addresses(history), ready_capsule_payload(ready_phase_capsule(phase)), parent, created, known, ready_actual_identity(actual_child), pending_ready),
        %Equal.sym(List<&2, F.AddressEntry>, addresses, observed_addresses, ready_child_address_exact(actual_child, edge, child_history, S.frame_artifacts(frame), ready_history_episode(history), ready_phase_child(phase), child_ready)):
          {ready_payload_replace(parent, F.Created{root, nodes, _}, known, ready_actual_identity(actual_child), ready_capsule_payload(ready_phase_capsule(phase))) == X.attachment_kind(D.frame(reference), child, known) : F.Replacement}
        %Equal.sym(String, ready_actual_identity(actual_child), identity,
          Pair.snd({ActualReady.edge_kind(edge, ready_actual_path(actual_child)) == ready_child_kind(ready_phase_child(phase)) : X.ChildKind}, {ready_actual_identity(actual_child) == ready_child_identity(ready_phase_child(phase)) : String}, ready_actual_shape_exact(actual_child, edge, child_history, S.frame_artifacts(frame), ready_history_episode(history), ready_phase_child(phase), child_ready))):
          {ready_payload_replace(parent, F.Created{root, nodes, observed_addresses}, known, _, ready_capsule_payload(ready_phase_capsule(phase))) == X.attachment_kind(D.frame(reference), child, known) : F.Replacement}
        Equal.sym(F.Replacement, X.attachment_kind(D.frame(reference), child, known), ready_payload_replace(parent, F.Created{root, nodes, observed_addresses}, known, identity, ready_capsule_payload(ready_phase_capsule(phase))),
          ready_reference_replacement(reference, child, history, child_history, phase, known, reference_ready)))
    case _ Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{None{}, _}, _, _, _, _, _, _}, _}:
      Empty.absurd({ready_phase_parent_replace(actual_child, edge, child_history, phase, known) == X.attachment_kind(D.frame(reference), child, known) : F.Replacement}, ready_reference_replacement(reference, child, history, child_history, phase, known, reference_ready))


def ready_reference_attachment_selected(+state: D.State, +child: X.Child) -> {X.attachment(D.frame(state), child) == X.attachment_kind(D.frame(state), child, X.known_file(D.frame(state), ready_reference_attempt(child))) : F.Replacement}:
  match child:
    case X.Child{_, _, _, _}: {==}

def ready_replacement_select_exact(+actual_child: T.TentativeChild, +edge: Local.Pending, +frame: T.ResolverFrame, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +known: Bool, child_ready: {ActualReady.child_project(actual_child, edge, child_history, S.frame_artifacts(frame), ready_history_episode(history)) == Some{ready_phase_child(phase)} : Maybe<&2, Phase.Child>}, pending_ready: {V.pending_payload(edge, ready_history_addresses(history)) == Some{ready_capsule_payload(ready_phase_capsule(phase))} : Maybe<&2, V.PendingPayload>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, selected: {known == X.known_file(D.frame(reference), ready_reference_attempt(child)) : Bool}) -> {ready_phase_parent_replace(actual_child, edge, child_history, phase, known) == X.attachment(D.frame(reference), child) : F.Replacement}:
  Equal.trans(F.Replacement, ready_phase_parent_replace(actual_child, edge, child_history, phase, known), X.attachment_kind(D.frame(reference), child, known), X.attachment(D.frame(reference), child),
    ready_parent_reference_replacement(actual_child, edge, frame, reference, child, history, child_history, phase, known, child_ready, pending_ready, reference_ready),
    Equal.trans(F.Replacement, X.attachment_kind(D.frame(reference), child, known), X.attachment_kind(D.frame(reference), child, X.known_file(D.frame(reference), ready_reference_attempt(child))), X.attachment(D.frame(reference), child),
      Equal.cong(Bool, F.Replacement, value => X.attachment_kind(D.frame(reference), child, value), known, X.known_file(D.frame(reference), ready_reference_attempt(child)), selected),
      Equal.sym(F.Replacement, X.attachment(D.frame(reference), child), X.attachment_kind(D.frame(reference), child, X.known_file(D.frame(reference), ready_reference_attempt(child))), ready_reference_attachment_selected(reference, child))))

def ready_selected_reference_replacement(+state: T.ResolverState, +frame: T.ResolverFrame, +actual_child: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, selected: {ActualReady.parts(state, Some{frame}, Some{actual_child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {ready_phase_parent_replace(actual_child, edge, child_history, phase, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child))))) == X.attachment(D.frame(reference), child) : F.Replacement}:
  match history phase:
    case V.History{+addresses, _, _, _, _, +remaining, +episode} Phase.Phase{+view, +child_view, +capsule}:
      Parent.eliminate_pair({ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>},
        {ActualReady.child_project(actual_child, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>} &
        {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>},
        {ready_phase_parent_replace(actual_child, edge, child_history, phase, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child))))) == X.attachment(D.frame(reference), child) : F.Replacement},
        Pair.snd({Bool.and(ActualReady.mutable_maps_canonical(frame), Bool.and(ActualReady.fresh_registration(history, frame), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame))))) == True{} : Bool},
          assembled_result(ActualFrame.project(frame, history), ActualReady.child_project(actual_child, edge, child_history, S.frame_artifacts(frame), episode), ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state), phase),
          selected_phase_contents(state, frame, actual_child, edge, history, child_history, phase, selected)),
        frame_ready => rest =>
        Parent.eliminate_pair({ActualReady.child_project(actual_child, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>},
          {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>},
          {ready_phase_parent_replace(actual_child, edge, child_history, phase, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child))))) == X.attachment(D.frame(reference), child) : F.Replacement}, rest,
          child_ready => capsule_ready =>
          +child_ready: {ActualReady.child_project(actual_child, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>} = child_ready
          ready_replacement_select_exact(actual_child, edge, frame, reference, child, history, child_history, phase,
            Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child)))), child_ready,
            ready_capsule_pending(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state, capsule, capsule_ready), reference_ready,
            ready_attachment_selector_exact(actual_child, edge, child, frame, reference, history, child_history, view, child_view, frame_ready,
              Pair.fst({ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, {ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>} & {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}, reference_ready_contents(reference, child, history, child_history, phase, reference_ready)), child_ready,
              Pair.fst({ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>}, {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>},
                Pair.snd({ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, {ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>} & {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}, reference_ready_contents(reference, child, history, child_history, phase, reference_ready)))))))


def ready_selected_materialization(+state: T.ResolverState, +frame: T.ResolverFrame, +actual_child: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +attachment: Compose.Attachment, +forest: F.Forest, +product: ArtifactValue.ProductValue, selected: {ActualReady.parts(state, Some{frame}, Some{actual_child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, materialized: {F.prepared_unit(Allowance.materialization(forest), forest, S.frame_dependencies(Attach.attached_frame(attachment, frame)), ready_prepared_fingerprint(S.state_prepared(state))) == F.Materialized{product} : F.Materialization}) -> {F.prepared_unit(Allowance.materialization(forest), forest, ready_reference_dependencies(D.frame(reference)), ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization}:
  match history phase:
    case V.History{+addresses, _, _, _, _, +remaining, +episode} Phase.Phase{+view, +child_view, +capsule}:
      Parent.eliminate_pair({ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>},
        {ActualReady.child_project(actual_child, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>} &
        {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>},
        {F.prepared_unit(Allowance.materialization(forest), forest, ready_reference_dependencies(D.frame(reference)), ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization},
        Pair.snd({Bool.and(ActualReady.mutable_maps_canonical(frame), Bool.and(ActualReady.fresh_registration(history, frame), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame))))) == True{} : Bool},
          assembled_result(ActualFrame.project(frame, history), ActualReady.child_project(actual_child, edge, child_history, S.frame_artifacts(frame), episode), ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state), phase),
          selected_phase_contents(state, frame, actual_child, edge, history, child_history, phase, selected)),
        frame_ready => rest =>
        ready_reference_same_product(state, reference, child, attachment, frame, forest, product,
          S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), history, child_history, phase, frame_ready,
          Pair.snd({ActualReady.child_project(actual_child, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>},
            {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>}, rest), reference_ready, materialized))


def ready_reference_product_observations(+reference: D.State, +child: X.Child, +history: V.History, +phase: Phase.Phase, +previous: Nat, +forest: F.Forest, +product: ArtifactValue.ProductValue) -> Type:
  {ReferenceBoundary.selected_request(ReferenceBoundary.enter(reference, child, previous)) == Some{ready_reference_request(reference, product)} : Maybe<&2, T.Request>} &
  {Staged.project(ReferenceBoundary.enter(reference, child, previous), History.measurement(phase, history))
    == Some{ready_staged_frame(ready_phase_frame(phase), forest, ready_child_rows(ready_phase_child(phase), ready_view_edge(ready_phase_frame(phase))),
      (ready_view_edge(ready_phase_frame(phase)) + List.length(&2, V.PendingEntry, ready_child_rows(ready_phase_child(phase), ready_view_edge(ready_phase_frame(phase)))) : Nat))} : Maybe<&2, V.Frame>}

def ready_same_parent_reference_observations(+state: T.ResolverState, +frame: T.ResolverFrame, +actual_child: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, +attachment: Compose.Attachment, +forest: F.Forest, +product: ArtifactValue.ProductValue, +selected: {ActualReady.parts(state, Some{frame}, Some{actual_child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, replaced: {ready_phase_parent_replace(actual_child, edge, child_history, phase, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child))))) == F.Replaced{forest} : F.Replacement}, materialized: {F.prepared_unit(Allowance.materialization(forest), forest, S.frame_dependencies(Attach.attached_frame(attachment, frame)), ready_prepared_fingerprint(S.state_prepared(state))) == F.Materialized{product} : F.Materialization}) -> ready_reference_product_observations(reference, child, history, phase, previous, forest, product):
  +reference_replaced: {X.attachment(D.frame(reference), child) == F.Replaced{forest} : F.Replacement} =
    Equal.trans(F.Replacement, X.attachment(D.frame(reference), child),
      ready_phase_parent_replace(actual_child, edge, child_history, phase, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child))))), F.Replaced{forest},
      Equal.sym(F.Replacement, ready_phase_parent_replace(actual_child, edge, child_history, phase, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child))))), X.attachment(D.frame(reference), child),
        ready_selected_reference_replacement(state, frame, actual_child, edge, reference, child, history, child_history, phase, selected, reference_ready)), replaced)
  +reference_product: {F.prepared_unit(Allowance.materialization(forest), forest, ready_reference_dependencies(D.frame(reference)), ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization} =
    ready_selected_materialization(state, frame, actual_child, edge, reference, child, history, child_history, phase, attachment, forest, product, selected, reference_ready, materialized)
  Tuple{ready_reference_enter_request(reference, child, previous, forest, product, reference_replaced, reference_product),
    ready_reference_staged_common(reference, child, previous, forest, product, history, child_history, phase, reference_ready, reference_replaced, reference_product)}


def ready_selected_request_identity(+state: T.ResolverState, +frame: T.ResolverFrame, +actual_child: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +product: ArtifactValue.ProductValue, selected: {ActualReady.parts(state, Some{frame}, Some{actual_child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {ready_actual_request(state, product) == ready_reference_request(reference, product) : T.Request}:
  match history phase:
    case V.History{+addresses, _, _, _, _, +remaining, +episode} Phase.Phase{+view, +child_view, +capsule}:
      Parent.eliminate_pair({ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>},
        {ActualReady.child_project(actual_child, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>} &
        {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>},
        {ready_actual_request(state, product) == ready_reference_request(reference, product) : T.Request},
        Pair.snd({Bool.and(ActualReady.mutable_maps_canonical(frame), Bool.and(ActualReady.fresh_registration(history, frame), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame))))) == True{} : Bool},
          assembled_result(ActualFrame.project(frame, history), ActualReady.child_project(actual_child, edge, child_history, S.frame_artifacts(frame), episode), ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state), phase),
          selected_phase_contents(state, frame, actual_child, edge, history, child_history, phase, selected)),
        frame_ready => rest =>
        ready_request_identity_exact(state, reference, child,
          S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), capsule, product,
          Pair.snd({ActualReady.child_project(actual_child, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>},
            {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>}, rest),
          Pair.snd({ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>}, {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>},
            Pair.snd({ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, {ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>} & {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}, reference_ready_contents(reference, child, history, child_history, phase, reference_ready)))))


def ready_shared_request_exact(+continuation: Loop.Continuation, +selection: D.Selection, +actual: T.Request, +reference: T.Request, emitted: {ready_loop_request(continuation) == Some{actual} : Maybe<&2, T.Request>}, expected: {ReferenceBoundary.selected_request(selection) == Some{reference} : Maybe<&2, T.Request>}, identity: {actual == reference : T.Request}) -> {ready_loop_request(continuation) == ReferenceBoundary.selected_request(selection) : Maybe<&2, T.Request>}:
  Equal.trans(Maybe<&2, T.Request>, ready_loop_request(continuation), Some{actual}, ReferenceBoundary.selected_request(selection), emitted,
    Equal.trans(Maybe<&2, T.Request>, Some{actual}, Some{reference}, ReferenceBoundary.selected_request(selection),
      Equal.cong(T.Request, Maybe<&2, T.Request>, request => Some{request}, actual, reference, identity),
      Equal.sym(Maybe<&2, T.Request>, ReferenceBoundary.selected_request(selection), Some{reference}, expected)))


def ready_child_addresses(history: Phase.ChildHistory) -> List<&2, F.AddressEntry>:
  match history:
    case Phase.ChildHistory{F.Created{_, _, addresses}, _, _, _, _}: addresses


def ready_child_payloads(view: Phase.Child) -> List<&2, V.PendingPayload>:
  match view:
    case Phase.Child{_, _, _, _, _, _, _, _, _, _, _, payloads, _, _, _, _}: payloads

def ready_child_pending_exact(+child: T.TentativeChild, +edge: Local.Pending, +history: Phase.ChildHistory, +artifacts: List<&2, T.ArtifactEntry>, +episode: Nat, +view: Phase.Child, ready: {ActualReady.child_project(child, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}) -> {ActualReady.pending(ready_plan_pending(ready_actual_child_plan(child)), ready_child_addresses(history)) == Some{ready_child_payloads(view)} : Maybe<&2, List<&2, V.PendingPayload>>}:
  match child history view:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{+root, +nodes, +slots, +items, +visited, _}, _, _, _}
      Phase.ChildHistory{F.Created{_, _, +addresses}, _, _, _, +order}
      Phase.Child{_, _, _, _, _, _, _, _, _, +forest, _, +payloads, +seen, _, _, _}:
      Pair.fst({ActualReady.pending(items, addresses) == Some{payloads} : Maybe<&2, List<&2, V.PendingPayload>>}, {ActualReady.visited_complete(order, visited) == Some{seen} : Maybe<&2, List<&2, String>>},
        Pair.snd({ActualReady.valid_forest(P.project(root, nodes, slots, artifacts, addresses), episode) == Some{forest} : Maybe<&2, F.Forest>}, {ActualReady.pending(items, addresses) == Some{payloads} : Maybe<&2, List<&2, V.PendingPayload>>} & {ActualReady.visited_complete(order, visited) == Some{seen} : Maybe<&2, List<&2, String>>},
          child_view_contents(ActualReady.valid_forest(P.project(root, nodes, slots, artifacts, addresses), episode), ActualReady.pending(items, addresses), ActualReady.visited_complete(order, visited), child, edge, history, view,
            Pair.snd({child_checks(child) == True{} : Bool}, {ActualReady.child_projected(child, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}, actual_child_contents(child, edge, history, artifacts, episode, view, ready)))))

def ready_staged_rows_next(+view: V.Frame, +forest: F.Forest, +payloads: List<&2, V.PendingPayload>, +next: Nat, +observed_next: Nat, +source: T.SourceFacts, +observed_source: T.SourceFacts, +catalog: RootSpec.Source, +observed_catalog: RootSpec.Source, +attached_next: Nat, next_equal: {next == observed_next : Nat}, source_equal: {source == observed_source : T.SourceFacts}, catalog_equal: {catalog == observed_catalog : RootSpec.Source}, count: {attached_next == (next + List.length(&2, V.PendingPayload, payloads) : Nat) : Nat}) -> {ready_staged_frame(view, forest, ready_payload_rows(payloads, next, source, catalog), attached_next) == ready_staged_frame(view, forest, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog), (observed_next + List.length(&2, V.PendingEntry, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog)) : Nat)) : V.Frame}:
  %Equal.sym(Nat, attached_next, (next + List.length(&2, V.PendingPayload, payloads) : Nat), count):
    {ready_staged_frame(view, forest, ready_payload_rows(payloads, next, source, catalog), _) == ready_staged_frame(view, forest, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog), (observed_next + List.length(&2, V.PendingEntry, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog)) : Nat)) : V.Frame}
  %Equal.sym(Nat, next, observed_next, next_equal):
    {ready_staged_frame(view, forest, ready_payload_rows(payloads, _, source, catalog), (_ + List.length(&2, V.PendingPayload, payloads) : Nat)) == ready_staged_frame(view, forest, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog), (observed_next + List.length(&2, V.PendingEntry, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog)) : Nat)) : V.Frame}
  %Equal.sym(T.SourceFacts, source, observed_source, source_equal):
    {ready_staged_frame(view, forest, ready_payload_rows(payloads, observed_next, _, catalog), (observed_next + List.length(&2, V.PendingPayload, payloads) : Nat)) == ready_staged_frame(view, forest, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog), (observed_next + List.length(&2, V.PendingEntry, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog)) : Nat)) : V.Frame}
  %Equal.sym(RootSpec.Source, catalog, observed_catalog, catalog_equal):
    {ready_staged_frame(view, forest, ready_payload_rows(payloads, observed_next, observed_source, _), (observed_next + List.length(&2, V.PendingPayload, payloads) : Nat)) == ready_staged_frame(view, forest, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog), (observed_next + List.length(&2, V.PendingEntry, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog)) : Nat)) : V.Frame}
  Equal.cong(Nat, V.Frame, size => ready_staged_frame(view, forest, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog), (observed_next + size : Nat)), List.length(&2, V.PendingPayload, payloads), List.length(&2, V.PendingEntry, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog)),
    Equal.sym(Nat, List.length(&2, V.PendingEntry, ready_payload_rows(payloads, observed_next, observed_source, observed_catalog)), List.length(&2, V.PendingPayload, payloads), ready_payload_rows_length(payloads, observed_next, observed_source, observed_catalog)))


def ready_selected_staged_equality_result(child_history: Phase.ChildHistory, +phase: Phase.Phase, +frame: T.ResolverFrame, +attachment: Compose.Attachment, +forest: F.Forest) -> Type:
  match child_history phase:
    case Phase.ChildHistory{_, +source, +catalog, _, _} Phase.Phase{+view, Phase.Child{_, _, _, _, _, _, _, _, _, _, _, +payloads, _, _, _, _}, _}:
      {ready_staged_frame(view, forest, ready_payload_rows(payloads, S.frame_next_edge(frame), source, catalog), S.frame_next_edge(Attach.attached_frame(attachment, frame)))
        == ready_staged_frame(view, forest, ready_child_rows(ready_phase_child(phase), ready_view_edge(view)),
          (ready_view_edge(view) + List.length(&2, V.PendingEntry, ready_child_rows(ready_phase_child(phase), ready_view_edge(view))) : Nat)) : V.Frame}

def ready_selected_staged_equality_coordinates(+child: T.TentativeChild, +edge: Local.Pending, +frame: T.ResolverFrame, +attachment: Compose.Attachment, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +forest: F.Forest, attached: ready_selected_attachment_result(child, frame, edge, attachment), pending: {ActualReady.pending(ready_plan_pending(ready_actual_child_plan(child)), ready_child_addresses(child_history)) == Some{ready_child_payloads(ready_phase_child(phase))} : Maybe<&2, List<&2, V.PendingPayload>>}, coordinates: ready_frame_coordinates(frame, ready_phase_frame(phase)) & ready_child_coordinates(child, child_history, ready_phase_child(phase))) -> ready_selected_staged_equality_result(child_history, phase, frame, attachment, forest):
  match child child_history phase:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Phase.ChildHistory{F.Created{_, _, +addresses}, +source, +catalog, _, _}
      Phase.Phase{V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, +next, _, _, _, _, _},
        Phase.Child{_, _, _, _, _, _, _, _, _, _, _, +payloads, _, _, +observed_source, +observed_catalog}, _}:
      match coordinates:
        case ((_, (_, edge_equal)), (_, (_, (source_equal, catalog_equal)))):
          ready_staged_rows_next(ready_phase_frame(phase), forest, payloads, S.frame_next_edge(frame), next, source, observed_source, catalog, observed_catalog,
            S.frame_next_edge(Attach.attached_frame(attachment, frame)), edge_equal, source_equal, catalog_equal,
            ready_selected_attachment_count(child, frame, edge, attachment, addresses, payloads, attached, pending))

def ready_selected_staged_equality(+state: T.ResolverState, +frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +attachment: Compose.Attachment, +forest: F.Forest, +selected: {ActualReady.parts(state, Some{frame}, Some{child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, attached: ready_selected_attachment_result(child, frame, edge, attachment)) -> ready_selected_staged_equality_result(child_history, phase, frame, attachment, forest):
  match history phase:
    case V.History{+addresses, _, _, _, _, +remaining, +episode} Phase.Phase{+view, +child_view, +capsule}:
      ready_selected_staged_equality_coordinates(child, edge, frame, attachment, child_history, phase, forest, attached,
        ready_child_pending_exact(child, edge, child_history, S.frame_artifacts(frame), episode, child_view,
          Pair.fst({ActualReady.child_project(child, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>},
            {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>},
            Pair.snd({ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>},
              {ActualReady.child_project(child, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>} & {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>},
              Pair.snd({Bool.and(ActualReady.mutable_maps_canonical(frame), Bool.and(ActualReady.fresh_registration(history, frame), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame))))) == True{} : Bool}, assembled_result(ActualFrame.project(frame, history), ActualReady.child_project(child, edge, child_history, S.frame_artifacts(frame), episode), ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state), phase), selected_phase_contents(state, frame, child, edge, history, child_history, phase, selected))))),
        ready_selected_coordinates(child, history, child_history, phase, state, frame, edge, selected))


def ready_reference_product_at(+reference: D.State, +child: X.Child, +history: V.History, +phase: Phase.Phase, +previous: Nat, +product: ArtifactValue.ProductValue, +view: V.Frame) -> Type:
  {ReferenceBoundary.selected_request(ReferenceBoundary.enter(reference, child, previous)) == Some{ready_reference_request(reference, product)} : Maybe<&2, T.Request>} &
  {Staged.project(ReferenceBoundary.enter(reference, child, previous), History.measurement(phase, history)) == Some{view} : Maybe<&2, V.Frame>}

def ready_reference_product_aligned(+reference: D.State, +child: X.Child, +history: V.History, +phase: Phase.Phase, +previous: Nat, +forest: F.Forest, +product: ArtifactValue.ProductValue, +view: V.Frame, aligned: {view == ready_staged_frame(ready_phase_frame(phase), forest, ready_child_rows(ready_phase_child(phase), ready_view_edge(ready_phase_frame(phase))), (ready_view_edge(ready_phase_frame(phase)) + List.length(&2, V.PendingEntry, ready_child_rows(ready_phase_child(phase), ready_view_edge(ready_phase_frame(phase)))) : Nat)) : V.Frame}, observations: ready_reference_product_observations(reference, child, history, phase, previous, forest, product)) -> ready_reference_product_at(reference, child, history, phase, previous, product, view):
  match observations:
    case (requested, staged):
      Tuple{requested,
        %Equal.sym(V.Frame, view, ready_staged_frame(ready_phase_frame(phase), forest, ready_child_rows(ready_phase_child(phase), ready_view_edge(ready_phase_frame(phase))),
          (ready_view_edge(ready_phase_frame(phase)) + List.length(&2, V.PendingEntry, ready_child_rows(ready_phase_child(phase), ready_view_edge(ready_phase_frame(phase)))) : Nat)), aligned):
          {Staged.project(ReferenceBoundary.enter(reference, child, previous), History.measurement(phase, history)) == Some{_} : Maybe<&2, V.Frame>}
        staged}

def ready_shared_staged_total_result(+attachment: Compose.Attachment, +frame: T.ResolverFrame, +actual_child: T.TentativeChild, +state: T.ResolverState, +previous: Nat, +history: V.History, +phase: Phase.Phase, +view: V.Frame, +reference: D.State, +child: X.Child) -> Type:
  Exists(ArtifactValue.ProductValue, product =>
    {F.prepared_unit(Allowance.materialization(ready_staged_forest(view)), ready_staged_forest(view), S.frame_dependencies(Attach.attached_frame(attachment, frame)), ready_prepared_fingerprint(S.state_prepared(state))) == F.Materialized{product} : F.Materialization} &
    {ready_loop_request(Attach.attachment(Some{attachment}, actual_child, previous, state, frame)) == ReferenceBoundary.selected_request(ReferenceBoundary.enter(reference, child, previous)) : Maybe<&2, T.Request>} &
    ready_measurement_staged_result(Attach.attachment(Some{attachment}, actual_child, previous, state, frame), product, History.measurement(phase, history), view) &
    ready_reference_product_at(reference, child, history, phase, previous, product, view))

def ready_shared_staged_product(+attachment: Compose.Attachment, +frame: T.ResolverFrame, +actual_child: T.TentativeChild, +state: T.ResolverState, +previous: Nat, +history: V.History, +phase: Phase.Phase, +view: V.Frame, +reference: D.State, +child: X.Child, +product: ArtifactValue.ProductValue, materialized: {F.prepared_unit(Allowance.materialization(ready_staged_forest(view)), ready_staged_forest(view), S.frame_dependencies(Attach.attached_frame(attachment, frame)), ready_prepared_fingerprint(S.state_prepared(state))) == F.Materialized{product} : F.Materialization}, emitted: {ready_loop_request(Attach.attachment(Some{attachment}, actual_child, previous, state, frame)) == Some{ready_actual_request(state, product)} : Maybe<&2, T.Request>}, measured: ready_measurement_staged_result(Attach.attachment(Some{attachment}, actual_child, previous, state, frame), product, History.measurement(phase, history), view), identity: {ready_actual_request(state, product) == ready_reference_request(reference, product) : T.Request}, observations: ready_reference_product_at(reference, child, history, phase, previous, product, view)) -> ready_shared_staged_total_result(attachment, frame, actual_child, state, previous, history, phase, view, reference, child):
  match observations:
    case (requested, staged):
      +requested: {ReferenceBoundary.selected_request(ReferenceBoundary.enter(reference, child, previous)) == Some{ready_reference_request(reference, product)} : Maybe<&2, T.Request>} = requested
      Tuple{product, Tuple{materialized, Tuple{
        ready_shared_request_exact(Attach.attachment(Some{attachment}, actual_child, previous, state, frame), ReferenceBoundary.enter(reference, child, previous), ready_actual_request(state, product), ready_reference_request(reference, product), emitted, requested, identity),
        Tuple{measured, Tuple{requested, staged}}}}}

def ready_shared_parent_result(+child: T.TentativeChild, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +frame: T.ResolverFrame, +edge: Local.Pending, +known: Bool, +state: T.ResolverState, +previous: Nat, +reference: D.State, +reference_child: X.Child) -> Type:
  match child history child_history phase edge:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{+root, +nodes, +slots, +items, +visited, +budget}, _, _, _}
        V.History{+addresses, _, _, _, _, _, +episode}
        Phase.ChildHistory{F.Created{_, _, +child_addresses}, +source, +catalog, _, _}
        Phase.Phase{V.Frame{_, _, _, _, _, +parent_forest, _, _, _, _, _, _, _, _, _, _, _, _, _, _},
          Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{Some{+birth}, +semantic_nodes}, _, +payloads, _, _, _, _}, _}
        Local.Pending{+owner, +index, _, +symbol, _, _, _, _}:
      Exists(Compose.Attachment, attachment => Exists(F.Forest, forest =>
        {Compose.tentative_attachment(Compose.remap(Local.Plan{root, nodes, slots, items, visited, budget}, List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), S.frame_nodes(frame), S.frame_references(frame), owner, index,
          Bool.pick(Maybe<&2, String>, known, Some{ready_actual_identity(child)}, None{}), S.frame_next_edge(frame), S.frame_pending(frame)) == Some{attachment} : Maybe<&2, Compose.Attachment>} &
        {F.replace(F.append(parent_forest, F.Created{birth, semantic_nodes, child_addresses}), ready_payload_owner(ready_capsule_payload(ready_phase_capsule(phase))), index,
          X.attachment_reference(known, F.Created{birth, semantic_nodes, child_addresses}, symbol, ready_actual_identity(child))) == F.Replaced{forest} : F.Replacement} &
        ready_shared_staged_total_result(attachment, frame, child, state, previous, history, phase,
          ready_staged_frame(ready_phase_frame(phase), forest, ready_payload_rows(payloads, S.frame_next_edge(frame), source, catalog), S.frame_next_edge(Attach.attached_frame(attachment, frame))), reference, reference_child)
      ))
    case _ _ _ Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{None{}, _}, _, _, _, _, _, _}, _} _: Empty

def ready_same_parent_reference_witness(+state: T.ResolverState, +frame: T.ResolverFrame, +actual_child: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, +selected: {ActualReady.parts(state, Some{frame}, Some{actual_child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, evidence: ready_parent_measured_result(actual_child, history, child_history, phase, frame, edge, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child)))), state, previous)) -> ready_shared_parent_result(actual_child, history, child_history, phase, frame, edge, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child)))), state, previous, reference, child):
  match actual_child edge history child_history phase:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Local.Pending{_, _, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _}
      Phase.ChildHistory{F.Created{_, _, _}, +source, +catalog, _, _}
      Phase.Phase{V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _},
        Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{Some{_}, _}, _, +payloads, _, _, _, _}, _}:
      match evidence:
        case (+attachment, (+forest, (attached, (replaced, (+product, (materialized, (request_identity, measured))))))):
          +attached: {Compose.tentative_attachment(Compose.remap(ready_actual_child_plan(actual_child), List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), S.frame_nodes(frame), S.frame_references(frame), Attach.edge_owner(edge), Attach.edge_index(edge),
            Bool.pick(Maybe<&2, String>, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child)))), Some{ready_actual_identity(actual_child)}, None{}), S.frame_next_edge(frame), S.frame_pending(frame)) == Some{attachment} : Maybe<&2, Compose.Attachment>} = attached
          +replaced: {ready_phase_parent_replace(actual_child, edge, child_history, phase, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child))))) == F.Replaced{forest} : F.Replacement} = replaced
          +materialized: {F.prepared_unit(Allowance.materialization(forest), forest, S.frame_dependencies(Attach.attached_frame(attachment, frame)), ready_prepared_fingerprint(S.state_prepared(state))) == F.Materialized{product} : F.Materialization} = materialized
          Tuple{attachment, Tuple{forest, Tuple{attached, Tuple{replaced,
            ready_shared_staged_product(attachment, frame, actual_child, state, previous, history, phase,
              ready_staged_frame(ready_phase_frame(phase), forest, ready_payload_rows(payloads, S.frame_next_edge(frame), source, catalog), S.frame_next_edge(Attach.attached_frame(attachment, frame))),
              reference, child, product, materialized, request_identity, measured,
              ready_selected_request_identity(state, frame, actual_child, edge, reference, child, history, child_history, phase, product, selected, reference_ready),
              ready_reference_product_aligned(reference, child, history, phase, previous, forest, product,
                ready_staged_frame(ready_phase_frame(phase), forest, ready_payload_rows(payloads, S.frame_next_edge(frame), source, catalog), S.frame_next_edge(Attach.attached_frame(attachment, frame))),
                ready_selected_staged_equality(state, frame, actual_child, edge, history, child_history, phase, attachment, forest, selected, attached),
                ready_same_parent_reference_observations(state, frame, actual_child, edge, reference, child, history, child_history, phase, previous, attachment, forest, product, selected, reference_ready, replaced, materialized)))}}}}

    case _ _ _ _ Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{None{}, _}, _, _, _, _, _, _}, _}:
      Empty.absurd(ready_shared_parent_result(actual_child, history, child_history, phase, frame, edge, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child)))), state, previous, reference, child), evidence)


def ready_original_shared_result(+state: T.ResolverState, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat) -> Type:
  Exists(T.ResolverFrame, frame => Exists(T.TentativeChild, actual_child => Exists(Local.Pending, edge =>
    {S.state_frame(state) == Some{frame} : Maybe<&2, T.ResolverFrame>} &
    {S.scratch_tentative(S.state_scratch(state)) == Some{actual_child} : Maybe<&2, T.TentativeChild>} &
    {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>} &
    ready_shared_parent_result(actual_child, history, child_history, phase, frame, edge,
      Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child)))), state, previous, reference, child))))

def ready_original_shared_parts(+state: T.ResolverState, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}, evidence: actual_parts_result(S.state_frame(state), S.scratch_tentative(S.state_scratch(state)), S.scratch_pending_edge(S.state_scratch(state)))) -> ready_original_shared_result(state, reference, child, history, child_history, phase, previous):
  match evidence:
    case (+frame, (+actual_child, (+edge, (frame_present, (child_present, edge_present))))):
      +frame_present: {S.state_frame(state) == Some{frame} : Maybe<&2, T.ResolverFrame>} = frame_present
      +child_present: {S.scratch_tentative(S.state_scratch(state)) == Some{actual_child} : Maybe<&2, T.TentativeChild>} = child_present
      +edge_present: {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>} = edge_present
      +selected: {ActualReady.parts(state, Some{frame}, Some{actual_child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>} =
        ready_actual_parts_installed(state, history, child_history, phase, frame, actual_child, edge, frame_present, child_present, edge_present, ready)
      +known: Bool = Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(actual_child))))
      Tuple{frame, Tuple{actual_child, Tuple{edge, Tuple{frame_present, Tuple{child_present, Tuple{edge_present,
        ready_same_parent_reference_witness(state, frame, actual_child, edge, reference, child, history, child_history, phase, previous, selected, reference_ready,
          ready_selected_parent_measured(state, frame, actual_child, edge, history, child_history, phase, previous, known, selected, coherent,
            ready_selected_parent(actual_child, history, child_history, phase, state, frame, edge, known, selected)))}}}}}}

def ready_original_shared(+state: T.ResolverState, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, +ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> ready_original_shared_result(state, reference, child, history, child_history, phase, previous):
  ready_original_shared_parts(state, reference, child, history, child_history, phase, previous, ready, reference_ready, coherent,
    actual_ready_parts(state, history, child_history, phase, ready))


def ready_joined_measurement_result(+state: T.ResolverState, +reference: D.State, +child: X.Child, +history: V.History, +phase: Phase.Phase, +previous: Nat) -> Type:
  Exists(T.ResolverState, measured => Exists(T.Request, request => Exists(ArtifactValue.ProductValue, product => Exists(V.Frame, staged =>
    {Attach.previous(previous, state) == Loop.ServiceStep{T.AwaitService{measured, request}} : Loop.Continuation} &
    {Contract.operation(request) == T.EncodeProduct{product} : T.Operation} &
    {S.state_stage(measured) == T.MeasuringCandidateTree{} : T.ResolverStage} &
    {ReferenceBoundary.selected_request(ReferenceBoundary.enter(reference, child, previous)) == Some{request} : Maybe<&2, T.Request>} &
    {Contract.actual_frame(S.state_frame(measured), History.measurement(phase, history)) == Some{staged} : Maybe<&2, V.Frame>} &
    {Staged.project(ReferenceBoundary.enter(reference, child, previous), History.measurement(phase, history)) == Some{staged} : Maybe<&2, V.Frame>}))))

def ready_shared_measurement_extract(+attachment: Compose.Attachment, +frame: T.ResolverFrame, +actual_child: T.TentativeChild, +state: T.ResolverState, +previous: Nat, +history: V.History, +phase: Phase.Phase, +view: V.Frame, +reference: D.State, +child: X.Child, +product: ArtifactValue.ProductValue, continued: {Attach.previous(previous, state) == Attach.attachment(Some{attachment}, actual_child, previous, state, frame) : Loop.Continuation}, request_equal: {ready_loop_request(Attach.attachment(Some{attachment}, actual_child, previous, state, frame)) == ReferenceBoundary.selected_request(ReferenceBoundary.enter(reference, child, previous)) : Maybe<&2, T.Request>}, measured: ready_measurement_staged_result(Attach.attachment(Some{attachment}, actual_child, previous, state, frame), product, History.measurement(phase, history), view), observations: ready_reference_product_at(reference, child, history, phase, previous, product, view)) -> ready_joined_measurement_result(state, reference, child, history, phase, previous):
  match measured observations:
    case Tuple{+result, Tuple{+request, Tuple{awaited, Tuple{operation, Tuple{stage, projected}}}}} Tuple{_, staged}:
      +awaited: {Attach.attachment(Some{attachment}, actual_child, previous, state, frame) == Loop.ServiceStep{T.AwaitService{result, request}} : Loop.Continuation} = awaited
      Tuple{result, Tuple{request, Tuple{product, Tuple{view, Tuple{
        Equal.trans(Loop.Continuation, Attach.previous(previous, state), Attach.attachment(Some{attachment}, actual_child, previous, state, frame), Loop.ServiceStep{T.AwaitService{result, request}}, continued, awaited),
        Tuple{operation, Tuple{stage, Tuple{
          Equal.trans(Maybe<&2, T.Request>, ReferenceBoundary.selected_request(ReferenceBoundary.enter(reference, child, previous)), ready_loop_request(Attach.attachment(Some{attachment}, actual_child, previous, state, frame)), Some{request},
            Equal.sym(Maybe<&2, T.Request>, ready_loop_request(Attach.attachment(Some{attachment}, actual_child, previous, state, frame)), ReferenceBoundary.selected_request(ReferenceBoundary.enter(reference, child, previous)), request_equal),
            Equal.cong(Loop.Continuation, Maybe<&2, T.Request>, value => ready_loop_request(value), Attach.attachment(Some{attachment}, actual_child, previous, state, frame), Loop.ServiceStep{T.AwaitService{result, request}}, awaited)),
          Tuple{projected, staged}}}}}}}}}

def ready_joined_parent(+state: T.ResolverState, +frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, +reference: D.State, +reference_child: X.Child, +ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +frame_present: {S.state_frame(state) == Some{frame} : Maybe<&2, T.ResolverFrame>}, +child_present: {S.scratch_tentative(S.state_scratch(state)) == Some{child} : Maybe<&2, T.TentativeChild>}, +edge_present: {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>}, evidence: ready_shared_parent_result(child, history, child_history, phase, frame, edge, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(child)))), state, previous, reference, reference_child)) -> ready_joined_measurement_result(state, reference, reference_child, history, phase, previous):
  match child edge history child_history phase:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Local.Pending{_, _, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _}
      Phase.ChildHistory{F.Created{_, _, _}, +source, +catalog, _, _}
      Phase.Phase{V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _},
        Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{Some{_}, _}, _, +payloads, _, _, _, _}, _}:
      match evidence:
        case (+attachment, (+forest, (attached, (_, (+product, (_, (request_equal, (measured, observations)))))))):
          +view: V.Frame = ready_staged_frame(ready_phase_frame(phase), forest,
            ready_payload_rows(payloads, S.frame_next_edge(frame), source, catalog), S.frame_next_edge(Attach.attached_frame(attachment, frame)))
          continued: {Attach.previous(previous, state) == Attach.attachment(Some{attachment}, child, previous, state, frame) : Loop.Continuation} =
            ready_previous_attached(state, frame, child, edge, history, child_history, phase, previous, attachment,
              ready, frame_present, child_present, edge_present, attached)
          ready_shared_measurement_extract(attachment, frame, child, state, previous, history, phase, view, reference, reference_child, product, continued, request_equal, measured, observations)
    case _ _ _ _ Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{None{}, _}, _, _, _, _, _, _}, _}:
      Empty.absurd(ready_joined_measurement_result(state, reference, reference_child, history, phase, previous), evidence)

def ready_original_joined_witness(+state: T.ResolverState, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, evidence: ready_original_shared_result(state, reference, child, history, child_history, phase, previous)) -> ready_joined_measurement_result(state, reference, child, history, phase, previous):
  match evidence:
    case (+frame, (+actual_child, (+edge, (frame_present, (child_present, (edge_present, shared)))))):
      ready_joined_parent(state, frame, actual_child, edge, history, child_history, phase, previous, reference, child, ready, frame_present, child_present, edge_present, shared)

def ready_original_joined(+state: T.ResolverState, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +previous: Nat, +ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> ready_joined_measurement_result(state, reference, child, history, phase, previous):
  ready_original_joined_witness(state, reference, child, history, child_history, phase, previous, ready,
    ready_original_shared(state, reference, child, history, child_history, phase, previous, ready, reference_ready, coherent))


def ready_reply_outcome(reply: T.Reply) -> T.ServiceOutcome:
  match reply:
    case T.Reply{_, _, outcome}: outcome

# The arbitrary-reply part of the original transaction compares the actual
# validator with the independent boundary validator at its proved EncodeProduct.
def ready_checked_boundary(failure: Maybe<&2, T.TechnicalFailure>, outcome: T.ServiceOutcome) -> Protocol.CheckedReply:
  match failure:
    case None{}: Protocol.CheckedOutcome{outcome}
    case Some{failure}: Protocol.RejectedReply{failure}

def ready_provider_validation(+same: Bool, +owner: Nat, +actual: Nat, +outcome: T.ServiceOutcome) -> {Protocol.token_owner(same, owner, actual, outcome) == ready_checked_boundary( Bool.pick(Maybe<&2, T.TechnicalFailure>, same, None{}, Some{T.WrongInvocation{owner, actual}}), outcome) : Protocol.CheckedReply}:
  match same:
    case False{}: {==}
    case True{}: {==}

def ready_encode_variant(+product: ArtifactValue.ProductValue, +owner: Nat, +outcome: T.ServiceOutcome) -> {Protocol.check_matching(Protocol.matching(T.EncodeProduct{product}, outcome), outcome, owner) == ready_checked_boundary(Boundary.variant(Boundary.compatible(T.EncodeProduct{product}, outcome), owner, outcome), outcome) : Protocol.CheckedReply}:
  match outcome:
    case T.GoConfigurationRead{_}: {==}
    case T.AnalysisConfigurationIdentityRead{_}: {==}
    case T.ClockStarted{_}: {==}
    case T.ClockRead{_}: {==}
    case T.DirnameResult{_}: {==}
    case T.BasenameResult{_}: {==}
    case T.PathSeparatorResult{_}: {==}
    case T.JoinedResult{_}: {==}
    case T.NormalizedResult{_}: {==}
    case T.RelativeResult{_}: {==}
    case T.ExtensionResult{_}: {==}
    case T.AbsoluteResult{_}: {==}
    case T.JoinedPathFactsResult{_, _, _, _, _}: {==}
    case T.StatusResult{_}: {==}
    case T.MembershipResult{_}: {==}
    case T.DirectoryEntriesObserved{_, _}: {==}
    case T.DirectoryEntriesUnavailable{}: {==}
    case T.ContextSelectionResult{_}: {==}
    case T.PythonSyntaxResult{_}: {==}
    case T.IdentifierCharactersResult{_}: {==}
    case T.AccessResult{_}: {==}
    case T.InvocationCacheCreated{_}: {==}
    case T.CacheResult{_}: {==}
    case T.CacheSnapshot{_}: {==}
    case T.CacheStored{}: {==}
    case T.RootCacheInserted{}: {==}
    case T.CaptureResult{_}: {==}
    case T.FrontendResult{_}: {==}
    case T.CargoResult{_}: {==}
    case T.CapturedText{_, _}: {==}
    case T.GoCharactersResult{_}: {==}
    case T.GoBuildTextResult{_}: {==}
    case T.JsonProductHashed{_}: {==}
    case T.GoFileResult{_}: {==}
    case T.RustModulesResult{_}: {==}
    case T.DiagnosticObserved{}: {==}
    case T.ProductEncoded{_}: {==}
    case T.SourceTextEncoded{_}: {==}
    case T.ProviderRejected{T.ExceptionToken{+actual, _}}:
      ready_provider_validation(Nat.is_eq(owner, actual), owner, actual, outcome)

def ready_encode_correlation(+same: Bool, +expected: Nat, +actual: Nat, +owner: Nat, +product: ArtifactValue.ProductValue, +outcome: T.ServiceOutcome) -> {Protocol.check_correlation(same, expected, actual, T.EncodeProduct{product}, outcome, owner) == ready_checked_boundary(Boundary.correlation(same, expected, actual, owner, T.EncodeProduct{product}, outcome), outcome) : Protocol.CheckedReply}:
  match same:
    case False{}: {==}
    case True{}: ready_encode_variant(product, owner, outcome)

def ready_encode_header(+same: Bool, +owner: Nat, +actual: Nat, +id: Nat, +reply_id: Nat, +product: ArtifactValue.ProductValue, +outcome: T.ServiceOutcome) -> {Protocol.check_owner(same, owner, actual, id, reply_id, T.EncodeProduct{product}, outcome) == ready_checked_boundary(Boundary.header(same, owner, actual, id, reply_id, T.EncodeProduct{product}, outcome), outcome) : Protocol.CheckedReply}:
  match same:
    case False{}: {==}
    case True{}: ready_encode_correlation(Nat.is_eq(id, reply_id), id, reply_id, owner, product, outcome)

def ready_encode_validation(+owner: Nat, +id: Nat, +product: ArtifactValue.ProductValue, +reply: T.Reply) -> {Protocol.check(T.Request{owner, id, T.EncodeProduct{product}}, reply) == ready_checked_boundary(Boundary.check(T.Request{owner, id, T.EncodeProduct{product}}, reply), ready_reply_outcome(reply)) : Protocol.CheckedReply}:
  match reply:
    case T.Reply{+actual, +reply_id, +outcome}:
      ready_encode_header(Nat.is_eq(owner, actual), owner, actual, id, reply_id, product, outcome)

def ready_request_validation(+request: T.Request, +product: ArtifactValue.ProductValue, +reply: T.Reply, encoded: {Contract.operation(request) == T.EncodeProduct{product} : T.Operation}) -> {Protocol.check(request, reply) == ready_checked_boundary(Boundary.check(request, reply), ready_reply_outcome(reply)) : Protocol.CheckedReply}:
  match request:
    case T.Request{+owner, +id, +operation}:
      %Equal.sym(T.Operation, operation, T.EncodeProduct{product}, encoded):
        {Protocol.check(T.Request{owner, id, _}, reply) == ready_checked_boundary(Boundary.check(T.Request{owner, id, _}, reply), ready_reply_outcome(reply)) : Protocol.CheckedReply}
      ready_encode_validation(owner, id, product, reply)

def ready_actual_rejected(+continuation: Loop.Continuation, +measured: T.ResolverState, +request: T.Request, +product: ArtifactValue.ProductValue, +reply: T.Reply, +history: V.History, +failure: T.TechnicalFailure, awaited: {continuation == Loop.ServiceStep{T.AwaitService{measured, request}} : Loop.Continuation}, encoded: {Contract.operation(request) == T.EncodeProduct{product} : T.Operation}, rejected: {Boundary.check(request, reply) == Some{failure} : Maybe<&2, T.TechnicalFailure>}) -> {ActualBoundary.project(Machine.resume(continuation, T.ServiceReply{reply}), history) == Some{B.Failed{failure}} : Maybe<&2, B.Boundary>}:
  %Equal.sym(Loop.Continuation, continuation, Loop.ServiceStep{T.AwaitService{measured, request}}, awaited):
    {ActualBoundary.project(Machine.resume(_, T.ServiceReply{reply}), history) == Some{B.Failed{failure}} : Maybe<&2, B.Boundary>}
  %Equal.sym(Protocol.CheckedReply, Protocol.check(request, reply), ready_checked_boundary(Boundary.check(request, reply), ready_reply_outcome(reply)), ready_request_validation(request, product, reply, encoded)):
    {ActualBoundary.project(Machine.checked(_, measured), history) == Some{B.Failed{failure}} : Maybe<&2, B.Boundary>}
  %Equal.sym(Maybe<&2, T.TechnicalFailure>, Boundary.check(request, reply), Some{failure}, rejected):
    {ActualBoundary.project(Machine.checked(ready_checked_boundary(_, ready_reply_outcome(reply)), measured), history) == Some{B.Failed{failure}} : Maybe<&2, B.Boundary>}
  {==}

def ready_rejected_delivered(-World: Data, +request: T.Request, +state: D.State, +reply: T.Reply, +world: E.WorldState<World>, +child: X.Child, +history: V.History, +failure: T.TechnicalFailure, rejected: {Boundary.check(request, reply) == Some{failure} : Maybe<&2, T.TechnicalFailure>}) -> {ReferenceBoundaryView.project(World, ReferenceBoundary.normalize_progress(World, D.delivered(ReferenceBoundary.consume, World, request, state, reply, world)), child, history) == Some{B.Failed{failure}} : Maybe<&2, B.Boundary>}:
  match reply:
    case T.Reply{_, _, +outcome}:
      %Equal.sym(Maybe<&2, T.TechnicalFailure>, Boundary.check(request, reply), Some{failure}, rejected):
        {ReferenceBoundaryView.project(World, ReferenceBoundary.normalize_progress(World,
          D.validated(ReferenceBoundary.consume, World, _, state, outcome, world)), child, history) == Some{B.Failed{failure}} : Maybe<&2, B.Boundary>}
      {==}

def ready_rejected_selection_result(-World: Data, +selection: D.Selection, +reply: T.Reply, +world: E.WorldState<World>, +child: X.Child, +history: V.History, +failure: T.TechnicalFailure) -> Type:
  {ReferenceBoundaryView.project(World, ReferenceBoundary.deliver_next(World, selection, reply, world), child, history) == Some{B.Failed{failure}} : Maybe<&2, B.Boundary>}

def ready_reference_rejected(-World: Data, +selection: D.Selection, +request: T.Request, +reply: T.Reply, +world: E.WorldState<World>, +child: X.Child, +history: V.History, +failure: T.TechnicalFailure, selected: {ReferenceBoundary.selected_request(selection) == Some{request} : Maybe<&2, T.Request>}, rejected: {Boundary.check(request, reply) == Some{failure} : Maybe<&2, T.TechnicalFailure>}) -> ready_rejected_selection_result(World, selection, reply, world, child, history, failure):
  match selection:
    case D.Selected{D.State{+config, +frame, +targets, +ids, +target, +next, +iterations, +stage, +python}, +operation}:
      ready_rejected_delivered(World, T.Request{D.invocation(config), next, operation},
        D.State{config, frame, targets, ids, target, (next + 1n : Nat), iterations, stage, python}, reply, world, child, history, failure,
        %Equal.sym(T.Request, T.Request{D.invocation(config), next, operation}, request, Count.some_equal(T.Request, T.Request{D.invocation(config), next, operation}, request, selected)):
          {Boundary.check(_, reply) == Some{failure} : Maybe<&2, T.TechnicalFailure>}
        rejected)
    case D.Internal{_}:
      Empty.absurd(ready_rejected_selection_result(World, selection, reply, world, child, history, failure), Contents.none_some(T.Request, request, selected))
    case D.ChildBegin{_, _}:
      Empty.absurd(ready_rejected_selection_result(World, selection, reply, world, child, history, failure), Contents.none_some(T.Request, request, selected))
    case D.ChildResume{_, _, _}:
      Empty.absurd(ready_rejected_selection_result(World, selection, reply, world, child, history, failure), Contents.none_some(T.Request, request, selected))
    case D.Success{_, _}:
      Empty.absurd(ready_rejected_selection_result(World, selection, reply, world, child, history, failure), Contents.none_some(T.Request, request, selected))
    case D.EvaluationExhausted{_}:
      Empty.absurd(ready_rejected_selection_result(World, selection, reply, world, child, history, failure), Contents.none_some(T.Request, request, selected))
    case D.InvariantFailed{_}:
      Empty.absurd(ready_rejected_selection_result(World, selection, reply, world, child, history, failure), Contents.none_some(T.Request, request, selected))
    case D.Rejected{_, _}:
      Empty.absurd(ready_rejected_selection_result(World, selection, reply, world, child, history, failure), Contents.none_some(T.Request, request, selected))

# This is the rejected-envelope branch of the unchanged nine-field conclusion.
# The rejection equality is obtained by case analysis of the actual arbitrary
# reply, after the original-ready common witness has supplied claims one to six.
def ready_rejected_transaction(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +phase: Phase.Phase, +history: V.History, +previous: Nat, +reply: T.Reply, +world: E.WorldState<World>, +measured: T.ResolverState, +request: T.Request, +product: ArtifactValue.ProductValue, +staged: V.Frame, +failure: T.TechnicalFailure, +awaited: {Attach.previous(previous, actual) == Loop.ServiceStep{T.AwaitService{measured, request}} : Loop.Continuation}, +encoded: {Contract.operation(request) == T.EncodeProduct{product} : T.Operation}, stage: {S.state_stage(measured) == T.MeasuringCandidateTree{} : T.ResolverStage}, +selected: {ReferenceBoundary.selected_request(ReferenceBoundary.enter(reference, child, previous)) == Some{request} : Maybe<&2, T.Request>}, projected: {Contract.actual_frame(S.state_frame(measured), History.measurement(phase, history)) == Some{staged} : Maybe<&2, V.Frame>}, reference_projected: {Staged.project(ReferenceBoundary.enter(reference, child, previous), History.measurement(phase, history)) == Some{staged} : Maybe<&2, V.Frame>}, +rejected: {Boundary.check(request, reply) == Some{failure} : Maybe<&2, T.TechnicalFailure>}) -> Contract.conclusion(World, actual, reference, child, phase, history, previous, reply, world):
  Tuple{Contract.Witness{measured, request, product, staged, B.Failed{failure}},
    Tuple{awaited, Tuple{encoded, Tuple{stage, Tuple{selected, Tuple{projected, Tuple{reference_projected,
      Tuple{ready_actual_rejected(Attach.previous(previous, actual), measured, request, product, reply,
        History.reply(phase, History.measurement(phase, history), previous, request, reply), failure, awaited, encoded, rejected),
      Tuple{ready_reference_rejected(World, ReferenceBoundary.enter(reference, child, previous), request, reply, world, child,
        History.reply(phase, History.measurement(phase, history), previous, request, reply), failure, selected, rejected),
        boundary_world(World, ReferenceBoundary.enter(reference, child, previous), reply, world)}}}}}}}}}

def ready_actual_provider_rejected(+continuation: Loop.Continuation, +measured: T.ResolverState, +request: T.Request, +product: ArtifactValue.ProductValue, +owner: Nat, +id: Nat, +exception: T.ExceptionToken, +history: V.History, awaited: {continuation == Loop.ServiceStep{T.AwaitService{measured, request}} : Loop.Continuation}, encoded: {Contract.operation(request) == T.EncodeProduct{product} : T.Operation}, stage: {S.state_stage(measured) == T.MeasuringCandidateTree{} : T.ResolverStage}, accepted: {Boundary.check(request, T.Reply{owner, id, T.ProviderRejected{exception}}) == None{} : Maybe<&2, T.TechnicalFailure>}) -> {ActualBoundary.project(Machine.resume(continuation, T.ServiceReply{T.Reply{owner, id, T.ProviderRejected{exception}}}), history) == Some{B.Failed{T.ForeignProviderFailure{exception}}} : Maybe<&2, B.Boundary>}:
  +reply: T.Reply = T.Reply{owner, id, T.ProviderRejected{exception}}
  %Equal.sym(Loop.Continuation, continuation, Loop.ServiceStep{T.AwaitService{measured, request}}, awaited):
    {ActualBoundary.project(Machine.resume(_, T.ServiceReply{reply}), history) == Some{B.Failed{T.ForeignProviderFailure{exception}}} : Maybe<&2, B.Boundary>}
  %Equal.sym(Protocol.CheckedReply, Protocol.check(request, reply), ready_checked_boundary(Boundary.check(request, reply), ready_reply_outcome(reply)), ready_request_validation(request, product, reply, encoded)):
    {ActualBoundary.project(Machine.checked(_, measured), history) == Some{B.Failed{T.ForeignProviderFailure{exception}}} : Maybe<&2, B.Boundary>}
  %Equal.sym(Maybe<&2, T.TechnicalFailure>, Boundary.check(request, reply), None{}, accepted):
    {ActualBoundary.project(Machine.checked(ready_checked_boundary(_, T.ProviderRejected{exception}), measured), history) == Some{B.Failed{T.ForeignProviderFailure{exception}}} : Maybe<&2, B.Boundary>}
  %Equal.sym(T.ResolverStage, S.state_stage(measured), T.MeasuringCandidateTree{}, stage):
    {ActualBoundary.project(Machine.continue_action(Machine.stage_reply(_, T.ProviderRejected{exception}, measured)), history) == Some{B.Failed{T.ForeignProviderFailure{exception}}} : Maybe<&2, B.Boundary>}
  {==}

def ready_provider_consumed(+state: D.State, +exception: T.ExceptionToken) -> {ReferenceBoundary.consume(state, T.ProviderRejected{exception}) == D.Rejected{state, T.ForeignProviderFailure{exception}} : D.Selection}:
  match state:
    case D.State{_, _, _, _, _, _, _, D.Iteration{}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitDeadline{}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.Command{}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AfterCommand{_}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.Resolve{_}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.Scan{_, _, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitStatus{_, _, _, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.Check{_, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitChecked{_, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.Read{_, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitAuthorized{_, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitSnapshot{_, _, _, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitLookup{_, _, _, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitCapture{_, _, _, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitStored{_, _, _, _, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitDiagnostic{}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitFrontend{_, _, _, _, _, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitBundleBytes{_, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.Transaction{_}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.Completion{_}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitCompletion{_}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.PythonImporting{_, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.PythonInspectStart{_, _, _, _, _, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.PythonInspecting{_, _, _, _, _, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.PythonValidationStart{_}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.PythonValidating{_, _}, _}: {==}
    case D.State{_, _, _, _, _, _, _, D.AwaitFinalDeadline{_}, _}: {==}

def ready_provider_delivered(-World: Data, +request: T.Request, +state: D.State, +owner: Nat, +id: Nat, +exception: T.ExceptionToken, +world: E.WorldState<World>, +child: X.Child, +history: V.History, accepted: {Boundary.check(request, T.Reply{owner, id, T.ProviderRejected{exception}}) == None{} : Maybe<&2, T.TechnicalFailure>}) -> {ReferenceBoundaryView.project(World, ReferenceBoundary.normalize_progress(World, D.delivered(ReferenceBoundary.consume, World, request, state, T.Reply{owner, id, T.ProviderRejected{exception}}, world)), child, history) == Some{B.Failed{T.ForeignProviderFailure{exception}}} : Maybe<&2, B.Boundary>}:
  %Equal.sym(Maybe<&2, T.TechnicalFailure>, Boundary.check(request, T.Reply{owner, id, T.ProviderRejected{exception}}), None{}, accepted):
    {ReferenceBoundaryView.project(World, ReferenceBoundary.normalize_progress(World,
      D.validated(ReferenceBoundary.consume, World, _, state, T.ProviderRejected{exception}, world)), child, history) == Some{B.Failed{T.ForeignProviderFailure{exception}}} : Maybe<&2, B.Boundary>}
  %Equal.sym(D.Selection, ReferenceBoundary.consume(state, T.ProviderRejected{exception}), D.Rejected{state, T.ForeignProviderFailure{exception}}, ready_provider_consumed(state, exception)):
    {ReferenceBoundaryView.project(World, ReferenceBoundary.normalize_progress(World,
      D.consumed(World, _, world)), child, history) == Some{B.Failed{T.ForeignProviderFailure{exception}}} : Maybe<&2, B.Boundary>}
  {==}

def ready_reference_provider_rejected(-World: Data, +selection: D.Selection, +request: T.Request, +owner: Nat, +id: Nat, +exception: T.ExceptionToken, +world: E.WorldState<World>, +child: X.Child, +history: V.History, selected: {ReferenceBoundary.selected_request(selection) == Some{request} : Maybe<&2, T.Request>}, accepted: {Boundary.check(request, T.Reply{owner, id, T.ProviderRejected{exception}}) == None{} : Maybe<&2, T.TechnicalFailure>}) -> ready_rejected_selection_result(World, selection, T.Reply{owner, id, T.ProviderRejected{exception}}, world, child, history, T.ForeignProviderFailure{exception}):
  match selection:
    case D.Selected{D.State{+config, +frame, +targets, +ids, +target, +next, +iterations, +stage, +python}, +operation}:
      ready_provider_delivered(World, T.Request{D.invocation(config), next, operation},
        D.State{config, frame, targets, ids, target, (next + 1n : Nat), iterations, stage, python}, owner, id, exception, world, child, history,
        %Equal.sym(T.Request, T.Request{D.invocation(config), next, operation}, request, Count.some_equal(T.Request, T.Request{D.invocation(config), next, operation}, request, selected)):
          {Boundary.check(_, T.Reply{owner, id, T.ProviderRejected{exception}}) == None{} : Maybe<&2, T.TechnicalFailure>}
        accepted)
    case D.Internal{_}:
      Empty.absurd(ready_rejected_selection_result(World, selection, T.Reply{owner, id, T.ProviderRejected{exception}}, world, child, history, T.ForeignProviderFailure{exception}), Contents.none_some(T.Request, request, selected))
    case D.ChildBegin{_, _}:
      Empty.absurd(ready_rejected_selection_result(World, selection, T.Reply{owner, id, T.ProviderRejected{exception}}, world, child, history, T.ForeignProviderFailure{exception}), Contents.none_some(T.Request, request, selected))
    case D.ChildResume{_, _, _}:
      Empty.absurd(ready_rejected_selection_result(World, selection, T.Reply{owner, id, T.ProviderRejected{exception}}, world, child, history, T.ForeignProviderFailure{exception}), Contents.none_some(T.Request, request, selected))
    case D.Success{_, _}:
      Empty.absurd(ready_rejected_selection_result(World, selection, T.Reply{owner, id, T.ProviderRejected{exception}}, world, child, history, T.ForeignProviderFailure{exception}), Contents.none_some(T.Request, request, selected))
    case D.EvaluationExhausted{_}:
      Empty.absurd(ready_rejected_selection_result(World, selection, T.Reply{owner, id, T.ProviderRejected{exception}}, world, child, history, T.ForeignProviderFailure{exception}), Contents.none_some(T.Request, request, selected))
    case D.InvariantFailed{_}:
      Empty.absurd(ready_rejected_selection_result(World, selection, T.Reply{owner, id, T.ProviderRejected{exception}}, world, child, history, T.ForeignProviderFailure{exception}), Contents.none_some(T.Request, request, selected))
    case D.Rejected{_, _}:
      Empty.absurd(ready_rejected_selection_result(World, selection, T.Reply{owner, id, T.ProviderRejected{exception}}, world, child, history, T.ForeignProviderFailure{exception}), Contents.none_some(T.Request, request, selected))

def ready_provider_transaction(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +phase: Phase.Phase, +history: V.History, +previous: Nat, +owner: Nat, +id: Nat, +exception: T.ExceptionToken, +world: E.WorldState<World>, +measured: T.ResolverState, +request: T.Request, +product: ArtifactValue.ProductValue, +staged: V.Frame, +awaited: {Attach.previous(previous, actual) == Loop.ServiceStep{T.AwaitService{measured, request}} : Loop.Continuation}, +encoded: {Contract.operation(request) == T.EncodeProduct{product} : T.Operation}, +stage: {S.state_stage(measured) == T.MeasuringCandidateTree{} : T.ResolverStage}, +selected: {ReferenceBoundary.selected_request(ReferenceBoundary.enter(reference, child, previous)) == Some{request} : Maybe<&2, T.Request>}, projected: {Contract.actual_frame(S.state_frame(measured), History.measurement(phase, history)) == Some{staged} : Maybe<&2, V.Frame>}, reference_projected: {Staged.project(ReferenceBoundary.enter(reference, child, previous), History.measurement(phase, history)) == Some{staged} : Maybe<&2, V.Frame>}, +accepted: {Boundary.check(request, T.Reply{owner, id, T.ProviderRejected{exception}}) == None{} : Maybe<&2, T.TechnicalFailure>}) -> Contract.conclusion(World, actual, reference, child, phase, history, previous, T.Reply{owner, id, T.ProviderRejected{exception}}, world):
  +reply: T.Reply = T.Reply{owner, id, T.ProviderRejected{exception}}
  Tuple{Contract.Witness{measured, request, product, staged, B.Failed{T.ForeignProviderFailure{exception}}},
    Tuple{awaited, Tuple{encoded, Tuple{stage, Tuple{selected, Tuple{projected, Tuple{reference_projected,
      Tuple{ready_actual_provider_rejected(Attach.previous(previous, actual), measured, request, product, owner, id, exception,
        History.reply(phase, History.measurement(phase, history), previous, request, reply), awaited, encoded, stage, accepted),
      Tuple{ready_reference_provider_rejected(World, ReferenceBoundary.enter(reference, child, previous), request, owner, id, exception, world, child,
        History.reply(phase, History.measurement(phase, history), previous, request, reply), selected, accepted),
        boundary_world(World, ReferenceBoundary.enter(reference, child, previous), reply, world)}}}}}}}}}

def ready_provider_decision(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +phase: Phase.Phase, +history: V.History, +previous: Nat, +owner: Nat, +id: Nat, +exception: T.ExceptionToken, +world: E.WorldState<World>, +measured: T.ResolverState, +request: T.Request, +product: ArtifactValue.ProductValue, +staged: V.Frame, +awaited: {Attach.previous(previous, actual) == Loop.ServiceStep{T.AwaitService{measured, request}} : Loop.Continuation}, +encoded: {Contract.operation(request) == T.EncodeProduct{product} : T.Operation}, +stage: {S.state_stage(measured) == T.MeasuringCandidateTree{} : T.ResolverStage}, +selected: {ReferenceBoundary.selected_request(ReferenceBoundary.enter(reference, child, previous)) == Some{request} : Maybe<&2, T.Request>}, projected: {Contract.actual_frame(S.state_frame(measured), History.measurement(phase, history)) == Some{staged} : Maybe<&2, V.Frame>}, reference_projected: {Staged.project(ReferenceBoundary.enter(reference, child, previous), History.measurement(phase, history)) == Some{staged} : Maybe<&2, V.Frame>}, +validation: Maybe<&2, T.TechnicalFailure>, accepted: {Boundary.check(request, T.Reply{owner, id, T.ProviderRejected{exception}}) == validation : Maybe<&2, T.TechnicalFailure>}) -> Contract.conclusion(World, actual, reference, child, phase, history, previous, T.Reply{owner, id, T.ProviderRejected{exception}}, world):
  match validation:
    case None{}:
      ready_provider_transaction(World, actual, reference, child, phase, history, previous, owner, id, exception, world, measured, request, product, staged,
        awaited, encoded, stage, selected, projected, reference_projected, accepted)
    case Some{failure}:
      ready_rejected_transaction(World, actual, reference, child, phase, history, previous, T.Reply{owner, id, T.ProviderRejected{exception}}, world, measured, request, product, staged, failure,
        awaited, encoded, stage, selected, projected, reference_projected, accepted)

def ready_provider_joined(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +phase: Phase.Phase, +history: V.History, +previous: Nat, +owner: Nat, +id: Nat, +exception: T.ExceptionToken, +world: E.WorldState<World>, evidence: ready_joined_measurement_result(actual, reference, child, history, phase, previous)) -> Contract.conclusion(World, actual, reference, child, phase, history, previous, T.Reply{owner, id, T.ProviderRejected{exception}}, world):
  match evidence:
    case (+measured, (+request, (+product, (+staged, (awaited, (encoded, (stage, (selected, (projected, reference_projected))))))))):
      ready_provider_decision(World, actual, reference, child, phase, history, previous, owner, id, exception, world, measured, request, product, staged,
        awaited, encoded, stage, selected, projected, reference_projected,
        Boundary.check(request, T.Reply{owner, id, T.ProviderRejected{exception}}), {==})

def ready_original_provider(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +phase: Phase.Phase, +history: V.History, +child_history: Phase.ChildHistory, +previous: Nat, +owner: Nat, +id: Nat, +exception: T.ExceptionToken, +world: E.WorldState<World>, ready: {ActualReady.project(actual, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> Contract.conclusion(World, actual, reference, child, phase, history, previous, T.Reply{owner, id, T.ProviderRejected{exception}}, world):
  ready_provider_joined(World, actual, reference, child, phase, history, previous, owner, id, exception, world,
    ready_original_joined(actual, reference, child, history, child_history, phase, previous, ready, reference_ready, coherent))

def ready_invalid_correlation(+same: Bool, +expected: Nat, +actual: Nat, +owner: Nat, +product: ArtifactValue.ProductValue, +outcome: T.ServiceOutcome, incompatible: {Boundary.compatible(T.EncodeProduct{product}, outcome) == False{} : Bool}) -> Exists(T.TechnicalFailure, failure => {Boundary.correlation(same, expected, actual, owner, T.EncodeProduct{product}, outcome) == Some{failure} : Maybe<&2, T.TechnicalFailure>}):
  match same:
    case False{}: Tuple{T.WrongCorrelation{expected, actual}, {==}}
    case True{}:
      Tuple{T.WrongReplyKind{},
        %Equal.sym(Bool, Boundary.compatible(T.EncodeProduct{product}, outcome), False{}, incompatible):
          {Boundary.variant(_, owner, outcome) == Some{T.WrongReplyKind{}} : Maybe<&2, T.TechnicalFailure>}
        {==}}

def ready_invalid_header(+same: Bool, +owner: Nat, +actual: Nat, +id: Nat, +reply_id: Nat, +product: ArtifactValue.ProductValue, +outcome: T.ServiceOutcome, incompatible: {Boundary.compatible(T.EncodeProduct{product}, outcome) == False{} : Bool}) -> Exists(T.TechnicalFailure, failure => {Boundary.header(same, owner, actual, id, reply_id, T.EncodeProduct{product}, outcome) == Some{failure} : Maybe<&2, T.TechnicalFailure>}):
  match same:
    case False{}: Tuple{T.WrongInvocation{owner, actual}, {==}}
    case True{}: ready_invalid_correlation(Nat.is_eq(id, reply_id), id, reply_id, owner, product, outcome, incompatible)

def ready_invalid_request(+request: T.Request, +product: ArtifactValue.ProductValue, +reply: T.Reply, encoded: {Contract.operation(request) == T.EncodeProduct{product} : T.Operation}, incompatible: {Boundary.compatible(T.EncodeProduct{product}, ready_reply_outcome(reply)) == False{} : Bool}) -> Exists(T.TechnicalFailure, failure => {Boundary.check(request, reply) == Some{failure} : Maybe<&2, T.TechnicalFailure>}):
  match request reply:
    case T.Request{+owner, +id, +operation} T.Reply{+actual, +reply_id, +outcome}:
      %Equal.sym(T.Operation, operation, T.EncodeProduct{product}, encoded):
        Exists(T.TechnicalFailure, failure => {Boundary.check(T.Request{owner, id, _}, reply) == Some{failure} : Maybe<&2, T.TechnicalFailure>})
      ready_invalid_header(Nat.is_eq(owner, actual), owner, actual, id, reply_id, product, outcome, incompatible)

def ready_invalid_witness(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +phase: Phase.Phase, +history: V.History, +previous: Nat, +reply: T.Reply, +world: E.WorldState<World>, +measured: T.ResolverState, +request: T.Request, +product: ArtifactValue.ProductValue, +staged: V.Frame, +awaited: {Attach.previous(previous, actual) == Loop.ServiceStep{T.AwaitService{measured, request}} : Loop.Continuation}, +encoded: {Contract.operation(request) == T.EncodeProduct{product} : T.Operation}, stage: {S.state_stage(measured) == T.MeasuringCandidateTree{} : T.ResolverStage}, +selected: {ReferenceBoundary.selected_request(ReferenceBoundary.enter(reference, child, previous)) == Some{request} : Maybe<&2, T.Request>}, projected: {Contract.actual_frame(S.state_frame(measured), History.measurement(phase, history)) == Some{staged} : Maybe<&2, V.Frame>}, reference_projected: {Staged.project(ReferenceBoundary.enter(reference, child, previous), History.measurement(phase, history)) == Some{staged} : Maybe<&2, V.Frame>}, evidence: Exists(T.TechnicalFailure, failure => {Boundary.check(request, reply) == Some{failure} : Maybe<&2, T.TechnicalFailure>})) -> Contract.conclusion(World, actual, reference, child, phase, history, previous, reply, world):
  match evidence:
    case (+failure, rejected):
      ready_rejected_transaction(World, actual, reference, child, phase, history, previous, reply, world, measured, request, product, staged, failure,
        awaited, encoded, stage, selected, projected, reference_projected, rejected)

def ready_incompatible_joined(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +phase: Phase.Phase, +history: V.History, +previous: Nat, +reply: T.Reply, +world: E.WorldState<World>, incompatible: @product: ArtifactValue.ProductValue -> {Boundary.compatible(T.EncodeProduct{product}, ready_reply_outcome(reply)) == False{} : Bool}, evidence: ready_joined_measurement_result(actual, reference, child, history, phase, previous)) -> Contract.conclusion(World, actual, reference, child, phase, history, previous, reply, world):
  match evidence:
    case (+measured, (+request, (+product, (+staged, (awaited, (encoded, (stage, (selected, (projected, reference_projected))))))))):
      +encoded: {Contract.operation(request) == T.EncodeProduct{product} : T.Operation} = encoded
      ready_invalid_witness(World, actual, reference, child, phase, history, previous, reply, world, measured, request, product, staged,
        awaited, encoded, stage, selected, projected, reference_projected,
        ready_invalid_request(request, product, reply, encoded, incompatible(product)))

def ready_original_incompatible(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +phase: Phase.Phase, +history: V.History, +child_history: Phase.ChildHistory, +previous: Nat, +reply: T.Reply, +world: E.WorldState<World>, incompatible: @product: ArtifactValue.ProductValue -> {Boundary.compatible(T.EncodeProduct{product}, ready_reply_outcome(reply)) == False{} : Bool}, ready: {ActualReady.project(actual, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> Contract.conclusion(World, actual, reference, child, phase, history, previous, reply, world):
  ready_incompatible_joined(World, actual, reference, child, phase, history, previous, reply, world, incompatible,
    ready_original_joined(actual, reference, child, history, child_history, phase, previous, ready, reference_ready, coherent))

# Accepted ProductEncoded uses these same source/contribution/work/ID values
# on both sides of the original transaction. This compares the independent
# admission directly, before transporting publication or rollback fields.
def ready_capture_edges(+ids: List<&2, Nat>, +depth: Nat) -> {G.with_depth(ids, depth) == GraphReference.edges(ids, depth) : List<&2, G.Edge>}:
  match ids:
    case []: {==}
    case +head <> +tail:
      Equal.cong(List<&2, G.Edge>, List<&2, G.Edge>, rest => G.Edge{head, depth} <> rest,
        G.with_depth(tail, depth), GraphReference.edges(tail, depth), ready_capture_edges(tail, depth))

def ready_capture_formula(+read_bad: Bool, +work_bad: Bool, +overflow: Bool, +limits: G.Limits, +edge_id: Nat, +depth: Nat, +target: Nat, +source: Nat, +contribution: Nat, +local_work: Nat, +ids: List<&2, Nat>, +pending: List<&2, G.Edge>, +visited: List<&2, Nat>, +files: Nat, +read: Nat, +tree: Nat, +work: Nat, +skipped: Bool, +excluded: Bool, +other: Bool) -> {Bool.pick(G.Step, read_bad, G.fail(limits, pending, visited, files, read, tree, work, skipped, excluded, other, G.ReadLimit{}), Bool.pick(G.Step, work_bad, G.fail(limits, pending, visited, files, read, tree, work, skipped, excluded, other, G.WorkLimit{}), Bool.pick(G.Step, overflow, G.Step{G.Graph{G.GraphReady{}, pending, target <> visited, (files + 1n : Nat), (read + source : Nat), tree, (work + local_work : Nat), True{}, excluded, other, limits}, G.SkipImport{target, G.TreeLimit{}}}, G.Step{G.Graph{G.GraphReady{}, List.append(&2, G.Edge, pending, G.with_depth(ids, (depth + 1n : Nat))), target <> visited, (files + 1n : Nat), (read + source : Nat), Bool.pick(Nat, overflow, tree, (tree + contribution : Nat)), (work + local_work : Nat), skipped, excluded, other, limits}, G.NoCommand{}}))) == GraphReference.admission(GraphReference.failure_check(read_bad, G.ReadLimit{}, GraphReference.failure_check(work_bad, G.WorkLimit{}, None{})), G.Graph{G.Capturing{G.Edge{edge_id, depth}, target}, pending, visited, files, read, tree, work, skipped, excluded, other, limits}, _ => GraphReference.accept_capture(overflow, G.Graph{G.Capturing{G.Edge{edge_id, depth}, target}, pending, visited, files, read, tree, work, skipped, excluded, other, limits}, G.Edge{edge_id, depth}, target, source, contribution, local_work, ids)) : G.Step}:
  match read_bad work_bad overflow skipped:
    case False{} False{} False{} False{}:
      %Equal.sym(List<&2, G.Edge>, G.with_depth(ids, (depth + 1n : Nat)), GraphReference.edges(ids, (depth + 1n : Nat)), ready_capture_edges(ids, (depth + 1n : Nat))):
        {Bool.pick(G.Step, False{}, G.fail(limits, pending, visited, files, read, tree, work, False{}, excluded, other, G.ReadLimit{}), Bool.pick(G.Step, False{}, G.fail(limits, pending, visited, files, read, tree, work, False{}, excluded, other, G.WorkLimit{}), Bool.pick(G.Step, False{}, G.Step{G.Graph{G.GraphReady{}, pending, target <> visited, (files + 1n : Nat), (read + source : Nat), tree, (work + local_work : Nat), True{}, excluded, other, limits}, G.SkipImport{target, G.TreeLimit{}}}, G.Step{G.Graph{G.GraphReady{}, List.append(&2, G.Edge, pending, _), target <> visited, (files + 1n : Nat), (read + source : Nat), Bool.pick(Nat, False{}, tree, (tree + contribution : Nat)), (work + local_work : Nat), False{}, excluded, other, limits}, G.NoCommand{}}))) == GraphReference.admission(GraphReference.failure_check(False{}, G.ReadLimit{}, GraphReference.failure_check(False{}, G.WorkLimit{}, None{})), G.Graph{G.Capturing{G.Edge{edge_id, depth}, target}, pending, visited, files, read, tree, work, False{}, excluded, other, limits}, _ => GraphReference.accept_capture(False{}, G.Graph{G.Capturing{G.Edge{edge_id, depth}, target}, pending, visited, files, read, tree, work, False{}, excluded, other, limits}, G.Edge{edge_id, depth}, target, source, contribution, local_work, ids)) : G.Step}
      {==}
    case False{} False{} False{} True{}:
      %Equal.sym(List<&2, G.Edge>, G.with_depth(ids, (depth + 1n : Nat)), GraphReference.edges(ids, (depth + 1n : Nat)), ready_capture_edges(ids, (depth + 1n : Nat))):
        {Bool.pick(G.Step, False{}, G.fail(limits, pending, visited, files, read, tree, work, True{}, excluded, other, G.ReadLimit{}), Bool.pick(G.Step, False{}, G.fail(limits, pending, visited, files, read, tree, work, True{}, excluded, other, G.WorkLimit{}), Bool.pick(G.Step, False{}, G.Step{G.Graph{G.GraphReady{}, pending, target <> visited, (files + 1n : Nat), (read + source : Nat), tree, (work + local_work : Nat), True{}, excluded, other, limits}, G.SkipImport{target, G.TreeLimit{}}}, G.Step{G.Graph{G.GraphReady{}, List.append(&2, G.Edge, pending, _), target <> visited, (files + 1n : Nat), (read + source : Nat), Bool.pick(Nat, False{}, tree, (tree + contribution : Nat)), (work + local_work : Nat), True{}, excluded, other, limits}, G.NoCommand{}}))) == GraphReference.admission(GraphReference.failure_check(False{}, G.ReadLimit{}, GraphReference.failure_check(False{}, G.WorkLimit{}, None{})), G.Graph{G.Capturing{G.Edge{edge_id, depth}, target}, pending, visited, files, read, tree, work, True{}, excluded, other, limits}, _ => GraphReference.accept_capture(False{}, G.Graph{G.Capturing{G.Edge{edge_id, depth}, target}, pending, visited, files, read, tree, work, True{}, excluded, other, limits}, G.Edge{edge_id, depth}, target, source, contribution, local_work, ids)) : G.Step}
      {==}
    case False{} False{} True{} False{}: {==}
    case False{} False{} True{} True{}: {==}
    case False{} True{} False{} False{}: {==}
    case False{} True{} False{} True{}: {==}
    case False{} True{} True{} False{}: {==}
    case False{} True{} True{} True{}: {==}
    case True{} False{} False{} False{}: {==}
    case True{} False{} False{} True{}: {==}
    case True{} False{} True{} False{}: {==}
    case True{} False{} True{} True{}: {==}
    case True{} True{} False{} False{}: {==}
    case True{} True{} False{} True{}: {==}
    case True{} True{} True{} False{}: {==}
    case True{} True{} True{} True{}: {==}

def ready_captured_transition(+limits: G.Limits, +edge: G.Edge, +target: Nat, +source: Nat, +contribution: Nat, +local_work: Nat, +ids: List<&2, Nat>, +pending: List<&2, G.Edge>, +visited: List<&2, Nat>, +files: Nat, +read: Nat, +tree: Nat, +work: Nat, +skipped: Bool, +excluded: Bool, +other: Bool) -> {G.captured(limits, edge, target, source, contribution, local_work, ids, pending, visited, files, read, tree, work, skipped, excluded, other) == GraphReference.captured(G.Graph{G.Capturing{edge, target}, pending, visited, files, read, tree, work, skipped, excluded, other, limits}, edge, target, source, contribution, local_work, ids) : G.Step}:
  match limits edge:
    case G.Limits{_, +source_cap, +tree_cap, _, +read_cap, +edge_cap, _, +work_cap} G.Edge{+edge_id, +depth}:
      ready_capture_formula(
        Bool.or(Nat.is_gt(source, source_cap), Nat.is_gt((read + source : Nat), read_cap)),
        Bool.or(Nat.is_gt(List.length(&2, Nat, ids), edge_cap), Nat.is_gt((work + local_work : Nat), work_cap)),
        Nat.is_gt((tree + contribution : Nat), tree_cap), limits, edge_id, depth, target,
        source, contribution, local_work, ids, pending, visited, files, read, tree, work, skipped, excluded, other)

def ready_captured_graph(+graph: G.Graph, +source: Nat, +contribution: Nat, +local_work: Nat, +ids: List<&2, Nat>) -> {G.step(graph, G.Captured{source, contribution, local_work, ids}) == GraphReference.transition(graph, G.Captured{source, contribution, local_work, ids}) : G.Step}:
  match graph:
    case G.Graph{+phase, +pending, +visited, +files, +read, +tree, +work, +skipped, +excluded, +other, +limits}:
      match phase:
        case G.Capturing{edge, target}:
          ready_captured_transition(limits, edge, target, source, contribution, local_work, ids, pending, visited, files, read, tree, work, skipped, excluded, other)
        case G.Idle{}: {==}
        case G.GraphReady{}: {==}
        case G.Resolving{_}: {==}
        case G.Checking{_, _}: {==}
        case G.Complete{}: {==}
        case G.Incomplete{_}: {==}

def ready_captured_allowance(+graph: G.Graph, +source: Nat, +contribution: Nat, +local_work: Nat, +ids: List<&2, Nat>, +remaining: Nat, positive: {Nat.is_gt(remaining, 0n) == True{} : Bool}) -> {GraphReference.bounded_transition(G.Bounded{graph, remaining}, G.Captured{source, contribution, local_work, ids}) == GraphReference.bounded_result(G.step(graph, G.Captured{source, contribution, local_work, ids}), Nat.sub(remaining, 1n)) : G.BoundedStep}:
  match remaining:
    case 0n:
      Empty.absurd({GraphReference.bounded_transition(G.Bounded{graph, remaining}, G.Captured{source, contribution, local_work, ids}) ==
        GraphReference.bounded_result(G.step(graph, G.Captured{source, contribution, local_work, ids}), Nat.sub(remaining, 1n)) : G.BoundedStep},
        BoolFacts.internal_false_ne_true(positive))
    case 1n++rest:
      %Equal.sym(Nat, Nat.sub(rest, 0n), rest, NatFacts.sub_zero(rest)):
        {GraphReference.bounded_result(GraphReference.transition(graph, G.Captured{source, contribution, local_work, ids}), rest) == GraphReference.bounded_result(G.step(graph, G.Captured{source, contribution, local_work, ids}), _) : G.BoundedStep}
      Equal.cong(G.Step, G.BoundedStep, step => GraphReference.bounded_result(step, rest),
        GraphReference.transition(graph, G.Captured{source, contribution, local_work, ids}), G.step(graph, G.Captured{source, contribution, local_work, ids}),
        Equal.sym(G.Step, G.step(graph, G.Captured{source, contribution, local_work, ids}), GraphReference.transition(graph, G.Captured{source, contribution, local_work, ids}), ready_captured_graph(graph, source, contribution, local_work, ids)))

def ready_rollback_forward(+nodes: List<&2, Local.PlannedNode>, +slots: List<&2, Local.ReferenceSlot>, +owner: Nat, +index: Nat, +name: String, +forward: {P.forward_nodes(nodes, slots) == True{} : Bool}) -> {P.forward_nodes(nodes, ReplacementStructure.slots(Compose.replace_slot(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name}))) == True{} : Bool}:
  match nodes:
    case []: {==}
    case Local.PlannedNode{+id, _} <> +tail:
      BoolFacts.and_eq_true(
        P.indexed(P.owner_slots(ReplacementStructure.slots(Compose.replace_slot(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name})), id), 0n, tail),
        P.forward_nodes(tail, ReplacementStructure.slots(Compose.replace_slot(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name}))),
        ReplacementStructure.replacement_owner_indexed(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name}, id, 0n, tail,
          BoolFacts.eq_true_of_and_left(P.indexed(P.owner_slots(slots, id), 0n, tail), P.forward_nodes(tail, slots), forward), {==}),
        ready_rollback_forward(tail, slots, owner, index, name,
          BoolFacts.eq_true_of_and_right(P.indexed(P.owner_slots(slots, id), 0n, tail), P.forward_nodes(tail, slots), forward)))

def ready_rollback_project_parts(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +addresses: List<&2, F.AddressEntry>, +birth: O.NodeAddress, +retained: List<&2, F.Node>, +owner: Nat, +index: Nat, +name: String, +changed: List<&2, Local.ReferenceSlot>, +values: List<&2, F.Node>, +guard: {Bool.and(P.aligned(nodes, addresses, nodes, addresses), Bool.and(P.catalog_unique(catalog, catalog), Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots)))) == True{} : Bool}, old_forest: {P.forest(F.address_at(addresses, root), P.nodes(nodes, slots, catalog, addresses)) == Some{F.Forest{Some{birth}, retained}} : Maybe<&2, F.Forest>}, replaced: {Compose.replacement(Compose.replace_slot(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name})) == Some{changed} : Maybe<&2, List<&2, Local.ReferenceSlot>>}, projected: {P.nodes(nodes, changed, catalog, addresses) == Some{values} : Maybe<&2, List<&2, F.Node>>}) -> {P.project(root, nodes, changed, catalog, addresses) == Some{F.Forest{Some{birth}, values}} : Maybe<&2, F.Forest>}:
  +rest: {Bool.and(P.catalog_unique(catalog, catalog), Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots))) == True{} : Bool} =
    BoolFacts.eq_true_of_and_right(P.aligned(nodes, addresses, nodes, addresses), Bool.and(P.catalog_unique(catalog, catalog), Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots))), guard)
  +structure: {Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots)) == True{} : Bool} =
    BoolFacts.eq_true_of_and_right(P.catalog_unique(catalog, catalog), Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots)), rest)
  +payload: {ReplacementStructure.slots(Compose.replace_slot(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name})) == changed : List<&2, Local.ReferenceSlot>} =
    NodeReplacement.replacement_payload(Compose.replace_slot(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name}), changed, replaced)
  Contents.project_from_parts(root, nodes, changed, catalog, addresses, birth, values,
    BoolFacts.eq_true_of_and_left(P.aligned(nodes, addresses, nodes, addresses), Bool.and(P.catalog_unique(catalog, catalog), Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots))), guard),
    BoolFacts.eq_true_of_and_left(P.catalog_unique(catalog, catalog), Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots)), rest),
    %payload: {P.slots_owned(_, nodes) == True{} : Bool}
      ReplacementStructure.replacement_owned(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name}, nodes, BoolFacts.eq_true_of_and_left(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots), structure)),
    %payload: {P.forward_nodes(nodes, _) == True{} : Bool}
      ready_rollback_forward(nodes, slots, owner, index, name, BoolFacts.eq_true_of_and_right(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots), structure)),
    Contents.projected_forest_root(F.address_at(addresses, root), P.nodes(nodes, slots, catalog, addresses), birth, retained, old_forest), projected)

def ready_rollback_project(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +addresses: List<&2, F.AddressEntry>, +birth: O.NodeAddress, +retained: List<&2, F.Node>, +owner: Nat, +index: Nat, +name: String, +changed: List<&2, Local.ReferenceSlot>, +values: List<&2, F.Node>, original: {P.project(root, nodes, slots, catalog, addresses) == Some{F.Forest{Some{birth}, retained}} : Maybe<&2, F.Forest>}, replaced: {Compose.replacement(Compose.replace_slot(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name})) == Some{changed} : Maybe<&2, List<&2, Local.ReferenceSlot>>}, projected: {P.nodes(nodes, changed, catalog, addresses) == Some{values} : Maybe<&2, List<&2, F.Node>>}) -> {P.project(root, nodes, changed, catalog, addresses) == Some{F.Forest{Some{birth}, values}} : Maybe<&2, F.Forest>}:
  Parent.eliminate_pair(
    {Bool.and(P.aligned(nodes, addresses, nodes, addresses), Bool.and(P.catalog_unique(catalog, catalog), Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots)))) == True{} : Bool},
    {P.forest(F.address_at(addresses, root), P.nodes(nodes, slots, catalog, addresses)) == Some{F.Forest{Some{birth}, retained}} : Maybe<&2, F.Forest>},
    {P.project(root, nodes, changed, catalog, addresses) == Some{F.Forest{Some{birth}, values}} : Maybe<&2, F.Forest>},
    Contents.project_contents(root, nodes, slots, catalog, addresses, F.Forest{Some{birth}, retained}, original),
    guard => forest => ready_rollback_project_parts(root, nodes, slots, catalog, addresses, birth, retained, owner, index, name, changed, values, guard, forest, replaced, projected))

def ready_rollback_owner_count(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +addresses: List<&2, F.AddressEntry>, +birth: O.NodeAddress, +retained: List<&2, F.Node>, +owner: Nat, +address: O.NodeAddress, original: {P.project(root, nodes, slots, catalog, addresses) == Some{F.Forest{Some{birth}, retained}} : Maybe<&2, F.Forest>}, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, present: {F.address_at(addresses, owner) == Some{address} : Maybe<&2, O.NodeAddress>}) -> {F.count_address(retained, address) == 1n : Nat}:
  Parent.eliminate_pair(
    {Bool.and(P.aligned(nodes, addresses, nodes, addresses), Bool.and(P.catalog_unique(catalog, catalog), Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots)))) == True{} : Bool},
    {P.forest(F.address_at(addresses, root), P.nodes(nodes, slots, catalog, addresses)) == Some{F.Forest{Some{birth}, retained}} : Maybe<&2, F.Forest>},
    {F.count_address(retained, address) == 1n : Nat},
    Contents.project_contents(root, nodes, slots, catalog, addresses, F.Forest{Some{birth}, retained}, original),
    guard => forest => Parent.projected_lookup_count(nodes, addresses, slots, catalog, retained, owner, address,
      BoolFacts.eq_true_of_and_left(P.aligned(nodes, addresses, nodes, addresses), Bool.and(P.catalog_unique(catalog, catalog), Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots))), guard),
      dense, NodeReplacement.projected_forest_nodes(F.address_at(addresses, root), P.nodes(nodes, slots, catalog, addresses), birth, retained, forest), present))

def ready_rollback_result(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +addresses: List<&2, F.AddressEntry>, +birth: O.NodeAddress, +retained: List<&2, F.Node>, +owner: Nat, +index: Nat, +symbol: String, +name: String, +address: O.NodeAddress) -> Type:
  Exists(List<&2, Local.ReferenceSlot>, changed => Exists(List<&2, F.Node>, values =>
    {Compose.replacement(Compose.replace_slot(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name})) == Some{changed} : Maybe<&2, List<&2, Local.ReferenceSlot>>} &
    {P.project(root, nodes, changed, catalog, addresses) == Some{F.Forest{Some{birth}, values}} : Maybe<&2, F.Forest>} &
    {F.replace(F.Forest{Some{birth}, retained}, address, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}) == F.Replaced{F.Forest{Some{birth}, values}} : F.Replacement}))

def ready_rollback_witness(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +addresses: List<&2, F.AddressEntry>, +birth: O.NodeAddress, +retained: List<&2, F.Node>, +owner: Nat, +index: Nat, +symbol: String, +name: String, +address: O.NodeAddress, original: {P.project(root, nodes, slots, catalog, addresses) == Some{F.Forest{Some{birth}, retained}} : Maybe<&2, F.Forest>}, counted: {F.count_address(retained, address) == 1n : Nat}, evidence: Exists(List<&2, Local.ReferenceSlot>, changed => Exists(List<&2, F.Node>, values => {Compose.replacement(Compose.replace_slot(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name})) == Some{changed} : Maybe<&2, List<&2, Local.ReferenceSlot>>} & {P.nodes(nodes, changed, catalog, addresses) == Some{values} : Maybe<&2, List<&2, F.Node>>} & {F.replace_nodes(retained, address, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}) == F.Nodes{values, 1n} : F.Nodes}))) -> ready_rollback_result(root, nodes, slots, catalog, addresses, birth, retained, owner, index, symbol, name, address):
  match evidence:
    case (+changed, (+values, (replaced, (projected, semantic)))):
      +replaced: {Compose.replacement(Compose.replace_slot(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name})) == Some{changed} : Maybe<&2, List<&2, Local.ReferenceSlot>>} = replaced
      Tuple{changed, Tuple{values, Tuple{replaced, Tuple{
        ready_rollback_project(root, nodes, slots, catalog, addresses, birth, retained, owner, index, name, changed, values, original, replaced, projected),
        Parent.forest_replacement_completed(birth, retained, address, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}, values, counted, {==}, semantic)}}}}

def ready_rollback_exact(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +addresses: List<&2, F.AddressEntry>, +birth: O.NodeAddress, +retained: List<&2, F.Node>, +owner: Nat, +index: Nat, +symbol: String, +name: String, +address: O.NodeAddress, +original: {P.project(root, nodes, slots, catalog, addresses) == Some{F.Forest{Some{birth}, retained}} : Maybe<&2, F.Forest>}, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, selected: {ActualReady.slot_count(slots, owner, index, symbol) == 1n : Nat}, +present: {F.address_at(addresses, owner) == Some{address} : Maybe<&2, O.NodeAddress>}) -> ready_rollback_result(root, nodes, slots, catalog, addresses, birth, retained, owner, index, symbol, name, address):
  ready_rollback_witness(root, nodes, slots, catalog, addresses, birth, retained, owner, index, symbol, name, address, original,
    ready_rollback_owner_count(root, nodes, slots, catalog, addresses, birth, retained, owner, address, original, dense, present),
    NodeReplacement.node_replacement_exact(root, nodes, slots, catalog, addresses, birth, retained, owner, index, symbol, address,
      Local.Omitted{Local.ReferenceLimit{}, name}, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}, original, selected, present, {==}))

# The selected rollback already supplies a checked semantic replacement.  Carry
# the original frame invariant through that same replacement, so the actual
# projection cannot discard the resulting forest at forest_valid.
def ready_rollback_forest_valid(+forest: F.Forest, +changed: F.Forest, +episode: Nat, +owner: O.NodeAddress, +index: Nat, +symbol: String, +name: String, before: {Relation.frame_forest(forest, episode) == True{} : Bool}, replaced: {F.replace(forest, owner, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}) == F.Replaced{changed} : F.Replacement}) -> {Relation.frame_forest(changed, episode) == True{} : Bool}:
  Equal.sym(Bool, True{}, Relation.frame_forest(changed, episode),
    Equal.trans(Bool, True{}, Rollback.replacement_valid(F.replace(forest, owner, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}), episode), Relation.frame_forest(changed, episode),
      Rollback.omitted_replacement_valid(forest, episode, owner, index, F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}, Equal.sym(Bool, Relation.frame_forest(forest, episode), True{}, before)),
      Equal.cong(F.Replacement, Bool, result => Rollback.replacement_valid(result, episode), F.replace(forest, owner, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}), F.Replaced{changed}, replaced)))

def ready_rollback_observed(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +addresses: List<&2, F.AddressEntry>, +forest: F.Forest, +changed: F.Forest, +episode: Nat, +owner: O.NodeAddress, +index: Nat, +symbol: String, +name: String, projected: {P.project(root, nodes, slots, catalog, addresses) == Some{changed} : Maybe<&2, F.Forest>}, before: {Relation.frame_forest(forest, episode) == True{} : Bool}, replaced: {F.replace(forest, owner, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}) == F.Replaced{changed} : F.Replacement}) -> {ActualFrame.forest_valid(P.project(root, nodes, slots, catalog, addresses), episode) == Some{changed} : Maybe<&2, F.Forest>}:
  Equal.trans(Maybe<&2, F.Forest>, ActualFrame.forest_valid(P.project(root, nodes, slots, catalog, addresses), episode), ActualFrame.forest_valid(Some{changed}, episode), Some{changed},
    Equal.cong(Maybe<&2, F.Forest>, Maybe<&2, F.Forest>, value => ActualFrame.forest_valid(value, episode), P.project(root, nodes, slots, catalog, addresses), Some{changed}, projected),
    Equal.cong(Bool, Maybe<&2, F.Forest>, valid => Bool.pick(Maybe<&2, F.Forest>, valid, Some{changed}, None{}), Relation.frame_forest(changed, episode), True{},
      ready_rollback_forest_valid(forest, changed, episode, owner, index, symbol, name, before, replaced)))

def ready_rollback_valid_witness(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +catalog: List<&2, T.ArtifactEntry>, +addresses: List<&2, F.AddressEntry>, +birth: O.NodeAddress, +retained: List<&2, F.Node>, +episode: Nat, +slots: List<&2, Local.ReferenceSlot>, +owner: Nat, +index: Nat, +symbol: String, +name: String, +address: O.NodeAddress, before: {Relation.frame_forest(F.Forest{Some{birth}, retained}, episode) == True{} : Bool}, evidence: ready_rollback_result(root, nodes, slots, catalog, addresses, birth, retained, owner, index, symbol, name, address)) -> Exists(List<&2, Local.ReferenceSlot>, changed => Exists(List<&2, F.Node>, values => {Compose.replacement(Compose.replace_slot(slots, owner, index, Local.Omitted{Local.ReferenceLimit{}, name})) == Some{changed} : Maybe<&2, List<&2, Local.ReferenceSlot>>} & {ActualFrame.forest_valid(P.project(root, nodes, changed, catalog, addresses), episode) == Some{F.Forest{Some{birth}, values}} : Maybe<&2, F.Forest>} & {F.replace(F.Forest{Some{birth}, retained}, address, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}) == F.Replaced{F.Forest{Some{birth}, values}} : F.Replacement})):
  match evidence:
    case (+changed, (+values, (replaced, (projected, semantic)))):
      +semantic: {F.replace(F.Forest{Some{birth}, retained}, address, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}) == F.Replaced{F.Forest{Some{birth}, values}} : F.Replacement} = semantic
      Tuple{changed, Tuple{values, Tuple{replaced, Tuple{
        ready_rollback_observed(root, nodes, changed, catalog, addresses, F.Forest{Some{birth}, retained}, F.Forest{Some{birth}, values}, episode, address, index, symbol, name, projected, before, semantic), semantic}}}}

def ready_replaced_view(view: V.Frame, forest: F.Forest) -> V.Frame:
  match view:
    case V.Frame{branch, limits, graph, command, deps, _, pending, targets, ids, captured, identities, visited, budget, node, edge, target, artifact, catalog, remaining, episode}:
      V.Frame{branch, limits, graph, command, deps, forest, pending, targets, ids, captured, identities, visited, budget, node, edge, target, artifact, catalog, remaining, episode}

def ready_rollback_frame_rows(+forest: Maybe<&2, F.Forest>, +pending: Maybe<&2, List<&2, V.PendingEntry>>, +targets: Maybe<&2, List<&2, V.TargetEntry>>, +ids: Maybe<&2, List<&2, V.TargetId>>, +captured: Maybe<&2, List<&2, V.CapturedEntry>>, +identities: Maybe<&2, List<&2, V.TargetArtifact>>, +visited: Maybe<&2, List<&2, String>>, +actual: T.ResolverFrame, +remaining: Nat, +episode: Nat, +view: V.Frame, +changed: F.Forest, +slots: List<&2, Local.ReferenceSlot>, ready: {ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, actual, remaining, episode) == Some{view} : Maybe<&2, V.Frame>}) -> {ActualFrame.frame_view(Some{changed}, pending, targets, ids, captured, identities, visited, S.with_frame_references(actual, slots), remaining, episode) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>}:
  match forest pending targets ids captured identities visited actual:
    case Some{+old} Some{+pending_value} Some{+targets_value} Some{+ids_value} Some{+captured_value} Some{+identities_value} Some{+visited_value}
      T.ResolverFrame{branch, limits, graph, command, deps, _, _, _, _, budget, node, edge, target, artifact, _, _, _, _, _, artifacts}:
      %Count.some_equal(V.Frame, V.Frame{branch, limits, graph, command, deps, old, pending_value, targets_value, ids_value, captured_value, identities_value, visited_value, V.actual_budget(budget), node, edge, target, artifact, artifacts, remaining, episode}, view, ready):
        {ActualFrame.frame_view(Some{changed}, Some{pending_value}, Some{targets_value}, Some{ids_value}, Some{captured_value}, Some{identities_value}, Some{visited_value}, S.with_frame_references(actual, slots), remaining, episode) == Some{ready_replaced_view(_, changed)} : Maybe<&2, V.Frame>}
      {==}
    case None{} _ _ _ _ _ _ _:
