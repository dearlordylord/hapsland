    case _ Some{V.CaptureSource{_, _, _}} None{}: Empty.absurd({Maybe.is_some(&2, List<&2, V.CapturedEntry>, ReferenceFrame.captured(Bool.pick(List<&2, X.Captured>, same, X.Captured{path, source, bytes} <> tail, X.Captured{key, old, old_bytes} <> X.store_capture(tail, path, source, bytes)), History.store_capture(sources, path, source, catalog))) == True{} : Bool}, Contents.none_some(List<&2, V.CapturedEntry>, rows, projected))

def ready_reference_capture_store_total(+items: List<&2, X.Captured>, +sources: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source, +bytes: Nat, +rows: List<&2, V.CapturedEntry>, projected: {ReferenceFrame.captured(items, sources) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}) -> {Maybe.is_some(&2, List<&2, V.CapturedEntry>, ReferenceFrame.captured(X.store_capture(items, path, source, bytes), History.store_capture(sources, path, source, catalog))) == True{} : Bool}:
  match items:
    case []:
      ready_reference_capture_prefix_some(ReferenceFrame.captured_entry(path, source, bytes, V.capture_at(History.store_capture(sources, path, source, catalog), path)), Some{[]},
        ready_reference_capture_entry_some(path, source, bytes, V.capture_at(History.store_capture(sources, path, source, catalog), path),
          Equal.cong(Maybe<&2, V.CaptureSource>, Bool, value => Maybe.is_some(&2, V.CaptureSource, value), V.capture_at(History.store_capture(sources, path, source, catalog), path), Some{V.CaptureSource{path, source, catalog}}, ready_capture_provenance_at(sources, path, source, catalog))), {==})
    case X.Captured{+key, +old, +old_bytes} <> +tail:
