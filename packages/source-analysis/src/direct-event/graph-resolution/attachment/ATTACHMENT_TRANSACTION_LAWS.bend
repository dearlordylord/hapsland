      visited_coverage: {ActualFrame.coverage(visited_order, visited_frame) == True{} : Bool} =
        ready_visited_replaced_coverage(order, frame, visited, next_visited, coverage,
          BoolFacts.eq_true_of_and_left(ActualFrame.strings_unique(visited, visited), Nat.is_eq(List.length(&2, String, visited), List.length(&2, String, Map.keys(&2, Bool, next_visited))), visited_guard),
          BoolFacts.eq_true_of_and_right(ActualFrame.strings_unique(visited, visited), Nat.is_eq(List.length(&2, String, visited), List.length(&2, String, Map.keys(&2, Bool, next_visited))), visited_guard))
