def reference_visited_guard_true(+guard: Bool, +value: Maybe<&2, List<&2, String>>, +observed: List<&2, String>, ready: {Bool.pick(Maybe<&2, List<&2, String>>, guard, value, None{}) == Some{observed} : Maybe<&2, List<&2, String>>}) -> {guard == True{} : Bool}:
  match guard:
    case True{}: {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, Contents.none_some(List<&2, String>, observed, ready))

def reference_visited_cardinality(+order: List<&2, String>, +entries: Map<&2, Bool>, +observed: List<&2, String>, ready: {ReferenceFrame.visited(order, entries) == Some{observed} : Maybe<&2, List<&2, String>>}) -> {Nat.is_eq(List.length(&2, String, order), List.length(&2, String, Map.keys(&2, Bool, entries))) == True{} : Bool}:
  BoolFacts.eq_true_of_and_right(ReferenceFrame.unique_strings(order, order),
    Nat.is_eq(List.length(&2, String, order), List.length(&2, String, Map.keys(&2, Bool, entries))),
    reference_visited_guard_true(
      Bool.and(ReferenceFrame.unique_strings(order, order),
        Nat.is_eq(List.length(&2, String, order), List.length(&2, String, Map.keys(&2, Bool, entries)))),
      ReferenceFrame.visited_entries(order, entries), observed, ready))

def visited_lookup_selected(+present: Bool, +order: List<&2, String>, +actual: Map<&2, Bool>, +reference: Map<&2, Bool>, +observed: List<&2, String>, +query: String, +member: {List.contains(String, String.eq, order, query) == present : Bool}, actual_ready: {ActualFrame.visited(order, actual) == Some{observed} : Maybe<&2, List<&2, String>>}, +reference_ready: {ReferenceFrame.visited(order, reference) == Some{observed} : Maybe<&2, List<&2, String>>}, +unique: {ActualFrame.strings_unique(order, order) == True{} : Bool}, actual_size: {Nat.is_eq(List.length(&2, String, order), List.length(&2, String, Map.keys(&2, Bool, actual))) == True{} : Bool}) -> {Local.map_result(Bool, Map.get(Bool, False{}, actual, query)) == Local.map_result(Bool, Map.get(Bool, False{}, reference, query)) : Bool}:
  match present:
    case True{}: visited_present_correspondence(order, actual, reference, observed, query, actual_ready, reference_ready, member)
    case False{}:
      Equal.trans(Bool, Local.map_result(Bool, Map.get(Bool, False{}, actual, query)), False{},
        Local.map_result(Bool, Map.get(Bool, False{}, reference, query)),
