def ready_capture_publication_recursive(+items: List<&2, X.Captured>, +entries: Map<&2, Maybe<&2, T.CapturedFacts>>, +sources: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source, +bytes: Nat, +rows: List<&2, V.CapturedEntry>, +valid: {Patricia.canonical(Maybe<&2, T.CapturedFacts>, entries) == True{} : Bool}, bound: NatFacts.le(ActualFrame.string_count(ready_capture_reference_paths(items), path), 1n), actual: {ActualFrame.captured(ready_capture_reference_paths(items), entries, sources) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}, reference: {ReferenceFrame.captured(items, sources) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}) -> {ActualFrame.captured(History.retain_string(ready_capture_reference_paths(items), path), Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceFrame.source_exports(source), bytes}}), History.store_capture(sources, path, source, catalog)) == ReferenceFrame.captured(X.store_capture(items, path, source, bytes), History.store_capture(sources, path, source, catalog)) : Maybe<&2, List<&2, V.CapturedEntry>>}:
  match items:
    case []:
      ready_capture_prefix_join(ActualFrame.captured_entry(path, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceFrame.source_exports(source), bytes}}), path), V.capture_at(History.store_capture(sources, path, source, catalog), path)), Some{[]}, ReferenceFrame.captured_entry(path, source, bytes, V.capture_at(History.store_capture(sources, path, source, catalog), path)), Some{[]},
        ready_capture_selected_correspondence(entries, sources, path, source, catalog, bytes, valid), {==})
    case X.Captured{+key, +old, +old_bytes} <> +tail:
      ready_capture_common_cons({ActualFrame.captured(History.retain_string(key <> ready_capture_reference_paths(tail), path), Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceFrame.source_exports(source), bytes}}), History.store_capture(sources, path, source, catalog)) == ReferenceFrame.captured(X.store_capture(X.Captured{key, old, old_bytes} <> tail, path, source, bytes), History.store_capture(sources, path, source, catalog)) : Maybe<&2, List<&2, V.CapturedEntry>>}, ActualFrame.captured_entry(key, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, entries, key), V.capture_at(sources, key)), ActualFrame.captured(ready_capture_reference_paths(tail), entries, sources), ReferenceFrame.captured_entry(key, old, old_bytes, V.capture_at(sources, key)), ReferenceFrame.captured(tail, sources), rows, actual, reference,
        row => rest => head => tail_actual => head_reference => tail_reference =>
          ready_capture_publication_case(key, old, old_bytes, tail, entries, sources, path, source, catalog, bytes, String.eq(key, path), {==}, valid, bound,
            row, rest, head, tail_actual, head_reference, tail_reference,
            retained => remaining => actual_rest => reference_rest =>
              ready_capture_publication_recursive(tail, entries, sources, path, source, catalog, bytes, retained, valid, remaining, actual_rest, reference_rest)))

def ready_capture_row_paths(items: List<&2, V.CapturedEntry>) -> List<&2, String>:
  match items:
    case []: []
    case V.CapturedEntry{path, _, _} <> tail: path <> ready_capture_row_paths(tail)

def ready_capture_observed_paths(items: Maybe<&2, List<&2, V.CapturedEntry>>) -> List<&2, String>:
  match items:
    case Some{rows}: ready_capture_row_paths(rows)
    case None{}: []

def ready_capture_actual_paths_prefix(+key: String, +tail: List<&2, String>, +file: Maybe<&2, T.CapturedFacts>, +provenance: Maybe<&2, V.CaptureSource>, +rest: Maybe<&2, List<&2, V.CapturedEntry>>, +rows: List<&2, V.CapturedEntry>, projected: {ActualFrame.captured_prefix(ActualFrame.captured_entry(key, file, provenance), rest) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}, recurse: @retained: List<&2, V.CapturedEntry> -> {rest == Some{retained} : Maybe<&2, List<&2, V.CapturedEntry>>} -> {tail == ready_capture_row_paths(retained) : List<&2, String>}) -> {key <> tail == ready_capture_row_paths(rows) : List<&2, String>}:
  match file provenance rest:
    case Some{+facts} Some{V.CaptureSource{_, +original, _}} Some{+retained}:
      Equal.trans(List<&2, String>, key <> tail, key <> ready_capture_row_paths(retained), ready_capture_row_paths(rows),
        Equal.cong(List<&2, String>, List<&2, String>, paths => key <> paths, tail, ready_capture_row_paths(retained), recurse(retained, {==})),
        Equal.cong(Maybe<&2, List<&2, V.CapturedEntry>>, List<&2, String>, ready_capture_observed_paths,
          Some{V.CapturedEntry{key, facts, original} <> retained}, Some{rows}, projected))
    case None{} _ _:
      Empty.absurd({key <> tail == ready_capture_row_paths(rows) : List<&2, String>}, Contents.none_some(List<&2, V.CapturedEntry>, rows, projected))
    case Some{_} None{} _:
      Empty.absurd({key <> tail == ready_capture_row_paths(rows) : List<&2, String>}, Contents.none_some(List<&2, V.CapturedEntry>, rows, projected))
    case Some{_} Some{_} None{}:
      Empty.absurd({key <> tail == ready_capture_row_paths(rows) : List<&2, String>}, Contents.none_some(List<&2, V.CapturedEntry>, rows, projected))

def ready_capture_actual_paths(+order: List<&2, String>, +entries: Map<&2, Maybe<&2, T.CapturedFacts>>, +sources: List<&2, V.CaptureSource>, +rows: List<&2, V.CapturedEntry>, projected: {ActualFrame.captured(order, entries, sources) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}) -> {order == ready_capture_row_paths(rows) : List<&2, String>}:
  match order:
    case []: Equal.cong(Maybe<&2, List<&2, V.CapturedEntry>>, List<&2, String>, ready_capture_observed_paths, Some{[]}, Some{rows}, projected)
    case +head <> +tail:
      ready_capture_actual_paths_prefix(head, tail, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, entries, head),
        V.capture_at(sources, head), ActualFrame.captured(tail, entries, sources), rows, projected,
        retained => witness => ready_capture_actual_paths(tail, entries, sources, retained, witness))

def ready_capture_reference_paths_prefix(+key: String, +source: T.SourceFacts, +bytes: Nat, +tail: List<&2, String>, +provenance: Maybe<&2, V.CaptureSource>, +rest: Maybe<&2, List<&2, V.CapturedEntry>>, +rows: List<&2, V.CapturedEntry>, projected: {ReferenceFrame.prefix(V.CapturedEntry, ReferenceFrame.captured_entry(key, source, bytes, provenance), rest) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}, recurse: @retained: List<&2, V.CapturedEntry> -> {rest == Some{retained} : Maybe<&2, List<&2, V.CapturedEntry>>} -> {tail == ready_capture_row_paths(retained) : List<&2, String>}) -> {key <> tail == ready_capture_row_paths(rows) : List<&2, String>}:
  match provenance rest:
    case Some{V.CaptureSource{_, _, +catalog}} Some{+retained}:
      Equal.trans(List<&2, String>, key <> tail, key <> ready_capture_row_paths(retained), ready_capture_row_paths(rows),
        Equal.cong(List<&2, String>, List<&2, String>, paths => key <> paths, tail, ready_capture_row_paths(retained), recurse(retained, {==})),
        Equal.cong(Maybe<&2, List<&2, V.CapturedEntry>>, List<&2, String>, ready_capture_observed_paths,
          Some{V.CapturedEntry{key, T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceFrame.source_exports(source), bytes}, source} <> retained}, Some{rows}, projected))
    case None{} _:
      Empty.absurd({key <> tail == ready_capture_row_paths(rows) : List<&2, String>}, Contents.none_some(List<&2, V.CapturedEntry>, rows, projected))
    case Some{_} None{}:
      Empty.absurd({key <> tail == ready_capture_row_paths(rows) : List<&2, String>}, Contents.none_some(List<&2, V.CapturedEntry>, rows, projected))

def ready_capture_reference_paths_exact(+items: List<&2, X.Captured>, +sources: List<&2, V.CaptureSource>, +rows: List<&2, V.CapturedEntry>, projected: {ReferenceFrame.captured(items, sources) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}) -> {ready_capture_reference_paths(items) == ready_capture_row_paths(rows) : List<&2, String>}:
  match items:
    case []: Equal.cong(Maybe<&2, List<&2, V.CapturedEntry>>, List<&2, String>, ready_capture_observed_paths, Some{[]}, Some{rows}, projected)
    case X.Captured{+key, +source, +bytes} <> +tail:
