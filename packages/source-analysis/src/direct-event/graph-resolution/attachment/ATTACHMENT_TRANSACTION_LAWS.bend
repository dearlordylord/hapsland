def ready_registered_budget_result(+registration: Compose.RegisteredPending, +frame: T.ResolverFrame, +references: List<&2, Local.ReferenceSlot>, plan: Local.Plan) -> Type:
  match plan:
    case Local.Plan{+root, +nodes, +slots, +items, +visited, +budget}:
      {V.actual_budget(S.frame_budget(Attach.attached_frame(Compose.attachment_registered(registration,
        Compose.remap(Local.Plan{root, nodes, slots, items, visited, budget}, List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), S.frame_nodes(frame), references), frame)))
        == V.actual_budget(budget) : V.Budget}

def ready_registered_budget(+registration: Compose.RegisteredPending, +frame: T.ResolverFrame, +references: List<&2, Local.ReferenceSlot>, +plan: Local.Plan) -> ready_registered_budget_result(registration, frame, references, plan):
  match registration frame plan:
    case Compose.RegisteredPending{_, _, _} T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
        Local.Plan{_, _, _, _, _, _}: {==}

def ready_attached_catalog(+attachment: Compose.Attachment, +frame: T.ResolverFrame) -> {S.frame_artifacts(Attach.attached_frame(attachment, frame)) == S.frame_artifacts(frame) : List<&2, T.ArtifactEntry>}:
