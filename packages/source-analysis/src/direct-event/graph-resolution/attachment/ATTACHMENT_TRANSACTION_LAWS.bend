def ready_encoded_joined(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +phase: Phase.Phase, +history: V.History, +previous: Nat, +owner: Nat, +id: Nat, +bytes: Nat, +world: E.WorldState<World>, +child_history: Phase.ChildHistory, +original_ready: {ActualReady.project(actual, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +original_reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}, shared: ready_original_shared_result(actual, reference, child, history, child_history, phase, previous), evidence: ready_joined_measurement_result(actual, reference, child, history, phase, previous)) -> Contract.conclusion(World, actual, reference, child, phase, history, previous, T.Reply{owner, id, T.ProductEncoded{bytes}}, world):
  match evidence:
    case (+measured, (+request, (+product, (+staged, (awaited, (encoded, (stage, (selected, (projected, reference_projected))))))))):
      ready_encoded_decision(World, actual, reference, child, phase, history, previous, owner, id, bytes, world, measured, request, product, staged,
        awaited, encoded, stage, selected, projected, reference_projected,
        child_history, original_ready, original_reference_ready, coherent,
        Boundary.check(request, T.Reply{owner, id, T.ProductEncoded{bytes}}), {==}, shared)

def ready_encoded_shared(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +phase: Phase.Phase, +history: V.History, +previous: Nat, +owner: Nat, +id: Nat, +bytes: Nat, +world: E.WorldState<World>, +child_history: Phase.ChildHistory, +original_ready: {ActualReady.project(actual, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +original_reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}, shared: ready_original_shared_result(actual, reference, child, history, child_history, phase, previous)) -> Contract.conclusion(World, actual, reference, child, phase, history, previous, T.Reply{owner, id, T.ProductEncoded{bytes}}, world):
  match phase history child_history:
    case Phase.Phase{V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _},
      Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{Some{_}, _}, _, _, _, _, _, _}, _}
      V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _}
      Phase.ChildHistory{F.Created{_, _, _}, _, _, _, _}:
      match shared:
        case (+original_frame, child_witness):
          match child_witness:
            case (+original_child, edge_witness):
              match original_child:
                case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}:
                  match edge_witness:
                    case (+original_edge, original_evidence):
                      match original_edge:
                        case Local.Pending{_, _, _, _, _, _, _, _}:
                          match original_evidence:
                            case (+frame_present, (+child_present, (+edge_present, parent_witness))):
                              match parent_witness:
                                case (+attachment, (+forest, (+attached, (+replaced, (+shared_product, (+materialized, (+request_equal, (shared_measurement, reference_observations)))))))):
                                  match shared_measurement:
                                    case (+shared_measured, (+shared_request, (+shared_awaited, (+shared_encoded, (+shared_stage, +shared_projected))))):
                                      match reference_observations:
                                        case (+reference_requested, +reference_staged):
                                          ready_encoded_joined(World, actual, reference, child, phase, history, previous, owner, id, bytes, world, child_history, original_ready, original_reference_ready, coherent,
                                            Tuple{original_frame, Tuple{original_child, Tuple{original_edge, Tuple{frame_present, Tuple{child_present, Tuple{edge_present, Tuple{attachment, Tuple{forest, Tuple{attached, Tuple{replaced, Tuple{shared_product, Tuple{materialized, Tuple{request_equal, Tuple{Tuple{shared_measured, Tuple{shared_request, Tuple{shared_awaited, Tuple{shared_encoded, Tuple{shared_stage, shared_projected}}}}}, Tuple{reference_requested, reference_staged}}}}}}}}}}}}}}},
                                            ready_original_joined_witness(actual, reference, child, history, child_history, phase, previous, original_ready,
                                              Tuple{original_frame, Tuple{original_child, Tuple{original_edge, Tuple{frame_present, Tuple{child_present, Tuple{edge_present, Tuple{attachment, Tuple{forest, Tuple{attached, Tuple{replaced, Tuple{shared_product, Tuple{materialized, Tuple{request_equal, Tuple{Tuple{shared_measured, Tuple{shared_request, Tuple{shared_awaited, Tuple{shared_encoded, Tuple{shared_stage, shared_projected}}}}}, Tuple{reference_requested, reference_staged}}}}}}}}}}}}}}}))
    case Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, F.Forest{None{}, _}, _, _, _, _, _, _}, _} _ _:
      match shared:
        case (+original_frame, (+original_child, (+original_edge, (frame_present, (child_present, (edge_present, parent_witness)))))):
          Empty.absurd(Contract.conclusion(World, actual, reference, child, phase, history, previous, T.Reply{owner, id, T.ProductEncoded{bytes}}, world), parent_witness)

def ready_attachment_transaction_exact(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +phase: Phase.Phase, +history: V.History, +child_history: Phase.ChildHistory, +previous: Nat, +reply: T.Reply, +world: E.WorldState<World>, ready: {ActualReady.project(actual, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> Contract.conclusion(World, actual, reference, child, phase, history, previous, reply, world):
  match reply:
    case T.Reply{_, _, T.GoConfigurationRead{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.AnalysisConfigurationIdentityRead{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.ClockStarted{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.ClockRead{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.DirnameResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.BasenameResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.PathSeparatorResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.JoinedResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.NormalizedResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.RelativeResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.ExtensionResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.AbsoluteResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.JoinedPathFactsResult{_, _, _, _, _}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.StatusResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.MembershipResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.DirectoryEntriesObserved{_, _}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.DirectoryEntriesUnavailable{}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.ContextSelectionResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.PythonSyntaxResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.IdentifierCharactersResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.AccessResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.InvocationCacheCreated{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.CacheResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.CacheSnapshot{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.CacheStored{}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.RootCacheInserted{}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.CaptureResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.FrontendResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.CargoResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.CapturedText{_, _}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.GoCharactersResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.GoBuildTextResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.JsonProductHashed{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.GoFileResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.RustModulesResult{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{_, _, T.DiagnosticObserved{}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{+owner, +id, T.ProductEncoded{+bytes}}:
      ready_encoded_shared(World, actual, reference, child, phase, history, previous, owner, id, bytes, world, child_history, ready, reference_ready, coherent,
        ready_original_shared(actual, reference, child, history, child_history, phase, previous, ready, reference_ready, coherent))
    case T.Reply{_, _, T.SourceTextEncoded{_}}:
      ready_original_incompatible(World, actual, reference, child, phase, history, child_history, previous, reply, world, product => {==}, ready, reference_ready, coherent)
    case T.Reply{+owner, +id, T.ProviderRejected{+exception}}:
      ready_original_provider(World, actual, reference, child, phase, history, child_history, previous, owner, id, exception, world, ready, reference_ready, coherent)

# DRAFT: one complete attachment transaction, not a provider/scheduler law.
# Successful ready projections are internal relational premises to be derived
# from whole entry execution. External resolver inputs are not restricted here.
# No successful materialization, selected query or accepted reply is assumed.
# The existential conclusion requires real Some observations on both sides.
# Reply includes arbitrary correlation, variant, bytes and exception ownership.
# World already contains provider effects; this pure law neither creates those
# effects nor erases scheduler cancellation stutters between pure transitions.
law attachment_transaction_exact:
  for ~World: Data
  for +actual: T.ResolverState
  for +reference: D.State
  for +child: X.Child
  for +phase: Phase.Phase
  for +history: V.History
  for +child_history: Phase.ChildHistory
  for +previous: Nat
  for +reply: T.Reply
  for +world: E.WorldState<World>
  for actual_ready: {
    ActualReady.project(actual, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>
  }
  for reference_ready: {
    ReferenceReady.project(reference, child, history, child_history)
    == Some{phase}
    : Maybe<&2, Phase.Phase>
  }
  # Actual Attach.built_allowed installs plan_budget before measurement;
  # reference X.guarded/retain_budget establishes the same retained budget.
  # This exact internal coherence is derived at entry, never imposed on raw
  # ResolverInput or replaced with a partial Boolean map comparison.
  for budget_coherent: {
    Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget
  }
  Contract.conclusion(World, actual, reference, child, phase, history, previous, reply, world)

def main() -> Unit:
  Unit{}
