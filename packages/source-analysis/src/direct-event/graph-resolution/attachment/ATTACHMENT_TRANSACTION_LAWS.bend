def ready_capture_provenance_some_case(+same: Bool, +sources: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source, +query: String, test: {String.eq(query, path) == same : Bool}, present: {Maybe.is_some(&2, V.CaptureSource, V.capture_at(sources, query)) == True{} : Bool}) -> {Maybe.is_some(&2, V.CaptureSource, V.capture_at(History.store_capture(sources, path, source, catalog), query)) == True{} : Bool}:
  match same:
    case True{}:
      %Equal.sym(String, query, path, StringFacts.eq_of_eq_true(query, path, test)):
        {Maybe.is_some(&2, V.CaptureSource, V.capture_at(History.store_capture(sources, path, source, catalog), _)) == True{} : Bool}
      Equal.cong(Maybe<&2, V.CaptureSource>, Bool, value => Maybe.is_some(&2, V.CaptureSource, value), V.capture_at(History.store_capture(sources, path, source, catalog), path), Some{V.CaptureSource{path, source, catalog}}, ready_capture_provenance_at(sources, path, source, catalog))
    case False{}:
      Equal.trans(Bool, Maybe.is_some(&2, V.CaptureSource, V.capture_at(History.store_capture(sources, path, source, catalog), query)), Maybe.is_some(&2, V.CaptureSource, V.capture_at(sources, query)), True{},
        Equal.cong(Maybe<&2, V.CaptureSource>, Bool, value => Maybe.is_some(&2, V.CaptureSource, value), V.capture_at(History.store_capture(sources, path, source, catalog), query), V.capture_at(sources, query), ready_capture_provenance_other(sources, path, source, catalog, query, test)), present)

def ready_reference_capture_entry_some(+path: String, +source: T.SourceFacts, +bytes: Nat, +provenance: Maybe<&2, V.CaptureSource>, present: {Maybe.is_some(&2, V.CaptureSource, provenance) == True{} : Bool}) -> {Maybe.is_some(&2, V.CapturedEntry, ReferenceFrame.captured_entry(path, source, bytes, provenance)) == True{} : Bool}:
  match provenance:
