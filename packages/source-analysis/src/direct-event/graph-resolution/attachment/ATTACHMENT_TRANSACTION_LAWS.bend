# Reify the existing reference publication result, then prove it is exactly
# the frame returned by X.publish; no additional runtime state is introduced.
def ready_reference_published(+state: D.State, +child: X.Child, +next: Recursive.State) -> D.State:
  match state child next:
    case D.State{config, X.Frame{graph, command, forest, Signed.State{Recursive.State{_, _, address, old_pending}, signed}, pending, captured, identities, edge, episode, artifact, deps, fingerprint}, targets, ids, next_target, request, iterations, stage, python}
      X.Child{X.Attempt{target, _, kind, source, bytes, _, _, declaration, _, _}, _, _, _}
      Recursive.State{visited, budget, _, _}:
      D.State{config, X.Frame{graph, command, forest, Signed.State{Recursive.State{visited, budget, address, old_pending}, signed}, pending, X.publish_capture(kind, captured, source, bytes), X.store_identity(identities, target, X.identity(declaration)), edge, episode, artifact, deps, fingerprint}, targets, ids, next_target, request, iterations, stage, python}

def ready_reference_published_exact(+state: D.State, +child: X.Child, +next: Recursive.State) -> {X.publish(D.frame(state), child, next, Signed.local(X.frame_local(D.frame(state)))) == X.TransactionFinished{D.frame(ready_reference_published(state, child, next))} : X.Transaction}:
  match state child next:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{_, _, _, _}, _}, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}
      X.Child{X.Attempt{_, _, _, _, _, _, _, _, _, _}, _, _, _} Recursive.State{_, _, _, _}: {==}

def ready_reference_identity_rows(state: D.State) -> List<&2, V.TargetArtifact>:
  match state:
    case D.State{_, X.Frame{_, _, _, _, _, _, identities, _, _, _, _, _}, _, _, _, _, _, _, _}: ReferenceFrame.identities(identities)

def ready_reference_budget(state: D.State) -> V.Budget:
  match state:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{_, budget, _, _}, signed}, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}: V.budget(budget, signed)

def ready_reference_publication_rows(+state: D.State, +history: V.History, +child: X.Child, +next: Recursive.State, +targets_value: Maybe<&2, List<&2, V.TargetEntry>>, +captures_value: Maybe<&2, List<&2, V.CapturedEntry>>, +visited_value: Maybe<&2, List<&2, String>>, +view: V.Frame, +captures: List<&2, V.CapturedEntry>, +seen: List<&2, String>, ready: {ReferenceFrame.assembled(state, history, targets_value, captures_value, visited_value) == Some{view} : Maybe<&2, V.Frame>}, budget_equal: {ready_reference_budget(ready_reference_published(state, child, next)) == ready_reference_budget(state) : V.Budget}) -> {ReferenceFrame.assembled(ready_reference_published(state, child, next), history, targets_value, Some{captures}, Some{seen}) == Some{ready_publication_view(view, captures, ready_reference_identity_rows(ready_reference_published(state, child, next)), seen, ready_reference_remaining(D.frame(state)))} : Maybe<&2, V.Frame>}:
