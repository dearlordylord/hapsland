def visited_lookup_exact(+order: List<&2, String>, +actual: Map<&2, Bool>, +reference: Map<&2, Bool>, +observed: List<&2, String>, +query: String, actual_ready: {ActualFrame.visited(order, actual) == Some{observed} : Maybe<&2, List<&2, String>>}, reference_ready: {ReferenceFrame.visited(order, reference) == Some{observed} : Maybe<&2, List<&2, String>>}, unique: {ActualFrame.strings_unique(order, order) == True{} : Bool}, actual_size: {Nat.is_eq(List.length(&2, String, order), List.length(&2, String, Map.keys(&2, Bool, actual))) == True{} : Bool}) -> {Local.map_result(Bool, Map.get(Bool, False{}, actual, query)) == Local.map_result(Bool, Map.get(Bool, False{}, reference, query)) : Bool}:
  visited_lookup_selected(List.contains(String, String.eq, order, query), order, actual, reference, observed, query,
    {==}, actual_ready, reference_ready, unique, actual_size)

# Extract the existing coverage guard; no extra visited-map assumption is used.
def ready_visited_order(order: V.Order) -> List<&2, String>:
  match order:
    case V.Order{_, _, _, _, _, visited}: visited

def ready_visited_unique(+order: V.Order, valid: {ActualFrame.order_valid(order) == True{} : Bool}) -> {ActualFrame.strings_unique(ready_visited_order(order), ready_visited_order(order)) == True{} : Bool}:
  match order:
