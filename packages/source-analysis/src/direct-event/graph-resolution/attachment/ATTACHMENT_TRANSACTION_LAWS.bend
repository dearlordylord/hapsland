def ready_map_put_count(-Value: Data, +tree: Map<&2, Value>, +key: String, +value: Value, +valid: {Patricia.canonical(Value, tree) == True{} : Bool}, present: {Patricia.nonempty(Value, tree) == True{} : Bool}) -> {List.length(&2, String, Map.keys(&2, Value, Map.put(&2, Value, tree, key, value))) == List.length(&2, String, Map.keys(&2, Value, tree)) : Nat}:
