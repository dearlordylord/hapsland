def ready_reference_child_budget_rows(+child: X.Child, +history: Phase.ChildHistory, +visited: Maybe<&2, List<&2, String>>, +view: Phase.Child, ready: {ReferenceReady.child_view(child, history, visited) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_reference_child_budget(child) == ready_child_view_budget(view) : V.Budget}:
