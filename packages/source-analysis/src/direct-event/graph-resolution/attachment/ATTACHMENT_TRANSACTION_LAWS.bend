def ready_history_captures(history: V.History) -> List<&2, V.CaptureSource>:
  match history:
    case V.History{_, _, _, captures, _, _, _}: captures


def ready_file_publication_coverage(+frame: T.ResolverFrame, +history: V.History, +target: Nat, +path: String, +file: T.CapturedFacts, +identity: String, +plan: Local.Plan, +source: T.SourceFacts, +catalog: RootSpec.Source, +child_order: List<&2, String>, +visited: List<&2, String>, +remaining: Nat, +capture_rows: List<&2, V.CapturedEntry>, +identity_rows: List<&2, V.TargetArtifact>, +canonical: {ActualReady.mutable_maps_canonical(frame) == True{} : Bool}, +coverage: {ActualFrame.coverage(ready_history_order(history), frame) == True{} : Bool}, captures: {ActualFrame.captured(ready_capture_order(ready_history_order(history)), S.frame_captured(frame), ready_history_captures(history)) == Some{capture_rows} : Maybe<&2, List<&2, V.CapturedEntry>>}, identities: {ActualFrame.identities(ready_identity_order(ready_history_order(history)), S.frame_target_artifacts(frame)) == Some{identity_rows} : Maybe<&2, List<&2, V.TargetArtifact>>}, complete: {ActualReady.visited_complete(child_order, Admission.plan_visited(plan)) == Some{visited} : Maybe<&2, List<&2, String>>}) -> {ActualFrame.coverage(ready_history_order(History.published(history, X.FileChild{path}, target, path, source, catalog, visited, remaining)), Admission.publish_child(False{}, frame, target, path, file, identity, plan)) == True{} : Bool}:
  match frame history plan:
    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
      V.History{_, V.Order{+pending, +targets, +ids, +captured, +old_identities, _}, _, _, _, _, _} Local.Plan{_, _, _, _, +next_visited, _}:
      +order: V.Order = ready_history_order(history)
      +visited_order: V.Order = ready_visited_replaced_order(order, visited)
      +visited_frame: T.ResolverFrame = S.with_frame_visited(frame, next_visited)
      +visited_guard: {Bool.and(ActualFrame.strings_unique(visited, visited), Nat.is_eq(List.length(&2, String, visited), List.length(&2, String, Map.keys(&2, Bool, next_visited)))) == True{} : Bool} = ready_visited_complete_guard(child_order, next_visited, visited, complete)
      visited_coverage: {ActualFrame.coverage(visited_order, visited_frame) == True{} : Bool} =
        ready_visited_replaced_coverage(order, frame, visited, next_visited, coverage,
          BoolFacts.eq_true_of_and_left(ActualFrame.strings_unique(visited, visited), Nat.is_eq(List.length(&2, String, visited), List.length(&2, String, Map.keys(&2, Bool, next_visited))), visited_guard),
          BoolFacts.eq_true_of_and_right(ActualFrame.strings_unique(visited, visited), Nat.is_eq(List.length(&2, String, visited), List.length(&2, String, Map.keys(&2, Bool, next_visited))), visited_guard))
      +captured_order: V.Order = ready_capture_replaced_order(visited_order, History.retain_string(captured, path))
      +captured_frame: T.ResolverFrame = S.with_frame_captured(visited_frame, Map.set(&2, Maybe<&2, T.CapturedFacts>, S.frame_captured(frame), path, Some{file}))
      captured_coverage: {ActualFrame.coverage(captured_order, captured_frame) == True{} : Bool} =
        ready_capture_replaced_coverage(visited_order, visited_frame, History.retain_string(captured, path), Map.set(&2, Maybe<&2, T.CapturedFacts>, S.frame_captured(frame), path, Some{file}), visited_coverage,
          ready_string_retain_unique(captured, path, ready_capture_unique_order(order, ready_coverage_order(order, frame, coverage))),
