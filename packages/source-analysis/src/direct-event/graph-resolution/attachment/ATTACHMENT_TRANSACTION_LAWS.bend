    case Some{+entry} Some{+retained}:
      ready_reference_capture_prefix_some(ReferenceFrame.captured_entry(key, old, bytes, V.capture_at(History.store_capture(sources, path, source, catalog), key)), ReferenceFrame.captured(tail, History.store_capture(sources, path, source, catalog)),
        ready_reference_capture_entry_some(key, old, bytes, V.capture_at(History.store_capture(sources, path, source, catalog), key),
