      ready_reference_capture_prefix_some(ReferenceFrame.captured_entry(path, source, bytes, V.capture_at(History.store_capture(sources, path, source, catalog), path)), ReferenceFrame.captured(tail, History.store_capture(sources, path, source, catalog)),
