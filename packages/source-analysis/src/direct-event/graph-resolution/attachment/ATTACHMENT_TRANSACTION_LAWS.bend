    case None{}: Empty.absurd({Maybe.is_some(&2, V.CapturedEntry, ReferenceFrame.captured_entry(path, source, bytes, provenance)) == True{} : Bool}, NatFacts.internal_false_ne_true(present))

def ready_reference_capture_prefix_some(+head: Maybe<&2, V.CapturedEntry>, +tail: Maybe<&2, List<&2, V.CapturedEntry>>, first: {Maybe.is_some(&2, V.CapturedEntry, head) == True{} : Bool}, rest: {Maybe.is_some(&2, List<&2, V.CapturedEntry>, tail) == True{} : Bool}) -> {Maybe.is_some(&2, List<&2, V.CapturedEntry>, ReferenceFrame.prefix(V.CapturedEntry, head, tail)) == True{} : Bool}:
