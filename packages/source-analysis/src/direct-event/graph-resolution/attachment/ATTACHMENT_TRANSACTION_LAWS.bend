        recurse(retained, {==}))
    case None{} _: Empty.absurd({Maybe.is_some(&2, List<&2, V.CapturedEntry>, ReferenceFrame.captured(X.Captured{key, old, bytes} <> tail, History.store_capture(sources, path, source, catalog))) == True{} : Bool}, Contents.none_some(List<&2, V.CapturedEntry>, rows, projected))
    case Some{V.CaptureSource{_, _, _}} None{}: Empty.absurd({Maybe.is_some(&2, List<&2, V.CapturedEntry>, ReferenceFrame.captured(X.Captured{key, old, bytes} <> tail, History.store_capture(sources, path, source, catalog))) == True{} : Bool}, Contents.none_some(List<&2, V.CapturedEntry>, rows, projected))

def ready_reference_capture_retained_total(+items: List<&2, X.Captured>, +sources: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source, +rows: List<&2, V.CapturedEntry>, projected: {ReferenceFrame.captured(items, sources) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}) -> {Maybe.is_some(&2, List<&2, V.CapturedEntry>, ReferenceFrame.captured(items, History.store_capture(sources, path, source, catalog))) == True{} : Bool}:
  match items:
    case []: {==}
    case X.Captured{+key, +old, +bytes} <> +tail:
