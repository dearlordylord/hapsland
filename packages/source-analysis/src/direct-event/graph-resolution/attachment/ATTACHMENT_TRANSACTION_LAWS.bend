def ready_bundled_publication_coverage(+frame: T.ResolverFrame, +history: V.History, +target: Nat, +path: String, +file: T.CapturedFacts, +identity: String, +plan: Local.Plan, +source: T.SourceFacts, +catalog: RootSpec.Source, +child_order: List<&2, String>, +visited: List<&2, String>, +remaining: Nat, +capture_rows: List<&2, V.CapturedEntry>, +identity_rows: List<&2, V.TargetArtifact>, +canonical: {ActualReady.mutable_maps_canonical(frame) == True{} : Bool}, +coverage: {ActualFrame.coverage(ready_history_order(history), frame) == True{} : Bool}, captures: {ActualFrame.captured(ready_capture_order(ready_history_order(history)), S.frame_captured(frame), ready_history_captures(history)) == Some{capture_rows} : Maybe<&2, List<&2, V.CapturedEntry>>}, identities: {ActualFrame.identities(ready_identity_order(ready_history_order(history)), S.frame_target_artifacts(frame)) == Some{identity_rows} : Maybe<&2, List<&2, V.TargetArtifact>>}, complete: {ActualReady.visited_complete(child_order, Admission.plan_visited(plan)) == Some{visited} : Maybe<&2, List<&2, String>>}) -> {ActualFrame.coverage(ready_history_order(History.published(history, X.BundledChild{}, target, path, source, catalog, visited, remaining)), Admission.publish_child(True{}, frame, target, path, file, identity, plan)) == True{} : Bool}:
