        ReferenceFrame.captured(tail, sources), rows, projected,
        retained => witness => ready_capture_reference_paths_exact(tail, sources, retained, witness))

def ready_capture_paths_exact(+order: List<&2, String>, +items: List<&2, X.Captured>, +entries: Map<&2, Maybe<&2, T.CapturedFacts>>, +sources: List<&2, V.CaptureSource>, +rows: List<&2, V.CapturedEntry>, actual: {ActualFrame.captured(order, entries, sources) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}, reference: {ReferenceFrame.captured(items, sources) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}) -> {order == ready_capture_reference_paths(items) : List<&2, String>}:
