def ready_capture_present_step(+head: String, +tail: List<&2, String>, +tree: Map<&2, Maybe<&2, T.CapturedFacts>>, +query: String, +raw: Maybe<&2, T.CapturedFacts>, +provenance: Maybe<&2, V.CaptureSource>, +rest: Maybe<&2, List<&2, V.CapturedEntry>>, +rows: List<&2, V.CapturedEntry>, lookup: {Local.map_result(Maybe<&2, T.CapturedFacts>, Map.get(Maybe<&2, T.CapturedFacts>, None{}, tree, head)) == raw : Maybe<&2, T.CapturedFacts>}, projected: {ActualFrame.captured_prefix(ActualFrame.captured_entry(head, raw, provenance), rest) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}, present: {List.contains(String, String.eq, head <> tail, query) == True{} : Bool}, recurse: @retained: List<&2, V.CapturedEntry> -> {rest == Some{retained} : Maybe<&2, List<&2, V.CapturedEntry>>} -> {List.contains(String, String.eq, tail, query) == True{} : Bool} -> {Insert.leaf_exists(Maybe<&2, T.CapturedFacts>, tree, query) == True{} : Bool}) -> {Insert.leaf_exists(Maybe<&2, T.CapturedFacts>, tree, query) == True{} : Bool}:
