def ready_reference_publication_actual(+frame: T.ResolverFrame, +plan: Local.Plan, +child: X.Child) -> T.ResolverFrame:
  match child:
    case X.Child{+attempt, _, _, _}:
      match attempt:
        case X.Attempt{target, _, +kind, +source, bytes, _, _, declaration, catalog, _}:
          match kind:
            case X.FileChild{_}: Admission.publish_child(False{}, frame, target, X.attempt_path(attempt), T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceReady.file_exports(kind, source), bytes}, X.identity(declaration), plan)
            case X.BundledChild{}: Admission.publish_child(True{}, frame, target, X.attempt_path(attempt), T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceReady.file_exports(kind, source), bytes}, X.identity(declaration), plan)

def ready_reference_publication_value(+frame: T.ResolverFrame, +plan: Local.Plan, +child: X.Child, +history: Phase.ChildHistory, +visited: List<&2, String>) -> {Some{ready_reference_publication_actual(frame, plan, child)} == Maybe.map(&2, Phase.Child, T.ResolverFrame, view => ready_phase_publication(frame, plan, view), ReferenceReady.child_view(child, history, Some{visited})) : Maybe<&2, T.ResolverFrame>}:
  match child history:
    case X.Child{X.Attempt{_, _, X.FileChild{_}, _, _, _, _, Local.Declaration{_, _, _, _, _, _}, _, _}, F.Created{_, _, _}, Signed.State{Recursive.State{_, _, _, _}, _}, _}
      Phase.ChildHistory{_, _, _, _, _}: {==}
    case X.Child{X.Attempt{_, _, X.BundledChild{}, _, _, _, _, Local.Declaration{_, _, _, _, _, _}, _, _}, F.Created{_, _, _}, Signed.State{Recursive.State{_, _, _, _}, _}, _}
      Phase.ChildHistory{_, _, _, _, _}: {==}

def ready_reference_child_publication_rows(+frame: T.ResolverFrame, +plan: Local.Plan, +child: X.Child, +history: Phase.ChildHistory, +visited: Maybe<&2, List<&2, String>>, +view: Phase.Child, ready: {ReferenceReady.child_view(child, history, visited) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_reference_publication_actual(frame, plan, child) == ready_phase_publication(frame, plan, view) : T.ResolverFrame}:
  match child history visited:
    case _ _ Some{+seen}:
      Count.some_equal(T.ResolverFrame, ready_reference_publication_actual(frame, plan, child), ready_phase_publication(frame, plan, view),
        Equal.trans(Maybe<&2, T.ResolverFrame>, Some{ready_reference_publication_actual(frame, plan, child)}, Maybe.map(&2, Phase.Child, T.ResolverFrame, value => ready_phase_publication(frame, plan, value), ReferenceReady.child_view(child, history, Some{seen})), Some{ready_phase_publication(frame, plan, view)},
          ready_reference_publication_value(frame, plan, child, history, seen),
          Equal.cong(Maybe<&2, Phase.Child>, Maybe<&2, T.ResolverFrame>, value => Maybe.map(&2, Phase.Child, T.ResolverFrame, item => ready_phase_publication(frame, plan, item), value), ReferenceReady.child_view(child, history, Some{seen}), Some{view}, ready)))
    case X.Child{X.Attempt{_, _, _, _, _, _, _, Local.Declaration{_, _, _, _, _, _}, _, _}, F.Created{_, _, _}, Signed.State{Recursive.State{_, _, _, _}, _}, _} Phase.ChildHistory{_, _, _, _, _} None{}:
      Empty.absurd({ready_reference_publication_actual(frame, plan, child) == ready_phase_publication(frame, plan, view) : T.ResolverFrame}, Contents.none_some(Phase.Child, view, ready))

def ready_reference_child_publication(+frame: T.ResolverFrame, +plan: Local.Plan, +child: X.Child, +history: Phase.ChildHistory, +view: Phase.Child, ready: {ReferenceReady.child_project(child, history) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_reference_publication_actual(frame, plan, child) == ready_phase_publication(frame, plan, view) : T.ResolverFrame}:
  match child history:
    case X.Child{_, _, Signed.State{Recursive.State{+values, _, _, _}, _}, _} Phase.ChildHistory{_, _, _, _, +order}:
      ready_reference_child_publication_rows(frame, plan, child, history, ReferenceFrame.visited(order, values), view, ready)

def ready_common_child_publication(+frame: T.ResolverFrame, +actual: T.TentativeChild, +edge: Local.Pending, +reference: X.Child, +history: Phase.ChildHistory, +artifacts: List<&2, T.ArtifactEntry>, +episode: Nat, +view: Phase.Child, actual_ready: {ActualReady.child_project(actual, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}, reference_ready: {ReferenceReady.child_project(reference, history) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_tentative_publication(frame, actual, edge) == ready_reference_publication_actual(frame, ready_actual_child_plan(actual), reference) : T.ResolverFrame}:
  Equal.trans(T.ResolverFrame, ready_tentative_publication(frame, actual, edge), ready_phase_publication(frame, ready_actual_child_plan(actual), view), ready_reference_publication_actual(frame, ready_actual_child_plan(actual), reference),
    ready_actual_child_publication(frame, actual, edge, history, artifacts, episode, view, actual_ready),
    Equal.sym(T.ResolverFrame, ready_reference_publication_actual(frame, ready_actual_child_plan(actual), reference), ready_phase_publication(frame, ready_actual_child_plan(actual), view), ready_reference_child_publication(frame, ready_actual_child_plan(actual), reference, history, view, reference_ready)))

def ready_selected_common_publication(+state: T.ResolverState, +frame: T.ResolverFrame, +actual: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, selected: selected_phase_result(state, frame, actual, edge, history, child_history, phase), ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {ready_tentative_publication(frame, actual, edge) == ready_reference_publication_actual(frame, ready_actual_child_plan(actual), child) : T.ResolverFrame}:
  match history phase:
    case V.History{_, _, _, _, _, _, +episode} Phase.Phase{+frame_view, +view, +capsule}:
      match selected:
        case (_, (_, (actual_child, _))):
          ready_common_child_publication(frame, actual, edge, child, child_history, S.frame_artifacts(frame), episode, view, actual_child,
            Pair.fst({ReferenceReady.child_project(child, child_history) == Some{view} : Maybe<&2, Phase.Child>}, {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>},
              Pair.snd({ReferenceFrame.project(reference, history) == Some{frame_view} : Maybe<&2, V.Frame>}, {ReferenceReady.child_project(child, child_history) == Some{view} : Maybe<&2, Phase.Child>} & {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}, reference_ready_contents(reference, child, history, child_history, phase, ready))))

def ready_publication_input_witness(+state: T.ResolverState, +reference_child: X.Child) -> Type:
  Exists(T.ResolverFrame, frame => Exists(T.TentativeChild, child => Exists(Local.Pending, edge =>
    {S.state_frame(state) == Some{frame} : Maybe<&2, T.ResolverFrame>} &
    {S.scratch_tentative(S.state_scratch(state)) == Some{child} : Maybe<&2, T.TentativeChild>} &
    {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>} &
    {ready_tentative_publication(frame, child, edge) == ready_reference_publication_actual(frame, ready_actual_child_plan(child), reference_child) : T.ResolverFrame})))

def ready_original_common_publication(+state: T.ResolverState, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +actual_ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> ready_publication_input_witness(state, child):
  ready_actual_inputs(ready_publication_input_witness(state, child), state, history, child_history, phase, actual_ready,
    frame => actual_child => edge => frame_present => child_present => edge_present => selected =>
    +frame = frame
    +actual_child = actual_child
    +edge = edge
    Tuple{frame, Tuple{actual_child, Tuple{edge, Tuple{frame_present, Tuple{child_present, Tuple{edge_present,
      ready_selected_common_publication(state, frame, actual_child, edge, reference, child, history, child_history, phase, selected, reference_ready)}}}}}})

def ready_reference_publication_pair(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, +child: X.Child, +plan: Local.Plan, +child_order: List<&2, String>, +seen: List<&2, String>, canonical: {ActualReady.mutable_maps_canonical(actual) == True{} : Bool}, actual_ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, complete: {ActualReady.visited_complete(child_order, Admission.plan_visited(plan)) == Some{seen} : Maybe<&2, List<&2, String>>}, budget_equal: {ready_reference_budget(ready_reference_published(reference, child, ready_reference_child_local(child))) == ready_reference_budget(reference) : V.Budget}, visited: {ReferenceFrame.visited(seen, ready_reference_visited(ready_reference_published(reference, child, ready_reference_child_local(child)))) == Some{seen} : Maybe<&2, List<&2, String>>}) -> Exists(V.Frame, published => {ActualFrame.project(ready_reference_publication_actual(actual, plan, child), ready_reference_publication_history(history, child, seen, ready_reference_remaining(D.frame(reference)))) == Some{published} : Maybe<&2, V.Frame>} & {ReferenceFrame.project(ready_reference_published(reference, child, ready_reference_child_local(child)), ready_reference_publication_history(history, child, seen, ready_reference_remaining(D.frame(reference)))) == Some{published} : Maybe<&2, V.Frame>}):
  match child:
    case X.Child{X.Attempt{target, X.Edge{+edge_id, F.Pending{+edge_owner, Local.Pending{+p0, +p1, +p2, +p3, +p4, +p5, +p6, +p7}}, +edge_path, +edge_target}, X.FileChild{path}, source, bytes, name, expected, declaration, catalog, before}, created, Signed.State{+local, +signed}, pending}:
      ready_file_publication_pair(actual, reference, history, view, target, X.Edge{edge_id, F.Pending{edge_owner, Local.Pending{p0, p1, p2, p3, p4, p5, p6, p7}}, edge_path, edge_target}, path, source, bytes, name, expected, declaration, catalog, before, created, Signed.State{local, signed}, pending, plan, child_order, seen, canonical, actual_ready, reference_ready, complete, budget_equal, visited)
    case X.Child{X.Attempt{+target, X.Edge{+edge_id, F.Pending{+edge_owner, Local.Pending{+p0, +p1, +p2, +p3, +p4, +p5, +p6, +p7}}, +edge_path, +edge_target}, X.BundledChild{}, +source, +bytes, +name, +expected, +declaration, +catalog, +before}, created, Signed.State{+local, +signed}, pending}:
      ready_bundled_publication_pair(actual, reference, history, view, target, X.Edge{edge_id, F.Pending{edge_owner, Local.Pending{p0, p1, p2, p3, p4, p5, p6, p7}}, edge_path, edge_target}, X.attempt_path(X.Attempt{target, X.Edge{edge_id, F.Pending{edge_owner, Local.Pending{p0, p1, p2, p3, p4, p5, p6, p7}}, edge_path, edge_target}, X.BundledChild{}, source, bytes, name, expected, declaration, catalog, before}), source, bytes, name, expected, declaration, catalog, before, created, Signed.State{local, signed}, pending, plan, child_order, seen, canonical, actual_ready, reference_ready, complete, budget_equal, visited)

def ready_child_history_order(history: Phase.ChildHistory) -> List<&2, String>:
  match history:
    case Phase.ChildHistory{_, _, _, _, order}: order

def ready_actual_child_seen_contents(+forest: Maybe<&2, F.Forest>, +pending: Maybe<&2, List<&2, V.PendingPayload>>, +visited: Maybe<&2, List<&2, String>>, +view: Phase.Child, evidence: child_content_result(forest, pending, visited, view)) -> {visited == Some{ready_child_visited(view)} : Maybe<&2, List<&2, String>>}:
  match view:
    case Phase.Child{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}:
      match evidence:
        case (_, (_, complete)): complete

def ready_actual_child_seen_project(+child: T.TentativeChild, +edge: Local.Pending, +history: Phase.ChildHistory, +artifacts: List<&2, T.ArtifactEntry>, +episode: Nat, +view: Phase.Child, ready: {ActualReady.child_project(child, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}) -> {ActualReady.visited_complete(ready_child_history_order(history), Admission.plan_visited(ready_actual_child_plan(child))) == Some{ready_child_visited(view)} : Maybe<&2, List<&2, String>>}:
  match child history:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{+root, +nodes, +slots, +edges, +visited, _}, _, _, _}
      Phase.ChildHistory{F.Created{_, _, +addresses}, _, _, _, +order}:
      ready_actual_child_seen_contents(ActualReady.valid_forest(P.project(root, nodes, slots, artifacts, addresses), episode), ActualReady.pending(edges, addresses), ActualReady.visited_complete(order, visited), view,
        child_view_contents(ActualReady.valid_forest(P.project(root, nodes, slots, artifacts, addresses), episode), ActualReady.pending(edges, addresses), ActualReady.visited_complete(order, visited), child, edge, history, view,
          Pair.snd({child_checks(child) == True{} : Bool}, {ActualReady.child_projected(child, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}, actual_child_contents(child, edge, history, artifacts, episode, view, ready))))

def ready_common_published_result(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +child: X.Child, +plan: Local.Plan, +seen: List<&2, String>) -> Type:
  Exists(V.Frame, published =>
    {ActualFrame.project(ready_reference_publication_actual(actual, plan, child), ready_reference_publication_history(history, child, seen, ready_reference_remaining(D.frame(reference)))) == Some{published} : Maybe<&2, V.Frame>} &
    {ReferenceFrame.project(ready_reference_published(reference, child, ready_reference_child_local(child)), ready_reference_publication_history(history, child, seen, ready_reference_remaining(D.frame(reference)))) == Some{published} : Maybe<&2, V.Frame>})

def ready_selected_publication_pair(+state: T.ResolverState, +actual: T.ResolverFrame, +tentative: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, selected: selected_phase_result(state, actual, tentative, edge, history, child_history, phase), +reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> ready_common_published_result(actual, reference, history, child, ready_actual_child_plan(tentative), ready_child_visited(ready_phase_child(phase))):
  match history phase:
    case V.History{_, _, _, _, _, +remaining, +episode} Phase.Phase{+frame_view, +child_view, +capsule}:
      match selected:
        case (valid, (frame_ready, (child_ready, _))):
          ready_reference_publication_pair(actual, reference, history, frame_view, child, ready_actual_child_plan(tentative), ready_child_history_order(child_history), ready_child_visited(child_view),
            BoolFacts.eq_true_of_and_left(ActualReady.mutable_maps_canonical(actual), Bool.and(ActualReady.fresh_registration(history, actual), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(actual)))), valid),
            frame_ready,
            Pair.fst({ReferenceFrame.project(reference, history) == Some{frame_view} : Maybe<&2, V.Frame>}, {ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>} & {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}, reference_ready_contents(reference, child, history, child_history, phase, reference_ready)),
            ready_actual_child_seen_project(tentative, edge, child_history, S.frame_artifacts(actual), episode, child_view, child_ready),
            ready_original_reference_publication_budget(reference, child, history, child_history, phase, reference_ready, coherent),
            ready_original_reference_published_visited(reference, child, history, child_history, phase, reference_ready))

def ready_actual_publication_pair_result(+actual: T.ResolverFrame, +tentative: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +history: V.History, +child: X.Child, +seen: List<&2, String>) -> Type:
  Exists(V.Frame, published =>
    {ActualFrame.project(ready_tentative_publication(actual, tentative, edge), ready_reference_publication_history(history, child, seen, ready_reference_remaining(D.frame(reference)))) == Some{published} : Maybe<&2, V.Frame>} &
    {ReferenceFrame.project(ready_reference_published(reference, child, ready_reference_child_local(child)), ready_reference_publication_history(history, child, seen, ready_reference_remaining(D.frame(reference)))) == Some{published} : Maybe<&2, V.Frame>})

def ready_selected_actual_publication_pair(+state: T.ResolverState, +actual: T.ResolverFrame, +tentative: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +actual_ready: {ActualReady.parts(state, Some{actual}, Some{tentative}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> ready_actual_publication_pair_result(actual, tentative, edge, reference, history, child, ready_child_visited(ready_phase_child(phase))):
  %Equal.sym(T.ResolverFrame, ready_tentative_publication(actual, tentative, edge), ready_reference_publication_actual(actual, ready_actual_child_plan(tentative), child),
    ready_selected_common_publication(state, actual, tentative, edge, reference, child, history, child_history, phase,
      selected_phase_contents(state, actual, tentative, edge, history, child_history, phase, actual_ready), reference_ready)):
    Exists(V.Frame, published =>
      {ActualFrame.project(_, ready_reference_publication_history(history, child, ready_child_visited(ready_phase_child(phase)), ready_reference_remaining(D.frame(reference)))) == Some{published} : Maybe<&2, V.Frame>} &
      {ReferenceFrame.project(ready_reference_published(reference, child, ready_reference_child_local(child)), ready_reference_publication_history(history, child, ready_child_visited(ready_phase_child(phase)), ready_reference_remaining(D.frame(reference)))) == Some{published} : Maybe<&2, V.Frame>})
  ready_selected_publication_pair(state, actual, tentative, edge, reference, child, history, child_history, phase,
    selected_phase_contents(state, actual, tentative, edge, history, child_history, phase, actual_ready), reference_ready, coherent)

def ready_original_publication_result(+state: T.ResolverState, +reference: D.State, +reference_child: X.Child, +history: V.History, +phase: Phase.Phase) -> Type:
  Exists(T.ResolverFrame, frame => Exists(T.TentativeChild, child => Exists(Local.Pending, edge =>
    {S.state_frame(state) == Some{frame} : Maybe<&2, T.ResolverFrame>} &
    {S.scratch_tentative(S.state_scratch(state)) == Some{child} : Maybe<&2, T.TentativeChild>} &
    {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>} &
    ready_actual_publication_pair_result(frame, child, edge, reference, history, reference_child, ready_child_visited(ready_phase_child(phase))))))

def ready_original_publication(+state: T.ResolverState, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +actual_ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> ready_original_publication_result(state, reference, child, history, phase):
  ready_actual_inputs(ready_original_publication_result(state, reference, child, history, phase), state, history, child_history, phase, actual_ready,
    frame => tentative => edge => frame_present => child_present => edge_present => selected =>
    +frame = frame
    +tentative = tentative
    +edge = edge
    +frame_present = frame_present
    +child_present = child_present
    +edge_present = edge_present
    Tuple{frame, Tuple{tentative, Tuple{edge, Tuple{frame_present, Tuple{child_present, Tuple{edge_present,
      ready_selected_actual_publication_pair(state, frame, tentative, edge, reference, child, history, child_history, phase,
        ready_actual_parts_installed(state, history, child_history, phase, frame, tentative, edge, frame_present, child_present, edge_present, actual_ready), reference_ready, coherent)}}}}}})

def ready_actual_publication_transition(+frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +step: G.Step) -> {ready_tentative_publication(PreparedRoot.frame_transition(frame, step), child, edge) == PreparedRoot.frame_transition(ready_tentative_publication(frame, child, edge), step) : T.ResolverFrame}:
  match frame child edge step:
    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
      T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Local.Pending{_, _, _, _, _, _, _, Local.Imported{_, _}} G.Step{_, _}: {==}
    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
      T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Local.Pending{_, _, _, _, _, _, _, Local.BundledTarget{_}} G.Step{_, _}: {==}

def ready_reference_publication_transition(+state: D.State, +child: X.Child, +next: Recursive.State, +step: G.BoundedStep) -> {ready_reference_published(D.with_frame(state, X.event_result(D.frame(state), step)), child, next) == D.with_frame(ready_reference_published(state, child, next), X.event_result(D.frame(ready_reference_published(state, child, next)), step)) : D.State}:
  match state child next step:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{_, _, _, _}, _}, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}
      X.Child{X.Attempt{_, _, _, _, _, _, _, _, _, _}, _, _, _} Recursive.State{_, _, _, _} G.BoundedStep{_, _}: {==}

def ready_actual_publication_captured(+frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +event: G.GraphEvent) -> {ready_tentative_publication(S.advance(frame, event), child, edge) == S.advance(ready_tentative_publication(frame, child, edge), event) : T.ResolverFrame}:
  match frame child edge:
    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
      T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Local.Pending{_, _, _, _, _, _, _, Local.Imported{_, _}}:
      ready_actual_publication_transition(frame, child, edge, G.step(S.frame_graph(frame), event))
    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
      T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Local.Pending{_, _, _, _, _, _, _, Local.BundledTarget{_}}:
      ready_actual_publication_transition(frame, child, edge, G.step(S.frame_graph(frame), event))

def ready_reference_publication_captured(+state: D.State, +child: X.Child, +next: Recursive.State, +event: G.GraphEvent) -> {ready_reference_published(D.with_frame(state, X.event(D.frame(state), event)), child, next) == D.with_frame(ready_reference_published(state, child, next), X.event(D.frame(ready_reference_published(state, child, next)), event)) : D.State}:
  match state child next:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{_, _, _, _}, _}, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}
      X.Child{X.Attempt{_, _, _, _, _, _, _, _, _, _}, _, _, _} Recursive.State{_, _, _, _}:
      ready_reference_publication_transition(state, child, next, GraphReference.bounded_transition(X.frame_graph(D.frame(state)), event))

def ready_publication_captured_views(+actual: T.ResolverFrame, +tentative: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +next: Recursive.State, +history: V.History, +view: V.Frame, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>, actual_ready: {ActualFrame.project(ready_tentative_publication(actual, tentative, edge), history) == Some{view} : Maybe<&2, V.Frame>}, reference_ready: {ReferenceFrame.project(ready_reference_published(reference, child, next), history) == Some{view} : Maybe<&2, V.Frame>}, positive: ready_history_positive(history)) -> {ActualFrame.project(ready_tentative_publication(S.advance(actual, G.Captured{source, contribution, work, ids}), tentative, edge), History.allowance(history, Nat.sub(ready_history_remaining(history), 1n))) == Some{ready_graph_view(view, G.step(S.frame_graph(ready_tentative_publication(actual, tentative, edge)), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n))} : Maybe<&2, V.Frame>} & {ReferenceFrame.project(ready_reference_published(D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), child, next), History.allowance(history, Nat.sub(ready_history_remaining(history), 1n))) == Some{ready_graph_view(view, G.step(S.frame_graph(ready_tentative_publication(actual, tentative, edge)), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n))} : Maybe<&2, V.Frame>}:
  %Equal.sym(T.ResolverFrame, ready_tentative_publication(S.advance(actual, G.Captured{source, contribution, work, ids}), tentative, edge), S.advance(ready_tentative_publication(actual, tentative, edge), G.Captured{source, contribution, work, ids}), ready_actual_publication_captured(actual, tentative, edge, G.Captured{source, contribution, work, ids})):
    {ActualFrame.project(_, History.allowance(history, Nat.sub(ready_history_remaining(history), 1n))) == Some{ready_graph_view(view, G.step(S.frame_graph(ready_tentative_publication(actual, tentative, edge)), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n))} : Maybe<&2, V.Frame>} &
    {ReferenceFrame.project(ready_reference_published(D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), child, next), History.allowance(history, Nat.sub(ready_history_remaining(history), 1n))) == Some{ready_graph_view(view, G.step(S.frame_graph(ready_tentative_publication(actual, tentative, edge)), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n))} : Maybe<&2, V.Frame>}
  %Equal.sym(D.State, ready_reference_published(D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), child, next), D.with_frame(ready_reference_published(reference, child, next), X.event(D.frame(ready_reference_published(reference, child, next)), G.Captured{source, contribution, work, ids})), ready_reference_publication_captured(reference, child, next, G.Captured{source, contribution, work, ids})):
    {ActualFrame.project(S.advance(ready_tentative_publication(actual, tentative, edge), G.Captured{source, contribution, work, ids}), History.allowance(history, Nat.sub(ready_history_remaining(history), 1n))) == Some{ready_graph_view(view, G.step(S.frame_graph(ready_tentative_publication(actual, tentative, edge)), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n))} : Maybe<&2, V.Frame>} &
    {ReferenceFrame.project(_, History.allowance(history, Nat.sub(ready_history_remaining(history), 1n))) == Some{ready_graph_view(view, G.step(S.frame_graph(ready_tentative_publication(actual, tentative, edge)), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n))} : Maybe<&2, V.Frame>}
  ready_captured_frames(ready_tentative_publication(actual, tentative, edge), ready_reference_published(reference, child, next), history, view, source, contribution, work, ids, actual_ready, reference_ready, positive)

def ready_publication_allowance(+history: V.History, +child: X.Child, +seen: List<&2, String>, +before: Nat, +after: Nat) -> {History.allowance(ready_reference_publication_history(history, child, seen, before), after) == ready_reference_publication_history(history, child, seen, after) : V.History}:
  match history child:
    case V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _}
      X.Child{X.Attempt{_, _, X.FileChild{_}, _, _, _, _, _, _, _}, _, _, _}: {==}
    case V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _}
      X.Child{X.Attempt{_, _, X.BundledChild{}, _, _, _, _, _, _, _}, _, _, _}: {==}

def ready_publication_remaining(+history: V.History, +child: X.Child, +seen: List<&2, String>, +remaining: Nat) -> {ready_history_remaining(ready_reference_publication_history(history, child, seen, remaining)) == remaining : Nat}:
  match history child:
    case V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _}
      X.Child{X.Attempt{_, _, X.FileChild{_}, _, _, _, _, _, _, _}, _, _, _}: {==}
    case V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _}
      X.Child{X.Attempt{_, _, X.BundledChild{}, _, _, _, _, _, _, _}, _, _, _}: {==}

def ready_selected_reference_allowance(+state: T.ResolverState, +frame: T.ResolverFrame, +tentative: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, selected: selected_phase_result(state, frame, tentative, edge, history, child_history, phase), reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {Nat.is_gt(ready_reference_remaining(D.frame(reference)), 0n) == True{} : Bool}:
  match history phase:
    case V.History{_, _, _, _, _, +remaining, _} Phase.Phase{+view, +child_view, +capsule}:
      match selected:
        case (valid, (frame_ready, _)):
          Equal.trans(Bool, Nat.is_gt(ready_reference_remaining(D.frame(reference)), 0n), Nat.is_gt(remaining, 0n), True{},
            Equal.cong(Nat, Bool, value => Nat.is_gt(value, 0n), ready_reference_remaining(D.frame(reference)), remaining,
              Pair.snd({ReferenceFrame.graph(D.frame(reference)) == S.frame_graph(frame) : G.Graph}, {ready_reference_remaining(D.frame(reference)) == remaining : Nat}, ready_captured_coordinates(frame, reference, history, view, frame_ready,
                Pair.fst({ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, {ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>} & {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}, reference_ready_contents(reference, child, history, child_history, phase, reference_ready))))),
            BoolFacts.eq_true_of_and_left(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame)),
              BoolFacts.eq_true_of_and_right(ActualReady.fresh_registration(history, frame), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame))),
                BoolFacts.eq_true_of_and_right(ActualReady.mutable_maps_canonical(frame), Bool.and(ActualReady.fresh_registration(history, frame), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame)))), valid))))

def ready_original_reference_allowance(+state: T.ResolverState, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +actual_ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {Nat.is_gt(ready_reference_remaining(D.frame(reference)), 0n) == True{} : Bool}:
  ready_actual_inputs({Nat.is_gt(ready_reference_remaining(D.frame(reference)), 0n) == True{} : Bool}, state, history, child_history, phase, actual_ready,
    frame => tentative => edge => frame_present => child_present => edge_present => selected =>
      ready_selected_reference_allowance(state, frame, tentative, edge, reference, child, history, child_history, phase, selected, reference_ready))

def ready_publication_positive(+history: V.History, +child: X.Child, +seen: List<&2, String>, +remaining: Nat, positive: {Nat.is_gt(remaining, 0n) == True{} : Bool}) -> ready_history_positive(ready_reference_publication_history(history, child, seen, remaining)):
  match history child:
    case V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _}
      X.Child{X.Attempt{_, _, X.FileChild{_}, _, _, _, _, _, _, _}, _, _, _}: positive
    case V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _}
      X.Child{X.Attempt{_, _, X.BundledChild{}, _, _, _, _, _, _, _}, _, _, _}: positive

def ready_selected_captured_publication_result(+actual: T.ResolverFrame, +tentative: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +phase: Phase.Phase, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>) -> Type:
  Exists(V.Frame, view => {ActualFrame.project(ready_tentative_publication(S.advance(actual, G.Captured{source, contribution, work, ids}), tentative, edge), History.allowance(ready_reference_publication_history(history, child, ready_child_visited(ready_phase_child(phase)), ready_reference_remaining(D.frame(reference))), Nat.sub(ready_history_remaining(ready_reference_publication_history(history, child, ready_child_visited(ready_phase_child(phase)), ready_reference_remaining(D.frame(reference)))), 1n))) == Some{view} : Maybe<&2, V.Frame>} & {ReferenceFrame.project(ready_reference_published(D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), child, ready_reference_child_local(child)), History.allowance(ready_reference_publication_history(history, child, ready_child_visited(ready_phase_child(phase)), ready_reference_remaining(D.frame(reference))), Nat.sub(ready_history_remaining(ready_reference_publication_history(history, child, ready_child_visited(ready_phase_child(phase)), ready_reference_remaining(D.frame(reference)))), 1n))) == Some{view} : Maybe<&2, V.Frame>})

def ready_captured_publication_pair(+actual: T.ResolverFrame, +tentative: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +phase: Phase.Phase, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>, positive: ready_history_positive(ready_reference_publication_history(history, child, ready_child_visited(ready_phase_child(phase)), ready_reference_remaining(D.frame(reference)))), evidence: ready_actual_publication_pair_result(actual, tentative, edge, reference, history, child, ready_child_visited(ready_phase_child(phase)))) -> ready_selected_captured_publication_result(actual, tentative, edge, reference, child, history, phase, source, contribution, work, ids):
  match evidence:
    case (+view, (actual_published, reference_published)):
      Tuple{ready_graph_view(view, G.step(S.frame_graph(ready_tentative_publication(actual, tentative, edge)), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(ready_reference_publication_history(history, child, ready_child_visited(ready_phase_child(phase)), ready_reference_remaining(D.frame(reference)))), 1n)), ready_publication_captured_views(actual, tentative, edge, reference, child, ready_reference_child_local(child), ready_reference_publication_history(history, child, ready_child_visited(ready_phase_child(phase)), ready_reference_remaining(D.frame(reference))), view, source, contribution, work, ids, actual_published, reference_published, positive)}

def ready_selected_captured_publication(+state: T.ResolverState, +actual: T.ResolverFrame, +tentative: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>, +actual_ready: {ActualReady.parts(state, Some{actual}, Some{tentative}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, +reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> ready_selected_captured_publication_result(actual, tentative, edge, reference, child, history, phase, source, contribution, work, ids):
  ready_captured_publication_pair(actual, tentative, edge, reference, child, history, phase, source, contribution, work, ids,
    ready_publication_positive(history, child, ready_child_visited(ready_phase_child(phase)), ready_reference_remaining(D.frame(reference)),
      ready_selected_reference_allowance(state, actual, tentative, edge, reference, child, history, child_history, phase,
        selected_phase_contents(state, actual, tentative, edge, history, child_history, phase, actual_ready), reference_ready)),
    ready_selected_actual_publication_pair(state, actual, tentative, edge, reference, child, history, child_history, phase, actual_ready, reference_ready, coherent))

def ready_iteration_boundary(view: V.Frame, capsule: Phase.Capsule) -> B.Boundary:
  match capsule:
    case Phase.Capsule{_, _, _, _, _, _, _, 0n, _, _, _}: B.Finished{None{}, view}
    case Phase.Capsule{+invocation, path, language, context, +clock, cache, +next, 1n++remaining, target, edge, fingerprint}:
      B.Selected{T.Request{invocation, next, T.ReadClock{clock}}, view,
        B.CheckingIteration{Phase.Capsule{invocation, path, language, context, clock, cache, (next + 1n : Nat), remaining, target, edge, fingerprint}}}

def ready_reference_iteration_state(state: D.State, remaining: Nat) -> D.State:
  match state:
    case D.State{config, frame, targets, ids, target, next, _, _, python}:
      D.State{config, frame, targets, ids, target, next, remaining, D.AwaitDeadline{}, python}

def ready_reference_iteration_assembled(+state: D.State, +history: V.History, +remaining: Nat, +targets: Maybe<&2, List<&2, V.TargetEntry>>, +captured: Maybe<&2, List<&2, V.CapturedEntry>>, +visited: Maybe<&2, List<&2, String>>) -> {ReferenceFrame.assembled(ready_reference_iteration_state(state, remaining), history, targets, captured, visited) == ReferenceFrame.assembled(state, history, targets, captured, visited) : Maybe<&2, V.Frame>}:
  match state history targets captured visited:
    case D.State{D.Config{_, _, _, _, _, _}, X.Frame{G.Bounded{_, _}, _, _, Signed.State{Recursive.State{_, _, _, _}, _}, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}
      V.History{_, _, _, _, _, _, _} Some{_} Some{_} Some{_}: {==}
    case D.State{_, _, _, _, _, _, _, _, _} _ None{} _ _: {==}
    case D.State{_, _, _, _, _, _, _, _, _} _ Some{_} None{} _: {==}
    case D.State{_, _, _, _, _, _, _, _, _} _ Some{_} Some{_} None{}: {==}

def ready_reference_iteration_project(+state: D.State, +history: V.History, +remaining: Nat) -> {ReferenceFrame.project(ready_reference_iteration_state(state, remaining), history) == ReferenceFrame.project(state, history) : Maybe<&2, V.Frame>}:
  match state history:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{values, _, _, _}, _}, _, captures, _, _, _, _, _, _}, targets, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, seen}, _, sources, _, _, _}:
      ready_reference_iteration_assembled(state, history, remaining, ReferenceFrame.targets(targets), ReferenceFrame.captured(captures, sources), ReferenceFrame.visited(seen, values))

def ready_reference_iteration_boundary(-World: Data, +state: D.State, +child: X.Child, +history: V.History, +view: V.Frame, +world: E.WorldState<World>, ready: {ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>}) -> {ReferenceBoundaryView.project(World, D.consumed(World, D.iteration(state), world), child, history) == Some{ready_iteration_boundary(view, ReferenceReady.capsule(state, child))} : Maybe<&2, B.Boundary>}:
  match state child:
    case D.State{D.Config{_, _, _, _, _, _}, X.Frame{_, _, _, _, _, _, _, _, _, _, _, _}, _, _, _, _, 0n, _, _}
      X.Child{X.Attempt{_, _, _, _, _, _, _, _, _, _}, _, _, _}:
      Equal.cong(Maybe<&2, V.Frame>, Maybe<&2, B.Boundary>, value => ReferenceBoundaryView.finished(None{}, value), ReferenceFrame.project(state, history), Some{view}, ready)
    case D.State{D.Config{+invocation, _, _, _, +clock, _}, X.Frame{_, _, _, _, _, _, _, _, _, _, _, _}, _, _, _, +next, 1n+++remaining, _, _}
      X.Child{X.Attempt{_, _, _, _, _, _, _, _, _, _}, _, _, _}:
      Equal.cong(Maybe<&2, V.Frame>, Maybe<&2, B.Boundary>, value => ReferenceBoundaryView.selected(Some{T.Request{invocation, next, T.ReadClock{clock}}}, value, B.CheckingIteration{ReferenceBoundaryView.allocated(ReferenceReady.capsule(ready_reference_iteration_state(state, remaining), child))}),
        ReferenceFrame.project(ready_reference_iteration_state(state, remaining), history), Some{view},
        Equal.trans(Maybe<&2, V.Frame>, ReferenceFrame.project(ready_reference_iteration_state(state, remaining), history), ReferenceFrame.project(state, history), Some{view}, ready_reference_iteration_project(state, history, remaining), ready))

def ready_actual_iteration_parts(+state: T.ResolverState, +history: V.History, +clock: Maybe<&2, T.ClockToken>, +language: Maybe<&2, T.Language>, +active: Maybe<&2, Nat>, +edge: Maybe<&2, V.PendingPayload>) -> Maybe<&2, B.Boundary>:
  match state:
    case T.ResolverState{_, _, _, _, 0n, _, _, _, _, _, _, _, _}:
      ActualBoundary.finished(None{}, ActualBoundary.frame(S.state_frame(state), history))
    case T.ResolverState{T.ResolverInput{invocation, _, _, _, _, _, _, _, _}, _, _, +next, 1n++remaining, _, _, _, _, _, _, _, _}:
      match clock:
        case None{}: Some{B.Failed{T.MalformedReply{}}}
        case Some{+value}:
          ActualBoundary.selected(T.Request{invocation, next, T.ReadClock{value}},
            ActualBoundary.frame(S.state_frame(state), history),
            ActualBoundary.iteration(ActualReady.capsule(clock, language, active, edge,
              S.with_state_next_request(S.with_state_stage(S.with_state_iteration_fuel(state, remaining), T.CheckingIterationDeadline{}), (next + 1n : Nat)))))

def ready_actual_iteration_parts_exact(+state: T.ResolverState, +history: V.History) -> {ActualBoundary.project(LoopPolicy.start(state), history) == ready_actual_iteration_parts(state, history, S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), ActualBoundary.ready_edge(S.scratch_pending_edge(S.state_scratch(state)), ready_history_addresses(history))) : Maybe<&2, B.Boundary>}:
  match state history:
    case T.ResolverState{_, _, _, _, 0n, _, _, _, _, _, _, _, _} V.History{_, _, _, _, _, _, _}: {==}
    case T.ResolverState{T.ResolverInput{_, _, _, _, _, _, _, _, _}, _, None{}, _, 1n++_, _, _, _, _, _, _, _, _} V.History{_, _, _, _, _, _, _}: {==}
    case T.ResolverState{T.ResolverInput{_, _, _, _, _, _, _, _, _}, _, Some{_}, _, 1n++_, _, _, _, _, _, _, _, _} V.History{_, _, _, _, _, _, _}: {==}

def ready_iteration_observed(frame: Maybe<&2, V.Frame>, capsule: Phase.Capsule) -> Maybe<&2, B.Boundary>:
  match capsule:
    case Phase.Capsule{_, _, _, _, _, _, _, 0n, _, _, _}: ActualBoundary.finished(None{}, frame)
    case Phase.Capsule{+invocation, path, language, context, +clock, cache, +next, 1n++remaining, target, edge, fingerprint}:
      ActualBoundary.selected(T.Request{invocation, next, T.ReadClock{clock}}, frame,
        Some{B.CheckingIteration{Phase.Capsule{invocation, path, language, context, clock, cache, (next + 1n : Nat), remaining, target, edge, fingerprint}}})

def ready_actual_iteration_capsule(+clock: Maybe<&2, T.ClockToken>, +language: Maybe<&2, T.Language>, +active: Maybe<&2, Nat>, +edge: Maybe<&2, V.PendingPayload>, +state: T.ResolverState, +history: V.History, +capsule: Phase.Capsule, ready: {ActualReady.capsule(clock, language, active, edge, state) == Some{capsule} : Maybe<&2, Phase.Capsule>}) -> {ready_actual_iteration_parts(state, history, clock, language, active, edge) == ready_iteration_observed(ActualBoundary.frame(S.state_frame(state), history), capsule) : Maybe<&2, B.Boundary>}:
  match clock language active edge state:
    case Some{clock_value} Some{+language_value} Some{active_value} Some{edge_value}
      T.ResolverState{T.ResolverInput{+invocation, path, _, _, _, _, branch, cache, _}, _, _, +next, 0n, _, _, rust, _, _, _, _, _}:
      %Count.some_equal(Phase.Capsule,
        Phase.Capsule{invocation, path, language_value, ActualReady.context(language_value, branch, rust), clock_value, cache, next, 0n, active_value, edge_value, ActualReady.fingerprint(S.state_prepared(state))}, capsule, ready):
        {ready_actual_iteration_parts(state, history, clock, language, active, edge) == ready_iteration_observed(ActualBoundary.frame(S.state_frame(state), history), _) : Maybe<&2, B.Boundary>}
      {==}
    case Some{clock_value} Some{+language_value} Some{active_value} Some{edge_value}
      T.ResolverState{T.ResolverInput{+invocation, path, _, _, _, _, branch, cache, _}, _, _, +next, 1n+++remaining, _, _, rust, _, _, _, _, _}:
      %Count.some_equal(Phase.Capsule,
        Phase.Capsule{invocation, path, language_value, ActualReady.context(language_value, branch, rust), clock_value, cache, next, S.state_iteration_fuel(state), active_value, edge_value, ActualReady.fingerprint(S.state_prepared(state))}, capsule, ready):
        {ready_actual_iteration_parts(state, history, clock, language, active, edge) == ready_iteration_observed(ActualBoundary.frame(S.state_frame(state), history), _) : Maybe<&2, B.Boundary>}
      {==}
    case None{} _ _ _ _:
      Empty.absurd({ready_actual_iteration_parts(state, history, clock, language, active, edge) == ready_iteration_observed(ActualBoundary.frame(S.state_frame(state), history), capsule) : Maybe<&2, B.Boundary>}, Contents.none_some(Phase.Capsule, capsule, ready))
    case Some{_} None{} _ _ _:
      Empty.absurd({ready_actual_iteration_parts(state, history, clock, language, active, edge) == ready_iteration_observed(ActualBoundary.frame(S.state_frame(state), history), capsule) : Maybe<&2, B.Boundary>}, Contents.none_some(Phase.Capsule, capsule, ready))
    case Some{_} Some{_} None{} _ _:
      Empty.absurd({ready_actual_iteration_parts(state, history, clock, language, active, edge) == ready_iteration_observed(ActualBoundary.frame(S.state_frame(state), history), capsule) : Maybe<&2, B.Boundary>}, Contents.none_some(Phase.Capsule, capsule, ready))
    case Some{_} Some{_} Some{_} None{} _:
      Empty.absurd({ready_actual_iteration_parts(state, history, clock, language, active, edge) == ready_iteration_observed(ActualBoundary.frame(S.state_frame(state), history), capsule) : Maybe<&2, B.Boundary>}, Contents.none_some(Phase.Capsule, capsule, ready))

def ready_iteration_observed_some(+view: V.Frame, +capsule: Phase.Capsule) -> {ready_iteration_observed(Some{view}, capsule) == Some{ready_iteration_boundary(view, capsule)} : Maybe<&2, B.Boundary>}:
  match capsule:
    case Phase.Capsule{_, _, _, _, _, _, _, 0n, _, _, _}: {==}
    case Phase.Capsule{_, _, _, _, _, _, _, 1n++_, _, _, _}: {==}

def ready_actual_iteration_boundary(+state: T.ResolverState, +history: V.History, +view: V.Frame, +capsule: Phase.Capsule, frame: {ActualBoundary.frame(S.state_frame(state), history) == Some{view} : Maybe<&2, V.Frame>}, ready: {ActualBoundary.capsule(state, history) == Some{capsule} : Maybe<&2, Phase.Capsule>}) -> {ActualBoundary.project(LoopPolicy.start(state), history) == Some{ready_iteration_boundary(view, capsule)} : Maybe<&2, B.Boundary>}:
  match history:
    case V.History{+addresses, _, _, _, _, _, _}:
      Equal.trans(Maybe<&2, B.Boundary>, ActualBoundary.project(LoopPolicy.start(state), history),
        ready_actual_iteration_parts(state, history, S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), ActualBoundary.ready_edge(S.scratch_pending_edge(S.state_scratch(state)), addresses)),
        Some{ready_iteration_boundary(view, capsule)}, ready_actual_iteration_parts_exact(state, history),
        Equal.trans(Maybe<&2, B.Boundary>,
          ready_actual_iteration_parts(state, history, S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), ActualBoundary.ready_edge(S.scratch_pending_edge(S.state_scratch(state)), addresses)),
          ready_iteration_observed(ActualBoundary.frame(S.state_frame(state), history), capsule),
          Some{ready_iteration_boundary(view, capsule)},
          ready_actual_iteration_capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), ActualBoundary.ready_edge(S.scratch_pending_edge(S.state_scratch(state)), addresses), state, history, capsule, ready),
          Equal.trans(Maybe<&2, B.Boundary>, ready_iteration_observed(ActualBoundary.frame(S.state_frame(state), history), capsule), ready_iteration_observed(Some{view}, capsule), Some{ready_iteration_boundary(view, capsule)},
            Equal.cong(Maybe<&2, V.Frame>, Maybe<&2, B.Boundary>, value => ready_iteration_observed(value, capsule), ActualBoundary.frame(S.state_frame(state), history), Some{view}, frame),
            ready_iteration_observed_some(view, capsule))))

def ready_common_iteration_boundary(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +history: V.History, +view: V.Frame, +world: E.WorldState<World>, actual_frame: {ActualBoundary.frame(S.state_frame(actual), history) == Some{view} : Maybe<&2, V.Frame>}, reference_frame: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, capsule: {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(reference, child)} : Maybe<&2, Phase.Capsule>}) -> {ActualBoundary.project(LoopPolicy.start(actual), history) == Some{ready_iteration_boundary(view, ReferenceReady.capsule(reference, child))} : Maybe<&2, B.Boundary>} & {ReferenceBoundaryView.project(World, D.consumed(World, D.iteration(reference), world), child, history) == Some{ready_iteration_boundary(view, ReferenceReady.capsule(reference, child))} : Maybe<&2, B.Boundary>}:
  Tuple{ready_actual_iteration_boundary(actual, history, view, ReferenceReady.capsule(reference, child), actual_frame, capsule),
    ready_reference_iteration_boundary(World, reference, child, history, view, world, reference_frame)}

def ready_omission_node_guard(+address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +tail: List<&2, F.Node>, +all: List<&2, F.Node>, +valid: {Relation.nodes_valid(F.Node{address, artifact, references} <> tail, all) == True{} : Bool}) -> NatFacts.le(Relation.incoming(all, address), F.count_address(all, address)):
  +rest: {Bool.and(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(tail, all))) == True{} : Bool} =
    BoolFacts.eq_true_of_and_right(Nat.is_eq(F.count_address(all, address), 1n), Bool.and(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(tail, all))), valid)
  count: {F.count_address(all, address) == 1n : Nat} = NatFacts.eq_of_is_eq(F.count_address(all, address), 1n,
    BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(all, address), 1n), Bool.and(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(tail, all))), valid))
  %Equal.sym(Nat, F.count_address(all, address), 1n, count): NatFacts.le(Relation.incoming(all, address), _)
  BoolFacts.eq_true_of_and_left(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(tail, all)), rest)

def ready_omission_member_branch(+address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +tail: List<&2, F.Node>, +all: List<&2, F.Node>, +query: O.NodeAddress, +remainder: Nat, +valid: {Relation.nodes_valid(F.Node{address, artifact, references} <> tail, all) == True{} : Bool}, present: {F.count_address(F.Node{address, artifact, references} <> tail, query) == 1n+remainder : Nat}, recursive: {Relation.nodes_valid(tail, all) == True{} : Bool} -> {F.count_address(tail, query) == 1n+remainder : Nat} -> NatFacts.le(Relation.incoming(all, query), F.count_address(all, query)), same: Bool, equal: {F.same_address(query, address) == same : Bool}) -> NatFacts.le(Relation.incoming(all, query), F.count_address(all, query)):
  match same:
    case True{}:
      %Equal.sym(O.NodeAddress, query, address, Rollback.same_address_equal(query, address, equal)):
        NatFacts.le(Relation.incoming(all, _), F.count_address(all, _))
      ready_omission_node_guard(address, artifact, references, tail, all, valid)
    case False{}:
      recursive(Equal.sym(Bool, True{}, Relation.nodes_valid(tail, all), Rollback.nodes_tail(F.Node{address, artifact, references}, tail, all,
        Equal.sym(Bool, Relation.nodes_valid(F.Node{address, artifact, references} <> tail, all), True{}, valid))))(
        %equal: {(Bool.pick(Nat, _, 1n, 0n) + F.count_address(tail, query) : Nat) == 1n+remainder : Nat}
        present)

def ready_omission_member_guard(items: List<&2, F.Node>, +all: List<&2, F.Node>, +query: O.NodeAddress, +remainder: Nat, valid: {Relation.nodes_valid(items, all) == True{} : Bool}, present: {F.count_address(items, query) == 1n+remainder : Nat}) -> NatFacts.le(Relation.incoming(all, query), F.count_address(all, query)):
  match items:
    case []:
      Empty.absurd(NatFacts.le(Relation.incoming(all, query), F.count_address(all, query)),
        Arithmetic.succ_ne_zero(remainder)(Equal.sym(Nat, 0n, 1n+remainder, present)))
    case F.Node{+address, +artifact, +references} <> +tail:
      ready_omission_member_branch(address, artifact, references, tail, all, query, remainder, valid, present,
        tail_valid => tail_present => ready_omission_member_guard(tail, all, query, remainder, tail_valid, tail_present), F.same_address(query, address), {==})

def ready_omission_incoming_case(+nodes: List<&2, F.Node>, +query: O.NodeAddress, valid: {Relation.nodes_valid(nodes, nodes) == True{} : Bool}, count: Nat, +counted: {F.count_address(nodes, query) == count : Nat}) -> NatFacts.le(Relation.incoming(nodes, query), F.count_address(nodes, query)):
  match count:
    case 0n:
      %Equal.sym(Nat, F.count_address(nodes, query), 0n, counted): NatFacts.le(Relation.incoming(nodes, query), _)
      %Equal.sym(Nat, Relation.incoming(nodes, query), 0n,
        Rollback.valid_nodes_absent_incoming(nodes, nodes, query, Equal.sym(Bool, Relation.nodes_valid(nodes, nodes), True{}, valid), counted)):
        NatFacts.le(_, 0n)
      {==}
    case 1n+remaining: ready_omission_member_guard(nodes, nodes, query, remaining, valid, counted)

def ready_omission_bit_bound(same: Bool) -> NatFacts.le((Bool.pick(Nat, same, 1n, 0n) + 0n : Nat), 1n):
  match same:
    case True{}: {==}
    case False{}: {==}

def ready_omission_root_demand_case(+root: O.NodeAddress, +nodes: List<&2, F.Node>, +query: O.NodeAddress, +valid: {Relation.retained(F.Forest{Some{root}, nodes}) == True{} : Bool}, same: Bool, equal: {F.same_address(root, query) == same : Bool}) -> NatFacts.le((Bool.pick(Nat, F.same_address(root, query), 1n, 0n) + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query)):
  match same:
    case True{}:
      %Rollback.same_address_equal(root, query, equal):
        NatFacts.le((Bool.pick(Nat, F.same_address(root, _), 1n, 0n) + Relation.incoming(nodes, _) : Nat), F.count_address(nodes, _))
      +root_valid: {Bool.and(Nat.is_eq(F.count_address(nodes, root), 1n), Nat.is_eq(Relation.incoming(nodes, root), 0n)) == True{} : Bool} =
        BoolFacts.eq_true_of_and_left(Relation.root_valid(Some{root}, nodes), Relation.nodes_valid(nodes, nodes), valid)
      %Equal.sym(Nat, F.count_address(nodes, root), 1n, NatFacts.eq_of_is_eq(F.count_address(nodes, root), 1n,
        BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(nodes, root), 1n), Nat.is_eq(Relation.incoming(nodes, root), 0n), root_valid))):
        NatFacts.le((Bool.pick(Nat, F.same_address(root, root), 1n, 0n) + Relation.incoming(nodes, root) : Nat), _)
      %Equal.sym(Nat, Relation.incoming(nodes, root), 0n, NatFacts.eq_of_is_eq(Relation.incoming(nodes, root), 0n,
        BoolFacts.eq_true_of_and_right(Nat.is_eq(F.count_address(nodes, root), 1n), Nat.is_eq(Relation.incoming(nodes, root), 0n), root_valid))):
        NatFacts.le((Bool.pick(Nat, F.same_address(root, root), 1n, 0n) + _ : Nat), 1n)
      ready_omission_bit_bound(F.same_address(root, root))
    case False{}:
      %Equal.sym(Bool, F.same_address(root, query), False{}, equal):
        NatFacts.le((Bool.pick(Nat, _, 1n, 0n) + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query))
      ready_omission_incoming_case(nodes, query,
        BoolFacts.eq_true_of_and_right(Relation.root_valid(Some{root}, nodes), Relation.nodes_valid(nodes, nodes), valid), F.count_address(nodes, query), {==})

def ready_omission_forest_demand(+root: O.NodeAddress, +nodes: List<&2, F.Node>, +query: O.NodeAddress, +episode: Nat, valid: {Relation.frame_forest(F.Forest{Some{root}, nodes}, episode) == True{} : Bool}) -> NatFacts.le((Bool.pick(Nat, F.same_address(root, query), 1n, 0n) + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query)):
  ready_omission_root_demand_case(root, nodes, query,
    BoolFacts.eq_true_of_and_left(Relation.retained(F.Forest{Some{root}, nodes}), Relation.episodes_before(nodes, episode), valid), F.same_address(root, query), {==})

def ready_omission_weight_swap(+a: Nat, +b: Nat, +c: Nat) -> {(a + (b + c : Nat) : Nat) == (b + (a + c : Nat) : Nat) : Nat}:
  Equal.trans(Nat, (a + (b + c : Nat) : Nat), ((a + b : Nat) + c : Nat), (b + (a + c : Nat) : Nat),
    Equal.sym(Nat, ((a + b : Nat) + c : Nat), (a + (b + c : Nat) : Nat), Arithmetic.add_assoc(a, b, c)),
    Equal.trans(Nat, ((a + b : Nat) + c : Nat), ((b + a : Nat) + c : Nat), (b + (a + c : Nat) : Nat),
      Equal.cong(Nat, Nat, value => (value + c : Nat), (a + b : Nat), (b + a : Nat), Arithmetic.add_comm(a, b)), Arithmetic.add_assoc(b, a, c)))

def ready_omission_address_arithmetic(+references: Nat, +nodes: Nat, +rest: Nat) -> {(((2n + references : Nat) + nodes : Nat) + rest : Nat) == 1n+(nodes + ((1n + references : Nat) + rest : Nat) : Nat) : Nat}:
  %Equal.sym(Nat, (((2n + references : Nat) + nodes : Nat) + rest : Nat), ((2n + references : Nat) + (nodes + rest : Nat) : Nat), Arithmetic.add_assoc((2n + references : Nat), nodes, rest)):
    {_ == 1n+(nodes + ((1n + references : Nat) + rest : Nat) : Nat) : Nat}
  Equal.cong(Nat, Nat, value => 1n+value,
    ((1n + references : Nat) + (nodes + rest : Nat) : Nat), (nodes + ((1n + references : Nat) + rest : Nat) : Nat),
    ready_omission_weight_swap((1n + references : Nat), nodes, rest))

def ready_omission_work_weight(work: List<&2, D.OmissionWork>) -> Nat:
  match work:
    case []: 0n
    case D.OmissionAddress{_} <> tail: ready_omission_work_weight(tail)
    case D.OmissionReferences{references} <> tail:
      (1n + Allowance.references(references) + ready_omission_work_weight(tail) : Nat)

def ready_omission_node_weight(prefix: List<&2, F.Node>, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>) -> {Allowance.nodes(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix)) == ((2n + Allowance.references(references) : Nat) + Allowance.nodes(List.append(&2, F.Node, prefix, suffix)) : Nat) : Nat}:
  match prefix:
    case []: {==}
    case F.Node{_, _, +before} <> +tail:
      %Equal.sym(Nat, Allowance.nodes(List.append(&2, F.Node, tail, F.Node{address, artifact, references} <> suffix)),
        ((2n + Allowance.references(references) : Nat) + Allowance.nodes(List.append(&2, F.Node, tail, suffix)) : Nat), ready_omission_node_weight(tail, address, artifact, references, suffix)):
        {((2n + Allowance.references(before) : Nat) + _ : Nat) ==
          ((2n + Allowance.references(references) : Nat) + Allowance.nodes(List.append(&2, F.Node, prefix, suffix)) : Nat) : Nat}
      ready_omission_weight_swap((2n + Allowance.references(before) : Nat), (2n + Allowance.references(references) : Nat), Allowance.nodes(List.append(&2, F.Node, tail, suffix)))

def ready_omission_address_weight(+prefix: List<&2, F.Node>, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>, +rest: List<&2, D.OmissionWork>) -> {(Allowance.nodes(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix)) + ready_omission_work_weight(D.OmissionAddress{address} <> rest) : Nat) == 1n+(Allowance.nodes(List.append(&2, F.Node, prefix, suffix)) + ready_omission_work_weight(D.OmissionReferences{references} <> rest) : Nat) : Nat}:
  %Equal.sym(Nat, Allowance.nodes(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix)),
    ((2n + Allowance.references(references) : Nat) + Allowance.nodes(List.append(&2, F.Node, prefix, suffix)) : Nat), ready_omission_node_weight(prefix, address, artifact, references, suffix)):
    {(_ + ready_omission_work_weight(rest) : Nat) == 1n+(Allowance.nodes(List.append(&2, F.Node, prefix, suffix)) + ready_omission_work_weight(D.OmissionReferences{references} <> rest) : Nat) : Nat}
  ready_omission_address_arithmetic(Allowance.references(references), Allowance.nodes(List.append(&2, F.Node, prefix, suffix)), ready_omission_work_weight(rest))

def ready_omission_work_demand(work: List<&2, D.OmissionWork>, +query: O.NodeAddress) -> Nat:
  match work:
    case []: 0n
    case D.OmissionAddress{address} <> tail:
      (Bool.pick(Nat, F.same_address(query, address), 1n, 0n) + ready_omission_work_demand(tail, query) : Nat)
    case D.OmissionReferences{references} <> tail:
      (Relation.incoming_references(references, query) + ready_omission_work_demand(tail, query) : Nat)

def ready_omission_remove_incoming(prefix: List<&2, F.Node>, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>, +query: O.NodeAddress) -> {Relation.incoming(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), query) == (Relation.incoming_references(references, query) + Relation.incoming(List.append(&2, F.Node, prefix, suffix), query) : Nat) : Nat}:
  match prefix:
    case []: {==}
    case F.Node{_, _, +before} <> +tail:
      %Equal.sym(Nat, Relation.incoming(List.append(&2, F.Node, tail, F.Node{address, artifact, references} <> suffix), query),
        (Relation.incoming_references(references, query) + Relation.incoming(List.append(&2, F.Node, tail, suffix), query) : Nat), ready_omission_remove_incoming(tail, address, artifact, references, suffix, query)):
        {(Relation.incoming_references(before, query) + _ : Nat) == (Relation.incoming_references(references, query) + Relation.incoming(List.append(&2, F.Node, prefix, suffix), query) : Nat) : Nat}
      ready_omission_weight_swap(Relation.incoming_references(before, query), Relation.incoming_references(references, query), Relation.incoming(List.append(&2, F.Node, tail, suffix), query))

def ready_omission_remove_count(prefix: List<&2, F.Node>, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>, +query: O.NodeAddress) -> {F.count_address(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), query) == (Bool.pick(Nat, F.same_address(query, address), 1n, 0n) + F.count_address(List.append(&2, F.Node, prefix, suffix), query) : Nat) : Nat}:
  match prefix:
    case []: {==}
    case F.Node{+before, _, _} <> +tail:
      %Equal.sym(Nat, F.count_address(List.append(&2, F.Node, tail, F.Node{address, artifact, references} <> suffix), query),
        (Bool.pick(Nat, F.same_address(query, address), 1n, 0n) + F.count_address(List.append(&2, F.Node, tail, suffix), query) : Nat), ready_omission_remove_count(tail, address, artifact, references, suffix, query)):
        {(Bool.pick(Nat, F.same_address(query, before), 1n, 0n) + _ : Nat) == (Bool.pick(Nat, F.same_address(query, address), 1n, 0n) + F.count_address(List.append(&2, F.Node, prefix, suffix), query) : Nat) : Nat}
      ready_omission_weight_swap(Bool.pick(Nat, F.same_address(query, before), 1n, 0n), Bool.pick(Nat, F.same_address(query, address), 1n, 0n), F.count_address(List.append(&2, F.Node, tail, suffix), query))

def ready_omission_demand_arithmetic(+bit: Nat, +work: Nat, +references: Nat, +nodes: Nat) -> {((bit + work : Nat) + (references + nodes : Nat) : Nat) == (bit + ((references + work : Nat) + nodes : Nat) : Nat) : Nat}:
  Equal.trans(Nat, ((bit + work : Nat) + (references + nodes : Nat) : Nat), (bit + (work + (references + nodes : Nat) : Nat) : Nat),
    (bit + ((references + work : Nat) + nodes : Nat) : Nat), Arithmetic.add_assoc(bit, work, (references + nodes : Nat)),
    Equal.cong(Nat, Nat, value => (bit + value : Nat), (work + (references + nodes : Nat) : Nat), ((references + work : Nat) + nodes : Nat),
      Equal.trans(Nat, (work + (references + nodes : Nat) : Nat), (references + (work + nodes : Nat) : Nat), ((references + work : Nat) + nodes : Nat),
        ready_omission_weight_swap(work, references, nodes), Equal.sym(Nat, ((references + work : Nat) + nodes : Nat), (references + (work + nodes : Nat) : Nat), Arithmetic.add_assoc(references, work, nodes)))))

def ready_omission_cancel_demand(same: Bool, +left: Nat, +right: Nat, bounded: NatFacts.le((Bool.pick(Nat, same, 1n, 0n) + left : Nat), (Bool.pick(Nat, same, 1n, 0n) + right : Nat))) -> NatFacts.le(left, right):
  match same:
    case False{}: bounded
    case True{}: bounded

def ready_omission_address_demand(+prefix: List<&2, F.Node>, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>, +rest: List<&2, D.OmissionWork>, +query: O.NodeAddress, available: NatFacts.le((ready_omission_work_demand(D.OmissionAddress{address} <> rest, query) + Relation.incoming(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), query) : Nat), F.count_address(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), query))) -> NatFacts.le((ready_omission_work_demand(D.OmissionReferences{references} <> rest, query) + Relation.incoming(List.append(&2, F.Node, prefix, suffix), query) : Nat), F.count_address(List.append(&2, F.Node, prefix, suffix), query)):
  ready_omission_cancel_demand(F.same_address(query, address),
    (ready_omission_work_demand(D.OmissionReferences{references} <> rest, query) + Relation.incoming(List.append(&2, F.Node, prefix, suffix), query) : Nat), F.count_address(List.append(&2, F.Node, prefix, suffix), query),
    %ready_omission_demand_arithmetic(Bool.pick(Nat, F.same_address(query, address), 1n, 0n), ready_omission_work_demand(rest, query), Relation.incoming_references(references, query), Relation.incoming(List.append(&2, F.Node, prefix, suffix), query)):
      NatFacts.le(_, (Bool.pick(Nat, F.same_address(query, address), 1n, 0n) + F.count_address(List.append(&2, F.Node, prefix, suffix), query) : Nat))
    %ready_omission_remove_incoming(prefix, address, artifact, references, suffix, query):
      NatFacts.le((ready_omission_work_demand(D.OmissionAddress{address} <> rest, query) + _ : Nat), (Bool.pick(Nat, F.same_address(query, address), 1n, 0n) + F.count_address(List.append(&2, F.Node, prefix, suffix), query) : Nat))
    %ready_omission_remove_count(prefix, address, artifact, references, suffix, query):
      NatFacts.le((ready_omission_work_demand(D.OmissionAddress{address} <> rest, query) + Relation.incoming(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), query) : Nat), _)
    available)

def ready_omission_reference_step_result(+references: List<&2, F.Reference>, +rest: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +query: O.NodeAddress) -> Type:
  Exists(List<&2, D.OmissionWork>, next =>
    {D.omission_step(D.OmissionReferences{references}, rest, nodes) == Some{next} : Maybe<&2, List<&2, D.OmissionWork>>} &
    {ready_omission_work_weight(D.OmissionReferences{references} <> rest) == 1n+ready_omission_work_weight(next) : Nat} &
    {ready_omission_work_demand(D.OmissionReferences{references} <> rest, query) == ready_omission_work_demand(next, query) : Nat})

def ready_omission_reference_step(+references: List<&2, F.Reference>, +rest: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +query: O.NodeAddress, absent: {D.omission_found(D.OmissionReferences{references}) == False{} : Bool}) -> ready_omission_reference_step_result(references, rest, nodes, query):
  match references:
    case []: Tuple{rest, Tuple{{==}, Tuple{{==}, {==}}}}
    case F.Included{_, _} <> tail:
      Tuple{D.OmissionReferences{tail} <> rest, Tuple{{==}, Tuple{{==}, {==}}}}
    case F.Omitted{_, _, _} <> _:
      Empty.absurd(ready_omission_reference_step_result(references, rest, nodes, query),
        BoolFacts.internal_false_ne_true(Equal.sym(Bool, True{}, False{}, absent)))
    case F.Expanded{_, +child} <> +tail:
      Tuple{D.OmissionAddress{child} <> D.OmissionReferences{tail} <> rest, Tuple{{==}, Tuple{{==},
        Equal.trans(Nat,
          ((Bool.pick(Nat, F.same_address(child, query), 1n, 0n) + Relation.incoming_references(tail, query) : Nat) + ready_omission_work_demand(rest, query) : Nat),
          (Bool.pick(Nat, F.same_address(child, query), 1n, 0n) + (Relation.incoming_references(tail, query) + ready_omission_work_demand(rest, query) : Nat) : Nat),
          (Bool.pick(Nat, F.same_address(query, child), 1n, 0n) + (Relation.incoming_references(tail, query) + ready_omission_work_demand(rest, query) : Nat) : Nat),
          Arithmetic.add_assoc(Bool.pick(Nat, F.same_address(child, query), 1n, 0n), Relation.incoming_references(tail, query), ready_omission_work_demand(rest, query)),
          Equal.cong(Bool, Nat, same => (Bool.pick(Nat, same, 1n, 0n) + (Relation.incoming_references(tail, query) + ready_omission_work_demand(rest, query) : Nat) : Nat),
            F.same_address(child, query), F.same_address(query, child), Construction.same_address_symmetric(child, query)))}}}

def ready_omission_occurrence(+nodes: List<&2, F.Node>, +address: O.NodeAddress) -> Type:
  Exists(List<&2, F.Node>, prefix => Exists(T.Artifact, artifact => Exists(List<&2, F.Reference>, references => Exists(List<&2, F.Node>, suffix =>
    {nodes == List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix) : List<&2, F.Node>} &
    {F.count_address(prefix, address) == 0n : Nat}))))

def ready_omission_occurrence_cons(+owner: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +tail: List<&2, F.Node>, +address: O.NodeAddress, +different: {F.same_address(address, owner) == False{} : Bool}, evidence: ready_omission_occurrence(tail, address)) -> ready_omission_occurrence(F.Node{owner, artifact, references} <> tail, address):
  match evidence:
    case (+prefix, (+found, (+refs, (+suffix, (decomposed, absent))))):
      Tuple{F.Node{owner, artifact, references} <> prefix, Tuple{found, Tuple{refs, Tuple{suffix, Tuple{
        Equal.cong(List<&2, F.Node>, List<&2, F.Node>, rest => F.Node{owner, artifact, references} <> rest,
          tail, List.append(&2, F.Node, prefix, F.Node{address, found, refs} <> suffix), decomposed),
        %Equal.sym(Bool, F.same_address(address, owner), False{}, different):
          {(Bool.pick(Nat, _, 1n, 0n) + F.count_address(prefix, address) : Nat) == 0n : Nat}
        absent}}}}}

def ready_omission_occurrence_branch(+owner: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +tail: List<&2, F.Node>, +address: O.NodeAddress, present: NatFacts.le(1n, F.count_address(F.Node{owner, artifact, references} <> tail, address)), recursive: NatFacts.le(1n, F.count_address(tail, address)) -> ready_omission_occurrence(tail, address), same: Bool, +equal: {F.same_address(address, owner) == same : Bool}) -> ready_omission_occurrence(F.Node{owner, artifact, references} <> tail, address):
  match same:
    case True{}:
      Tuple{[], Tuple{artifact, Tuple{references, Tuple{tail, Tuple{
        Equal.cong(O.NodeAddress, List<&2, F.Node>, value => F.Node{value, artifact, references} <> tail, owner, address,
          Equal.sym(O.NodeAddress, address, owner, Rollback.same_address_equal(address, owner, equal))), {==}}}}}}
    case False{}:
      ready_omission_occurrence_cons(owner, artifact, references, tail, address, equal,
        recursive(%equal: NatFacts.le(1n, (Bool.pick(Nat, _, 1n, 0n) + F.count_address(tail, address) : Nat))
          present))

def ready_omission_positive_occurrence(nodes: List<&2, F.Node>, +address: O.NodeAddress, present: NatFacts.le(1n, F.count_address(nodes, address))) -> ready_omission_occurrence(nodes, address):
  match nodes:
    case []: Empty.absurd(ready_omission_occurrence([], address), BoolFacts.internal_false_ne_true(present))
    case F.Node{+owner, +artifact, +references} <> +tail:
      ready_omission_occurrence_branch(owner, artifact, references, tail, address, present,
        positive => ready_omission_positive_occurrence(tail, address, positive), F.same_address(address, owner), {==})

def ready_omission_lookup_prefix(+nodes: List<&2, F.Node>, +address: O.NodeAddress, +prefix: List<&2, F.Node>, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>, decomposed: {nodes == List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix) : List<&2, F.Node>}, absent: {F.count_address(prefix, address) == 0n : Nat}) -> {F.node_at(nodes, address) == Some{F.Node{address, artifact, references}} : Maybe<&2, F.Node>}:
  Equal.trans(Maybe<&2, F.Node>, F.node_at(nodes, address), F.node_at(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), address), Some{F.Node{address, artifact, references}},
    Equal.cong(List<&2, F.Node>, Maybe<&2, F.Node>, items => F.node_at(items, address), nodes, List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), decomposed),
    Equal.trans(Maybe<&2, F.Node>, F.node_at(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), address), F.node_at(F.Node{address, artifact, references} <> suffix, address), Some{F.Node{address, artifact, references}},
      ForestLookup.skip_absent(prefix, F.Node{address, artifact, references} <> suffix, address, absent),
      Equal.cong(Bool, Maybe<&2, F.Node>, same => Bool.pick(Maybe<&2, F.Node>, same, Some{F.Node{address, artifact, references}}, F.node_at(suffix, address)), F.same_address(address, address), True{}, ForestLookup.address_refl(address))))

def ready_omission_resolved_occurrence(+nodes: List<&2, F.Node>, +address: O.NodeAddress) -> Type:
  Exists(List<&2, F.Node>, prefix => Exists(T.Artifact, artifact => Exists(List<&2, F.Reference>, references => Exists(List<&2, F.Node>, suffix =>
    {nodes == List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix) : List<&2, F.Node>} &
    {F.count_address(prefix, address) == 0n : Nat} &
    {F.node_at(nodes, address) == Some{F.Node{address, artifact, references}} : Maybe<&2, F.Node>}))))

def ready_omission_occurrence_lookup(+nodes: List<&2, F.Node>, +address: O.NodeAddress, evidence: ready_omission_occurrence(nodes, address)) -> ready_omission_resolved_occurrence(nodes, address):
  match evidence:
    case (+prefix, (+artifact, (+references, (+suffix, (decomposed, absent))))):
      +decomposed: {nodes == List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix) : List<&2, F.Node>} = decomposed
      +absent: {F.count_address(prefix, address) == 0n : Nat} = absent
      Tuple{prefix, Tuple{artifact, Tuple{references, Tuple{suffix, Tuple{decomposed, Tuple{absent,
        ready_omission_lookup_prefix(nodes, address, prefix, artifact, references, suffix, decomposed, absent)}}}}}}

def ready_omission_address_positive(+nodes: List<&2, F.Node>, +address: O.NodeAddress, +rest: List<&2, D.OmissionWork>) -> NatFacts.le(1n, (ready_omission_work_demand(D.OmissionAddress{address} <> rest, address) + Relation.incoming(nodes, address) : Nat)):
  %Equal.sym(Bool, F.same_address(address, address), True{}, ForestLookup.address_refl(address)):
    NatFacts.le(1n, ((Bool.pick(Nat, _, 1n, 0n) + ready_omission_work_demand(rest, address) : Nat) + Relation.incoming(nodes, address) : Nat))
  NatFacts.succ_le_succ(0n, (ready_omission_work_demand(rest, address) + Relation.incoming(nodes, address) : Nat),
    NatFacts.zero_le((ready_omission_work_demand(rest, address) + Relation.incoming(nodes, address) : Nat)))

def ready_omission_demanded_occurrence(+nodes: List<&2, F.Node>, +address: O.NodeAddress, +rest: List<&2, D.OmissionWork>, available: NatFacts.le((ready_omission_work_demand(D.OmissionAddress{address} <> rest, address) + Relation.incoming(nodes, address) : Nat), F.count_address(nodes, address))) -> ready_omission_resolved_occurrence(nodes, address):
  ready_omission_occurrence_lookup(nodes, address, ready_omission_positive_occurrence(nodes, address,
    NatFacts.le_trans(1n, (ready_omission_work_demand(D.OmissionAddress{address} <> rest, address) + Relation.incoming(nodes, address) : Nat), F.count_address(nodes, address),
      ready_omission_address_positive(nodes, address, rest), available)))

def ready_omission_node_rows(items: List<&2, F.Node>, +all: List<&2, F.Node>) -> Type:
  match items:
    case []: Unit
    case F.Node{+address, +artifact, +references} <> tail:
      {F.node_at(all, address) == Some{F.Node{address, artifact, references}} : Maybe<&2, F.Node>} & ready_omission_node_rows(tail, all)

def ready_omission_prefix_step(prefix: List<&2, F.Node>, +node: F.Node, +tail: List<&2, F.Node>) -> {List.append(&2, F.Node, prefix, node <> tail) == List.append(&2, F.Node, List.append(&2, F.Node, prefix, [node]), tail) : List<&2, F.Node>}:
  match prefix:
    case []: {==}
    case +head <> +rest:
      Equal.cong(List<&2, F.Node>, List<&2, F.Node>, items => head <> items,
        List.append(&2, F.Node, rest, node <> tail), List.append(&2, F.Node, List.append(&2, F.Node, rest, [node]), tail), ready_omission_prefix_step(rest, node, tail))

def ready_omission_rows_from_valid(items: List<&2, F.Node>, +prefix: List<&2, F.Node>, +all: List<&2, F.Node>, +decomposed: {all == List.append(&2, F.Node, prefix, items) : List<&2, F.Node>}, +valid: {Relation.nodes_valid(items, all) == True{} : Bool}) -> ready_omission_node_rows(items, all):
  match items:
    case []: Unit{}
    case F.Node{+address, +artifact, +references} <> +tail:
      +counted: {F.count_address(all, address) == 1n : Nat} = NatFacts.eq_of_is_eq(F.count_address(all, address), 1n,
        BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(all, address), 1n), Bool.and(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(tail, all))), valid))
      Tuple{
        Equal.trans(Maybe<&2, F.Node>, F.node_at(all, address), F.node_at(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> tail), address), Some{F.Node{address, artifact, references}},
          Equal.cong(List<&2, F.Node>, Maybe<&2, F.Node>, values => F.node_at(values, address), all, List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> tail), decomposed),
          ForestLookup.exact_node(prefix, address, artifact, references, tail,
            %decomposed: {F.count_address(_, address) == 1n : Nat}
            counted)),
        ready_omission_rows_from_valid(tail, List.append(&2, F.Node, prefix, [F.Node{address, artifact, references}]), all,
          Equal.trans(List<&2, F.Node>, all, List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> tail), List.append(&2, F.Node, List.append(&2, F.Node, prefix, [F.Node{address, artifact, references}]), tail), decomposed, ready_omission_prefix_step(prefix, F.Node{address, artifact, references}, tail)),
          Equal.sym(Bool, True{}, Relation.nodes_valid(tail, all), Rollback.nodes_tail(F.Node{address, artifact, references}, tail, all, Equal.sym(Bool, Relation.nodes_valid(items, all), True{}, valid))))}

def ready_omission_rows_remove_cons(+head: F.Node, +prefix: List<&2, F.Node>, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>, +all: List<&2, F.Node>, head_ready: ready_omission_node_rows([head], all), remainder: {F.node_at(all, address) == Some{F.Node{address, artifact, references}} : Maybe<&2, F.Node>} & ready_omission_node_rows(List.append(&2, F.Node, prefix, suffix), all)) -> {F.node_at(all, address) == Some{F.Node{address, artifact, references}} : Maybe<&2, F.Node>} & ready_omission_node_rows(List.append(&2, F.Node, head <> prefix, suffix), all):
  match head head_ready remainder:
    case F.Node{_, _, _} Tuple{head_equal, _} Tuple{found, rest}: Tuple{found, Tuple{head_equal, rest}}

def ready_omission_rows_remove(prefix: List<&2, F.Node>, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>, +all: List<&2, F.Node>, rows: ready_omission_node_rows(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), all)) -> {F.node_at(all, address) == Some{F.Node{address, artifact, references}} : Maybe<&2, F.Node>} & ready_omission_node_rows(List.append(&2, F.Node, prefix, suffix), all):
  match prefix:
    case []: rows
    case F.Node{+owner, +value, +refs} <> +tail:
      match rows:
        case Tuple{head_ready, rest}:
          ready_omission_rows_remove_cons(F.Node{owner, value, refs}, tail, address, artifact, references, suffix, all,
            Tuple{head_ready, Unit{}}, ready_omission_rows_remove(tail, address, artifact, references, suffix, all, rest))

def ready_omission_demands(domain: List<&2, F.Node>, +work: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>) -> Bool:
  match domain:
    case []: True{}
    case F.Node{+address, _, _} <> tail:
      Bool.and(Nat.is_le((ready_omission_work_demand(work, address) + Relation.incoming(nodes, address) : Nat), F.count_address(nodes, address)),
        ready_omission_demands(tail, work, nodes))

def ready_omission_demands_address(domain: List<&2, F.Node>, +prefix: List<&2, F.Node>, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>, +rest: List<&2, D.OmissionWork>, +valid: {ready_omission_demands(domain, D.OmissionAddress{address} <> rest, List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix)) == True{} : Bool}) -> {ready_omission_demands(domain, D.OmissionReferences{references} <> rest, List.append(&2, F.Node, prefix, suffix)) == True{} : Bool}:
  match domain:
    case []: {==}
    case F.Node{+query, _, _} <> +tail:
      BoolFacts.and_eq_true(
        Nat.is_le((ready_omission_work_demand(D.OmissionReferences{references} <> rest, query) + Relation.incoming(List.append(&2, F.Node, prefix, suffix), query) : Nat), F.count_address(List.append(&2, F.Node, prefix, suffix), query)),
        ready_omission_demands(tail, D.OmissionReferences{references} <> rest, List.append(&2, F.Node, prefix, suffix)),
        ready_omission_address_demand(prefix, address, artifact, references, suffix, rest, query,
          BoolFacts.eq_true_of_and_left(
            Nat.is_le((ready_omission_work_demand(D.OmissionAddress{address} <> rest, query) + Relation.incoming(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), query) : Nat), F.count_address(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), query)),
            ready_omission_demands(tail, D.OmissionAddress{address} <> rest, List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix)), valid)),
        ready_omission_demands_address(tail, prefix, address, artifact, references, suffix, rest,
          BoolFacts.eq_true_of_and_right(
            Nat.is_le((ready_omission_work_demand(D.OmissionAddress{address} <> rest, query) + Relation.incoming(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), query) : Nat), F.count_address(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), query)),
            ready_omission_demands(tail, D.OmissionAddress{address} <> rest, List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix)), valid)))

def ready_omission_demands_at(prefix: List<&2, F.Node>, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>, +work: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, valid: {ready_omission_demands(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), work, nodes) == True{} : Bool}) -> NatFacts.le((ready_omission_work_demand(work, address) + Relation.incoming(nodes, address) : Nat), F.count_address(nodes, address)):
  match prefix:
    case []:
      BoolFacts.eq_true_of_and_left(Nat.is_le((ready_omission_work_demand(work, address) + Relation.incoming(nodes, address) : Nat), F.count_address(nodes, address)), ready_omission_demands(suffix, work, nodes), valid)
    case F.Node{+query, _, _} <> +tail:
      ready_omission_demands_at(tail, address, artifact, references, suffix, work, nodes,
        BoolFacts.eq_true_of_and_right(Nat.is_le((ready_omission_work_demand(work, query) + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query)),
          ready_omission_demands(List.append(&2, F.Node, tail, F.Node{address, artifact, references} <> suffix), work, nodes), valid))

def ready_omission_demands_occurrence(+domain: List<&2, F.Node>, +address: O.NodeAddress, +work: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, valid: {ready_omission_demands(domain, work, nodes) == True{} : Bool}, occurrence: ready_omission_occurrence(domain, address)) -> NatFacts.le((ready_omission_work_demand(work, address) + Relation.incoming(nodes, address) : Nat), F.count_address(nodes, address)):
  match occurrence:
    case (+prefix, (+artifact, (+references, (+suffix, (decomposed, _))))):
      ready_omission_demands_at(prefix, address, artifact, references, suffix, work, nodes,
        %decomposed: {ready_omission_demands(_, work, nodes) == True{} : Bool}
        valid)

def ready_omission_reference_targets(references: List<&2, F.Reference>, +all: List<&2, F.Node>) -> Bool:
  match references:
    case []: True{}
    case F.Expanded{_, +child} <> tail:
      Bool.and(Nat.is_eq(F.count_address(all, child), 1n), ready_omission_reference_targets(tail, all))
    case _ <> tail: ready_omission_reference_targets(tail, all)

def ready_omission_work_targets(work: List<&2, D.OmissionWork>, +all: List<&2, F.Node>) -> Bool:
  match work:
    case []: True{}
    case D.OmissionAddress{address} <> tail:
      Bool.and(Nat.is_eq(F.count_address(all, address), 1n), ready_omission_work_targets(tail, all))
    case D.OmissionReferences{references} <> tail:
      Bool.and(ready_omission_reference_targets(references, all), ready_omission_work_targets(tail, all))

def ready_omission_reference_targets_valid(references: List<&2, F.Reference>, +owner: O.NodeAddress, +all: List<&2, F.Node>, +valid: {Relation.references_valid(references, owner, all) == True{} : Bool}) -> {ready_omission_reference_targets(references, all) == True{} : Bool}:
  match references:
    case []: {==}
    case F.Expanded{_, +child} <> +tail:
      BoolFacts.and_eq_true(Nat.is_eq(F.count_address(all, child), 1n), ready_omission_reference_targets(tail, all),
        BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(all, child), 1n), Bool.and(F.born_after(owner, child), Relation.references_valid(tail, owner, all)), valid),
        ready_omission_reference_targets_valid(tail, owner, all,
          BoolFacts.eq_true_of_and_right(F.born_after(owner, child), Relation.references_valid(tail, owner, all),
            BoolFacts.eq_true_of_and_right(Nat.is_eq(F.count_address(all, child), 1n), Bool.and(F.born_after(owner, child), Relation.references_valid(tail, owner, all)), valid))))
    case F.Included{_, _} <> +tail: ready_omission_reference_targets_valid(tail, owner, all, valid)
    case F.Omitted{_, _, _} <> +tail: ready_omission_reference_targets_valid(tail, owner, all, valid)

def ready_omission_initial_demands(domain: List<&2, F.Node>, +root: O.NodeAddress, +nodes: List<&2, F.Node>, +episode: Nat, +valid: {Relation.frame_forest(F.Forest{Some{root}, nodes}, episode) == True{} : Bool}) -> {ready_omission_demands(domain, [D.OmissionAddress{root}], nodes) == True{} : Bool}:
  match domain:
    case []: {==}
    case F.Node{+query, _, _} <> +tail:
      BoolFacts.and_eq_true(Nat.is_le((ready_omission_work_demand([D.OmissionAddress{root}], query) + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query)),
        ready_omission_demands(tail, [D.OmissionAddress{root}], nodes),
        %Equal.sym(Nat, (Bool.pick(Nat, F.same_address(query, root), 1n, 0n) + 0n : Nat), Bool.pick(Nat, F.same_address(query, root), 1n, 0n), Arithmetic.add_zero(Bool.pick(Nat, F.same_address(query, root), 1n, 0n))):
          NatFacts.le((_ + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query))
        %Construction.same_address_symmetric(root, query):
          NatFacts.le((Bool.pick(Nat, _, 1n, 0n) + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query))
        ready_omission_forest_demand(root, nodes, query, episode, valid),
        ready_omission_initial_demands(tail, root, nodes, episode, valid))

def ready_omission_reference_targets_absent(references: List<&2, F.Reference>, +all: List<&2, F.Node>, +query: O.NodeAddress, +valid: {ready_omission_reference_targets(references, all) == True{} : Bool}, +missing: {F.count_address(all, query) == 0n : Nat}) -> {Relation.incoming_references(references, query) == 0n : Nat}:
  match references:
    case []: {==}
    case F.Included{_, _} <> tail: ready_omission_reference_targets_absent(tail, all, query, valid, missing)
    case F.Omitted{_, _, _} <> tail: ready_omission_reference_targets_absent(tail, all, query, valid, missing)
    case F.Expanded{_, +child} <> +tail:
      %Equal.sym(Bool, F.same_address(child, query), False{}, Rollback.present_absent_distinct(all, child, query,
        BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(all, child), 1n), ready_omission_reference_targets(tail, all), valid), missing)):
        {(Bool.pick(Nat, _, 1n, 0n) + Relation.incoming_references(tail, query) : Nat) == 0n : Nat}
      ready_omission_reference_targets_absent(tail, all, query,
        BoolFacts.eq_true_of_and_right(Nat.is_eq(F.count_address(all, child), 1n), ready_omission_reference_targets(tail, all), valid), missing)

def ready_omission_work_targets_absent(work: List<&2, D.OmissionWork>, +all: List<&2, F.Node>, +query: O.NodeAddress, +valid: {ready_omission_work_targets(work, all) == True{} : Bool}, +missing: {F.count_address(all, query) == 0n : Nat}) -> {ready_omission_work_demand(work, query) == 0n : Nat}:
  match work:
    case []: {==}
    case D.OmissionAddress{+address} <> +tail:
      %Equal.sym(Bool, F.same_address(query, address), False{}, Equal.trans(Bool, F.same_address(query, address), F.same_address(address, query), False{},
        Construction.same_address_symmetric(query, address), Rollback.present_absent_distinct(all, address, query,
          BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(all, address), 1n), ready_omission_work_targets(tail, all), valid), missing))):
        {(Bool.pick(Nat, _, 1n, 0n) + ready_omission_work_demand(tail, query) : Nat) == 0n : Nat}
      ready_omission_work_targets_absent(tail, all, query,
        BoolFacts.eq_true_of_and_right(Nat.is_eq(F.count_address(all, address), 1n), ready_omission_work_targets(tail, all), valid), missing)
    case D.OmissionReferences{+references} <> +tail:
      %Equal.sym(Nat, Relation.incoming_references(references, query), 0n, ready_omission_reference_targets_absent(references, all, query,
        BoolFacts.eq_true_of_and_left(ready_omission_reference_targets(references, all), ready_omission_work_targets(tail, all), valid), missing)):
        {(_ + ready_omission_work_demand(tail, query) : Nat) == 0n : Nat}
      ready_omission_work_targets_absent(tail, all, query,
        BoolFacts.eq_true_of_and_right(ready_omission_reference_targets(references, all), ready_omission_work_targets(tail, all), valid), missing)

def ready_omission_finite_query_case(+work: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +all: List<&2, F.Node>, +query: O.NodeAddress, +demands: {ready_omission_demands(all, work, nodes) == True{} : Bool}, +targets: {ready_omission_work_targets(work, all) == True{} : Bool}, +valid: {Relation.nodes_valid(nodes, all) == True{} : Bool}, count: Nat, +counted: {F.count_address(all, query) == count : Nat}) -> NatFacts.le((ready_omission_work_demand(work, query) + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query)):
  match count:
    case 0n:
      %Equal.sym(Nat, ready_omission_work_demand(work, query), 0n, ready_omission_work_targets_absent(work, all, query, targets, counted)):
        NatFacts.le((_ + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query))
      %Equal.sym(Nat, Relation.incoming(nodes, query), 0n, Rollback.valid_nodes_absent_incoming(nodes, all, query,
        Equal.sym(Bool, Relation.nodes_valid(nodes, all), True{}, valid), counted)):
        NatFacts.le(_, F.count_address(nodes, query))
      NatFacts.zero_le(F.count_address(nodes, query))
    case 1n+remaining:
      ready_omission_demands_occurrence(all, query, work, nodes, demands,
        ready_omission_positive_occurrence(all, query,
          %Equal.sym(Nat, F.count_address(all, query), 1n+remaining, counted): NatFacts.le(1n, _)
          NatFacts.succ_le_succ(0n, remaining, NatFacts.zero_le(remaining))))

def ready_omission_finite_query(+work: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +all: List<&2, F.Node>, +query: O.NodeAddress, demands: {ready_omission_demands(all, work, nodes) == True{} : Bool}, targets: {ready_omission_work_targets(work, all) == True{} : Bool}, valid: {Relation.nodes_valid(nodes, all) == True{} : Bool}) -> NatFacts.le((ready_omission_work_demand(work, query) + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query)):
  ready_omission_finite_query_case(work, nodes, all, query, demands, targets, valid, F.count_address(all, query), {==})

def ready_omission_keep_valid_head(+head: F.Node, +before: List<&2, F.Node>, +after: List<&2, F.Node>, +all: List<&2, F.Node>, +valid: {Relation.nodes_valid(head <> before, all) == True{} : Bool}, retained: {Relation.nodes_valid(after, all) == True{} : Bool}) -> {Relation.nodes_valid(head <> after, all) == True{} : Bool}:
  match head:
    case F.Node{+address, _, +references}:
      +more: {Bool.and(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(before, all))) == True{} : Bool} =
        BoolFacts.eq_true_of_and_right(Nat.is_eq(F.count_address(all, address), 1n), Bool.and(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(before, all))), valid)
      BoolFacts.and_eq_true(Nat.is_eq(F.count_address(all, address), 1n), Bool.and(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(after, all))),
        BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(all, address), 1n), Bool.and(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(before, all))), valid),
        BoolFacts.and_eq_true(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(after, all)),
          BoolFacts.eq_true_of_and_left(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(before, all)), more),
          BoolFacts.and_eq_true(Relation.references_valid(references, address, all), Relation.nodes_valid(after, all),
            BoolFacts.eq_true_of_and_left(Relation.references_valid(references, address, all), Relation.nodes_valid(before, all),
              BoolFacts.eq_true_of_and_right(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(before, all)), more)), retained)))

def ready_omission_remove_valid_cons(+head: F.Node, +prefix: List<&2, F.Node>, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>, +all: List<&2, F.Node>, valid: {Relation.nodes_valid(List.append(&2, F.Node, head <> prefix, F.Node{address, artifact, references} <> suffix), all) == True{} : Bool}, removed: {Relation.references_valid(references, address, all) == True{} : Bool} & {Relation.nodes_valid(List.append(&2, F.Node, prefix, suffix), all) == True{} : Bool}) -> {Relation.references_valid(references, address, all) == True{} : Bool} & {Relation.nodes_valid(List.append(&2, F.Node, head <> prefix, suffix), all) == True{} : Bool}:
  match removed:
    case Tuple{references_valid, retained}:
      Tuple{references_valid, ready_omission_keep_valid_head(head, List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), List.append(&2, F.Node, prefix, suffix), all, valid, retained)}

def ready_omission_remove_valid(prefix: List<&2, F.Node>, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>, +all: List<&2, F.Node>, +valid: {Relation.nodes_valid(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), all) == True{} : Bool}) -> {Relation.references_valid(references, address, all) == True{} : Bool} & {Relation.nodes_valid(List.append(&2, F.Node, prefix, suffix), all) == True{} : Bool}:
  match prefix:
    case []:
      pair: {Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(suffix, all)) == True{} : Bool} =
        BoolFacts.eq_true_of_and_right(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(suffix, all)),
        BoolFacts.eq_true_of_and_right(Nat.is_eq(F.count_address(all, address), 1n), Bool.and(Nat.is_le(Relation.incoming(all, address), 1n), Bool.and(Relation.references_valid(references, address, all), Relation.nodes_valid(suffix, all))), valid))
      Tuple{
        BoolFacts.eq_true_of_and_left(Relation.references_valid(references, address, all), Relation.nodes_valid(suffix, all), pair),
        Equal.sym(Bool, True{}, Relation.nodes_valid(suffix, all), Rollback.nodes_tail(F.Node{address, artifact, references}, suffix, all, Equal.sym(Bool, Relation.nodes_valid(F.Node{address, artifact, references} <> suffix, all), True{}, valid)))}
    case +head <> +tail:
      ready_omission_remove_valid_cons(head, tail, address, artifact, references, suffix, all, valid,
        ready_omission_remove_valid(tail, address, artifact, references, suffix, all,
          Equal.sym(Bool, True{}, Relation.nodes_valid(List.append(&2, F.Node, tail, F.Node{address, artifact, references} <> suffix), all),
            Rollback.nodes_tail(head, List.append(&2, F.Node, tail, F.Node{address, artifact, references} <> suffix), all,
              Equal.sym(Bool, Relation.nodes_valid(List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), all), True{}, valid)))))

def ready_omission_finite_transition(+work: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +all: List<&2, F.Node>, +head: D.OmissionWork, +rest: List<&2, D.OmissionWork>) -> Type:
  Exists(List<&2, D.OmissionWork>, next => Exists(List<&2, F.Node>, remaining =>
    {D.omission_step(head, rest, all) == Some{next} : Maybe<&2, List<&2, D.OmissionWork>>} &
    {(Allowance.nodes(nodes) + ready_omission_work_weight(work) : Nat) == 1n+(Allowance.nodes(remaining) + ready_omission_work_weight(next) : Nat) : Nat} &
    ready_omission_node_rows(remaining, all) &
    {Relation.nodes_valid(remaining, all) == True{} : Bool} &
    {ready_omission_work_targets(next, all) == True{} : Bool} &
    {ready_omission_demands(all, next, remaining) == True{} : Bool}))

def ready_omission_finite_address_parts(+prefix: List<&2, F.Node>, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +suffix: List<&2, F.Node>, +rest: List<&2, D.OmissionWork>, +all: List<&2, F.Node>, removed: {F.node_at(all, address) == Some{F.Node{address, artifact, references}} : Maybe<&2, F.Node>} & ready_omission_node_rows(List.append(&2, F.Node, prefix, suffix), all), retained: {Relation.references_valid(references, address, all) == True{} : Bool} & {Relation.nodes_valid(List.append(&2, F.Node, prefix, suffix), all) == True{} : Bool}, targets: {ready_omission_work_targets(rest, all) == True{} : Bool}, demands: {ready_omission_demands(all, D.OmissionAddress{address} <> rest, List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix)) == True{} : Bool}) -> ready_omission_finite_transition(D.OmissionAddress{address} <> rest, List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), all, D.OmissionAddress{address}, rest):
  match removed retained:
    case Tuple{found, rows} Tuple{reference_valid, nodes_valid}:
      Tuple{D.OmissionReferences{references} <> rest, Tuple{List.append(&2, F.Node, prefix, suffix), Tuple{
        Equal.cong(Maybe<&2, F.Node>, Maybe<&2, List<&2, D.OmissionWork>>, value => D.omission_node(value, rest), F.node_at(all, address), Some{F.Node{address, artifact, references}}, found),
        Tuple{ready_omission_address_weight(prefix, address, artifact, references, suffix, rest), Tuple{rows, Tuple{nodes_valid, Tuple{
          BoolFacts.and_eq_true(ready_omission_reference_targets(references, all), ready_omission_work_targets(rest, all), ready_omission_reference_targets_valid(references, address, all, reference_valid), targets),
          ready_omission_demands_address(all, prefix, address, artifact, references, suffix, rest, demands)}}}}}}}

def ready_omission_finite_address_resolved(+nodes: List<&2, F.Node>, +address: O.NodeAddress, +rest: List<&2, D.OmissionWork>, +all: List<&2, F.Node>, rows: ready_omission_node_rows(nodes, all), valid: {Relation.nodes_valid(nodes, all) == True{} : Bool}, targets: {ready_omission_work_targets(D.OmissionAddress{address} <> rest, all) == True{} : Bool}, demands: {ready_omission_demands(all, D.OmissionAddress{address} <> rest, nodes) == True{} : Bool}, occurrence: ready_omission_resolved_occurrence(nodes, address)) -> ready_omission_finite_transition(D.OmissionAddress{address} <> rest, nodes, all, D.OmissionAddress{address}, rest):
  match occurrence:
    case (+prefix, (+artifact, (+references, (+suffix, (+decomposed, _))))):
      %Equal.sym(List<&2, F.Node>, nodes, List.append(&2, F.Node, prefix, F.Node{address, artifact, references} <> suffix), decomposed):
        ready_omission_finite_transition(D.OmissionAddress{address} <> rest, _, all, D.OmissionAddress{address}, rest)
      ready_omission_finite_address_parts(prefix, address, artifact, references, suffix, rest, all,
        ready_omission_rows_remove(prefix, address, artifact, references, suffix, all,
          %decomposed: ready_omission_node_rows(_, all)
          rows),
        ready_omission_remove_valid(prefix, address, artifact, references, suffix, all,
          %decomposed: {Relation.nodes_valid(_, all) == True{} : Bool}
          valid),
        BoolFacts.eq_true_of_and_right(Nat.is_eq(F.count_address(all, address), 1n), ready_omission_work_targets(rest, all), targets),
        %decomposed: {ready_omission_demands(all, D.OmissionAddress{address} <> rest, _) == True{} : Bool}
        demands)

def ready_omission_finite_address(+nodes: List<&2, F.Node>, +address: O.NodeAddress, +rest: List<&2, D.OmissionWork>, +all: List<&2, F.Node>, rows: ready_omission_node_rows(nodes, all), +valid: {Relation.nodes_valid(nodes, all) == True{} : Bool}, +targets: {ready_omission_work_targets(D.OmissionAddress{address} <> rest, all) == True{} : Bool}, +demands: {ready_omission_demands(all, D.OmissionAddress{address} <> rest, nodes) == True{} : Bool}) -> ready_omission_finite_transition(D.OmissionAddress{address} <> rest, nodes, all, D.OmissionAddress{address}, rest):
  ready_omission_finite_address_resolved(nodes, address, rest, all, rows, valid, targets, demands,
    ready_omission_demanded_occurrence(nodes, address, rest, ready_omission_finite_query(D.OmissionAddress{address} <> rest, nodes, all, address, demands, targets, valid)))

def ready_omission_reference_demand_join(+references: List<&2, F.Reference>, +rest: List<&2, D.OmissionWork>, +all: List<&2, F.Node>, +query: O.NodeAddress, +next: List<&2, D.OmissionWork>, step: {D.omission_step(D.OmissionReferences{references}, rest, all) == Some{next} : Maybe<&2, List<&2, D.OmissionWork>>}, observed: ready_omission_reference_step_result(references, rest, all, query)) -> {ready_omission_work_demand(D.OmissionReferences{references} <> rest, query) == ready_omission_work_demand(next, query) : Nat}:
  match observed:
    case (+found, (exact, (_, demand))):
      Equal.trans(Nat, ready_omission_work_demand(D.OmissionReferences{references} <> rest, query), ready_omission_work_demand(found, query), ready_omission_work_demand(next, query), demand,
        Equal.cong(List<&2, D.OmissionWork>, Nat, work => ready_omission_work_demand(work, query), found, next,
          Count.some_equal(List<&2, D.OmissionWork>, found, next,
            Equal.trans(Maybe<&2, List<&2, D.OmissionWork>>, Some{found}, D.omission_step(D.OmissionReferences{references}, rest, all), Some{next},
              Equal.sym(Maybe<&2, List<&2, D.OmissionWork>>, D.omission_step(D.OmissionReferences{references}, rest, all), Some{found}, exact), step))))

def ready_omission_reference_demands(domain: List<&2, F.Node>, +references: List<&2, F.Reference>, +rest: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +all: List<&2, F.Node>, +next: List<&2, D.OmissionWork>, +step: {D.omission_step(D.OmissionReferences{references}, rest, all) == Some{next} : Maybe<&2, List<&2, D.OmissionWork>>}, +absent: {D.omission_found(D.OmissionReferences{references}) == False{} : Bool}, +valid: {ready_omission_demands(domain, D.OmissionReferences{references} <> rest, nodes) == True{} : Bool}) -> {ready_omission_demands(domain, next, nodes) == True{} : Bool}:
  match domain:
    case []: {==}
    case F.Node{+query, _, _} <> +tail:
      BoolFacts.and_eq_true(Nat.is_le((ready_omission_work_demand(next, query) + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query)), ready_omission_demands(tail, next, nodes),
        %ready_omission_reference_demand_join(references, rest, all, query, next, step, ready_omission_reference_step(references, rest, all, query, absent)):
          NatFacts.le((_ + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query))
        BoolFacts.eq_true_of_and_left(Nat.is_le((ready_omission_work_demand(D.OmissionReferences{references} <> rest, query) + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query)), ready_omission_demands(tail, D.OmissionReferences{references} <> rest, nodes), valid),
        ready_omission_reference_demands(tail, references, rest, nodes, all, next, step, absent,
          BoolFacts.eq_true_of_and_right(Nat.is_le((ready_omission_work_demand(D.OmissionReferences{references} <> rest, query) + Relation.incoming(nodes, query) : Nat), F.count_address(nodes, query)), ready_omission_demands(tail, D.OmissionReferences{references} <> rest, nodes), valid)))

def ready_omission_reference_finite_parts(+references: List<&2, F.Reference>, +rest: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +all: List<&2, F.Node>, +next: List<&2, D.OmissionWork>, rows: ready_omission_node_rows(nodes, all), valid: {Relation.nodes_valid(nodes, all) == True{} : Bool}, targets: {ready_omission_work_targets(next, all) == True{} : Bool}, demands: {ready_omission_demands(all, D.OmissionReferences{references} <> rest, nodes) == True{} : Bool}, +step: {D.omission_step(D.OmissionReferences{references}, rest, all) == Some{next} : Maybe<&2, List<&2, D.OmissionWork>>}, weight: {ready_omission_work_weight(D.OmissionReferences{references} <> rest) == 1n+ready_omission_work_weight(next) : Nat}, absent: {D.omission_found(D.OmissionReferences{references}) == False{} : Bool}) -> ready_omission_finite_transition(D.OmissionReferences{references} <> rest, nodes, all, D.OmissionReferences{references}, rest):
  Tuple{next, Tuple{nodes, Tuple{step, Tuple{
    Equal.trans(Nat, (Allowance.nodes(nodes) + ready_omission_work_weight(D.OmissionReferences{references} <> rest) : Nat), (Allowance.nodes(nodes) + 1n+ready_omission_work_weight(next) : Nat), 1n+(Allowance.nodes(nodes) + ready_omission_work_weight(next) : Nat),
      Equal.cong(Nat, Nat, amount => (Allowance.nodes(nodes) + amount : Nat), ready_omission_work_weight(D.OmissionReferences{references} <> rest), 1n+ready_omission_work_weight(next), weight), Arithmetic.add_succ(Allowance.nodes(nodes), ready_omission_work_weight(next))),
    Tuple{rows, Tuple{valid, Tuple{targets, ready_omission_reference_demands(all, references, rest, nodes, all, next, step, absent, demands)}}}}}}}

def ready_omission_finite_references(+references: List<&2, F.Reference>, +rest: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +all: List<&2, F.Node>, rows: ready_omission_node_rows(nodes, all), valid: {Relation.nodes_valid(nodes, all) == True{} : Bool}, +targets: {ready_omission_work_targets(D.OmissionReferences{references} <> rest, all) == True{} : Bool}, demands: {ready_omission_demands(all, D.OmissionReferences{references} <> rest, nodes) == True{} : Bool}, absent: {D.omission_found(D.OmissionReferences{references}) == False{} : Bool}) -> ready_omission_finite_transition(D.OmissionReferences{references} <> rest, nodes, all, D.OmissionReferences{references}, rest):
  match references:
    case []:
      ready_omission_reference_finite_parts([], rest, nodes, all, rest, rows, valid,
        BoolFacts.eq_true_of_and_right(True{}, ready_omission_work_targets(rest, all), targets), demands, {==}, {==}, absent)
    case F.Included{+symbol, +identity} <> +tail:
      ready_omission_reference_finite_parts(references, rest, nodes, all, D.OmissionReferences{tail} <> rest, rows, valid, targets, demands, {==}, {==}, absent)
    case F.Omitted{_, _, _} <> _:
      Empty.absurd(ready_omission_finite_transition(D.OmissionReferences{references} <> rest, nodes, all, D.OmissionReferences{references}, rest), BoolFacts.internal_false_ne_true(Equal.sym(Bool, True{}, False{}, absent)))
    case F.Expanded{_, +child} <> +tail:
      +refs: {Bool.and(Nat.is_eq(F.count_address(all, child), 1n), ready_omission_reference_targets(tail, all)) == True{} : Bool} =
        BoolFacts.eq_true_of_and_left(ready_omission_reference_targets(references, all), ready_omission_work_targets(rest, all), targets)
      ready_omission_reference_finite_parts(references, rest, nodes, all, D.OmissionAddress{child} <> D.OmissionReferences{tail} <> rest, rows, valid,
        BoolFacts.and_eq_true(Nat.is_eq(F.count_address(all, child), 1n), ready_omission_work_targets(D.OmissionReferences{tail} <> rest, all),
          BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(all, child), 1n), ready_omission_reference_targets(tail, all), refs),
          BoolFacts.and_eq_true(ready_omission_reference_targets(tail, all), ready_omission_work_targets(rest, all),
            BoolFacts.eq_true_of_and_right(Nat.is_eq(F.count_address(all, child), 1n), ready_omission_reference_targets(tail, all), refs),
            BoolFacts.eq_true_of_and_right(ready_omission_reference_targets(references, all), ready_omission_work_targets(rest, all), targets))), demands, {==}, {==}, absent)

def ready_omission_observed(+fuel: Nat, +work: List<&2, D.OmissionWork>, +all: List<&2, F.Node>) -> Type:
  Exists(Bool, present => {D.omissions(fuel, work, all) == D.OmissionsObserved{present} : D.OmissionResult})

def ready_omission_transition_no_zero(+head: D.OmissionWork, +rest: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +all: List<&2, F.Node>, bounded: NatFacts.le((Allowance.nodes(nodes) + ready_omission_work_weight(head <> rest) : Nat), 0n), transition: ready_omission_finite_transition(head <> rest, nodes, all, head, rest)) -> Empty:
  match transition:
    case (+next, (+remaining, (_, (weight, _)))):
      BoolFacts.internal_false_ne_true(
        %weight: NatFacts.le(_, 0n)
        bounded)

def ready_omission_references_positive(+references: List<&2, F.Reference>, +rest: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>) -> NatFacts.le(1n, (Allowance.nodes(nodes) + ready_omission_work_weight(D.OmissionReferences{references} <> rest) : Nat)):
  %Equal.sym(Nat, (Allowance.nodes(nodes) + 1n+(Allowance.references(references) + ready_omission_work_weight(rest) : Nat) : Nat),
    1n+(Allowance.nodes(nodes) + (Allowance.references(references) + ready_omission_work_weight(rest) : Nat) : Nat),
    Arithmetic.add_succ(Allowance.nodes(nodes), (Allowance.references(references) + ready_omission_work_weight(rest) : Nat))):
    NatFacts.le(1n, _)
  NatFacts.succ_le_succ(0n, (Allowance.nodes(nodes) + (Allowance.references(references) + ready_omission_work_weight(rest) : Nat) : Nat),
    NatFacts.zero_le((Allowance.nodes(nodes) + (Allowance.references(references) + ready_omission_work_weight(rest) : Nat) : Nat)))

def ready_omission_observed_step(+fuel: Nat, +head: D.OmissionWork, +rest: List<&2, D.OmissionWork>, +all: List<&2, F.Node>, +next: List<&2, D.OmissionWork>, absent: {D.omission_found(head) == False{} : Bool}, step: {D.omission_step(head, rest, all) == Some{next} : Maybe<&2, List<&2, D.OmissionWork>>}, observed: ready_omission_observed(fuel, next, all)) -> ready_omission_observed(1n+fuel, head <> rest, all):
  match observed:
    case (+present, equal):
      Tuple{present,
        %Equal.sym(Bool, D.omission_found(head), False{}, absent):
          {D.omission_dispatch(_, D.omission_step(head, rest, all), items => D.omissions(fuel, items, all)) == D.OmissionsObserved{present} : D.OmissionResult}
        %Equal.sym(Maybe<&2, List<&2, D.OmissionWork>>, D.omission_step(head, rest, all), Some{next}, step):
          {D.omission_next(_, items => D.omissions(fuel, items, all)) == D.OmissionsObserved{present} : D.OmissionResult}
        equal}

def ready_omission_total_transition(+fuel: Nat, +head: D.OmissionWork, +rest: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +all: List<&2, F.Node>, absent: {D.omission_found(head) == False{} : Bool}, bounded: NatFacts.le((Allowance.nodes(nodes) + ready_omission_work_weight(head <> rest) : Nat), 1n+fuel), transition: ready_omission_finite_transition(head <> rest, nodes, all, head, rest), recursive: @next: List<&2, D.OmissionWork> -> @remaining: List<&2, F.Node> -> ready_omission_node_rows(remaining, all) -> {Relation.nodes_valid(remaining, all) == True{} : Bool} -> {ready_omission_work_targets(next, all) == True{} : Bool} -> {ready_omission_demands(all, next, remaining) == True{} : Bool} -> NatFacts.le((Allowance.nodes(remaining) + ready_omission_work_weight(next) : Nat), fuel) -> ready_omission_observed(fuel, next, all)) -> ready_omission_observed(1n+fuel, head <> rest, all):
  match transition:
    case (+next, (+remaining, (step, (weight, (rows, (valid, (targets, demands))))))):
      ready_omission_observed_step(fuel, head, rest, all, next, absent, step,
        recursive(next)(remaining)(rows)(valid)(targets)(demands)(
          %weight: NatFacts.le(_, 1n+fuel)
          bounded))

def ready_omission_total(fuel: Nat, +work: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +all: List<&2, F.Node>, rows: ready_omission_node_rows(nodes, all), +valid: {Relation.nodes_valid(nodes, all) == True{} : Bool}, +targets: {ready_omission_work_targets(work, all) == True{} : Bool}, +demands: {ready_omission_demands(all, work, nodes) == True{} : Bool}, bounded: NatFacts.le((Allowance.nodes(nodes) + ready_omission_work_weight(work) : Nat), fuel)) -> ready_omission_observed(fuel, work, all):
  match fuel work:
    case _ Nil{}: Tuple{False{}, {==}}
    case 0n D.OmissionAddress{+address} <> +rest:
      Empty.absurd(ready_omission_observed(0n, work, all),
        ready_omission_transition_no_zero(D.OmissionAddress{address}, rest, nodes, all, bounded, ready_omission_finite_address(nodes, address, rest, all, rows, valid, targets, demands)))
    case 0n D.OmissionReferences{+references} <> +rest:
      Empty.absurd(ready_omission_observed(0n, work, all), BoolFacts.internal_false_ne_true(
        NatFacts.le_trans(1n, (Allowance.nodes(nodes) + ready_omission_work_weight(work) : Nat), 0n, ready_omission_references_positive(references, rest, nodes), bounded)))
    case 1n++remaining D.OmissionAddress{+address} <> +rest:
      ready_omission_total_transition(remaining, D.OmissionAddress{address}, rest, nodes, all, {==}, bounded,
        ready_omission_finite_address(nodes, address, rest, all, rows, valid, targets, demands),
        +next => +unvisited => next_rows => next_valid => next_targets => next_demands => next_bound =>
          ready_omission_total(remaining, next, unvisited, all, next_rows, next_valid, next_targets, next_demands, next_bound))
    case 1n++remaining D.OmissionReferences{Nil{}} <> +rest:
      ready_omission_total_transition(remaining, D.OmissionReferences{[]}, rest, nodes, all, {==}, bounded,
        ready_omission_finite_references([], rest, nodes, all, rows, valid, targets, demands, {==}),
        +next => +unvisited => next_rows => next_valid => next_targets => next_demands => next_bound =>
          ready_omission_total(remaining, next, unvisited, all, next_rows, next_valid, next_targets, next_demands, next_bound))
    case 1n++remaining D.OmissionReferences{F.Included{+symbol, +identity} <> +tail} <> +rest:
      ready_omission_total_transition(remaining, D.OmissionReferences{F.Included{symbol, identity} <> tail}, rest, nodes, all, {==}, bounded,
        ready_omission_finite_references(F.Included{symbol, identity} <> tail, rest, nodes, all, rows, valid, targets, demands, {==}),
        +next => +unvisited => next_rows => next_valid => next_targets => next_demands => next_bound =>
          ready_omission_total(remaining, next, unvisited, all, next_rows, next_valid, next_targets, next_demands, next_bound))
    case 1n++remaining D.OmissionReferences{F.Expanded{+symbol, +child} <> +tail} <> +rest:
      ready_omission_total_transition(remaining, D.OmissionReferences{F.Expanded{symbol, child} <> tail}, rest, nodes, all, {==}, bounded,
        ready_omission_finite_references(F.Expanded{symbol, child} <> tail, rest, nodes, all, rows, valid, targets, demands, {==}),
        +next => +unvisited => next_rows => next_valid => next_targets => next_demands => next_bound =>
          ready_omission_total(remaining, next, unvisited, all, next_rows, next_valid, next_targets, next_demands, next_bound))
    case 1n+_ D.OmissionReferences{F.Omitted{_, _, _} <> _} <> _:
      Tuple{True{}, {==}}

def ready_omission_forest_total(+root: O.NodeAddress, +nodes: List<&2, F.Node>, +episode: Nat, +valid: {Relation.frame_forest(F.Forest{Some{root}, nodes}, episode) == True{} : Bool}) -> Exists(Bool, present => {D.forest_omissions(Allowance.materialization(F.Forest{Some{root}, nodes}), F.Forest{Some{root}, nodes}) == D.OmissionsObserved{present} : D.OmissionResult}):
  +retained: {Relation.retained(F.Forest{Some{root}, nodes}) == True{} : Bool} =
    BoolFacts.eq_true_of_and_left(Relation.retained(F.Forest{Some{root}, nodes}), Relation.episodes_before(nodes, episode), valid)
  +nodes_valid: {Relation.nodes_valid(nodes, nodes) == True{} : Bool} =
    BoolFacts.eq_true_of_and_right(Relation.root_valid(Some{root}, nodes), Relation.nodes_valid(nodes, nodes), retained)
  root_valid: {Relation.root_valid(Some{root}, nodes) == True{} : Bool} =
    BoolFacts.eq_true_of_and_left(Relation.root_valid(Some{root}, nodes), Relation.nodes_valid(nodes, nodes), retained)
  ready_omission_total(Allowance.materialization(F.Forest{Some{root}, nodes}), [D.OmissionAddress{root}], nodes, nodes,
    ready_omission_rows_from_valid(nodes, [], nodes, {==}, nodes_valid), nodes_valid,
    BoolFacts.and_eq_true(Nat.is_eq(F.count_address(nodes, root), 1n), True{},
      BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(nodes, root), 1n), Nat.is_eq(Relation.incoming(nodes, root), 0n), root_valid), {==}),
    ready_omission_initial_demands(nodes, root, nodes, episode, valid),
    NatFacts.add_le_add_left(0n, 2n, Allowance.nodes(nodes), NatFacts.zero_le(2n)))

def ready_actual_omission_filter_step(+actual: Nat, +index: Nat, +symbol: String, +reference: Local.PlannedReference, +tail: List<&2, Local.ReferenceSlot>, +remaining: Nat, +owner: Nat, +all: List<&2, Local.ReferenceSlot>, tail_equal: {LoopPolicy.has_omission(1n+remaining, tail, owner, all) == LoopPolicy.has_omission(1n+remaining, P.owner_slots(tail, owner), owner, all) : Bool}, same: Bool, +equal: {Nat.is_eq(actual, owner) == same : Bool}) -> {LoopPolicy.has_omission(1n+remaining, Local.ReferenceSlot{actual, index, symbol, reference} <> tail, owner, all) == LoopPolicy.has_omission(1n+remaining, P.owner_slots(Local.ReferenceSlot{actual, index, symbol, reference} <> tail, owner), owner, all) : Bool}:
  match same:
    case False{}:
      %Equal.sym(Bool, Nat.is_eq(actual, owner), False{}, equal):
        {LoopPolicy.omission_slot(_, reference, child => LoopPolicy.has_omission(remaining, all, child, all), _ => LoopPolicy.has_omission(1n+remaining, tail, owner, all))
          == LoopPolicy.has_omission(1n+remaining, Bool.pick(List<&2, Local.ReferenceSlot>, _, Local.ReferenceSlot{actual, index, symbol, reference} <> P.owner_slots(tail, owner), P.owner_slots(tail, owner)), owner, all) : Bool}
      tail_equal
    case True{}:
      %Equal.sym(Bool, Nat.is_eq(actual, owner), True{}, equal):
        {LoopPolicy.omission_slot(_, reference, child => LoopPolicy.has_omission(remaining, all, child, all), _ => LoopPolicy.has_omission(1n+remaining, tail, owner, all))
          == LoopPolicy.has_omission(1n+remaining, Bool.pick(List<&2, Local.ReferenceSlot>, _, Local.ReferenceSlot{actual, index, symbol, reference} <> P.owner_slots(tail, owner), P.owner_slots(tail, owner)), owner, all) : Bool}
      %Equal.sym(Bool, Nat.is_eq(actual, owner), True{}, equal):
        {LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(remaining, all, child, all), _ => LoopPolicy.has_omission(1n+remaining, tail, owner, all))
          == LoopPolicy.omission_slot(_, reference, child => LoopPolicy.has_omission(remaining, all, child, all), _ => LoopPolicy.has_omission(1n+remaining, P.owner_slots(tail, owner), owner, all)) : Bool}
      Equal.cong(Bool, Bool, +rest => LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(remaining, all, child, all), _ => rest),
        LoopPolicy.has_omission(1n+remaining, tail, owner, all), LoopPolicy.has_omission(1n+remaining, P.owner_slots(tail, owner), owner, all), tail_equal)

def ready_actual_omission_filter(slots: List<&2, Local.ReferenceSlot>, +fuel: Nat, +owner: Nat, +all: List<&2, Local.ReferenceSlot>) -> {LoopPolicy.has_omission(fuel, slots, owner, all) == LoopPolicy.has_omission(fuel, P.owner_slots(slots, owner), owner, all) : Bool}:
  match slots fuel:
    case Nil{} _: {==}
    case _ 0n: {==}
    case Local.ReferenceSlot{+actual, +index, +symbol, +reference} <> +tail 1n++remaining:
      ready_actual_omission_filter_step(actual, index, symbol, reference, tail, remaining, owner, all,
        ready_actual_omission_filter(tail, 1n+remaining, owner, all), Nat.is_eq(actual, owner), {==})

def ready_actual_omission_stable(nodes: List<&2, Local.PlannedNode>, +left: Nat, +right: Nat, +slots: List<&2, Local.ReferenceSlot>) -> Bool:
  match nodes:
    case []: True{}
    case Local.PlannedNode{+id, _} <> tail:
      Bool.and(Cmp.is_eq(Bool.cmp(LoopPolicy.has_omission(left, slots, id, slots), LoopPolicy.has_omission(right, slots, id, slots))),
        ready_actual_omission_stable(tail, left, right, slots))

def ready_actual_omission_query_branch(+id: Nat, +artifact: Nat, +tail: List<&2, Local.PlannedNode>, +query: Nat, +left: Nat, +right: Nat, +slots: List<&2, Local.ReferenceSlot>, +stable: {ready_actual_omission_stable(Local.PlannedNode{id, artifact} <> tail, left, right, slots) == True{} : Bool}, present: NatFacts.le(1n, P.node_count(Local.PlannedNode{id, artifact} <> tail, query)), recursive: {ready_actual_omission_stable(tail, left, right, slots) == True{} : Bool} -> NatFacts.le(1n, P.node_count(tail, query)) -> {LoopPolicy.has_omission(left, slots, query, slots) == LoopPolicy.has_omission(right, slots, query, slots) : Bool}, same: Bool, +equal: {Nat.is_eq(query, id) == same : Bool}) -> {LoopPolicy.has_omission(left, slots, query, slots) == LoopPolicy.has_omission(right, slots, query, slots) : Bool}:
  match same:
    case True{}:
      %Equal.sym(Nat, query, id, NatFacts.eq_of_is_eq(query, id, equal)):
        {LoopPolicy.has_omission(left, slots, _, slots) == LoopPolicy.has_omission(right, slots, _, slots) : Bool}
      BoolFacts.eq_of_cmp_eq(LoopPolicy.has_omission(left, slots, id, slots), LoopPolicy.has_omission(right, slots, id, slots),
        BoolFacts.eq_true_of_and_left(Cmp.is_eq(Bool.cmp(LoopPolicy.has_omission(left, slots, id, slots), LoopPolicy.has_omission(right, slots, id, slots))), ready_actual_omission_stable(tail, left, right, slots), stable))
    case False{}:
      recursive(BoolFacts.eq_true_of_and_right(Cmp.is_eq(Bool.cmp(LoopPolicy.has_omission(left, slots, id, slots), LoopPolicy.has_omission(right, slots, id, slots))), ready_actual_omission_stable(tail, left, right, slots), stable))(
        %equal: NatFacts.le(1n, (Bool.pick(Nat, _, 1n, 0n) + P.node_count(tail, query) : Nat))
        present)

def ready_actual_omission_query(nodes: List<&2, Local.PlannedNode>, +query: Nat, +left: Nat, +right: Nat, +slots: List<&2, Local.ReferenceSlot>, stable: {ready_actual_omission_stable(nodes, left, right, slots) == True{} : Bool}, present: NatFacts.le(1n, P.node_count(nodes, query))) -> {LoopPolicy.has_omission(left, slots, query, slots) == LoopPolicy.has_omission(right, slots, query, slots) : Bool}:
  match nodes:
    case []:
      Empty.absurd({LoopPolicy.has_omission(left, slots, query, slots) == LoopPolicy.has_omission(right, slots, query, slots) : Bool}, BoolFacts.internal_false_ne_true(present))
    case Local.PlannedNode{+id, +artifact} <> +tail:
      ready_actual_omission_query_branch(id, artifact, tail, query, left, right, slots, stable, present,
        next_stable => next_present => ready_actual_omission_query(tail, query, left, right, slots, next_stable, next_present), Nat.is_eq(query, id), {==})

def ready_actual_omission_slot_values(+actual: Nat, +index: Nat, +symbol: String, same: Bool, reference: Local.PlannedReference, +tail: List<&2, Local.ReferenceSlot>, +owner: Nat, +left: Nat, +right: Nat, +all: List<&2, Local.ReferenceSlot>, +later: List<&2, Local.PlannedNode>, +stable: {ready_actual_omission_stable(later, left, right, all) == True{} : Bool}, forward: {P.forward_reference(reference, later) == True{} : Bool}, tail_equal: {LoopPolicy.has_omission(1n+left, tail, owner, all) == LoopPolicy.has_omission(1n+right, tail, owner, all) : Bool}) -> {LoopPolicy.omission_slot(same, reference, child => LoopPolicy.has_omission(left, all, child, all), _ => LoopPolicy.has_omission(1n+left, tail, owner, all)) == LoopPolicy.omission_slot(same, reference, child => LoopPolicy.has_omission(right, all, child, all), _ => LoopPolicy.has_omission(1n+right, tail, owner, all)) : Bool}:
  match same:
    case False{}: tail_equal
    case True{}:
      match reference:
        case Local.Included{+identity}:
          Equal.cong(Bool, Bool, +rest => LoopPolicy.omission_slot(True{}, Local.Included{identity}, _ => False{}, _ => rest),
            LoopPolicy.has_omission(1n+left, tail, owner, all), LoopPolicy.has_omission(1n+right, tail, owner, all), tail_equal)
        case Local.Omitted{+reason, +target}:
          Equal.cong(Bool, Bool, +rest => LoopPolicy.omission_slot(True{}, Local.Omitted{reason, target}, _ => False{}, _ => rest),
            LoopPolicy.has_omission(1n+left, tail, owner, all), LoopPolicy.has_omission(1n+right, tail, owner, all), tail_equal)
        case Local.Expanded{+child}:
          child_equal: {LoopPolicy.has_omission(left, all, child, all) == LoopPolicy.has_omission(right, all, child, all) : Bool} =
            ready_actual_omission_query(later, child, left, right, all, stable,
              %Equal.sym(Nat, P.node_count(later, child), 1n, NatFacts.eq_of_is_eq(P.node_count(later, child), 1n, forward)): NatFacts.le(1n, _)
              NatFacts.le_refl(1n))
          Equal.trans(Bool,
            LoopPolicy.omission_slot(True{}, reference, node => LoopPolicy.has_omission(left, all, node, all), _ => LoopPolicy.has_omission(1n+left, tail, owner, all)),
            LoopPolicy.omission_slot(True{}, Local.Expanded{child}, _ => LoopPolicy.has_omission(right, all, child, all), _ => LoopPolicy.has_omission(1n+left, tail, owner, all)),
            LoopPolicy.omission_slot(True{}, reference, node => LoopPolicy.has_omission(right, all, node, all), _ => LoopPolicy.has_omission(1n+right, tail, owner, all)),
            Equal.cong(Bool, Bool, +value => LoopPolicy.omission_slot(True{}, Local.Expanded{child}, _ => value, _ => LoopPolicy.has_omission(1n+left, tail, owner, all)),
              LoopPolicy.has_omission(left, all, child, all), LoopPolicy.has_omission(right, all, child, all), child_equal),
            Equal.cong(Bool, Bool, +rest => LoopPolicy.omission_slot(True{}, Local.Expanded{child}, _ => LoopPolicy.has_omission(right, all, child, all), _ => rest),
              LoopPolicy.has_omission(1n+left, tail, owner, all), LoopPolicy.has_omission(1n+right, tail, owner, all), tail_equal))

def ready_actual_omission_slot_stable(+actual: Nat, +index: Nat, +symbol: String, reference: Local.PlannedReference, +tail: List<&2, Local.ReferenceSlot>, +owner: Nat, +left: Nat, +right: Nat, +all: List<&2, Local.ReferenceSlot>, +later: List<&2, Local.PlannedNode>, +stable: {ready_actual_omission_stable(later, left, right, all) == True{} : Bool}, forward: {P.forward_reference(reference, later) == True{} : Bool}, tail_equal: {LoopPolicy.has_omission(1n+left, tail, owner, all) == LoopPolicy.has_omission(1n+right, tail, owner, all) : Bool}) -> {LoopPolicy.has_omission(1n+left, Local.ReferenceSlot{actual, index, symbol, reference} <> tail, owner, all) == LoopPolicy.has_omission(1n+right, Local.ReferenceSlot{actual, index, symbol, reference} <> tail, owner, all) : Bool}:
  ready_actual_omission_slot_values(actual, index, symbol, Nat.is_eq(actual, owner), reference, tail, owner, left, right, all, later, stable, forward, tail_equal)

def ready_actual_omission_slots_stable(slots: List<&2, Local.ReferenceSlot>, +left: Nat, +right: Nat, +owner: Nat, +all: List<&2, Local.ReferenceSlot>, +later: List<&2, Local.PlannedNode>, +next: Nat, +stable: {ready_actual_omission_stable(later, left, right, all) == True{} : Bool}, +indexed: {P.indexed(slots, next, later) == True{} : Bool}) -> {LoopPolicy.has_omission(1n+left, slots, owner, all) == LoopPolicy.has_omission(1n+right, slots, owner, all) : Bool}:
  match slots:
    case []: {==}
    case Local.ReferenceSlot{+actual, +index, +symbol, +reference} <> +tail:
      +more: {Bool.and(P.forward_reference(reference, later), P.indexed(tail, (next + 1n : Nat), later)) == True{} : Bool} =
        BoolFacts.eq_true_of_and_right(Nat.is_eq(index, next), Bool.and(P.forward_reference(reference, later), P.indexed(tail, (next + 1n : Nat), later)), indexed)
      ready_actual_omission_slot_stable(actual, index, symbol, reference, tail, owner, left, right, all, later, stable,
        BoolFacts.eq_true_of_and_left(P.forward_reference(reference, later), P.indexed(tail, (next + 1n : Nat), later), more),
        ready_actual_omission_slots_stable(tail, left, right, owner, all, later, (next + 1n : Nat), stable,
          BoolFacts.eq_true_of_and_right(P.forward_reference(reference, later), P.indexed(tail, (next + 1n : Nat), later), more)))

def ready_actual_omission_owner_stable(+id: Nat, +left: Nat, +right: Nat, +slots: List<&2, Local.ReferenceSlot>, +later: List<&2, Local.PlannedNode>, stable: {ready_actual_omission_stable(later, left, right, slots) == True{} : Bool}, indexed: {P.indexed(P.owner_slots(slots, id), 0n, later) == True{} : Bool}) -> {LoopPolicy.has_omission(1n+left, slots, id, slots) == LoopPolicy.has_omission(1n+right, slots, id, slots) : Bool}:
  Equal.trans(Bool, LoopPolicy.has_omission(1n+left, slots, id, slots), LoopPolicy.has_omission(1n+left, P.owner_slots(slots, id), id, slots), LoopPolicy.has_omission(1n+right, slots, id, slots),
    ready_actual_omission_filter(slots, 1n+left, id, slots),
    Equal.trans(Bool, LoopPolicy.has_omission(1n+left, P.owner_slots(slots, id), id, slots), LoopPolicy.has_omission(1n+right, P.owner_slots(slots, id), id, slots), LoopPolicy.has_omission(1n+right, slots, id, slots),
      ready_actual_omission_slots_stable(P.owner_slots(slots, id), left, right, id, slots, later, 0n, stable, indexed),
      Equal.sym(Bool, LoopPolicy.has_omission(1n+right, slots, id, slots), LoopPolicy.has_omission(1n+right, P.owner_slots(slots, id), id, slots), ready_actual_omission_filter(slots, 1n+right, id, slots))))

def ready_actual_omission_equal_true(+left: Bool, +right: Bool, equal: {left == right : Bool}) -> {Cmp.is_eq(Bool.cmp(left, right)) == True{} : Bool}:
  %equal: {Cmp.is_eq(Bool.cmp(left, _)) == True{} : Bool}
  Equal.cong(Cmp, Bool, value => Cmp.is_eq(value), Bool.cmp(left, left), EQ{}, BoolFacts.cmp_refl(left))

def ready_actual_omission_suffix_stable(nodes: List<&2, Local.PlannedNode>, +left: Nat, +right: Nat, +slots: List<&2, Local.ReferenceSlot>, +forward: {P.forward_nodes(nodes, slots) == True{} : Bool}, +left_bound: NatFacts.le((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), left), +right_bound: NatFacts.le((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), right)) -> {ready_actual_omission_stable(nodes, left, right, slots) == True{} : Bool}:
  match nodes left right:
    case Nil{} _ _: {==}
    case Local.PlannedNode{_, _} <> _ 0n _:
      Empty.absurd({ready_actual_omission_stable(nodes, 0n, right, slots) == True{} : Bool}, BoolFacts.internal_false_ne_true(left_bound))
    case Local.PlannedNode{_, _} <> _ 1n+_ 0n:
      Empty.absurd({ready_actual_omission_stable(nodes, left, 0n, slots) == True{} : Bool}, BoolFacts.internal_false_ne_true(right_bound))
    case Local.PlannedNode{+id, _} <> +tail 1n++lower 1n++upper:
      +tail_forward: {P.forward_nodes(tail, slots) == True{} : Bool} =
        BoolFacts.eq_true_of_and_right(P.indexed(P.owner_slots(slots, id), 0n, tail), P.forward_nodes(tail, slots), forward)
      BoolFacts.and_eq_true(Cmp.is_eq(Bool.cmp(LoopPolicy.has_omission(left, slots, id, slots), LoopPolicy.has_omission(right, slots, id, slots))), ready_actual_omission_stable(tail, left, right, slots),
        ready_actual_omission_equal_true(LoopPolicy.has_omission(left, slots, id, slots), LoopPolicy.has_omission(right, slots, id, slots),
          ready_actual_omission_owner_stable(id, lower, upper, slots, tail,
            ready_actual_omission_suffix_stable(tail, lower, upper, slots, tail_forward, left_bound, right_bound),
            BoolFacts.eq_true_of_and_left(P.indexed(P.owner_slots(slots, id), 0n, tail), P.forward_nodes(tail, slots), forward))),
        ready_actual_omission_suffix_stable(tail, left, right, slots, tail_forward,
          NatFacts.le_trans((List.length(&2, Local.PlannedNode, tail) + 1n : Nat), 1n+(List.length(&2, Local.PlannedNode, tail) + 1n : Nat), left,
            NatFacts.le_succ((List.length(&2, Local.PlannedNode, tail) + 1n : Nat)), left_bound),
          NatFacts.le_trans((List.length(&2, Local.PlannedNode, tail) + 1n : Nat), 1n+(List.length(&2, Local.PlannedNode, tail) + 1n : Nat), right,
            NatFacts.le_succ((List.length(&2, Local.PlannedNode, tail) + 1n : Nat)), right_bound)))

# Proof-only observation of the existing address correspondence. The value
# inspected is the actual omission predicate at the fixed adequate fuel.
def ready_actual_address_omission(entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, +query: O.NodeAddress) -> Bool:
  match entries:
    case []: False{}
    case F.AddressEntry{id, address} <> tail:
      Bool.or(Bool.and(F.same_address(query, address), LoopPolicy.has_omission(fuel, slots, id, slots)),
        ready_actual_address_omission(tail, fuel, slots, query))

def ready_actual_address_absent_step(same: Bool, +value: Bool, +rest: Bool, +count: Nat, zero: {(Bool.pick(Nat, same, 1n, 0n) + count : Nat) == 0n : Nat}, continue: {count == 0n : Nat} -> {rest == False{} : Bool}) -> {Bool.or(Bool.and(same, value), rest) == False{} : Bool}:
  match same:
    case False{}: continue(zero)
    case True{}:
      Empty.absurd({Bool.or(value, rest) == False{} : Bool}, Arithmetic.internal_succ_ne_zero(count, zero))

def ready_actual_address_absent(entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, +query: O.NodeAddress, zero: {P.address_count(entries, query) == 0n : Nat}) -> {ready_actual_address_omission(entries, fuel, slots, query) == False{} : Bool}:
  match entries:
    case []: {==}
    case F.AddressEntry{+id, +address} <> +tail:
      ready_actual_address_absent_step(F.same_address(query, address), LoopPolicy.has_omission(fuel, slots, id, slots),
        ready_actual_address_omission(tail, fuel, slots, query), P.address_count(tail, query), zero,
        tail_zero => ready_actual_address_absent(tail, fuel, slots, query, tail_zero))

def ready_actual_address_found(+address: O.NodeAddress, +query: O.NodeAddress, +tail_count: Nat, found: {Some{address} == Some{query} : Maybe<&2, O.NodeAddress>}) -> NatFacts.le(1n, (Bool.pick(Nat, F.same_address(query, address), 1n, 0n) + tail_count : Nat)):
  %Count.some_equal(O.NodeAddress, address, query, found):
    NatFacts.le(1n, (Bool.pick(Nat, F.same_address(_, address), 1n, 0n) + tail_count : Nat))
  %Equal.sym(Bool, F.same_address(address, address), True{}, ForestLookup.address_refl(address)):
    NatFacts.le(1n, (Bool.pick(Nat, _, 1n, 0n) + tail_count : Nat))
  NatFacts.zero_le(tail_count)

def ready_actual_address_present_step(same: Bool, +address: O.NodeAddress, +query: O.NodeAddress, +tail_count: Nat, +tail_lookup: Maybe<&2, O.NodeAddress>, found: {Bool.pick(Maybe<&2, O.NodeAddress>, same, Some{address}, tail_lookup) == Some{query} : Maybe<&2, O.NodeAddress>}, continue: {tail_lookup == Some{query} : Maybe<&2, O.NodeAddress>} -> NatFacts.le(1n, tail_count)) -> NatFacts.le(1n, (Bool.pick(Nat, F.same_address(query, address), 1n, 0n) + tail_count : Nat)):
  match same:
    case True{}: ready_actual_address_found(address, query, tail_count, found)
    case False{}:
      NatFacts.le_trans(1n, tail_count, (Bool.pick(Nat, F.same_address(query, address), 1n, 0n) + tail_count : Nat),
        continue(found), NatFacts.add_le_add_right(0n, Bool.pick(Nat, F.same_address(query, address), 1n, 0n), tail_count,
          NatFacts.zero_le(Bool.pick(Nat, F.same_address(query, address), 1n, 0n))))

def ready_actual_address_present(entries: List<&2, F.AddressEntry>, +id: Nat, +query: O.NodeAddress, found: {F.address_at(entries, id) == Some{query} : Maybe<&2, O.NodeAddress>}) -> NatFacts.le(1n, P.address_count(entries, query)):
  match entries:
    case []:
      Empty.absurd(NatFacts.le(1n, 0n), Contents.none_some(O.NodeAddress, query, found))
    case F.AddressEntry{+other, +address} <> +tail:
      ready_actual_address_present_step(Nat.is_eq(other, id), address, query, P.address_count(tail, query), F.address_at(tail, id), found,
        tail_found => ready_actual_address_present(tail, id, query, tail_found))

def ready_actual_address_head(+id: Nat, +address: O.NodeAddress, +tail: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, unique: NatFacts.le(P.address_count(F.AddressEntry{id, address} <> tail, address), 1n)) -> {ready_actual_address_omission(F.AddressEntry{id, address} <> tail, fuel, slots, address) == LoopPolicy.has_omission(fuel, slots, id, slots) : Bool}:
  tail_zero: {P.address_count(tail, address) == 0n : Nat} = ready_capture_tail_zero(P.address_count(tail, address),
    %ForestLookup.address_refl(address):
      NatFacts.le((Bool.pick(Nat, _, 1n, 0n) + P.address_count(tail, address) : Nat), 1n)
    unique)
  %Equal.sym(Bool, F.same_address(address, address), True{}, ForestLookup.address_refl(address)):
    {Bool.or(Bool.and(_, LoopPolicy.has_omission(fuel, slots, id, slots)), ready_actual_address_omission(tail, fuel, slots, address))
      == LoopPolicy.has_omission(fuel, slots, id, slots) : Bool}
  Equal.trans(Bool,
    Bool.or(LoopPolicy.has_omission(fuel, slots, id, slots), ready_actual_address_omission(tail, fuel, slots, address)),
    Bool.or(LoopPolicy.has_omission(fuel, slots, id, slots), False{}), LoopPolicy.has_omission(fuel, slots, id, slots),
    Equal.cong(Bool, Bool, rest => Bool.or(LoopPolicy.has_omission(fuel, slots, id, slots), rest),
      ready_actual_address_omission(tail, fuel, slots, address), False{}, ready_actual_address_absent(tail, fuel, slots, address, tail_zero)),
    BoolFacts.or_false(LoopPolicy.has_omission(fuel, slots, id, slots)))

def ready_actual_address_selected(+other: Nat, +id: Nat, +address: O.NodeAddress, +query: O.NodeAddress, +tail: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, same: {Nat.is_eq(other, id) == True{} : Bool}, found: {Some{address} == Some{query} : Maybe<&2, O.NodeAddress>}, unique: NatFacts.le(P.address_count(F.AddressEntry{other, address} <> tail, query), 1n)) -> {ready_actual_address_omission(F.AddressEntry{other, address} <> tail, fuel, slots, query) == LoopPolicy.has_omission(fuel, slots, id, slots) : Bool}:
  +address_equal: {address == query : O.NodeAddress} = Count.some_equal(O.NodeAddress, address, query, found)
  Equal.trans(Bool,
    ready_actual_address_omission(F.AddressEntry{other, address} <> tail, fuel, slots, query),
    ready_actual_address_omission(F.AddressEntry{other, address} <> tail, fuel, slots, address),
    LoopPolicy.has_omission(fuel, slots, id, slots),
    Equal.cong(O.NodeAddress, Bool, value => ready_actual_address_omission(F.AddressEntry{other, address} <> tail, fuel, slots, value),
      query, address, Equal.sym(O.NodeAddress, address, query, address_equal)),
    Equal.trans(Bool, ready_actual_address_omission(F.AddressEntry{other, address} <> tail, fuel, slots, address),
      LoopPolicy.has_omission(fuel, slots, other, slots), LoopPolicy.has_omission(fuel, slots, id, slots),
      ready_actual_address_head(other, address, tail, fuel, slots,
        %Equal.sym(O.NodeAddress, address, query, address_equal):
          NatFacts.le(P.address_count(F.AddressEntry{other, address} <> tail, _), 1n)
        unique),
      Equal.cong(Nat, Bool, value => LoopPolicy.has_omission(fuel, slots, value, slots), other, id,
        NatFacts.eq_of_is_eq(other, id, same))))

def ready_actual_address_skipped(same: Bool, +head: Bool, +tail: Bool, +value: Bool, +count: Nat, unique: NatFacts.le((Bool.pick(Nat, same, 1n, 0n) + count : Nat), 1n), positive: NatFacts.le(1n, count), continue: NatFacts.le(count, 1n) -> {tail == value : Bool}) -> {Bool.or(Bool.and(same, head), tail) == value : Bool}:
  match same:
    case False{}: continue(unique)
    case True{}:
      Empty.absurd({Bool.or(head, tail) == value : Bool}, BoolFacts.internal_false_ne_true(
        %ready_capture_tail_zero(count, unique): NatFacts.le(1n, _)
        positive))

def ready_actual_address_lookup_step(same: Bool, +other: Nat, +id: Nat, +address: O.NodeAddress, +query: O.NodeAddress, +tail: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, selected: {Nat.is_eq(other, id) == same : Bool}, +found: {Bool.pick(Maybe<&2, O.NodeAddress>, same, Some{address}, F.address_at(tail, id)) == Some{query} : Maybe<&2, O.NodeAddress>}, unique: NatFacts.le(P.address_count(F.AddressEntry{other, address} <> tail, query), 1n), continue: {F.address_at(tail, id) == Some{query} : Maybe<&2, O.NodeAddress>} -> NatFacts.le(P.address_count(tail, query), 1n) -> {ready_actual_address_omission(tail, fuel, slots, query) == LoopPolicy.has_omission(fuel, slots, id, slots) : Bool}) -> {ready_actual_address_omission(F.AddressEntry{other, address} <> tail, fuel, slots, query) == LoopPolicy.has_omission(fuel, slots, id, slots) : Bool}:
  match same:
    case True{}: ready_actual_address_selected(other, id, address, query, tail, fuel, slots, selected, found, unique)
    case False{}:
      ready_actual_address_skipped(F.same_address(query, address), LoopPolicy.has_omission(fuel, slots, other, slots),
        ready_actual_address_omission(tail, fuel, slots, query), LoopPolicy.has_omission(fuel, slots, id, slots),
        P.address_count(tail, query), unique, ready_actual_address_present(tail, id, query, found), continue(found))

def ready_actual_address_lookup(entries: List<&2, F.AddressEntry>, +id: Nat, +query: O.NodeAddress, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, found: {F.address_at(entries, id) == Some{query} : Maybe<&2, O.NodeAddress>}, unique: NatFacts.le(P.address_count(entries, query), 1n)) -> {ready_actual_address_omission(entries, fuel, slots, query) == LoopPolicy.has_omission(fuel, slots, id, slots) : Bool}:
  match entries:
    case []:
      Empty.absurd({False{} == LoopPolicy.has_omission(fuel, slots, id, slots) : Bool}, Contents.none_some(O.NodeAddress, query, found))
    case F.AddressEntry{+other, +address} <> +tail:
      ready_actual_address_lookup_step(Nat.is_eq(other, id), other, id, address, query, tail, fuel, slots, {==}, found, unique,
        tail_found => tail_unique => ready_actual_address_lookup(tail, id, query, fuel, slots, tail_found, tail_unique))

def ready_actual_reference_omission(references: List<&2, F.Reference>, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>) -> Bool:
  match references:
    case []: False{}
    case F.Included{_, _} <> tail: ready_actual_reference_omission(tail, entries, fuel, slots)
    case F.Omitted{_, _, _} <> _: True{}
    case F.Expanded{_, child} <> tail:
      Bool.or(ready_actual_address_omission(entries, fuel, slots, child), ready_actual_reference_omission(tail, entries, fuel, slots))

def ready_actual_work_item_omission(item: D.OmissionWork, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>) -> Bool:
  match item:
    case D.OmissionAddress{address}: ready_actual_address_omission(entries, fuel, slots, address)
    case D.OmissionReferences{references}: ready_actual_reference_omission(references, entries, fuel, slots)

def ready_actual_work_omission(work: List<&2, D.OmissionWork>, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>) -> Bool:
  match work:
    case []: False{}
    case head <> tail:
      Bool.or(ready_actual_work_item_omission(head, entries, fuel, slots), ready_actual_work_omission(tail, entries, fuel, slots))

def ready_actual_work_reference_step(references: List<&2, F.Reference>, +rest: List<&2, D.OmissionWork>, +all: List<&2, F.Node>, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, clear: {D.omission_found(D.OmissionReferences{references}) == False{} : Bool}) -> Exists(List<&2, D.OmissionWork>, next => {D.omission_step(D.OmissionReferences{references}, rest, all) == Some{next} : Maybe<&2, List<&2, D.OmissionWork>>} & {ready_actual_work_omission(D.OmissionReferences{references} <> rest, entries, fuel, slots) == ready_actual_work_omission(next, entries, fuel, slots) : Bool}):
  match references:
    case []: Tuple{rest, Tuple{{==}, {==}}}
    case F.Included{_, _} <> tail: Tuple{D.OmissionReferences{tail} <> rest, Tuple{{==}, {==}}}
    case F.Expanded{_, +child} <> +tail:
      Tuple{D.OmissionAddress{child} <> D.OmissionReferences{tail} <> rest, Tuple{{==},
        BoolFacts.or_assoc(ready_actual_address_omission(entries, fuel, slots, child), ready_actual_reference_omission(tail, entries, fuel, slots),
          ready_actual_work_omission(rest, entries, fuel, slots))}}
    case F.Omitted{symbol, target, reason} <> tail:
      Empty.absurd(Exists(List<&2, D.OmissionWork>, next =>
        {D.omission_step(D.OmissionReferences{F.Omitted{symbol, target, reason} <> tail}, rest, all) == Some{next} : Maybe<&2, List<&2, D.OmissionWork>>} &
        {ready_actual_work_omission(D.OmissionReferences{F.Omitted{symbol, target, reason} <> tail} <> rest, entries, fuel, slots)
          == ready_actual_work_omission(next, entries, fuel, slots) : Bool}),
        BoolFacts.internal_false_ne_true(Equal.sym(Bool, True{}, False{}, clear)))

def ready_projected_address_observation(+nodes: List<&2, Local.PlannedNode>, +entries: List<&2, F.AddressEntry>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +retained: List<&2, F.Node>, +id: Nat, +address: O.NodeAddress, +fuel: Nat, aligned: {P.aligned(nodes, entries, nodes, entries) == True{} : Bool}, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, projected: {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>}, found: {F.address_at(entries, id) == Some{address} : Maybe<&2, O.NodeAddress>}, unique: {F.count_address(retained, address) == 1n : Nat}) -> {ready_actual_address_omission(entries, fuel, slots, address) == LoopPolicy.has_omission(fuel, slots, id, slots) : Bool}:
  ready_actual_address_lookup(entries, id, address, fuel, slots, found,
    %Equal.sym(Nat, P.address_count(entries, address), 1n,
      Equal.trans(Nat, P.address_count(entries, address), F.count_address(retained, address), 1n,
        Parent.projected_address_count(nodes, entries, slots, catalog, retained, address, aligned, dense, projected), unique)):
      NatFacts.le(_, 1n)
    NatFacts.le_refl(1n))

def ready_actual_omission_fixed(+nodes: List<&2, Local.PlannedNode>, +slots: List<&2, Local.ReferenceSlot>, +id: Nat, forward: {P.forward_nodes(nodes, slots) == True{} : Bool}, present: NatFacts.le(1n, P.node_count(nodes, id))) -> {LoopPolicy.has_omission((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, id, slots) == LoopPolicy.has_omission(1n+(List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, id, slots) : Bool}:
  ready_actual_omission_query(nodes, id, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat),
    1n+(List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots,
    ready_actual_omission_suffix_stable(nodes, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat),
      1n+(List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, forward,
      NatFacts.le_refl((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat)),
      NatFacts.le_succ((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat))), present)

def ready_projected_expanded_observation(+nodes: List<&2, Local.PlannedNode>, +entries: List<&2, F.AddressEntry>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +retained: List<&2, F.Node>, +id: Nat, +symbol: String, +reference: F.Reference, +fuel: Nat, lookup: Maybe<&2, O.NodeAddress>, +located: {F.address_at(entries, id) == lookup : Maybe<&2, O.NodeAddress>}, aligned: {P.aligned(nodes, entries, nodes, entries) == True{} : Bool}, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, projected: {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>}, observed: {P.expanded_reference(lookup, symbol) == Some{reference} : Maybe<&2, F.Reference>}, valid: {ready_omission_reference_targets([reference], retained) == True{} : Bool}) -> {ready_actual_reference_omission([reference], entries, fuel, slots) == LoopPolicy.has_omission(fuel, slots, id, slots) : Bool}:
  match lookup:
    case None{}:
      Empty.absurd({ready_actual_reference_omission([reference], entries, fuel, slots) == LoopPolicy.has_omission(fuel, slots, id, slots) : Bool},
        Contents.none_some(F.Reference, reference, observed))
    case Some{+address}:
      +same: {F.Expanded{F.ReferenceSymbol{symbol}, address} == reference : F.Reference} =
        Count.some_equal(F.Reference, F.Expanded{F.ReferenceSymbol{symbol}, address}, reference, observed)
      target_valid: {ready_omission_reference_targets([F.Expanded{F.ReferenceSymbol{symbol}, address}], retained) == True{} : Bool} =
        %Equal.sym(F.Reference, F.Expanded{F.ReferenceSymbol{symbol}, address}, reference, same):
          {ready_omission_reference_targets([_], retained) == True{} : Bool}
        valid
      %same:
        {ready_actual_reference_omission([_], entries, fuel, slots) == LoopPolicy.has_omission(fuel, slots, id, slots) : Bool}
      Equal.trans(Bool, Bool.or(ready_actual_address_omission(entries, fuel, slots, address), False{}),
        ready_actual_address_omission(entries, fuel, slots, address), LoopPolicy.has_omission(fuel, slots, id, slots),
        BoolFacts.or_false(ready_actual_address_omission(entries, fuel, slots, address)),
        ready_projected_address_observation(nodes, entries, slots, catalog, retained, id, address, fuel, aligned, dense, projected, located,
          NatFacts.eq_of_is_eq(F.count_address(retained, address), 1n,
            BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(retained, address), 1n), True{}, target_valid))))

def ready_actual_reference_cons(+head: F.Reference, +tail: List<&2, F.Reference>, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>) -> {ready_actual_reference_omission(head <> tail, entries, fuel, slots) == Bool.or(ready_actual_reference_omission([head], entries, fuel, slots), ready_actual_reference_omission(tail, entries, fuel, slots)) : Bool}:
  match head:
    case F.Included{_, _}: {==}
    case F.Omitted{_, _, _}: {==}
    case F.Expanded{_, +child}:
      Equal.cong(Bool, Bool, value => Bool.or(value, ready_actual_reference_omission(tail, entries, fuel, slots)),
        ready_actual_address_omission(entries, fuel, slots, child), Bool.or(ready_actual_address_omission(entries, fuel, slots, child), False{}),
        BoolFacts.or_false_sym(ready_actual_address_omission(entries, fuel, slots, child)))

def ready_actual_reference_targets_cons(head: F.Reference, +tail: List<&2, F.Reference>, +nodes: List<&2, F.Node>, +valid: {ready_omission_reference_targets(head <> tail, nodes) == True{} : Bool}) -> {ready_omission_reference_targets([head], nodes) == True{} : Bool} & {ready_omission_reference_targets(tail, nodes) == True{} : Bool}:
  match head:
    case F.Included{_, _}: Tuple{{==}, valid}
    case F.Omitted{_, _, _}: Tuple{{==}, valid}
    case F.Expanded{_, +child}:
      Tuple{BoolFacts.and_eq_true(Nat.is_eq(F.count_address(nodes, child), 1n), True{},
        BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(nodes, child), 1n), ready_omission_reference_targets(tail, nodes), valid), {==}),
        BoolFacts.eq_true_of_and_right(Nat.is_eq(F.count_address(nodes, child), 1n), ready_omission_reference_targets(tail, nodes), valid)}

def ready_actual_omission_slot_or(+reference: Local.PlannedReference, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, +rest: Bool) -> {Bool.or(LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => False{}), rest) == LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => rest) : Bool}:
  match reference:
    case Local.Included{_}: {==}
    case Local.Omitted{_, _}: {==}
    case Local.Expanded{+child}:
      Equal.cong(Bool, Bool, value => Bool.or(value, rest), Bool.or(LoopPolicy.has_omission(fuel, slots, child, slots), False{}),
        LoopPolicy.has_omission(fuel, slots, child, slots), BoolFacts.or_false(LoopPolicy.has_omission(fuel, slots, child, slots)))

def ready_actual_slot_observation(+reference: Local.PlannedReference, +owner: Nat, +index: Nat, +symbol: String, +nodes: List<&2, Local.PlannedNode>, +entries: List<&2, F.AddressEntry>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +retained: List<&2, F.Node>, +head: F.Reference, +fuel: Nat, aligned: {P.aligned(nodes, entries, nodes, entries) == True{} : Bool}, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, projected: {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>}, observed: {P.reference(Local.ReferenceSlot{owner, index, symbol, reference}, entries) == Some{head} : Maybe<&2, F.Reference>}, valid: {ready_omission_reference_targets([head], retained) == True{} : Bool}) -> {ready_actual_reference_omission([head], entries, fuel, slots) == LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => False{}) : Bool}:
  match reference:
    case Local.Included{+identity}:
      %Count.some_equal(F.Reference, F.Included{F.ReferenceSymbol{symbol}, F.ArtifactIdentity{identity}}, head, observed):
        {ready_actual_reference_omission([_], entries, fuel, slots) == False{} : Bool}
      {==}
    case Local.Omitted{+reason, +target}:
      %Count.some_equal(F.Reference, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{target}, reason}, head, observed):
        {ready_actual_reference_omission([_], entries, fuel, slots) == True{} : Bool}
      {==}
    case Local.Expanded{+child}:
      Equal.trans(Bool, ready_actual_reference_omission([head], entries, fuel, slots), LoopPolicy.has_omission(fuel, slots, child, slots),
        Bool.or(LoopPolicy.has_omission(fuel, slots, child, slots), False{}),
        ready_projected_expanded_observation(nodes, entries, slots, catalog, retained, child, symbol, head, fuel, F.address_at(entries, child),
          {==}, aligned, dense, projected, observed, valid),
        BoolFacts.or_false_sym(LoopPolicy.has_omission(fuel, slots, child, slots)))

def ready_actual_reference_join(+head: F.Reference, +tail: List<&2, F.Reference>, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, +reference: Local.PlannedReference, +rest: Bool, head_equal: {ready_actual_reference_omission([head], entries, fuel, slots) == LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => False{}) : Bool}, tail_equal: {ready_actual_reference_omission(tail, entries, fuel, slots) == rest : Bool}) -> {ready_actual_reference_omission(head <> tail, entries, fuel, slots) == LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => rest) : Bool}:
  Equal.trans(Bool, ready_actual_reference_omission(head <> tail, entries, fuel, slots),
    Bool.or(ready_actual_reference_omission([head], entries, fuel, slots), ready_actual_reference_omission(tail, entries, fuel, slots)),
    LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => rest),
    ready_actual_reference_cons(head, tail, entries, fuel, slots),
    Equal.trans(Bool,
      Bool.or(ready_actual_reference_omission([head], entries, fuel, slots), ready_actual_reference_omission(tail, entries, fuel, slots)),
      Bool.or(LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => False{}), rest),
      LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => rest),
      Equal.trans(Bool,
        Bool.or(ready_actual_reference_omission([head], entries, fuel, slots), ready_actual_reference_omission(tail, entries, fuel, slots)),
        Bool.or(LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => False{}), ready_actual_reference_omission(tail, entries, fuel, slots)),
        Bool.or(LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => False{}), rest),
        Equal.cong(Bool, Bool, value => Bool.or(value, ready_actual_reference_omission(tail, entries, fuel, slots)),
          ready_actual_reference_omission([head], entries, fuel, slots),
          LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => False{}), head_equal),
        Equal.cong(Bool, Bool, value => Bool.or(LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => False{}), value),
          ready_actual_reference_omission(tail, entries, fuel, slots), rest, tail_equal)),
      ready_actual_omission_slot_or(reference, fuel, slots, rest)))

def ready_actual_references_parts(+reference: Local.PlannedReference, +actual: Nat, +index: Nat, +symbol: String, +tail: List<&2, Local.ReferenceSlot>, +owner: Nat, +nodes: List<&2, Local.PlannedNode>, +entries: List<&2, F.AddressEntry>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +retained: List<&2, F.Node>, +refs: List<&2, F.Reference>, +fuel: Nat, aligned: {P.aligned(nodes, entries, nodes, entries) == True{} : Bool}, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, projected: {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>}, valid: {ready_omission_reference_targets(refs, retained) == True{} : Bool}, recursive: @+rest: List<&2, F.Reference> -> {P.references(P.owner_slots(tail, owner), entries) == Some{rest} : Maybe<&2, List<&2, F.Reference>>} -> {ready_omission_reference_targets(rest, retained) == True{} : Bool} -> {ready_actual_reference_omission(rest, entries, fuel, slots) == LoopPolicy.has_omission(1n+fuel, tail, owner, slots) : Bool}, contents: Exists(F.Reference, head => Exists(List<&2, F.Reference>, rest => {P.reference(Local.ReferenceSlot{actual, index, symbol, reference}, entries) == Some{head} : Maybe<&2, F.Reference>} & {P.references(P.owner_slots(tail, owner), entries) == Some{rest} : Maybe<&2, List<&2, F.Reference>>} & {Some{head <> rest} == Some{refs} : Maybe<&2, List<&2, F.Reference>>}))) -> {ready_actual_reference_omission(refs, entries, fuel, slots) == LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => LoopPolicy.has_omission(1n+fuel, tail, owner, slots)) : Bool}:
  match contents:
    case (+head, (+rest, (head_projected, (tail_projected, same)))):
      +rows_equal: {head <> rest == refs : List<&2, F.Reference>} = Count.some_equal(List<&2, F.Reference>, head <> rest, refs, same)
      +targets: {ready_omission_reference_targets(head <> rest, retained) == True{} : Bool} =
        %Equal.sym(List<&2, F.Reference>, head <> rest, refs, rows_equal):
          {ready_omission_reference_targets(_, retained) == True{} : Bool}
        valid
      %rows_equal:
        {ready_actual_reference_omission(_, entries, fuel, slots)
          == LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => LoopPolicy.has_omission(1n+fuel, tail, owner, slots)) : Bool}
      Parent.eliminate_pair({ready_omission_reference_targets([head], retained) == True{} : Bool},
        {ready_omission_reference_targets(rest, retained) == True{} : Bool},
        {ready_actual_reference_omission(head <> rest, entries, fuel, slots)
          == LoopPolicy.omission_slot(True{}, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => LoopPolicy.has_omission(1n+fuel, tail, owner, slots)) : Bool},
        ready_actual_reference_targets_cons(head, rest, retained, targets),
        head_valid => tail_valid => ready_actual_reference_join(head, rest, entries, fuel, slots, reference, LoopPolicy.has_omission(1n+fuel, tail, owner, slots),
          ready_actual_slot_observation(reference, actual, index, symbol, nodes, entries, slots, catalog, retained, head, fuel,
            aligned, dense, projected, head_projected, head_valid), recursive(rest)(tail_projected)(tail_valid)))

def ready_actual_references_step(same: Bool, +actual: Nat, +index: Nat, +symbol: String, +reference: Local.PlannedReference, +tail: List<&2, Local.ReferenceSlot>, +owner: Nat, +nodes: List<&2, Local.PlannedNode>, +entries: List<&2, F.AddressEntry>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +retained: List<&2, F.Node>, +refs: List<&2, F.Reference>, +fuel: Nat, +selected: {Nat.is_eq(actual, owner) == same : Bool}, aligned: {P.aligned(nodes, entries, nodes, entries) == True{} : Bool}, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, projected: {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>}, observed: {P.references(P.owner_slots(Local.ReferenceSlot{actual, index, symbol, reference} <> tail, owner), entries) == Some{refs} : Maybe<&2, List<&2, F.Reference>>}, valid: {ready_omission_reference_targets(refs, retained) == True{} : Bool}, recursive: @+rest: List<&2, F.Reference> -> {P.references(P.owner_slots(tail, owner), entries) == Some{rest} : Maybe<&2, List<&2, F.Reference>>} -> {ready_omission_reference_targets(rest, retained) == True{} : Bool} -> {ready_actual_reference_omission(rest, entries, fuel, slots) == LoopPolicy.has_omission(1n+fuel, tail, owner, slots) : Bool}) -> {ready_actual_reference_omission(refs, entries, fuel, slots) == LoopPolicy.has_omission(1n+fuel, Local.ReferenceSlot{actual, index, symbol, reference} <> tail, owner, slots) : Bool}:
  match same:
    case False{}:
      %Equal.sym(Bool, Nat.is_eq(actual, owner), False{}, selected):
        {ready_actual_reference_omission(refs, entries, fuel, slots)
          == LoopPolicy.omission_slot(_, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => LoopPolicy.has_omission(1n+fuel, tail, owner, slots)) : Bool}
      recursive(refs)(
        %selected:
          {P.references(Bool.pick(List<&2, Local.ReferenceSlot>, _, Local.ReferenceSlot{actual, index, symbol, reference} <> P.owner_slots(tail, owner), P.owner_slots(tail, owner)), entries)
            == Some{refs} : Maybe<&2, List<&2, F.Reference>>}
        observed)(valid)
    case True{}:
      %Equal.sym(Bool, Nat.is_eq(actual, owner), True{}, selected):
        {ready_actual_reference_omission(refs, entries, fuel, slots)
          == LoopPolicy.omission_slot(_, reference, child => LoopPolicy.has_omission(fuel, slots, child, slots), _ => LoopPolicy.has_omission(1n+fuel, tail, owner, slots)) : Bool}
      ready_actual_references_parts(reference, actual, index, symbol, tail, owner, nodes, entries, slots, catalog, retained, refs, fuel,
        aligned, dense, projected, valid, recursive,
        Count.reference_prefix_contents(P.reference(Local.ReferenceSlot{actual, index, symbol, reference}, entries), P.references(P.owner_slots(tail, owner), entries), refs,
          %selected:
            {P.references(Bool.pick(List<&2, Local.ReferenceSlot>, _, Local.ReferenceSlot{actual, index, symbol, reference} <> P.owner_slots(tail, owner), P.owner_slots(tail, owner)), entries)
              == Some{refs} : Maybe<&2, List<&2, F.Reference>>}
          observed))

def ready_actual_references_observation(items: List<&2, Local.ReferenceSlot>, +owner: Nat, +nodes: List<&2, Local.PlannedNode>, +entries: List<&2, F.AddressEntry>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +retained: List<&2, F.Node>, +refs: List<&2, F.Reference>, +fuel: Nat, +aligned: {P.aligned(nodes, entries, nodes, entries) == True{} : Bool}, +dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, +projected: {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>}, observed: {P.references(P.owner_slots(items, owner), entries) == Some{refs} : Maybe<&2, List<&2, F.Reference>>}, valid: {ready_omission_reference_targets(refs, retained) == True{} : Bool}) -> {ready_actual_reference_omission(refs, entries, fuel, slots) == LoopPolicy.has_omission(1n+fuel, items, owner, slots) : Bool}:
  match items:
    case []:
      %Count.some_equal(List<&2, F.Reference>, [], refs, observed):
        {ready_actual_reference_omission(_, entries, fuel, slots) == False{} : Bool}
      {==}
    case Local.ReferenceSlot{+actual, +index, +symbol, +reference} <> +tail:
      ready_actual_references_step(Nat.is_eq(actual, owner), actual, index, symbol, reference, tail, owner, nodes, entries, slots, catalog, retained, refs, fuel,
        {==}, aligned, dense, projected, observed, valid,
        rest => tail_projected => tail_valid => ready_actual_references_observation(tail, owner, nodes, entries, slots, catalog, retained, rest, fuel,
          aligned, dense, projected, tail_projected, tail_valid))

def ready_actual_node_fixed(+nodes: List<&2, Local.PlannedNode>, +entries: List<&2, F.AddressEntry>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +retained: List<&2, F.Node>, +id: Nat, +address: O.NodeAddress, +refs: List<&2, F.Reference>, +aligned: {P.aligned(nodes, entries, nodes, entries) == True{} : Bool}, +dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, +projected: {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>}, forward: {P.forward_nodes(nodes, slots) == True{} : Bool}, present: NatFacts.le(1n, P.node_count(nodes, id)), found: {F.address_at(entries, id) == Some{address} : Maybe<&2, O.NodeAddress>}, unique: {F.count_address(retained, address) == 1n : Nat}, references: {P.references(P.owner_slots(slots, id), entries) == Some{refs} : Maybe<&2, List<&2, F.Reference>>}, valid: {Relation.references_valid(refs, address, retained) == True{} : Bool}) -> {ready_actual_address_omission(entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, address) == ready_actual_reference_omission(refs, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots) : Bool}:
  Equal.trans(Bool,
    ready_actual_address_omission(entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, address),
    LoopPolicy.has_omission((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, id, slots),
    ready_actual_reference_omission(refs, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots),
    ready_projected_address_observation(nodes, entries, slots, catalog, retained, id, address,
      (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), aligned, dense, projected, found, unique),
    Equal.trans(Bool,
      LoopPolicy.has_omission((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, id, slots),
      LoopPolicy.has_omission(1n+(List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, id, slots),
      ready_actual_reference_omission(refs, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots),
      ready_actual_omission_fixed(nodes, slots, id, forward, present),
      Equal.sym(Bool,
        ready_actual_reference_omission(refs, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots),
        LoopPolicy.has_omission(1n+(List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, id, slots),
        ready_actual_references_observation(slots, id, nodes, entries, slots, catalog, retained, refs,
          (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), aligned, dense, projected, references,
          ready_omission_reference_targets_valid(refs, address, retained, valid)))))

def ready_actual_node_observations(nodes: List<&2, F.Node>, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>) -> Bool:
  match nodes:
    case []: True{}
    case F.Node{address, _, references} <> tail:
      Bool.and(Cmp.is_eq(Bool.cmp(ready_actual_address_omission(entries, fuel, slots, address),
        ready_actual_reference_omission(references, entries, fuel, slots))), ready_actual_node_observations(tail, entries, fuel, slots))

def ready_actual_node_observation_lookup_step(same: Bool, +address: O.NodeAddress, +artifact: T.Artifact, +references: List<&2, F.Reference>, +tail: List<&2, F.Node>, +query: O.NodeAddress, +found: F.Node, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, selected: {F.same_address(query, address) == same : Bool}, +valid: {ready_actual_node_observations(F.Node{address, artifact, references} <> tail, entries, fuel, slots) == True{} : Bool}, located: {Bool.pick(Maybe<&2, F.Node>, same, Some{F.Node{address, artifact, references}}, F.node_at(tail, query)) == Some{found} : Maybe<&2, F.Node>}, recursive: {ready_actual_node_observations(tail, entries, fuel, slots) == True{} : Bool} -> {F.node_at(tail, query) == Some{found} : Maybe<&2, F.Node>} -> {ready_actual_address_omission(entries, fuel, slots, query) == ready_actual_reference_omission(Rollback.node_references(found), entries, fuel, slots) : Bool}) -> {ready_actual_address_omission(entries, fuel, slots, query) == ready_actual_reference_omission(Rollback.node_references(found), entries, fuel, slots) : Bool}:
  match same:
    case False{}:
      recursive(BoolFacts.eq_true_of_and_right(Cmp.is_eq(Bool.cmp(ready_actual_address_omission(entries, fuel, slots, address),
        ready_actual_reference_omission(references, entries, fuel, slots))), ready_actual_node_observations(tail, entries, fuel, slots), valid))(located)
    case True{}:
      Equal.trans(Bool, ready_actual_address_omission(entries, fuel, slots, query), ready_actual_address_omission(entries, fuel, slots, address),
        ready_actual_reference_omission(Rollback.node_references(found), entries, fuel, slots),
        Equal.cong(O.NodeAddress, Bool, value => ready_actual_address_omission(entries, fuel, slots, value), query, address,
          Rollback.same_address_equal(query, address, selected)),
        Equal.trans(Bool, ready_actual_address_omission(entries, fuel, slots, address), ready_actual_reference_omission(references, entries, fuel, slots),
          ready_actual_reference_omission(Rollback.node_references(found), entries, fuel, slots),
          BoolFacts.eq_of_cmp_eq(ready_actual_address_omission(entries, fuel, slots, address), ready_actual_reference_omission(references, entries, fuel, slots),
            BoolFacts.eq_true_of_and_left(Cmp.is_eq(Bool.cmp(ready_actual_address_omission(entries, fuel, slots, address),
              ready_actual_reference_omission(references, entries, fuel, slots))), ready_actual_node_observations(tail, entries, fuel, slots), valid)),
          Equal.cong(F.Node, Bool, value => ready_actual_reference_omission(Rollback.node_references(value), entries, fuel, slots),
            F.Node{address, artifact, references}, found, Count.some_equal(F.Node, F.Node{address, artifact, references}, found, located))))

def ready_actual_node_observation_lookup(nodes: List<&2, F.Node>, +query: O.NodeAddress, +found: F.Node, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, valid: {ready_actual_node_observations(nodes, entries, fuel, slots) == True{} : Bool}, located: {F.node_at(nodes, query) == Some{found} : Maybe<&2, F.Node>}) -> {ready_actual_address_omission(entries, fuel, slots, query) == ready_actual_reference_omission(Rollback.node_references(found), entries, fuel, slots) : Bool}:
  match nodes:
    case []:
      Empty.absurd({ready_actual_address_omission(entries, fuel, slots, query) == ready_actual_reference_omission(Rollback.node_references(found), entries, fuel, slots) : Bool},
        Contents.none_some(F.Node, found, located))
    case F.Node{+address, +artifact, +references} <> +tail:
      ready_actual_node_observation_lookup_step(F.same_address(query, address), address, artifact, references, tail, query, found, entries, fuel, slots,
        {==}, valid, located, tail_valid => tail_found => ready_actual_node_observation_lookup(tail, query, found, entries, fuel, slots, tail_valid, tail_found))

def ready_actual_node_observation_contents(+nodes: List<&2, Local.PlannedNode>, +entries: List<&2, F.AddressEntry>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +retained: List<&2, F.Node>, +id: Nat, +handle: Nat, +head: F.Node, aligned: {P.aligned(nodes, entries, nodes, entries) == True{} : Bool}, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, projected: {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>}, forward: {P.forward_nodes(nodes, slots) == True{} : Bool}, present: NatFacts.le(1n, P.node_count(nodes, id)), valid: {Relation.nodes_valid([head], retained) == True{} : Bool}, contents: Exists(O.NodeAddress, address => Exists(T.Artifact, artifact => Exists(List<&2, F.Reference>, refs => {F.address_at(entries, id) == Some{address} : Maybe<&2, O.NodeAddress>} & {F.artifact_at(catalog, handle) == Some{artifact} : Maybe<&2, T.Artifact>} & {P.references(P.owner_slots(slots, id), entries) == Some{refs} : Maybe<&2, List<&2, F.Reference>>} & {Some{F.Node{address, artifact, refs}} == Some{head} : Maybe<&2, F.Node>})))) -> {ready_actual_node_observations([head], entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots) == True{} : Bool}:
  match contents:
    case (+address, (+artifact, (+refs, (found, (_, (references, same)))))):
      +node_equal: {F.Node{address, artifact, refs} == head : F.Node} = Count.some_equal(F.Node, F.Node{address, artifact, refs}, head, same)
      +head_valid: {Relation.nodes_valid([F.Node{address, artifact, refs}], retained) == True{} : Bool} =
        %Equal.sym(F.Node, F.Node{address, artifact, refs}, head, node_equal): {Relation.nodes_valid([_], retained) == True{} : Bool}
        valid
      %node_equal:
        {ready_actual_node_observations([_], entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots) == True{} : Bool}
      BoolFacts.and_eq_true(Cmp.is_eq(Bool.cmp(
        ready_actual_address_omission(entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, address),
        ready_actual_reference_omission(refs, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots))), True{},
        ready_actual_omission_equal_true(
          ready_actual_address_omission(entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, address),
          ready_actual_reference_omission(refs, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots),
          ready_actual_node_fixed(nodes, entries, slots, catalog, retained, id, address, refs, aligned, dense, projected, forward, present, found,
            NatFacts.eq_of_is_eq(F.count_address(retained, address), 1n,
              BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(retained, address), 1n),
                Bool.and(Nat.is_le(Relation.incoming(retained, address), 1n), Bool.and(Relation.references_valid(refs, address, retained), True{})), head_valid)), references,
            BoolFacts.eq_true_of_and_left(Relation.references_valid(refs, address, retained), True{},
              BoolFacts.eq_true_of_and_right(Nat.is_le(Relation.incoming(retained, address), 1n), Bool.and(Relation.references_valid(refs, address, retained), True{}),
                BoolFacts.eq_true_of_and_right(Nat.is_eq(F.count_address(retained, address), 1n),
                  Bool.and(Nat.is_le(Relation.incoming(retained, address), 1n), Bool.and(Relation.references_valid(refs, address, retained), True{})), head_valid))))), {==})

def ready_actual_node_observations_cons(+head: F.Node, +tail: List<&2, F.Node>, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, first: {ready_actual_node_observations([head], entries, fuel, slots) == True{} : Bool}, rest: {ready_actual_node_observations(tail, entries, fuel, slots) == True{} : Bool}) -> {ready_actual_node_observations(head <> tail, entries, fuel, slots) == True{} : Bool}:
  match head:
    case F.Node{+address, _, +references}:
      BoolFacts.and_eq_true(Cmp.is_eq(Bool.cmp(ready_actual_address_omission(entries, fuel, slots, address),
        ready_actual_reference_omission(references, entries, fuel, slots))), ready_actual_node_observations(tail, entries, fuel, slots),
        BoolFacts.eq_true_of_and_left(Cmp.is_eq(Bool.cmp(ready_actual_address_omission(entries, fuel, slots, address),
          ready_actual_reference_omission(references, entries, fuel, slots))), True{}, first), rest)

def ready_actual_node_observations_parts(+id: Nat, +handle: Nat, +tail: List<&2, Local.PlannedNode>, +nodes: List<&2, Local.PlannedNode>, +entries: List<&2, F.AddressEntry>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +retained: List<&2, F.Node>, +current: List<&2, F.Node>, aligned: {P.aligned(nodes, entries, nodes, entries) == True{} : Bool}, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, projected: {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>}, forward: {P.forward_nodes(nodes, slots) == True{} : Bool}, present: NatFacts.le(1n, P.node_count(nodes, id)), valid: {Relation.nodes_valid(current, retained) == True{} : Bool}, recursive: @+rest: List<&2, F.Node> -> {P.nodes(tail, slots, catalog, entries) == Some{rest} : Maybe<&2, List<&2, F.Node>>} -> {Relation.nodes_valid(rest, retained) == True{} : Bool} -> {ready_actual_node_observations(rest, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots) == True{} : Bool}, contents: Exists(F.Node, head => Exists(List<&2, F.Node>, rest => {P.projected_node(F.address_at(entries, id), F.artifact_at(catalog, handle), P.references(P.owner_slots(slots, id), entries)) == Some{head} : Maybe<&2, F.Node>} & {P.nodes(tail, slots, catalog, entries) == Some{rest} : Maybe<&2, List<&2, F.Node>>} & {Some{head <> rest} == Some{current} : Maybe<&2, List<&2, F.Node>>}))) -> {ready_actual_node_observations(current, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots) == True{} : Bool}:
  match contents:
    case (+head, (+rest, (head_projected, (tail_projected, same)))):
      +rows_equal: {head <> rest == current : List<&2, F.Node>} = Count.some_equal(List<&2, F.Node>, head <> rest, current, same)
      +rows_valid: {Relation.nodes_valid(head <> rest, retained) == True{} : Bool} =
        %Equal.sym(List<&2, F.Node>, head <> rest, current, rows_equal): {Relation.nodes_valid(_, retained) == True{} : Bool}
        valid
      %rows_equal:
        {ready_actual_node_observations(_, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots) == True{} : Bool}
      ready_actual_node_observations_cons(head, rest, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots,
        ready_actual_node_observation_contents(nodes, entries, slots, catalog, retained, id, handle, head, aligned, dense, projected, forward, present,
          ready_omission_keep_valid_head(head, rest, [], retained, rows_valid, {==}),
          Contents.node_contents(F.address_at(entries, id), F.artifact_at(catalog, handle), P.references(P.owner_slots(slots, id), entries), head, head_projected)),
        recursive(rest)(tail_projected)(Equal.sym(Bool, True{}, Relation.nodes_valid(rest, retained),
          Rollback.nodes_tail(head, rest, retained, Equal.sym(Bool, Relation.nodes_valid(head <> rest, retained), True{}, rows_valid)))))

def ready_actual_node_observations_cursor(items: List<&2, Local.PlannedNode>, cursor: List<&2, F.AddressEntry>, +nodes: List<&2, Local.PlannedNode>, +entries: List<&2, F.AddressEntry>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +retained: List<&2, F.Node>, +current: List<&2, F.Node>, +aligned: {P.aligned(nodes, entries, nodes, entries) == True{} : Bool}, +dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, +projected: {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>}, +forward: {P.forward_nodes(nodes, slots) == True{} : Bool}, cursor_aligned: {P.aligned(items, cursor, nodes, entries) == True{} : Bool}, current_projected: {P.nodes(items, slots, catalog, entries) == Some{current} : Maybe<&2, List<&2, F.Node>>}, valid: {Relation.nodes_valid(current, retained) == True{} : Bool}) -> {ready_actual_node_observations(current, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots) == True{} : Bool}:
  match items cursor:
    case Nil{} Nil{}:
      %Count.some_equal(List<&2, F.Node>, [], current, current_projected):
        {ready_actual_node_observations(_, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots) == True{} : Bool}
      {==}
    case Local.PlannedNode{+id, +handle} <> +tail F.AddressEntry{+other, +address} <> +rest:
      +counts: {Bool.and(Nat.is_eq(P.node_count(nodes, id), 1n), Bool.and(Nat.is_eq(P.address_count(entries, address), 1n), P.aligned(tail, rest, nodes, entries))) == True{} : Bool} =
        BoolFacts.eq_true_of_and_right(Nat.is_eq(id, other), Bool.and(Nat.is_eq(P.node_count(nodes, id), 1n), Bool.and(Nat.is_eq(P.address_count(entries, address), 1n), P.aligned(tail, rest, nodes, entries))), cursor_aligned)
      ready_actual_node_observations_parts(id, handle, tail, nodes, entries, slots, catalog, retained, current, aligned, dense, projected, forward,
        %Equal.sym(Nat, P.node_count(nodes, id), 1n, NatFacts.eq_of_is_eq(P.node_count(nodes, id), 1n,
          BoolFacts.eq_true_of_and_left(Nat.is_eq(P.node_count(nodes, id), 1n), Bool.and(Nat.is_eq(P.address_count(entries, address), 1n), P.aligned(tail, rest, nodes, entries)), counts))):
          NatFacts.le(1n, _)
        NatFacts.le_refl(1n), valid,
        next => next_projected => next_valid => ready_actual_node_observations_cursor(tail, rest, nodes, entries, slots, catalog, retained, next,
          aligned, dense, projected, forward,
          BoolFacts.eq_true_of_and_right(Nat.is_eq(P.address_count(entries, address), 1n), P.aligned(tail, rest, nodes, entries),
            BoolFacts.eq_true_of_and_right(Nat.is_eq(P.node_count(nodes, id), 1n), Bool.and(Nat.is_eq(P.address_count(entries, address), 1n), P.aligned(tail, rest, nodes, entries)), counts)),
          next_projected, next_valid),
        Contents.prefix_contents(P.projected_node(F.address_at(entries, id), F.artifact_at(catalog, handle), P.references(P.owner_slots(slots, id), entries)),
          P.nodes(tail, slots, catalog, entries), current, current_projected))
    case Nil{} Con{_, _}:
      Empty.absurd({ready_actual_node_observations(current, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots) == True{} : Bool}, BoolFacts.internal_false_ne_true(cursor_aligned))
    case Con{_, _} Nil{}:
      Empty.absurd({ready_actual_node_observations(current, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots) == True{} : Bool}, BoolFacts.internal_false_ne_true(cursor_aligned))

def ready_projected_node_observations(+nodes: List<&2, Local.PlannedNode>, +entries: List<&2, F.AddressEntry>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +retained: List<&2, F.Node>, +aligned: {P.aligned(nodes, entries, nodes, entries) == True{} : Bool}, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, +projected: {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>}, forward: {P.forward_nodes(nodes, slots) == True{} : Bool}, valid: {Relation.nodes_valid(retained, retained) == True{} : Bool}) -> {ready_actual_node_observations(retained, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots) == True{} : Bool}:
  ready_actual_node_observations_cursor(nodes, entries, nodes, entries, slots, catalog, retained, retained,
    aligned, dense, projected, forward, aligned, projected, valid)

def ready_omission_result_value(result: D.OmissionResult) -> Maybe<&2, Bool>:
  match result:
    case D.OmissionsObserved{present}: Some{present}
    case _: None{}

def ready_omission_value_injective(+left: Bool, +right: Bool, equal: {D.OmissionsObserved{left} == D.OmissionsObserved{right} : D.OmissionResult}) -> {left == right : Bool}:
  Count.some_equal(Bool, left, right, Equal.cong(D.OmissionResult, Maybe<&2, Bool>, ready_omission_result_value,
    D.OmissionsObserved{left}, D.OmissionsObserved{right}, equal))

def ready_omission_value_address(+remaining: Nat, +query: O.NodeAddress, +rest: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, +present: Bool, lookup: Maybe<&2, F.Node>, +found: {F.node_at(nodes, query) == lookup : Maybe<&2, F.Node>}, valid: {ready_actual_node_observations(nodes, entries, fuel, slots) == True{} : Bool}, observed: {D.omissions(1n+remaining, D.OmissionAddress{query} <> rest, nodes) == D.OmissionsObserved{present} : D.OmissionResult}, recursive: @+next: List<&2, D.OmissionWork> -> {D.omissions(remaining, next, nodes) == D.OmissionsObserved{present} : D.OmissionResult} -> {ready_actual_work_omission(next, entries, fuel, slots) == present : Bool}) -> {ready_actual_work_omission(D.OmissionAddress{query} <> rest, entries, fuel, slots) == present : Bool}:
  match lookup:
    case None{}:
      invalid: {D.OmissionInvalid{} == D.OmissionsObserved{present} : D.OmissionResult} =
        %found:
          {D.omission_next(D.omission_node(_, rest), items => D.omissions(remaining, items, nodes)) == D.OmissionsObserved{present} : D.OmissionResult}
        observed
      Empty.absurd({ready_actual_work_omission(D.OmissionAddress{query} <> rest, entries, fuel, slots) == present : Bool},
        Contents.none_some(Bool, present, Equal.cong(D.OmissionResult, Maybe<&2, Bool>, ready_omission_result_value,
          D.OmissionInvalid{}, D.OmissionsObserved{present}, invalid)))
    case Some{F.Node{+address, +artifact, +references}}:
      Equal.trans(Bool, ready_actual_work_omission(D.OmissionAddress{query} <> rest, entries, fuel, slots),
        ready_actual_work_omission(D.OmissionReferences{references} <> rest, entries, fuel, slots), present,
        Equal.cong(Bool, Bool, value => Bool.or(value, ready_actual_work_omission(rest, entries, fuel, slots)),
          ready_actual_address_omission(entries, fuel, slots, query), ready_actual_reference_omission(references, entries, fuel, slots),
          ready_actual_node_observation_lookup(nodes, query, F.Node{address, artifact, references}, entries, fuel, slots, valid, found)),
        recursive(D.OmissionReferences{references} <> rest)(
          %found:
            {D.omission_next(D.omission_node(_, rest), items => D.omissions(remaining, items, nodes)) == D.OmissionsObserved{present} : D.OmissionResult}
          observed))

def ready_omission_value(remaining: Nat, work: List<&2, D.OmissionWork>, +nodes: List<&2, F.Node>, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, +present: Bool, +valid: {ready_actual_node_observations(nodes, entries, fuel, slots) == True{} : Bool}, observed: {D.omissions(remaining, work, nodes) == D.OmissionsObserved{present} : D.OmissionResult}) -> {ready_actual_work_omission(work, entries, fuel, slots) == present : Bool}:
  match remaining work:
    case _ Nil{}: ready_omission_value_injective(False{}, present, observed)
    case 0n Con{+head, +tail}:
      Empty.absurd({ready_actual_work_omission(head <> tail, entries, fuel, slots) == present : Bool},
        Contents.none_some(Bool, present, Equal.cong(D.OmissionResult, Maybe<&2, Bool>, ready_omission_result_value,
          D.OmissionExhausted{}, D.OmissionsObserved{present}, observed)))
    case 1n++more D.OmissionAddress{+query} <> +rest:
      ready_omission_value_address(more, query, rest, nodes, entries, fuel, slots, present, F.node_at(nodes, query), {==}, valid, observed,
        next => next_observed => ready_omission_value(more, next, nodes, entries, fuel, slots, present, valid, next_observed))
    case 1n++more D.OmissionReferences{[]} <> +rest:
      ready_omission_value(more, rest, nodes, entries, fuel, slots, present, valid, observed)
    case 1n++more D.OmissionReferences{F.Included{_, _} <> +tail} <> +rest:
      ready_omission_value(more, D.OmissionReferences{tail} <> rest, nodes, entries, fuel, slots, present, valid, observed)
    case 1n++more D.OmissionReferences{F.Expanded{_, +child} <> +tail} <> +rest:
      Equal.trans(Bool, Bool.or(Bool.or(ready_actual_address_omission(entries, fuel, slots, child), ready_actual_reference_omission(tail, entries, fuel, slots)),
        ready_actual_work_omission(rest, entries, fuel, slots)),
        ready_actual_work_omission(D.OmissionAddress{child} <> D.OmissionReferences{tail} <> rest, entries, fuel, slots), present,
        BoolFacts.or_assoc(ready_actual_address_omission(entries, fuel, slots, child), ready_actual_reference_omission(tail, entries, fuel, slots), ready_actual_work_omission(rest, entries, fuel, slots)),
        ready_omission_value(more, D.OmissionAddress{child} <> D.OmissionReferences{tail} <> rest, nodes, entries, fuel, slots, present, valid, observed))
    case 1n+_ D.OmissionReferences{F.Omitted{_, _, _} <> _} <> _:
      ready_omission_value_injective(True{}, present, observed)

def ready_omission_total_value(+root: O.NodeAddress, +retained: List<&2, F.Node>, +entries: List<&2, F.AddressEntry>, +fuel: Nat, +slots: List<&2, Local.ReferenceSlot>, +actual: Bool, observations: {ready_actual_node_observations(retained, entries, fuel, slots) == True{} : Bool}, root_equal: {ready_actual_work_omission([D.OmissionAddress{root}], entries, fuel, slots) == actual : Bool}, total: Exists(Bool, present => {D.forest_omissions(Allowance.materialization(F.Forest{Some{root}, retained}), F.Forest{Some{root}, retained}) == D.OmissionsObserved{present} : D.OmissionResult})) -> {D.forest_omissions(Allowance.materialization(F.Forest{Some{root}, retained}), F.Forest{Some{root}, retained}) == D.OmissionsObserved{actual} : D.OmissionResult}:
  match total:
    case (+present, observed):
      +same_result: {D.forest_omissions(Allowance.materialization(F.Forest{Some{root}, retained}), F.Forest{Some{root}, retained}) == D.OmissionsObserved{present} : D.OmissionResult} = observed
      Equal.trans(D.OmissionResult,
        D.forest_omissions(Allowance.materialization(F.Forest{Some{root}, retained}), F.Forest{Some{root}, retained}),
        D.OmissionsObserved{present}, D.OmissionsObserved{actual}, same_result,
        Equal.cong(Bool, D.OmissionResult, value => D.OmissionsObserved{value}, present, actual,
          Equal.trans(Bool, present, ready_actual_work_omission([D.OmissionAddress{root}], entries, fuel, slots), actual,
            Equal.sym(Bool, ready_actual_work_omission([D.OmissionAddress{root}], entries, fuel, slots), present,
              ready_omission_value(Allowance.materialization(F.Forest{Some{root}, retained}), [D.OmissionAddress{root}], retained,
                entries, fuel, slots, present, observations, same_result)), root_equal)))

def ready_projected_omissions_known(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +entries: List<&2, F.AddressEntry>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +birth: O.NodeAddress, +retained: List<&2, F.Node>, +episode: Nat, +aligned: {P.aligned(nodes, entries, nodes, entries) == True{} : Bool}, +dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, +projected: {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>}, forward: {P.forward_nodes(nodes, slots) == True{} : Bool}, found: {F.address_at(entries, root) == Some{birth} : Maybe<&2, O.NodeAddress>}, +valid: {Relation.frame_forest(F.Forest{Some{birth}, retained}, episode) == True{} : Bool}) -> {D.forest_omissions(Allowance.materialization(F.Forest{Some{birth}, retained}), F.Forest{Some{birth}, retained}) == D.OmissionsObserved{LoopPolicy.has_omission((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, root, slots)} : D.OmissionResult}:
  +retained_valid: {Relation.retained(F.Forest{Some{birth}, retained}) == True{} : Bool} =
    BoolFacts.eq_true_of_and_left(Relation.retained(F.Forest{Some{birth}, retained}), Relation.episodes_before(retained, episode), valid)
  root_valid: {Relation.root_valid(Some{birth}, retained) == True{} : Bool} =
    BoolFacts.eq_true_of_and_left(Relation.root_valid(Some{birth}, retained), Relation.nodes_valid(retained, retained), retained_valid)
  ready_omission_total_value(birth, retained, entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots,
    LoopPolicy.has_omission((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, root, slots),
    ready_projected_node_observations(nodes, entries, slots, catalog, retained, aligned, dense, projected, forward,
      BoolFacts.eq_true_of_and_right(Relation.root_valid(Some{birth}, retained), Relation.nodes_valid(retained, retained), retained_valid)),
    Equal.trans(Bool, ready_actual_work_omission([D.OmissionAddress{birth}], entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots),
      ready_actual_address_omission(entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, birth),
      LoopPolicy.has_omission((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, root, slots),
      BoolFacts.or_false(ready_actual_address_omission(entries, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, birth)),
      ready_projected_address_observation(nodes, entries, slots, catalog, retained, root, birth, (List.length(&2, Local.PlannedNode, nodes) + 1n : Nat),
        aligned, dense, projected, found,
        NatFacts.eq_of_is_eq(F.count_address(retained, birth), 1n,
          BoolFacts.eq_true_of_and_left(Nat.is_eq(F.count_address(retained, birth), 1n), Nat.is_eq(Relation.incoming(retained, birth), 0n), root_valid)))),
    ready_omission_forest_total(birth, retained, episode, valid))

def ready_projected_omissions_forest_parts(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +entries: List<&2, F.AddressEntry>, +forest: F.Forest, +episode: Nat, +checks: {Bool.and(P.aligned(nodes, entries, nodes, entries), Bool.and(P.catalog_unique(catalog, catalog), Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots)))) == True{} : Bool}, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, valid: {Relation.frame_forest(forest, episode) == True{} : Bool}, contents: Exists(O.NodeAddress, birth => Exists(List<&2, F.Node>, retained => {F.address_at(entries, root) == Some{birth} : Maybe<&2, O.NodeAddress>} & {P.nodes(nodes, slots, catalog, entries) == Some{retained} : Maybe<&2, List<&2, F.Node>>} & {Some{F.Forest{Some{birth}, retained}} == Some{forest} : Maybe<&2, F.Forest>}))) -> {D.forest_omissions(Allowance.materialization(forest), forest) == D.OmissionsObserved{LoopPolicy.has_omission((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, root, slots)} : D.OmissionResult}:
  match contents:
    case (+birth, (+retained, (found, (projected, same)))):
      +forest_equal: {F.Forest{Some{birth}, retained} == forest : F.Forest} = Count.some_equal(F.Forest, F.Forest{Some{birth}, retained}, forest, same)
      %forest_equal:
        {D.forest_omissions(Allowance.materialization(_), _)
          == D.OmissionsObserved{LoopPolicy.has_omission((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, root, slots)} : D.OmissionResult}
      ready_projected_omissions_known(root, nodes, entries, slots, catalog, birth, retained, episode,
        BoolFacts.eq_true_of_and_left(P.aligned(nodes, entries, nodes, entries), Bool.and(P.catalog_unique(catalog, catalog),
          Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots))), checks), dense, projected,
        BoolFacts.eq_true_of_and_right(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots),
          BoolFacts.eq_true_of_and_right(P.catalog_unique(catalog, catalog), Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots)),
            BoolFacts.eq_true_of_and_right(P.aligned(nodes, entries, nodes, entries), Bool.and(P.catalog_unique(catalog, catalog),
              Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots))), checks))), found,
        %Equal.sym(F.Forest, F.Forest{Some{birth}, retained}, forest, forest_equal): {Relation.frame_forest(_, episode) == True{} : Bool}
        valid)

def ready_projected_omissions_parts(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +entries: List<&2, F.AddressEntry>, +forest: F.Forest, +episode: Nat, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, valid: {Relation.frame_forest(forest, episode) == True{} : Bool}, contents: {Bool.and(P.aligned(nodes, entries, nodes, entries), Bool.and(P.catalog_unique(catalog, catalog), Bool.and(P.slots_owned(slots, nodes), P.forward_nodes(nodes, slots)))) == True{} : Bool} & {P.forest(F.address_at(entries, root), P.nodes(nodes, slots, catalog, entries)) == Some{forest} : Maybe<&2, F.Forest>}) -> {D.forest_omissions(Allowance.materialization(forest), forest) == D.OmissionsObserved{LoopPolicy.has_omission((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, root, slots)} : D.OmissionResult}:
  match contents:
    case Tuple{checks, projected}:
      ready_projected_omissions_forest_parts(root, nodes, slots, catalog, entries, forest, episode, checks, dense, valid,
        Contents.forest_contents(F.address_at(entries, root), P.nodes(nodes, slots, catalog, entries), forest, projected))

def ready_projected_omissions(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +slots: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +entries: List<&2, F.AddressEntry>, +forest: F.Forest, +episode: Nat, projected: {P.project(root, nodes, slots, catalog, entries) == Some{forest} : Maybe<&2, F.Forest>}, dense: {ActualFrame.dense(nodes, 0n) == True{} : Bool}, valid: {Relation.frame_forest(forest, episode) == True{} : Bool}) -> {D.forest_omissions(Allowance.materialization(forest), forest) == D.OmissionsObserved{LoopPolicy.has_omission((List.length(&2, Local.PlannedNode, nodes) + 1n : Nat), slots, root, slots)} : D.OmissionResult}:
  ready_projected_omissions_parts(root, nodes, slots, catalog, entries, forest, episode, dense, valid,
    Contents.project_contents(root, nodes, slots, catalog, entries, forest, projected))

def ready_frame_view_omissions_semantics(+frame: T.ResolverFrame, +history: V.History, +view: V.Frame, checks: {frame_checks(frame, history) == True{} : Bool}, semantics: projected_frame_semantics_result(frame, history, view)) -> {D.forest_omissions(Allowance.materialization(ready_staged_forest(view)), ready_staged_forest(view)) == D.OmissionsObserved{LoopPolicy.frame_has_omission(frame)} : D.OmissionResult}:
  match history view:
    case V.History{+addresses, +order, _, _, _, _, +episode}
        V.Frame{_, _, _, _, _, +forest, _, _, _, _, _, _, _, _, _, _, _, _, _, _}:
      match semantics:
        case Tuple{projected, valid}:
          ready_projected_omissions(S.frame_root(frame), S.frame_nodes(frame), S.frame_references(frame), S.frame_artifacts(frame), addresses, forest, episode, projected,
            BoolFacts.eq_true_of_and_left(ActualFrame.dense(S.frame_nodes(frame), 0n), Bool.and(Nat.is_eq(S.frame_next_node(frame), List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), ActualFrame.catalog_valid(S.frame_artifacts(frame))),
              BoolFacts.eq_true_of_and_right(ActualFrame.coverage(order, frame), Bool.and(ActualFrame.dense(S.frame_nodes(frame), 0n), Bool.and(Nat.is_eq(S.frame_next_node(frame), List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), ActualFrame.catalog_valid(S.frame_artifacts(frame)))), checks)), valid)

def ready_frame_view_omissions_contents(+frame: T.ResolverFrame, +history: V.History, +view: V.Frame, contents: {frame_checks(frame, history) == True{} : Bool} & {ActualFrame.projected(frame, history) == Some{view} : Maybe<&2, V.Frame>}) -> {D.forest_omissions(Allowance.materialization(ready_staged_forest(view)), ready_staged_forest(view)) == D.OmissionsObserved{LoopPolicy.frame_has_omission(frame)} : D.OmissionResult}:
  match contents:
    case Tuple{checks, projected}:
      ready_frame_view_omissions_semantics(frame, history, view, checks,
        projected_frame_semantics(frame, history, view, projected))

def ready_frame_view_omissions(+frame: T.ResolverFrame, +history: V.History, +view: V.Frame, ready: {ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>}) -> {D.forest_omissions(Allowance.materialization(ready_staged_forest(view)), ready_staged_forest(view)) == D.OmissionsObserved{LoopPolicy.frame_has_omission(frame)} : D.OmissionResult}:
  ready_frame_view_omissions_contents(frame, history, view, actual_frame_contents(frame, history, view, ready))

def ready_common_frame_omissions(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, actual_ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}) -> {D.forest_omissions(Allowance.materialization(ready_reference_forest(D.frame(reference))), ready_reference_forest(D.frame(reference))) == D.OmissionsObserved{LoopPolicy.frame_has_omission(actual)} : D.OmissionResult}:
  Equal.trans(D.OmissionResult,
    D.forest_omissions(Allowance.materialization(ready_reference_forest(D.frame(reference))), ready_reference_forest(D.frame(reference))),
    D.forest_omissions(Allowance.materialization(ready_staged_forest(view)), ready_staged_forest(view)),
    D.OmissionsObserved{LoopPolicy.frame_has_omission(actual)},
    Equal.cong(F.Forest, D.OmissionResult, forest => D.forest_omissions(Allowance.materialization(forest), forest),
      ready_reference_forest(D.frame(reference)), ready_staged_forest(view),
      ready_reference_forest_project(reference, history, view, reference_ready)),
    ready_frame_view_omissions(actual, history, view, actual_ready))

def ready_reference_frame_dependencies_rows(+state: D.State, +history: V.History, +targets_value: Maybe<&2, List<&2, V.TargetEntry>>, +captured_value: Maybe<&2, List<&2, V.CapturedEntry>>, +visited_value: Maybe<&2, List<&2, String>>, +view: V.Frame, ready: {ReferenceFrame.assembled(state, history, targets_value, captured_value, visited_value) == Some{view} : Maybe<&2, V.Frame>}) -> {ready_reference_dependencies(D.frame(state)) == ready_view_dependencies(view) : List<&2, String>}:
  match state history targets_value captured_value visited_value:
    case D.State{D.Config{_, _, _, +context, _, _}, X.Frame{G.Bounded{+graph, +remaining}, +command, +forest, Signed.State{Recursive.State{_, +budget, _, _}, +signed}, +edges, _, +artifacts_by_target, +next_edge, +episode, +next_artifact, +dependencies, _}, _, +target_ids, +next_target, _, _, _, _} V.History{_, _, _, _, +artifacts, _, _}
      Some{+targets} Some{+captures} Some{+seen}:
      Equal.cong(V.Frame, List<&2, String>, value => ready_view_dependencies(value), V.Frame{ReferenceFrame.branch(context), ReferenceFrame.graph_limits(graph), graph, command, dependencies, forest, ReferenceFrame.pending(edges), targets, ReferenceFrame.ids(target_ids), captures, ReferenceFrame.identities(artifacts_by_target), seen, V.budget(budget, signed), ReferenceFrame.node_count(forest), next_edge, next_target, next_artifact, artifacts, remaining, episode}, view, Count.some_equal(V.Frame, V.Frame{ReferenceFrame.branch(context), ReferenceFrame.graph_limits(graph), graph, command, dependencies, forest, ReferenceFrame.pending(edges), targets, ReferenceFrame.ids(target_ids), captures, ReferenceFrame.identities(artifacts_by_target), seen, V.budget(budget, signed), ReferenceFrame.node_count(forest), next_edge, next_target, next_artifact, artifacts, remaining, episode}, view, ready))
    case _ _ None{} _ _:
      Empty.absurd({ready_reference_dependencies(D.frame(state)) == ready_view_dependencies(view) : List<&2, String>}, Contents.none_some(V.Frame, view, ready))
    case _ _ Some{_} None{} _:
      Empty.absurd({ready_reference_dependencies(D.frame(state)) == ready_view_dependencies(view) : List<&2, String>}, Contents.none_some(V.Frame, view, ready))
    case _ _ Some{_} Some{_} None{}:
      Empty.absurd({ready_reference_dependencies(D.frame(state)) == ready_view_dependencies(view) : List<&2, String>}, Contents.none_some(V.Frame, view, ready))

def ready_reference_frame_dependencies(+state: D.State, +history: V.History, +view: V.Frame, ready: {ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>}) -> {ready_reference_dependencies(D.frame(state)) == ready_view_dependencies(view) : List<&2, String>}:
  match state history:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{+values, _, _, _}, _}, _, +captures, _, _, _, _, _, _}, +target_values, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, +seen}, _, +sources, _, _, _}:
      ready_reference_frame_dependencies_rows(state, history, ReferenceFrame.targets(target_values), ReferenceFrame.captured(captures, sources), ReferenceFrame.visited(seen, values), view, ready)

def ready_completion_materialized_transport(+actual: T.ResolverState, +reference: D.State, +frame: T.ResolverFrame, +history: V.History, +view: V.Frame, +product: ArtifactValue.ProductValue, reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, dependencies: {S.frame_dependencies(frame) == ready_reference_dependencies(D.frame(reference)) : List<&2, String>}, fingerprint: {ready_prepared_fingerprint(S.state_prepared(actual)) == ready_reference_fingerprint(D.frame(reference)) : Maybe<&2, String>}, materialized: {F.prepared_unit(Allowance.materialization(ready_staged_forest(view)), ready_staged_forest(view), S.frame_dependencies(frame), ready_prepared_fingerprint(S.state_prepared(actual))) == F.Materialized{product} : F.Materialization}) -> {F.prepared_unit(Allowance.materialization(ready_reference_forest(D.frame(reference))), ready_reference_forest(D.frame(reference)), ready_reference_dependencies(D.frame(reference)), ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization}:
  %Equal.sym(F.Forest, ready_reference_forest(D.frame(reference)), ready_staged_forest(view), ready_reference_forest_project(reference, history, view, reference_ready)):
    {F.prepared_unit(Allowance.materialization(_), _, ready_reference_dependencies(D.frame(reference)), ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization}
  %dependencies:
    {F.prepared_unit(Allowance.materialization(ready_staged_forest(view)), ready_staged_forest(view), _, ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization}
  %fingerprint:
    {F.prepared_unit(Allowance.materialization(ready_staged_forest(view)), ready_staged_forest(view), S.frame_dependencies(frame), _) == F.Materialized{product} : F.Materialization}
  materialized

def ready_completion_materialized_pair(+actual: T.ResolverState, +reference: D.State, +frame: T.ResolverFrame, +history: V.History, +view: V.Frame, reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, dependencies: {S.frame_dependencies(frame) == ready_reference_dependencies(D.frame(reference)) : List<&2, String>}, fingerprint: {ready_prepared_fingerprint(S.state_prepared(actual)) == ready_reference_fingerprint(D.frame(reference)) : Maybe<&2, String>}, result: ready_frame_view_materialization_result(frame, S.state_prepared(actual), view)) -> Exists(ArtifactValue.ProductValue, product => {PreparedRoot.prepared_unit(frame, S.state_prepared(actual)) == Some{product} : Maybe<&2, ArtifactValue.ProductValue>} & {F.prepared_unit(Allowance.materialization(ready_reference_forest(D.frame(reference))), ready_reference_forest(D.frame(reference)), ready_reference_dependencies(D.frame(reference)), ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization}):
  match view:
    case V.Frame{_, _, _, _, _, +forest, _, _, _, _, _, _, _, _, _, _, _, _, _, _}:
      match result:
        case (+product, Tuple{actual_product, reference_product}):
          Tuple{product, Tuple{actual_product,
            ready_completion_materialized_transport(actual, reference, frame, history, view, product, reference_ready, dependencies, fingerprint, reference_product)}}

def ready_common_completion_materialized(+actual: T.ResolverState, +reference: D.State, +child: X.Child, +frame: T.ResolverFrame, +history: V.History, +view: V.Frame, +actual_ready: {ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>}, +reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, capsule: {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(reference, child)} : Maybe<&2, Phase.Capsule>}) -> Exists(ArtifactValue.ProductValue, product => {PreparedRoot.prepared_unit(frame, S.state_prepared(actual)) == Some{product} : Maybe<&2, ArtifactValue.ProductValue>} & {F.prepared_unit(Allowance.materialization(ready_reference_forest(D.frame(reference))), ready_reference_forest(D.frame(reference)), ready_reference_dependencies(D.frame(reference)), ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization}):
  match history:
    case V.History{+addresses, _, _, _, _, _, _}:
      ready_completion_materialized_pair(actual, reference, frame, history, view, reference_ready,
        Equal.trans(List<&2, String>, S.frame_dependencies(frame), ready_view_dependencies(view), ready_reference_dependencies(D.frame(reference)),
          ready_projected_frame_dependencies(frame, history, view,
            Pair.snd({frame_checks(frame, history) == True{} : Bool}, {ActualFrame.projected(frame, history) == Some{view} : Maybe<&2, V.Frame>}, actual_frame_contents(frame, history, view, actual_ready))),
          Equal.sym(List<&2, String>, ready_reference_dependencies(D.frame(reference)), ready_view_dependencies(view), ready_reference_frame_dependencies(reference, history, view, reference_ready))),
        ready_common_product_fingerprint(actual, reference, child, S.state_clock(actual), S.state_language(actual), S.scratch_active_target(S.state_scratch(actual)), ActualBoundary.ready_edge(S.scratch_pending_edge(S.state_scratch(actual)), addresses), ReferenceReady.capsule(reference, child), capsule, {==}),
        ready_frame_view_materialized(frame, S.state_prepared(actual), history, view, actual_ready))

def ready_completion_positive_parts(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +frame: T.ResolverFrame, +history: V.History, +view: V.Frame, +world: E.WorldState<World>, +reason: G.Reason, +count: Nat, actual_observed: {ActualBoundary.frame(S.state_frame(actual), history) == Some{view} : Maybe<&2, V.Frame>}, +actual_ready: {ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>}, +reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, +capsule: {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(reference, child)} : Maybe<&2, Phase.Capsule>}, eligible: {LoopPolicy.eligible_reason(reason) == True{} : Bool}, positive: {Nat.is_gt(LoopPolicy.files(S.frame_graph(frame)), 0n) == True{} : Bool}, reference_positive: {LoopPolicy.files(ReferenceFrame.graph(D.frame(reference))) == 1n+count : Nat}, materialized: Exists(ArtifactValue.ProductValue, product => {PreparedRoot.prepared_unit(frame, S.state_prepared(actual)) == Some{product} : Maybe<&2, ArtifactValue.ProductValue>} & {F.prepared_unit(Allowance.materialization(ready_reference_forest(D.frame(reference))), ready_reference_forest(D.frame(reference)), ready_reference_dependencies(D.frame(reference)), ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization})) -> Exists(B.Boundary, ReferenceBoundaryView.completion_partial_claim(World, actual, reference, child, history, frame, Allowance.materialization(ready_reference_forest(D.frame(reference))), reason, world)):
  match reference history:
    case D.State{D.Config{_, _, _, _, _, _}, X.Frame{_, _, _, _, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}
        V.History{+addresses, _, _, _, _, _, _}:
      match materialized:
        case (+product, Tuple{actual_product, reference_product}):
          ReferenceBoundaryView.completion_partial_common_positive(World, actual, reference, child, history, view, world, frame,
            Allowance.materialization(ready_reference_forest(D.frame(reference))), reason, count, product, LoopPolicy.frame_has_omission(frame),
            actual_observed, reference_ready, capsule,
            Equal.cong(T.Request, Maybe<&2, T.Request>, request => Some{request}, ready_actual_request(actual, product), ready_reference_request(reference, product),
              ready_request_identity_exact(actual, reference, child, S.state_clock(actual), S.state_language(actual), S.scratch_active_target(S.state_scratch(actual)), ActualBoundary.ready_edge(S.scratch_pending_edge(S.state_scratch(actual)), addresses), ReferenceReady.capsule(reference, child), product, capsule, {==})),
            eligible, positive, reference_positive, {==},
            ready_common_frame_omissions(frame, reference, history, view, actual_ready, reference_ready), actual_product, reference_product)

def ready_completion_positive(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +frame: T.ResolverFrame, +history: V.History, +view: V.Frame, +world: E.WorldState<World>, +reason: G.Reason, +count: Nat, actual_observed: {ActualBoundary.frame(S.state_frame(actual), history) == Some{view} : Maybe<&2, V.Frame>}, +actual_ready: {ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>}, +reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, +capsule: {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(reference, child)} : Maybe<&2, Phase.Capsule>}, eligible: {LoopPolicy.eligible_reason(reason) == True{} : Bool}, positive: {Nat.is_gt(LoopPolicy.files(S.frame_graph(frame)), 0n) == True{} : Bool}, reference_positive: {LoopPolicy.files(ReferenceFrame.graph(D.frame(reference))) == 1n+count : Nat}) -> Exists(B.Boundary, ReferenceBoundaryView.completion_partial_claim(World, actual, reference, child, history, frame, Allowance.materialization(ready_reference_forest(D.frame(reference))), reason, world)):
  ready_completion_positive_parts(World, actual, reference, child, frame, history, view, world, reason, count,
    actual_observed, actual_ready, reference_ready, capsule, eligible, positive, reference_positive,
    ready_common_completion_materialized(actual, reference, child, frame, history, view, actual_ready, reference_ready, capsule))

def ready_completion_normal_parts(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +frame: T.ResolverFrame, +history: V.History, +view: V.Frame, +world: E.WorldState<World>, actual_observed: {ActualBoundary.frame(S.state_frame(actual), history) == Some{view} : Maybe<&2, V.Frame>}, reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, +capsule: {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(reference, child)} : Maybe<&2, Phase.Capsule>}, materialized: Exists(ArtifactValue.ProductValue, product => {PreparedRoot.prepared_unit(frame, S.state_prepared(actual)) == Some{product} : Maybe<&2, ArtifactValue.ProductValue>} & {F.prepared_unit(Allowance.materialization(ready_reference_forest(D.frame(reference))), ready_reference_forest(D.frame(reference)), ready_reference_dependencies(D.frame(reference)), ready_reference_fingerprint(D.frame(reference))) == F.Materialized{product} : F.Materialization})) -> Exists(B.Boundary, ReferenceBoundaryView.completion_normal_claim(World, actual, reference, child, history, frame, Allowance.materialization(ready_reference_forest(D.frame(reference))), world)):
  match reference history:
    case D.State{D.Config{_, _, _, _, _, _}, X.Frame{_, _, _, _, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}
        V.History{+addresses, _, _, _, _, _, _}:
      match materialized:
        case (+product, Tuple{actual_product, reference_product}):
          ReferenceBoundaryView.completion_common_normal(World, actual, reference, child, history, view, world, frame,
            Allowance.materialization(ready_reference_forest(D.frame(reference))), product,
            actual_observed, reference_ready, capsule,
            Equal.cong(T.Request, Maybe<&2, T.Request>, request => Some{request}, ready_actual_request(actual, product), ready_reference_request(reference, product),
              ready_request_identity_exact(actual, reference, child, S.state_clock(actual), S.state_language(actual), S.scratch_active_target(S.state_scratch(actual)), ActualBoundary.ready_edge(S.scratch_pending_edge(S.state_scratch(actual)), addresses), ReferenceReady.capsule(reference, child), product, capsule, {==})),
            actual_product, reference_product)

def ready_completion_normal(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +frame: T.ResolverFrame, +history: V.History, +view: V.Frame, +world: E.WorldState<World>, actual_observed: {ActualBoundary.frame(S.state_frame(actual), history) == Some{view} : Maybe<&2, V.Frame>}, actual_ready: {ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>}, +reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, +capsule: {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(reference, child)} : Maybe<&2, Phase.Capsule>}) -> Exists(B.Boundary, ReferenceBoundaryView.completion_normal_claim(World, actual, reference, child, history, frame, Allowance.materialization(ready_reference_forest(D.frame(reference))), world)):
  ready_completion_normal_parts(World, actual, reference, child, frame, history, view, world,
    actual_observed, reference_ready, capsule,
    ready_common_completion_materialized(actual, reference, child, frame, history, view, actual_ready, reference_ready, capsule))

def ready_completion_partial_files(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +frame: T.ResolverFrame, +history: V.History, +view: V.Frame, +world: E.WorldState<World>, +reason: G.Reason, files: Nat, actual_observed: {ActualBoundary.frame(S.state_frame(actual), history) == Some{view} : Maybe<&2, V.Frame>}, actual_ready: {ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>}, reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, capsule: {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(reference, child)} : Maybe<&2, Phase.Capsule>}, eligible: {LoopPolicy.eligible_reason(reason) == True{} : Bool}, +files_equal: {LoopPolicy.files(S.frame_graph(frame)) == files : Nat}, graph_equal: {ReferenceFrame.graph(D.frame(reference)) == S.frame_graph(frame) : G.Graph}) -> Exists(B.Boundary, ReferenceBoundaryView.completion_partial_claim(World, actual, reference, child, history, frame, Allowance.materialization(ready_reference_forest(D.frame(reference))), reason, world)):
  match files:
    case 0n:
      Tuple{B.Finished{None{}, view},
        ReferenceBoundaryView.completion_empty_common(World, actual, reference, child, history, view, world, frame,
          Allowance.materialization(ready_reference_forest(D.frame(reference))), reason, actual_observed, reference_ready, files_equal,
          Equal.trans(Nat, LoopPolicy.files(ReferenceFrame.graph(D.frame(reference))), LoopPolicy.files(S.frame_graph(frame)), 0n,
            Equal.cong(G.Graph, Nat, LoopPolicy.files, ReferenceFrame.graph(D.frame(reference)), S.frame_graph(frame), graph_equal), files_equal))}
    case 1n+count:
      ready_completion_positive(World, actual, reference, child, frame, history, view, world, reason, count,
        actual_observed, actual_ready, reference_ready, capsule, eligible,
        %Equal.sym(Nat, LoopPolicy.files(S.frame_graph(frame)), 1n+count, files_equal): {Nat.is_gt(_, 0n) == True{} : Bool} {==},
        Equal.trans(Nat, LoopPolicy.files(ReferenceFrame.graph(D.frame(reference))), LoopPolicy.files(S.frame_graph(frame)), 1n+count,
          Equal.cong(G.Graph, Nat, LoopPolicy.files, ReferenceFrame.graph(D.frame(reference)), S.frame_graph(frame), graph_equal), files_equal))

def ready_completion_partial_reason(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +frame: T.ResolverFrame, +history: V.History, +view: V.Frame, +world: E.WorldState<World>, reason: G.Reason, actual_observed: {ActualBoundary.frame(S.state_frame(actual), history) == Some{view} : Maybe<&2, V.Frame>}, actual_ready: {ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>}, reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, capsule: {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(reference, child)} : Maybe<&2, Phase.Capsule>}, graph_equal: {ReferenceFrame.graph(D.frame(reference)) == S.frame_graph(frame) : G.Graph}) -> Exists(B.Boundary, ReferenceBoundaryView.completion_partial_claim(World, actual, reference, child, history, frame, Allowance.materialization(ready_reference_forest(D.frame(reference))), reason, world)):
  match reason:
    case G.Missing{}:
      ready_completion_partial_files(World, actual, reference, child, frame, history, view, world, G.Missing{}, LoopPolicy.files(S.frame_graph(frame)),
        actual_observed, actual_ready, reference_ready, capsule, {==}, {==}, graph_equal)
    case G.Ambiguous{}:
      ready_completion_partial_files(World, actual, reference, child, frame, history, view, world, G.Ambiguous{}, LoopPolicy.files(S.frame_graph(frame)),
        actual_observed, actual_ready, reference_ready, capsule, {==}, {==}, graph_equal)
    case G.Unsupported{}:
      ready_completion_partial_files(World, actual, reference, child, frame, history, view, world, G.Unsupported{}, LoopPolicy.files(S.frame_graph(frame)),
        actual_observed, actual_ready, reference_ready, capsule, {==}, {==}, graph_equal)
    case G.Omitted{}:
      ready_completion_partial_files(World, actual, reference, child, frame, history, view, world, G.Omitted{}, LoopPolicy.files(S.frame_graph(frame)),
        actual_observed, actual_ready, reference_ready, capsule, {==}, {==}, graph_equal)
    case G.Excluded{}:
      ready_completion_partial_files(World, actual, reference, child, frame, history, view, world, G.Excluded{}, LoopPolicy.files(S.frame_graph(frame)),
        actual_observed, actual_ready, reference_ready, capsule, {==}, {==}, graph_equal)
    case G.CaptureUnavailable{}:
      ready_completion_partial_files(World, actual, reference, child, frame, history, view, world, G.CaptureUnavailable{}, LoopPolicy.files(S.frame_graph(frame)),
        actual_observed, actual_ready, reference_ready, capsule, {==}, {==}, graph_equal)
    case G.FileLimit{}:
      ready_completion_partial_files(World, actual, reference, child, frame, history, view, world, G.FileLimit{}, LoopPolicy.files(S.frame_graph(frame)),
        actual_observed, actual_ready, reference_ready, capsule, {==}, {==}, graph_equal)
    case G.ReadLimit{}:
      ready_completion_partial_files(World, actual, reference, child, frame, history, view, world, G.ReadLimit{}, LoopPolicy.files(S.frame_graph(frame)),
        actual_observed, actual_ready, reference_ready, capsule, {==}, {==}, graph_equal)
    case G.TreeLimit{}:
      ready_completion_partial_files(World, actual, reference, child, frame, history, view, world, G.TreeLimit{}, LoopPolicy.files(S.frame_graph(frame)),
        actual_observed, actual_ready, reference_ready, capsule, {==}, {==}, graph_equal)
    case G.WorkLimit{}:
      ready_completion_partial_files(World, actual, reference, child, frame, history, view, world, G.WorkLimit{}, LoopPolicy.files(S.frame_graph(frame)),
        actual_observed, actual_ready, reference_ready, capsule, {==}, {==}, graph_equal)
    case G.Deadline{}:
      Tuple{B.Finished{None{}, view},
        ReferenceBoundaryView.completion_deadline(World, actual, reference, child, history, view, world, frame,
          Allowance.materialization(ready_reference_forest(D.frame(reference))), actual_observed, reference_ready)}
    case G.DepthLimit{}:
      ready_completion_partial_files(World, actual, reference, child, frame, history, view, world, G.DepthLimit{}, LoopPolicy.files(S.frame_graph(frame)),
        actual_observed, actual_ready, reference_ready, capsule, {==}, {==}, graph_equal)
    case G.ProtocolViolation{}:
      Tuple{B.Finished{None{}, view},
        ReferenceBoundaryView.completion_protocolviolation(World, actual, reference, child, history, view, world, frame,
          Allowance.materialization(ready_reference_forest(D.frame(reference))), actual_observed, reference_ready)}

def ready_completion_partial(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +frame: T.ResolverFrame, +history: V.History, +view: V.Frame, +world: E.WorldState<World>, +reason: G.Reason, actual_observed: {ActualBoundary.frame(S.state_frame(actual), history) == Some{view} : Maybe<&2, V.Frame>}, +actual_ready: {ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>}, +reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, capsule: {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(reference, child)} : Maybe<&2, Phase.Capsule>}) -> Exists(B.Boundary, ReferenceBoundaryView.completion_partial_claim(World, actual, reference, child, history, frame, Allowance.materialization(ready_reference_forest(D.frame(reference))), reason, world)):
  ready_completion_partial_reason(World, actual, reference, child, frame, history, view, world, reason,
    actual_observed, actual_ready, reference_ready, capsule,
    Pair.fst({ReferenceFrame.graph(D.frame(reference)) == S.frame_graph(frame) : G.Graph},
      {ready_reference_remaining(D.frame(reference)) == ready_history_remaining(history) : Nat},
      ready_captured_coordinates(frame, reference, history, view, actual_ready, reference_ready)))

def ready_reference_stage_capsule(+state: D.State, +child: X.Child, +stage: D.Stage) -> {ReferenceReady.capsule(D.stage(state, stage), child) == ReferenceReady.capsule(state, child) : Phase.Capsule}:
  match state child:
    case D.State{D.Config{_, _, _, _, _, _}, X.Frame{_, _, _, _, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}
        X.Child{X.Attempt{_, _, _, _, _, _, _, _, _, _}, _, _, _}: {==}

def ready_staged_capsule_observed(+actual: T.ResolverState, +reference: D.State, +child: X.Child, +history: V.History, +stage: D.Stage, capsule: {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(reference, child)} : Maybe<&2, Phase.Capsule>}) -> {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(D.stage(reference, stage), child)} : Maybe<&2, Phase.Capsule>}:
  %Equal.sym(Phase.Capsule, ReferenceReady.capsule(D.stage(reference, stage), child), ReferenceReady.capsule(reference, child), ready_reference_stage_capsule(reference, child, stage)):
    {ActualBoundary.capsule(actual, history) == Some{_} : Maybe<&2, Phase.Capsule>}
  capsule

def ready_common_after_phase(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +frame: T.ResolverFrame, +history: V.History, +view: V.Frame, +world: E.WorldState<World>, actual_observed: {ActualBoundary.frame(S.state_frame(actual), history) == Some{view} : Maybe<&2, V.Frame>}, actual_ready: {ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>}, reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, capsule: {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(reference, child)} : Maybe<&2, Phase.Capsule>}) -> Exists(B.Boundary, boundary => {ActualBoundary.project(LoopPolicy.after_phase(ReferenceFrame.graph(D.frame(reference)), actual, frame), history) == Some{boundary} : Maybe<&2, B.Boundary>} & {ReferenceBoundaryView.project(World, D.consumed(World, ReferenceBoundary.next_boundary(D.internal(reference, D.AfterCommand{False{}})), world), child, history) == Some{boundary} : Maybe<&2, B.Boundary>}):
  match reference:
    case D.State{_, X.Frame{G.Bounded{G.Graph{+phase, _, _, _, _, _, _, _, _, _, _}, _}, _, _, _, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}:
      match phase:
        case G.Complete{}:
          ready_completion_normal(World, actual, D.stage(reference, D.Completion{None{}}), child, frame, history, view, world,
            actual_observed, actual_ready, Equal.trans(Maybe<&2, V.Frame>, ReferenceFrame.project(D.stage(reference, D.Completion{None{}}), history), ReferenceFrame.project(reference, history), Some{view}, ready_reference_stage_project(reference, history, D.Completion{None{}}), reference_ready), ready_staged_capsule_observed(actual, reference, child, history, D.Completion{None{}}, capsule))
        case G.Incomplete{+reason}:
          ready_completion_partial(World, actual, D.stage(reference, D.Completion{Some{reason}}), child, frame, history, view, world, reason,
            actual_observed, actual_ready, Equal.trans(Maybe<&2, V.Frame>, ReferenceFrame.project(D.stage(reference, D.Completion{Some{reason}}), history), ReferenceFrame.project(reference, history), Some{view}, ready_reference_stage_project(reference, history, D.Completion{Some{reason}}), reference_ready), ready_staged_capsule_observed(actual, reference, child, history, D.Completion{Some{reason}}, capsule))
        case G.Idle{}:
          Tuple{ready_iteration_boundary(view, ReferenceReady.capsule(D.stage(reference, D.Iteration{}), child)),
            ready_common_iteration_boundary(World, actual, D.stage(reference, D.Iteration{}), child, history, view, world,
              actual_observed, Equal.trans(Maybe<&2, V.Frame>, ReferenceFrame.project(D.stage(reference, D.Iteration{}), history), ReferenceFrame.project(reference, history), Some{view}, ready_reference_stage_project(reference, history, D.Iteration{}), reference_ready), ready_staged_capsule_observed(actual, reference, child, history, D.Iteration{}, capsule))}
        case G.GraphReady{}:
          Tuple{ready_iteration_boundary(view, ReferenceReady.capsule(D.stage(reference, D.Iteration{}), child)),
            ready_common_iteration_boundary(World, actual, D.stage(reference, D.Iteration{}), child, history, view, world,
              actual_observed, Equal.trans(Maybe<&2, V.Frame>, ReferenceFrame.project(D.stage(reference, D.Iteration{}), history), ReferenceFrame.project(reference, history), Some{view}, ready_reference_stage_project(reference, history, D.Iteration{}), reference_ready), ready_staged_capsule_observed(actual, reference, child, history, D.Iteration{}, capsule))}
        case G.Resolving{_}:
          Tuple{ready_iteration_boundary(view, ReferenceReady.capsule(D.stage(reference, D.Iteration{}), child)),
            ready_common_iteration_boundary(World, actual, D.stage(reference, D.Iteration{}), child, history, view, world,
              actual_observed, Equal.trans(Maybe<&2, V.Frame>, ReferenceFrame.project(D.stage(reference, D.Iteration{}), history), ReferenceFrame.project(reference, history), Some{view}, ready_reference_stage_project(reference, history, D.Iteration{}), reference_ready), ready_staged_capsule_observed(actual, reference, child, history, D.Iteration{}, capsule))}
        case G.Checking{_, _}:
          Tuple{ready_iteration_boundary(view, ReferenceReady.capsule(D.stage(reference, D.Iteration{}), child)),
            ready_common_iteration_boundary(World, actual, D.stage(reference, D.Iteration{}), child, history, view, world,
              actual_observed, Equal.trans(Maybe<&2, V.Frame>, ReferenceFrame.project(D.stage(reference, D.Iteration{}), history), ReferenceFrame.project(reference, history), Some{view}, ready_reference_stage_project(reference, history, D.Iteration{}), reference_ready), ready_staged_capsule_observed(actual, reference, child, history, D.Iteration{}, capsule))}
        case G.Capturing{_, _}:
          Tuple{ready_iteration_boundary(view, ReferenceReady.capsule(D.stage(reference, D.Iteration{}), child)),
            ready_common_iteration_boundary(World, actual, D.stage(reference, D.Iteration{}), child, history, view, world,
              actual_observed, Equal.trans(Maybe<&2, V.Frame>, ReferenceFrame.project(D.stage(reference, D.Iteration{}), history), ReferenceFrame.project(reference, history), Some{view}, ready_reference_stage_project(reference, history, D.Iteration{}), reference_ready), ready_staged_capsule_observed(actual, reference, child, history, D.Iteration{}, capsule))}

def ready_after_command_transport(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +history: V.History, +world: E.WorldState<World>, +skip: Bool, +continuation: Loop.Continuation, +same: {LoopPolicy.after_command(skip, actual) == continuation : Loop.Continuation}, common: Exists(B.Boundary, boundary => {ActualBoundary.project(continuation, history) == Some{boundary} : Maybe<&2, B.Boundary>} & {ReferenceBoundaryView.project(World, D.consumed(World, ReferenceBoundary.next_boundary(D.internal(reference, D.AfterCommand{skip})), world), child, history) == Some{boundary} : Maybe<&2, B.Boundary>})) -> Exists(B.Boundary, boundary => {ActualBoundary.project(LoopPolicy.after_command(skip, actual), history) == Some{boundary} : Maybe<&2, B.Boundary>} & {ReferenceBoundaryView.project(World, D.consumed(World, ReferenceBoundary.next_boundary(D.internal(reference, D.AfterCommand{skip})), world), child, history) == Some{boundary} : Maybe<&2, B.Boundary>}):
  match common:
    case (+boundary, Tuple{actual_boundary, reference_boundary}):
      Tuple{boundary, Tuple{
        Equal.trans(Maybe<&2, B.Boundary>, ActualBoundary.project(LoopPolicy.after_command(skip, actual), history), ActualBoundary.project(continuation, history), Some{boundary},
          Equal.cong(Loop.Continuation, Maybe<&2, B.Boundary>, step => ActualBoundary.project(step, history), LoopPolicy.after_command(skip, actual), continuation, same), actual_boundary), reference_boundary}}

def ready_after_command_frame(+actual: T.ResolverState, +reference: D.State, +frame: T.ResolverFrame, present: {S.state_frame(actual) == Some{frame} : Maybe<&2, T.ResolverFrame>}, graph: {ReferenceFrame.graph(D.frame(reference)) == S.frame_graph(frame) : G.Graph}) -> {LoopPolicy.after_command(False{}, actual) == LoopPolicy.after_phase(ReferenceFrame.graph(D.frame(reference)), actual, frame) : Loop.Continuation}:
  Equal.trans(Loop.Continuation, LoopPolicy.after_command(False{}, actual), LoopPolicy.after_phase(S.frame_graph(frame), actual, frame),
    LoopPolicy.after_phase(ReferenceFrame.graph(D.frame(reference)), actual, frame),
    Equal.cong(Maybe<&2, T.ResolverFrame>, Loop.Continuation, value => LoopPolicy.after_frame(value, actual), S.state_frame(actual), Some{frame}, present),
    Equal.cong(G.Graph, Loop.Continuation, value => LoopPolicy.after_phase(value, actual, frame), S.frame_graph(frame), ReferenceFrame.graph(D.frame(reference)),
      Equal.sym(G.Graph, ReferenceFrame.graph(D.frame(reference)), S.frame_graph(frame), graph)))

def ready_common_after_command(-World: Data, +actual: T.ResolverState, +reference: D.State, +child: X.Child, +frame: T.ResolverFrame, +history: V.History, +view: V.Frame, +world: E.WorldState<World>, skip: Bool, +present: {S.state_frame(actual) == Some{frame} : Maybe<&2, T.ResolverFrame>}, +actual_ready: {ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>}, +reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, capsule: {ActualBoundary.capsule(actual, history) == Some{ReferenceReady.capsule(reference, child)} : Maybe<&2, Phase.Capsule>}) -> Exists(B.Boundary, boundary => {ActualBoundary.project(LoopPolicy.after_command(skip, actual), history) == Some{boundary} : Maybe<&2, B.Boundary>} & {ReferenceBoundaryView.project(World, D.consumed(World, ReferenceBoundary.next_boundary(D.internal(reference, D.AfterCommand{skip})), world), child, history) == Some{boundary} : Maybe<&2, B.Boundary>}):
  match reference skip:
    case D.State{_, X.Frame{G.Bounded{G.Graph{_, _, _, _, _, _, _, _, _, _, _}, _}, _, _, _, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _} True{}:
      Tuple{ready_iteration_boundary(view, ReferenceReady.capsule(D.stage(reference, D.Iteration{}), child)),
        ready_common_iteration_boundary(World, actual, D.stage(reference, D.Iteration{}), child, history, view, world,
          Equal.trans(Maybe<&2, V.Frame>, ActualBoundary.frame(S.state_frame(actual), history), ActualBoundary.frame(Some{frame}, history), Some{view},
            Equal.cong(Maybe<&2, T.ResolverFrame>, Maybe<&2, V.Frame>, value => ActualBoundary.frame(value, history), S.state_frame(actual), Some{frame}, present), actual_ready),
          Equal.trans(Maybe<&2, V.Frame>, ReferenceFrame.project(D.stage(reference, D.Iteration{}), history), ReferenceFrame.project(reference, history), Some{view}, ready_reference_stage_project(reference, history, D.Iteration{}), reference_ready),
          ready_staged_capsule_observed(actual, reference, child, history, D.Iteration{}, capsule))}
    case D.State{_, _, _, _, _, _, _, _, _} False{}:
      ready_after_command_transport(World, actual, reference, child, history, world, False{}, LoopPolicy.after_phase(ReferenceFrame.graph(D.frame(reference)), actual, frame),
        ready_after_command_frame(actual, reference, frame, present,
          Pair.fst({ReferenceFrame.graph(D.frame(reference)) == S.frame_graph(frame) : G.Graph},
            {ready_reference_remaining(D.frame(reference)) == ready_history_remaining(history) : Nat},
            ready_captured_coordinates(frame, reference, history, view, actual_ready, reference_ready))),
        ready_common_after_phase(World, actual, reference, child, frame, history, view, world,
          Equal.trans(Maybe<&2, V.Frame>, ActualBoundary.frame(S.state_frame(actual), history), ActualBoundary.frame(Some{frame}, history), Some{view},
            Equal.cong(Maybe<&2, T.ResolverFrame>, Maybe<&2, V.Frame>, value => ActualBoundary.frame(value, history), S.state_frame(actual), Some{frame}, present), actual_ready),
          actual_ready, reference_ready, capsule))

# Full original transaction assembly. The named hole is the remaining accepted
# ProductEncoded publication/rollback boundary; it is not an assumed premise.
# Recover the actual allocated Await state from the existing measurement equality.
# None is eliminated by that equality; no successful-product premise is added.
def ready_await_state(continuation: Loop.Continuation) -> Maybe<&2, T.ResolverState>:
  match continuation:
    case Loop.ServiceStep{T.AwaitService{state, _}}: Some{state}
    case _: None{}

def ready_candidate_state_value(+product: ArtifactValue.ProductValue, child: T.TentativeChild, ids: List<&2, Nat>, previous: Nat, +state: T.ResolverState) -> T.ResolverState:
  match child:
    case T.TentativeChild{target, path, capture, source_bytes, file, artifact, identity, before, plan, _, _, _}:
      S.with_state_next_request(S.with_state_stage(
        S.with_state_scratch(state, S.with_scratch_tentative(S.state_scratch(state),
          Some{T.TentativeChild{target, path, capture, source_bytes, file, artifact, identity, before, plan, previous, product, ids}})),
        T.MeasuringCandidateTree{}), (S.state_next_request(state) + 1n : Nat))

def ready_candidate_allocated_identity(+available: Maybe<&2, ArtifactValue.ProductValue>, +child: T.TentativeChild, +ids: List<&2, Nat>, +previous: Nat, +state: T.ResolverState, +measured: T.ResolverState, +request: T.Request, awaited: {Attach.request_candidate(available, child, ids, previous, state) == Loop.ServiceStep{T.AwaitService{measured, request}} : Loop.Continuation}) -> Exists(ArtifactValue.ProductValue, product => {available == Some{product} : Maybe<&2, ArtifactValue.ProductValue>} & {measured == ready_candidate_state_value(product, child, ids, previous, state) : T.ResolverState}):
  match available child state:
    case None{} _ _:
      Empty.absurd(Exists(ArtifactValue.ProductValue, product => {available == Some{product} : Maybe<&2, ArtifactValue.ProductValue>} & {measured == ready_candidate_state_value(product, child, ids, previous, state) : T.ResolverState}),
        Contents.none_some(T.ResolverState, measured,
          Equal.cong(Loop.Continuation, Maybe<&2, T.ResolverState>, ready_await_state,
            Attach.request_candidate(available, child, ids, previous, state), Loop.ServiceStep{T.AwaitService{measured, request}}, awaited)))
    case Some{+product} T.TentativeChild{_, _, _, _, _, _, _, _, _, _, _, _} T.ResolverState{_, _, _, _, _, _, _, _, _, _, _, _, _}:
      Tuple{product, Tuple{{==},
        Equal.sym(T.ResolverState, ready_candidate_state_value(product, child, ids, previous, state), measured,
          Count.some_equal(T.ResolverState, ready_candidate_state_value(product, child, ids, previous, state), measured,
            Equal.cong(Loop.Continuation, Maybe<&2, T.ResolverState>, ready_await_state,
              Attach.request_candidate(available, child, ids, previous, state), Loop.ServiceStep{T.AwaitService{measured, request}}, awaited)))}}

def ready_view_captured(view: Phase.Child, work: Nat, contribution: Nat, ids: List<&2, Nat>) -> G.GraphEvent:
  match view:
    case Phase.Child{_, _, _, _, bytes, _, _, _, before, _, _, _, _, V.Budget{_, _, _, _, _, _}, _, _}:
      G.Captured{bytes, contribution, Nat.sub(work, before), ids}

def ready_actual_captured(child: T.TentativeChild, work: Nat, contribution: Nat, ids: List<&2, Nat>) -> G.GraphEvent:
  match child:
    case T.TentativeChild{_, _, _, bytes, _, _, _, before, Local.Plan{_, _, _, _, _, budget}, _, _, _}:
      G.Captured{bytes, contribution, Nat.sub(work, before), ids}

def ready_reference_captured(child: X.Child, work: Nat, contribution: Nat, ids: List<&2, Nat>) -> G.GraphEvent:
  match child:
    case X.Child{X.Attempt{_, _, _, _, bytes, _, _, _, _, before}, _, _, _}:
      G.Captured{bytes, contribution, Nat.sub(work, before), ids}

def ready_actual_captured_view(+forest: Maybe<&2, F.Forest>, +pending: Maybe<&2, List<&2, V.PendingPayload>>, +visited: Maybe<&2, List<&2, String>>, +child: T.TentativeChild, +edge: Local.Pending, +history: Phase.ChildHistory, +view: Phase.Child, +work: Nat, +contribution: Nat, +ids: List<&2, Nat>, ready: {ActualReady.child_view(forest, pending, visited, child, edge, history) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_actual_captured(child, work, contribution, ids) == ready_view_captured(view, work, contribution, ids) : G.GraphEvent}:
  match forest pending visited child history:
    case Some{+forest_value} Some{+pending_value} Some{+visited_value}
      T.TentativeChild{target, +path, capture, bytes, file, artifact, identity, before, Local.Plan{_, _, _, _, _, Local.Budget{limits, targets, maximum, child_work, graph_work, depth}}, _, _, _}
      Phase.ChildHistory{F.Created{_, _, addresses}, source, catalog, _, _}:
      %Count.some_equal(Phase.Child, Phase.Child{target, path, ActualReady.edge_kind(edge, path), capture, bytes, file,
          artifact, identity, before, forest_value, addresses, pending_value, visited_value, V.actual_budget(Local.Budget{limits, targets, maximum, child_work, graph_work, depth}), source, catalog}, view, ready):
        {ready_actual_captured(child, work, contribution, ids) == ready_view_captured(_, work, contribution, ids) : G.GraphEvent}
      {==}
    case None{} _ _ _ _:
      Empty.absurd({ready_actual_captured(child, work, contribution, ids) == ready_view_captured(view, work, contribution, ids) : G.GraphEvent}, Contents.none_some(Phase.Child, view, ready))
    case Some{_} None{} _ _ _:
      Empty.absurd({ready_actual_captured(child, work, contribution, ids) == ready_view_captured(view, work, contribution, ids) : G.GraphEvent}, Contents.none_some(Phase.Child, view, ready))
    case Some{_} Some{_} None{} _ _:
      Empty.absurd({ready_actual_captured(child, work, contribution, ids) == ready_view_captured(view, work, contribution, ids) : G.GraphEvent}, Contents.none_some(Phase.Child, view, ready))

def ready_actual_captured_projected(+child: T.TentativeChild, +edge: Local.Pending, +history: Phase.ChildHistory, +artifacts: List<&2, T.ArtifactEntry>, +episode: Nat, +view: Phase.Child, +work: Nat, +contribution: Nat, +ids: List<&2, Nat>, ready: {ActualReady.child_projected(child, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_actual_captured(child, work, contribution, ids) == ready_view_captured(view, work, contribution, ids) : G.GraphEvent}:
  match child history:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{+root, +nodes, +slots, +items, +visited, _}, _, _, _}
        Phase.ChildHistory{F.Created{_, _, +addresses}, _, _, _, +order}:
      ready_actual_captured_view(ActualReady.valid_forest(P.project(root, nodes, slots, artifacts, addresses), episode),
        ActualReady.pending(items, addresses), ActualReady.visited_complete(order, visited), child, edge, history, view, work, contribution, ids, ready)

def ready_actual_captured_project(+child: T.TentativeChild, +edge: Local.Pending, +history: Phase.ChildHistory, +artifacts: List<&2, T.ArtifactEntry>, +episode: Nat, +view: Phase.Child, +work: Nat, +contribution: Nat, +ids: List<&2, Nat>, ready: {ActualReady.child_project(child, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_actual_captured(child, work, contribution, ids) == ready_view_captured(view, work, contribution, ids) : G.GraphEvent}:
  ready_actual_captured_projected(child, edge, history, artifacts, episode, view, work, contribution, ids,
    Pair.snd({child_checks(child) == True{} : Bool}, {ActualReady.child_projected(child, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}, actual_child_contents(child, edge, history, artifacts, episode, view, ready)))

def ready_reference_captured_view(+child: X.Child, +history: Phase.ChildHistory, +visited: Maybe<&2, List<&2, String>>, +view: Phase.Child, +work: Nat, +contribution: Nat, +ids: List<&2, Nat>, ready: {ReferenceReady.child_view(child, history, visited) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_reference_captured(child, work, contribution, ids) == ready_view_captured(view, work, contribution, ids) : G.GraphEvent}:
  match child history visited:
    case X.Child{
      X.Attempt{
        +target,
        edge,
        +kind,
        +source,
        +bytes,
        name,
        expected,
        Local.Declaration{+handle, +identity, function, bundled, references, +source_path},
        +catalog,
        +before
      },
      F.Created{root, nodes, addresses},
      Signed.State{Recursive.State{_, Local.Budget{limits, targets, maximum, child_work, graph_work, depth}, _, _}, signed},
      edges
    }
      Phase.ChildHistory{_, _, _, capture, _} Some{+visited}:
      %Count.some_equal(Phase.Child,
        Phase.Child{
          target,
          X.attempt_path(
            X.Attempt{
              target,
              edge,
              kind,
              source,
              bytes,
              name,
              expected,
              Local.Declaration{handle, identity, function, bundled, references, source_path},
              catalog,
              before
            }
          ),
          kind,
          capture,
          bytes,
          T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceReady.file_exports(kind, source), bytes},
          handle,
          identity,
          before,
          F.Forest{Some{root}, nodes},
          addresses,
          ReferenceReady.pending(edges),
          visited,
          V.budget(Local.Budget{limits, targets, maximum, child_work, graph_work, depth}, signed),
          source,
          catalog
        }, view, ready):
        {ready_reference_captured(child, work, contribution, ids) == ready_view_captured(_, work, contribution, ids) : G.GraphEvent}
      {==}
    case _ _ None{}:
      Empty.absurd({ready_reference_captured(child, work, contribution, ids) == ready_view_captured(view, work, contribution, ids) : G.GraphEvent}, Contents.none_some(Phase.Child, view, ready))

def ready_reference_captured_project(+child: X.Child, +history: Phase.ChildHistory, +view: Phase.Child, +work: Nat, +contribution: Nat, +ids: List<&2, Nat>, ready: {ReferenceReady.child_project(child, history) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_reference_captured(child, work, contribution, ids) == ready_view_captured(view, work, contribution, ids) : G.GraphEvent}:
  match child history:
    case X.Child{_, _, Signed.State{Recursive.State{+values, _, _, _}, _}, _} Phase.ChildHistory{_, _, _, _, +order}:
      ready_reference_captured_view(child, history, ReferenceFrame.visited(order, values), view, work, contribution, ids, ready)

def ready_common_child_captured(+actual: T.TentativeChild, +edge: Local.Pending, +reference: X.Child, +history: Phase.ChildHistory, +artifacts: List<&2, T.ArtifactEntry>, +episode: Nat, +view: Phase.Child, +work: Nat, +contribution: Nat, +ids: List<&2, Nat>, actual_ready: {ActualReady.child_project(actual, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}, reference_ready: {ReferenceReady.child_project(reference, history) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_actual_captured(actual, work, contribution, ids) == ready_reference_captured(reference, work, contribution, ids) : G.GraphEvent}:
  Equal.trans(G.GraphEvent, ready_actual_captured(actual, work, contribution, ids), ready_view_captured(view, work, contribution, ids), ready_reference_captured(reference, work, contribution, ids),
    ready_actual_captured_project(actual, edge, history, artifacts, episode, view, work, contribution, ids, actual_ready),
    Equal.sym(G.GraphEvent, ready_reference_captured(reference, work, contribution, ids), ready_view_captured(view, work, contribution, ids), ready_reference_captured_project(reference, history, view, work, contribution, ids, reference_ready)))

def ready_selected_child_captured(+state: T.ResolverState, +frame: T.ResolverFrame, +actual: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +work: Nat, +contribution: Nat, +ids: List<&2, Nat>, actual_ready: {ActualReady.parts(state, Some{frame}, Some{actual}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {ready_actual_captured(actual, work, contribution, ids) == ready_reference_captured(child, work, contribution, ids) : G.GraphEvent}:
  match history phase:
    case V.History{+addresses, _, _, _, _, +remaining, +episode} Phase.Phase{+view, +child_view, +capsule}:
      Parent.eliminate_pair({Bool.and(ActualReady.mutable_maps_canonical(frame), Bool.and(ActualReady.fresh_registration(history, frame), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame))))) == True{} : Bool}, {ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>} & {ActualReady.child_project(actual, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>} & {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>}, {ready_actual_captured(actual, work, contribution, ids) == ready_reference_captured(child, work, contribution, ids) : G.GraphEvent},
        selected_phase_contents(state, frame, actual, edge, history, child_history, phase, actual_ready),
        valid => observations =>
        Parent.eliminate_pair({ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>}, {ActualReady.child_project(actual, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>} & {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>}, {ready_actual_captured(actual, work, contribution, ids) == ready_reference_captured(child, work, contribution, ids) : G.GraphEvent}, observations,
          frame_ready => child_observations =>
          Parent.eliminate_pair({ActualReady.child_project(actual, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>}, {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>}, {ready_actual_captured(actual, work, contribution, ids) == ready_reference_captured(child, work, contribution, ids) : G.GraphEvent}, child_observations,
            actual_child => actual_capsule =>
            Parent.eliminate_pair({ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, {ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>} & {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}, {ready_actual_captured(actual, work, contribution, ids) == ready_reference_captured(child, work, contribution, ids) : G.GraphEvent}, reference_ready_contents(reference, child, history, child_history, phase, reference_ready),
              reference_frame => reference_observations =>
              Parent.eliminate_pair({ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>}, {Some{ReferenceReady.capsule(reference, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}, {ready_actual_captured(actual, work, contribution, ids) == ready_reference_captured(child, work, contribution, ids) : G.GraphEvent}, reference_observations,
                reference_child => reference_capsule =>
                ready_common_child_captured(actual, edge, child, child_history, S.frame_artifacts(frame), episode, child_view, work, contribution, ids, actual_child, reference_child))))))

def ready_registered_ids(value: Compose.RegisteredPending) -> List<&2, Nat>:
  match value:
    case Compose.RegisteredPending{_, ids, _}: ids

def ready_registration_ids(value: X.Registration) -> List<&2, Nat>:
  match value:
    case X.Registration{_, ids, _}: ids

def ready_attachment_ids(value: Compose.Attachment) -> List<&2, Nat>:
  match value:
    case Compose.Attachment{_, _, _, _, _, _, ids, _, _}: ids

def ready_registered_ids_prefix(+value: Compose.RegisteredPending, +id: Nat) -> {ready_registered_ids(Compose.registered_prefix(value, id)) == id <> ready_registered_ids(value) : List<&2, Nat>}:
  match value:
    case Compose.RegisteredPending{_, _, _}: {==}

def ready_registered_ids_exact(+items: List<&2, Local.Pending>, +next: Nat, +entries: Map<&2, Maybe<&2, Local.Pending>>) -> {ready_registered_ids(Compose.register_pending(items, next, entries)) == ready_pending_ids(items, next) : List<&2, Nat>}:
  match items:
    case []: {==}
    case +head <> +tail:
      Equal.trans(List<&2, Nat>, ready_registered_ids(Compose.register_pending(head <> tail, next, entries)), next <> ready_registered_ids(Compose.register_pending(tail, (next + 1n : Nat), Map.set(&2, Maybe<&2, Local.Pending>, entries, Nat.show(next), Some{head}))), next <> ready_pending_ids(tail, (next + 1n : Nat)),
        ready_registered_ids_prefix(Compose.register_pending(tail, (next + 1n : Nat), Map.set(&2, Maybe<&2, Local.Pending>, entries, Nat.show(next), Some{head})), next),
        Equal.cong(List<&2, Nat>, List<&2, Nat>, rest => next <> rest,
          ready_registered_ids(Compose.register_pending(tail, (next + 1n : Nat), Map.set(&2, Maybe<&2, Local.Pending>, entries, Nat.show(next), Some{head}))), ready_pending_ids(tail, (next + 1n : Nat)),
          ready_registered_ids_exact(tail, (next + 1n : Nat), Map.set(&2, Maybe<&2, Local.Pending>, entries, Nat.show(next), Some{head}))))

def ready_shifted_pending_ids(+items: List<&2, Local.Pending>, +offset: Nat, +next: Nat) -> {ready_pending_ids(Compose.shift_pending(items, offset), next) == ready_pending_ids(items, next) : List<&2, Nat>}:
  match items:
    case []: {==}
    case Local.Pending{_, _, _, _, _, _, _, _} <> +tail:
      Equal.cong(List<&2, Nat>, List<&2, Nat>, rest => next <> rest, ready_pending_ids(Compose.shift_pending(tail, offset), (next + 1n : Nat)), ready_pending_ids(tail, (next + 1n : Nat)), ready_shifted_pending_ids(tail, offset, (next + 1n : Nat)))

def ready_reference_ids_prefix(+value: X.Registration, +head: F.Pending, +source: T.SourceFacts, +catalog: RootSpec.Source, +next: Nat) -> {ready_registration_ids(X.registered(value, head, source, catalog, next)) == next <> ready_registration_ids(value) : List<&2, Nat>}:
  match value:
    case X.Registration{_, _, _}: {==}

def ready_reference_ids_exact(+items: List<&2, F.Pending>, +source: T.SourceFacts, +catalog: RootSpec.Source, +next: Nat) -> {ready_registration_ids(X.register(items, source, catalog, next)) == History.ids(ReferenceReady.pending(items), next) : List<&2, Nat>}:
  match items:
    case []: {==}
    case +head <> +tail:
      Equal.trans(List<&2, Nat>, ready_registration_ids(X.register(head <> tail, source, catalog, next)), next <> ready_registration_ids(X.register(tail, source, catalog, (next + 1n : Nat))), next <> History.ids(ReferenceReady.pending(tail), (next + 1n : Nat)),
        ready_reference_ids_prefix(X.register(tail, source, catalog, (next + 1n : Nat)), head, source, catalog, next),
        Equal.cong(List<&2, Nat>, List<&2, Nat>, rest => next <> rest,
          ready_registration_ids(X.register(tail, source, catalog, (next + 1n : Nat))), History.ids(ReferenceReady.pending(tail), (next + 1n : Nat)), ready_reference_ids_exact(tail, source, catalog, (next + 1n : Nat))))

def ready_registered_attachment_ids(+registration: Compose.RegisteredPending, +plan: Compose.RemappedPlan, +nodes: List<&2, Local.PlannedNode>, +references: List<&2, Local.ReferenceSlot>) -> {ready_attachment_ids(Compose.attachment_registered(registration, plan, nodes, references)) == ready_registered_ids(registration) : List<&2, Nat>}:
  match registration plan:
    case Compose.RegisteredPending{_, _, _} Compose.RemappedPlan{_, _, _, _, _, _, _}: {==}

def ready_attach_replaced_ids(+replaced: Maybe<&2, List<&2, Local.ReferenceSlot>>, +plan: Compose.RemappedPlan, +nodes: List<&2, Local.PlannedNode>, +next: Nat, +pending: Map<&2, Maybe<&2, Local.Pending>>, +attachment: Compose.Attachment, attached: {Compose.attach_replaced(replaced, plan, nodes, next, pending) == Some{attachment} : Maybe<&2, Compose.Attachment>}) -> {ready_attachment_ids(attachment) == ready_registered_ids(Compose.register_pending(ready_remapped_pending(plan), next, pending)) : List<&2, Nat>}:
  match replaced plan:
    case Some{+references} Compose.RemappedPlan{_, _, _, _, +items, _, _}:
      %Count.some_equal(Compose.Attachment, Compose.attachment_registered(Compose.register_pending(items, next, pending), plan, nodes, references), attachment, attached):
        {ready_attachment_ids(_) == ready_registered_ids(Compose.register_pending(items, next, pending)) : List<&2, Nat>}
      ready_registered_attachment_ids(Compose.register_pending(items, next, pending), plan, nodes, references)
    case None{} _:
      Empty.absurd({ready_attachment_ids(attachment) == ready_registered_ids(Compose.register_pending(ready_remapped_pending(plan), next, pending)) : List<&2, Nat>}, Contents.none_some(Compose.Attachment, attachment, attached))

def ready_tentative_attachment_ids(+plan: Compose.RemappedPlan, +nodes: List<&2, Local.PlannedNode>, +references: List<&2, Local.ReferenceSlot>, +owner: Nat, +index: Nat, +include: Maybe<&2, String>, +next: Nat, +pending: Map<&2, Maybe<&2, Local.Pending>>, +attachment: Compose.Attachment, attached: {Compose.tentative_attachment(plan, nodes, references, owner, index, include, next, pending) == Some{attachment} : Maybe<&2, Compose.Attachment>}) -> {ready_attachment_ids(attachment) == ready_registered_ids(Compose.register_pending(ready_remapped_pending(plan), next, pending)) : List<&2, Nat>}:
  match plan include:
    case Compose.RemappedPlan{+root, _, _, _, _, _, _} None{}:
      ready_attach_replaced_ids(Compose.replacement(Compose.replace_slot(references, owner, index, Local.Expanded{root})), plan, nodes, next, pending, attachment, attached)
    case Compose.RemappedPlan{_, _, _, _, _, _, _} Some{+identity}:
      ready_attach_replaced_ids(Compose.replacement(Compose.replace_slot(references, owner, index, Local.Included{identity})), plan, nodes, next, pending, attachment, attached)

def ready_selected_attachment_ids(+child: T.TentativeChild, +frame: T.ResolverFrame, +edge: Local.Pending, +attachment: Compose.Attachment, +addresses: List<&2, F.AddressEntry>, +payloads: List<&2, V.PendingPayload>, attached: ready_selected_attachment_result(child, frame, edge, attachment), projected: {ActualReady.pending(ready_plan_pending(ready_actual_child_plan(child)), addresses) == Some{payloads} : Maybe<&2, List<&2, V.PendingPayload>>}) -> {ready_attachment_ids(attachment) == History.ids(payloads, S.frame_next_edge(frame)) : List<&2, Nat>}:
  match child edge:
    case T.TentativeChild{_, _, _, _, _, _, +identity, _, Local.Plan{+root, +nodes, +slots, +items, +visited, +budget}, _, _, _} Local.Pending{+owner, +index, _, _, _, _, _, _}:
      +offset: Nat = List.length(&2, Local.PlannedNode, S.frame_nodes(frame))
      +next: Nat = S.frame_next_edge(frame)
      +plan: Compose.RemappedPlan = Compose.remap(Local.Plan{root, nodes, slots, items, visited, budget}, offset)
      Equal.trans(List<&2, Nat>, ready_attachment_ids(attachment), ready_registered_ids(Compose.register_pending(Compose.shift_pending(items, offset), next, S.frame_pending(frame))), History.ids(payloads, next),
        ready_tentative_attachment_ids(plan, S.frame_nodes(frame), S.frame_references(frame), owner, index,
          Bool.pick(Maybe<&2, String>, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), identity))), Some{identity}, None{}), next, S.frame_pending(frame), attachment, attached),
        Equal.trans(List<&2, Nat>, ready_registered_ids(Compose.register_pending(Compose.shift_pending(items, offset), next, S.frame_pending(frame))), ready_pending_ids(Compose.shift_pending(items, offset), next), History.ids(payloads, next),
          ready_registered_ids_exact(Compose.shift_pending(items, offset), next, S.frame_pending(frame)),
          Equal.trans(List<&2, Nat>, ready_pending_ids(Compose.shift_pending(items, offset), next), ready_pending_ids(items, next), History.ids(payloads, next),
            ready_shifted_pending_ids(items, offset, next), ready_pending_ids_exact(items, addresses, next, payloads, projected))))

def ready_reference_ids_view(+child: X.Child, +history: Phase.ChildHistory, +visited: Maybe<&2, List<&2, String>>, +view: Phase.Child, +next: Nat, ready: {ReferenceReady.child_view(child, history, visited) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_registration_ids(ready_reference_child_registration(child, next)) == History.ids(ready_child_payloads(view), next) : List<&2, Nat>}:
  match child history visited:
    case X.Child{
      X.Attempt{
        +target,
        edge,
        +kind,
        +source,
        +bytes,
        name,
        expected,
        Local.Declaration{+handle, +identity, function, bundled, references, +source_path},
        +catalog,
        +before
      },
      F.Created{root, nodes, addresses},
      Signed.State{Recursive.State{_, budget, _, _}, signed},
      +edges
    }
      Phase.ChildHistory{_, _, _, capture, _} Some{+visited}:
      %Count.some_equal(Phase.Child,
        Phase.Child{
          target,
          X.attempt_path(
            X.Attempt{
              target,
              edge,
              kind,
              source,
              bytes,
              name,
              expected,
              Local.Declaration{handle, identity, function, bundled, references, source_path},
              catalog,
              before
            }
          ),
          kind,
          capture,
          bytes,
          T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceReady.file_exports(kind, source), bytes},
          handle,
          identity,
          before,
          F.Forest{Some{root}, nodes},
          addresses,
          ReferenceReady.pending(edges),
          visited,
          V.budget(budget, signed),
          source,
          catalog
        }, view, ready):
        {ready_registration_ids(ready_reference_child_registration(child, next)) == History.ids(ready_child_payloads(_), next) : List<&2, Nat>}
      ready_reference_ids_exact(edges, source, catalog, next)
    case _ _ None{}:
      Empty.absurd({ready_registration_ids(ready_reference_child_registration(child, next)) == History.ids(ready_child_payloads(view), next) : List<&2, Nat>}, Contents.none_some(Phase.Child, view, ready))

def ready_reference_child_ids(+child: X.Child, +history: Phase.ChildHistory, +view: Phase.Child, +next: Nat, ready: {ReferenceReady.child_project(child, history) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_registration_ids(ready_reference_child_registration(child, next)) == History.ids(ready_child_payloads(view), next) : List<&2, Nat>}:
  match child history:
    case X.Child{_, _, Signed.State{Recursive.State{+values, _, _, _}, _}, _}
      Phase.ChildHistory{_, _, _, _, +order}:
      ready_reference_ids_view(child, history, ReferenceFrame.visited(order, values), view, next, ready)

def ready_reference_phase_ids(+state: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, ready: {ReferenceReady.project(state, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {ready_registration_ids(ready_reference_registration(state, child)) == History.ids(ready_child_payloads(ready_phase_child(phase)), ready_view_edge(ready_phase_frame(phase))) : List<&2, Nat>}:
  match phase:
    case Phase.Phase{+view, +child_view, +capsule}:
      Parent.eliminate_pair({ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>},
        {ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>} &
        {Some{ReferenceReady.capsule(state, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>},
        {ready_registration_ids(ready_reference_registration(state, child)) == History.ids(ready_child_payloads(child_view), ready_view_edge(view)) : List<&2, Nat>},
        reference_ready_contents(state, child, history, child_history, phase, ready),
        frame_ready => child_observations =>
        Parent.eliminate_pair({ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>},
          {Some{ReferenceReady.capsule(state, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>},
          {ready_registration_ids(ready_reference_registration(state, child)) == History.ids(ready_child_payloads(child_view), ready_view_edge(view)) : List<&2, Nat>},
          child_observations, child_ready => capsule_ready =>
          Equal.trans(List<&2, Nat>, ready_registration_ids(ready_reference_registration(state, child)),
            History.ids(ready_child_payloads(child_view), ready_reference_edge(state)), History.ids(ready_child_payloads(child_view), ready_view_edge(view)),
            Equal.trans(List<&2, Nat>, ready_registration_ids(ready_reference_registration(state, child)),
              ready_registration_ids(ready_reference_child_registration(child, ready_reference_edge(state))),
              History.ids(ready_child_payloads(child_view), ready_reference_edge(state)),
              Equal.cong(X.Registration, List<&2, Nat>, value => ready_registration_ids(value),
                ready_reference_registration(state, child), ready_reference_child_registration(child, ready_reference_edge(state)), ready_reference_registration_rows(state, child)),
              ready_reference_child_ids(child, child_history, child_view, ready_reference_edge(state), child_ready)),
            Equal.cong(Nat, List<&2, Nat>, next => History.ids(ready_child_payloads(child_view), next), ready_reference_edge(state), ready_view_edge(view),
              ready_reference_edge_projected(state, history, view, frame_ready)))))

def ready_actual_phase_ids_coordinates(+child: T.TentativeChild, +edge: Local.Pending, +frame: T.ResolverFrame, +attachment: Compose.Attachment, +child_history: Phase.ChildHistory, +phase: Phase.Phase, attached: ready_selected_attachment_result(child, frame, edge, attachment), pending: {ActualReady.pending(ready_plan_pending(ready_actual_child_plan(child)), ready_child_addresses(child_history)) == Some{ready_child_payloads(ready_phase_child(phase))} : Maybe<&2, List<&2, V.PendingPayload>>}, coordinates: ready_frame_coordinates(frame, ready_phase_frame(phase)) & ready_child_coordinates(child, child_history, ready_phase_child(phase))) -> {ready_attachment_ids(attachment) == History.ids(ready_child_payloads(ready_phase_child(phase)), ready_view_edge(ready_phase_frame(phase))) : List<&2, Nat>}:
  match child child_history phase:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Phase.ChildHistory{F.Created{_, _, +addresses}, _, _, _, _}
      Phase.Phase{V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, +next, _, _, _, _, _}, Phase.Child{_, _, _, _, _, _, _, _, _, _, _, +payloads, _, _, _, _}, _}:
      match coordinates:
        case ((_, (_, edge_equal)), _):
          Equal.trans(List<&2, Nat>, ready_attachment_ids(attachment), History.ids(payloads, S.frame_next_edge(frame)), History.ids(payloads, next),
            ready_selected_attachment_ids(child, frame, edge, attachment, addresses, payloads, attached, pending),
            Equal.cong(Nat, List<&2, Nat>, value => History.ids(payloads, value), S.frame_next_edge(frame), next, edge_equal))

def ready_actual_phase_ids(+state: T.ResolverState, +frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +attachment: Compose.Attachment, +selected: {ActualReady.parts(state, Some{frame}, Some{child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, attached: ready_selected_attachment_result(child, frame, edge, attachment)) -> {ready_attachment_ids(attachment) == History.ids(ready_child_payloads(ready_phase_child(phase)), ready_view_edge(ready_phase_frame(phase))) : List<&2, Nat>}:
  match history phase:
    case V.History{+addresses, _, _, _, _, +remaining, +episode} Phase.Phase{+view, +child_view, +capsule}:
      ready_actual_phase_ids_coordinates(child, edge, frame, attachment, child_history, phase, attached,
        ready_child_pending_exact(child, edge, child_history, S.frame_artifacts(frame), episode, child_view,
          Pair.fst({ActualReady.child_project(child, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>},
            {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>},
            Pair.snd({ActualFrame.project(frame, history) == Some{view} : Maybe<&2, V.Frame>},
              {ActualReady.child_project(child, edge, child_history, S.frame_artifacts(frame), episode) == Some{child_view} : Maybe<&2, Phase.Child>} & {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{capsule} : Maybe<&2, Phase.Capsule>},
              Pair.snd({Bool.and(ActualReady.mutable_maps_canonical(frame), Bool.and(ActualReady.fresh_registration(history, frame), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame))))) == True{} : Bool}, assembled_result(ActualFrame.project(frame, history), ActualReady.child_project(child, edge, child_history, S.frame_artifacts(frame), episode), ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state), phase), selected_phase_contents(state, frame, child, edge, history, child_history, phase, selected))))),
        ready_selected_coordinates(child, history, child_history, phase, state, frame, edge, selected))

def ready_common_registration_ids(+state: T.ResolverState, +frame: T.ResolverFrame, +actual: T.TentativeChild, +edge: Local.Pending, +reference: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +attachment: Compose.Attachment, selected: {ActualReady.parts(state, Some{frame}, Some{actual}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, reference_ready: {ReferenceReady.project(reference, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, attached: ready_selected_attachment_result(actual, frame, edge, attachment)) -> {ready_attachment_ids(attachment) == ready_registration_ids(ready_reference_registration(reference, child)) : List<&2, Nat>}:
  Equal.trans(List<&2, Nat>, ready_attachment_ids(attachment), History.ids(ready_child_payloads(ready_phase_child(phase)), ready_view_edge(ready_phase_frame(phase))), ready_registration_ids(ready_reference_registration(reference, child)),
    ready_actual_phase_ids(state, frame, actual, edge, history, child_history, phase, attachment, selected, attached),
    Equal.sym(List<&2, Nat>, ready_registration_ids(ready_reference_registration(reference, child)), History.ids(ready_child_payloads(ready_phase_child(phase)), ready_view_edge(ready_phase_frame(phase))), ready_reference_phase_ids(reference, child, history, child_history, phase, reference_ready)))

def ready_observed_work(budget: V.Budget) -> Nat:
  match budget:
    case V.Budget{_, _, _, work, _, _}: work

def ready_reference_work(state: D.State) -> Nat:
  match state:
    case D.State{_, X.Frame{_, _, _, local, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}:
      X.budget_work(Recursive.state_budget(Signed.local(local)))

def ready_common_frame_work(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, actual_ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}) -> {Admission.local_work(S.frame_budget(actual)) == ready_reference_work(reference) : Nat}:
  match actual reference view:
    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, Local.Budget{_, _, _, _, _, _}, _, _, _, _, _, _, _, _, _, _}
      D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{_, Local.Budget{_, _, _, _, _, _}, _, _}, _}, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}
      V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, +budget, +node, +edge, _, _, _, _, _}:
      Equal.trans(Nat, Admission.local_work(S.frame_budget(actual)), ready_observed_work(budget), ready_reference_work(reference),
        Equal.cong(V.Budget, Nat, ready_observed_work, V.actual_budget(S.frame_budget(actual)), budget,
          Pair.fst({V.actual_budget(S.frame_budget(actual)) == budget : V.Budget}, {S.frame_next_node(actual) == node : Nat} & {S.frame_next_edge(actual) == edge : Nat},
            ready_projected_frame_coordinates(actual, history, view,
              Pair.snd({frame_checks(actual, history) == True{} : Bool}, {ActualFrame.projected(actual, history) == Some{view} : Maybe<&2, V.Frame>}, actual_frame_contents(actual, history, view, actual_ready))))),
        Equal.sym(Nat, ready_reference_work(reference), ready_observed_work(budget),
          Equal.cong(V.Budget, Nat, ready_observed_work, ready_reference_budget(reference), budget, ready_reference_budget_project(reference, history, view, reference_ready))))

def ready_registration_eliminate(-Result: Type, +registration: X.Registration, body: @more: List<&2, X.Edge> -> @ids: List<&2, Nat> -> @next: Nat -> {registration == X.Registration{more, ids, next} : X.Registration} -> Result) -> Result:
  match registration:
    case X.Registration{+more, +ids, +next}: body(more)(ids)(next)({==})

