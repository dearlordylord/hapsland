    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
      V.History{+addresses, V.Order{+pending_order, +target_order, +id_order, +capture_order, +identity_order, +visited_order}, +sources, +captures, _, +remaining, +episode}:
      Equal.trans(Maybe<&2, V.Frame>, ActualFrame.projected(S.with_frame_references(actual, slots), history), ActualFrame.frame_view(Some{changed}, ActualFrame.pending(pending_order, S.frame_pending(actual), sources, addresses), ActualFrame.targets(target_order, S.frame_target_paths(actual), addresses), ActualFrame.ids(id_order, S.frame_target_ids(actual)), ActualFrame.captured(capture_order, S.frame_captured(actual), captures), ActualFrame.identities(identity_order, S.frame_target_artifacts(actual)), ActualFrame.visited(visited_order, S.frame_visited(actual)), S.with_frame_references(actual, slots), remaining, episode), Some{ready_replaced_view(view, changed)},
        Equal.cong(Maybe<&2, F.Forest>, Maybe<&2, V.Frame>, forest => ActualFrame.frame_view(forest, ActualFrame.pending(pending_order, S.frame_pending(actual), sources, addresses), ActualFrame.targets(target_order, S.frame_target_paths(actual), addresses), ActualFrame.ids(id_order, S.frame_target_ids(actual)), ActualFrame.captured(capture_order, S.frame_captured(actual), captures), ActualFrame.identities(identity_order, S.frame_target_artifacts(actual)), ActualFrame.visited(visited_order, S.frame_visited(actual)), S.with_frame_references(actual, slots), remaining, episode), ActualFrame.forest_valid(P.project(S.frame_root(actual), S.frame_nodes(actual), slots, S.frame_artifacts(actual), addresses), episode), Some{changed}, observed),
        ready_rollback_frame_rows(ActualFrame.forest_valid(P.project(S.frame_root(actual), S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), addresses), episode), ActualFrame.pending(pending_order, S.frame_pending(actual), sources, addresses), ActualFrame.targets(target_order, S.frame_target_paths(actual), addresses), ActualFrame.ids(id_order, S.frame_target_ids(actual)), ActualFrame.captured(capture_order, S.frame_captured(actual), captures), ActualFrame.identities(identity_order, S.frame_target_artifacts(actual)), ActualFrame.visited(visited_order, S.frame_visited(actual)), actual, remaining, episode, view, changed, slots, ready))

def ready_rollback_frame_complete(+actual: T.ResolverFrame, +history: V.History, +view: V.Frame, +changed: F.Forest, +slots: List<&2, Local.ReferenceSlot>, ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, observed: {ActualFrame.forest_valid(P.project(S.frame_root(actual), S.frame_nodes(actual), slots, S.frame_artifacts(actual), ready_history_addresses(history)), ready_history_episode(history)) == Some{changed} : Maybe<&2, F.Forest>}) -> {ActualFrame.project(S.with_frame_references(actual, slots), history) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>}:
  match actual history:
    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _}:
      Parent.eliminate_pair({frame_checks(actual, history) == True{} : Bool},
        {ActualFrame.projected(actual, history) == Some{view} : Maybe<&2, V.Frame>},
        {ActualFrame.project(S.with_frame_references(actual, slots), history) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>},
        actual_frame_contents(actual, history, view, ready), checks => projected =>
          Equal.trans(Maybe<&2, V.Frame>, ActualFrame.project(S.with_frame_references(actual, slots), history), ActualFrame.projected(S.with_frame_references(actual, slots), history), Some{ready_replaced_view(view, changed)},
            Equal.cong(Bool, Maybe<&2, V.Frame>, valid => ActualFrame.validated(valid, S.with_frame_references(actual, slots), history), frame_checks(actual, history), True{}, checks),
            ready_rollback_projected_frame(actual, history, view, changed, slots, projected, observed)))

def ready_graph_view(view: V.Frame, step: G.Step, remaining: Nat) -> V.Frame:
  match view step:
    case V.Frame{branch, limits, _, _, deps, forest, pending, targets, ids, captured, identities, visited, budget, node, edge, target, artifact, catalog, _, episode} G.Step{graph, command}:
      V.Frame{branch, limits, graph, command, deps, forest, pending, targets, ids, captured, identities, visited, budget, node, edge, target, artifact, catalog, remaining, episode}

def ready_graph_frame_rows(+forest: Maybe<&2, F.Forest>, +pending: Maybe<&2, List<&2, V.PendingEntry>>, +targets: Maybe<&2, List<&2, V.TargetEntry>>, +ids: Maybe<&2, List<&2, V.TargetId>>, +captured: Maybe<&2, List<&2, V.CapturedEntry>>, +identities: Maybe<&2, List<&2, V.TargetArtifact>>, +visited: Maybe<&2, List<&2, String>>, +actual: T.ResolverFrame, +remaining: Nat, +episode: Nat, +view: V.Frame, +step: G.Step, +after: Nat, ready: {ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, actual, remaining, episode) == Some{view} : Maybe<&2, V.Frame>}) -> {ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, PreparedRoot.frame_transition(actual, step), after, episode) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}:
  match forest pending targets ids captured identities visited actual step:
    case Some{+old} Some{+pending_value} Some{+targets_value} Some{+ids_value} Some{+captured_value} Some{+identities_value} Some{+visited_value}
      T.ResolverFrame{branch, limits, graph, command, deps, _, _, _, _, budget, node, edge, target, artifact, _, _, _, _, _, artifacts} G.Step{_, _}:
      %Count.some_equal(V.Frame, V.Frame{branch, limits, graph, command, deps, old, pending_value, targets_value, ids_value, captured_value, identities_value, visited_value, V.actual_budget(budget), node, edge, target, artifact, artifacts, remaining, episode}, view, ready):
        {ActualFrame.frame_view(Some{old}, Some{pending_value}, Some{targets_value}, Some{ids_value}, Some{captured_value}, Some{identities_value}, Some{visited_value}, PreparedRoot.frame_transition(actual, step), after, episode) == Some{ready_graph_view(_, step, after)} : Maybe<&2, V.Frame>}
      {==}
    case None{} _ _ _ _ _ _ _ _:
      Empty.absurd({ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, PreparedRoot.frame_transition(actual, step), after, episode) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))
    case Some{_} None{} _ _ _ _ _ _ _:
      Empty.absurd({ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, PreparedRoot.frame_transition(actual, step), after, episode) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} None{} _ _ _ _ _ _:
      Empty.absurd({ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, PreparedRoot.frame_transition(actual, step), after, episode) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} None{} _ _ _ _ _:
      Empty.absurd({ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, PreparedRoot.frame_transition(actual, step), after, episode) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} Some{_} None{} _ _ _ _:
      Empty.absurd({ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, PreparedRoot.frame_transition(actual, step), after, episode) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} Some{_} Some{_} None{} _ _ _:
      Empty.absurd({ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, PreparedRoot.frame_transition(actual, step), after, episode) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} Some{_} Some{_} Some{_} None{} _ _:
      Empty.absurd({ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, PreparedRoot.frame_transition(actual, step), after, episode) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))


def ready_graph_projected_frame(+actual: T.ResolverFrame, +history: V.History, +view: V.Frame, +step: G.Step, +after: Nat, ready: {ActualFrame.projected(actual, history) == Some{view} : Maybe<&2, V.Frame>}) -> {ActualFrame.projected(PreparedRoot.frame_transition(actual, step), History.allowance(history, after)) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}:
  match actual history step:
    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
      V.History{+addresses, V.Order{+pending_order, +target_order, +id_order, +capture_order, +identity_order, +visited_order}, +sources, +captures, _, +remaining, +episode} G.Step{_, _}:
      ready_graph_frame_rows(ActualFrame.forest_valid(P.project(S.frame_root(actual), S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), addresses), episode), ActualFrame.pending(pending_order, S.frame_pending(actual), sources, addresses), ActualFrame.targets(target_order, S.frame_target_paths(actual), addresses), ActualFrame.ids(id_order, S.frame_target_ids(actual)), ActualFrame.captured(capture_order, S.frame_captured(actual), captures), ActualFrame.identities(identity_order, S.frame_target_artifacts(actual)), ActualFrame.visited(visited_order, S.frame_visited(actual)), actual, remaining, episode, view, step, after, ready)

def ready_graph_frame_complete(+actual: T.ResolverFrame, +history: V.History, +view: V.Frame, +step: G.Step, +after: Nat, ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}) -> {ActualFrame.project(PreparedRoot.frame_transition(actual, step), History.allowance(history, after)) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}:
  match actual history step:
    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, _}, _, _, _, _, _} G.Step{_, _}:
      Parent.eliminate_pair({frame_checks(actual, history) == True{} : Bool},
        {ActualFrame.projected(actual, history) == Some{view} : Maybe<&2, V.Frame>},
        {ActualFrame.project(PreparedRoot.frame_transition(actual, step), History.allowance(history, after)) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>},
        actual_frame_contents(actual, history, view, ready), checks => projected =>
          Equal.trans(Maybe<&2, V.Frame>, ActualFrame.project(PreparedRoot.frame_transition(actual, step), History.allowance(history, after)), ActualFrame.projected(PreparedRoot.frame_transition(actual, step), History.allowance(history, after)), Some{ready_graph_view(view, step, after)},
            Equal.cong(Bool, Maybe<&2, V.Frame>, valid => ActualFrame.validated(valid, PreparedRoot.frame_transition(actual, step), History.allowance(history, after)), frame_checks(actual, history), True{}, checks),
            ready_graph_projected_frame(actual, history, view, step, after, projected)))

def ready_rollback_full_result(+actual: T.ResolverFrame, +history: V.History, +view: V.Frame, +forest: F.Forest, +owner: Nat, +index: Nat, +name: String, +symbol: String, +address: O.NodeAddress) -> Type:
  Exists(List<&2, Local.ReferenceSlot>, slots => Exists(F.Forest, changed =>
    {Compose.replacement(Compose.replace_slot(S.frame_references(actual), owner, index, Local.Omitted{Local.ReferenceLimit{}, name})) == Some{slots} : Maybe<&2, List<&2, Local.ReferenceSlot>>} &
    {ActualFrame.project(S.with_frame_references(actual, slots), history) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>} &
    {F.replace(forest, address, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}) == F.Replaced{changed} : F.Replacement}))

def ready_rollback_full_witness(+actual: T.ResolverFrame, +history: V.History, +view: V.Frame, +birth: O.NodeAddress, +retained: List<&2, F.Node>, +owner: Nat, +index: Nat, +name: String, +symbol: String, +address: O.NodeAddress, +ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, +before: {Relation.frame_forest(F.Forest{Some{birth}, retained}, ready_history_episode(history)) == True{} : Bool}, evidence: ready_rollback_result(S.frame_root(actual), S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), ready_history_addresses(history), birth, retained, owner, index, symbol, name, address)) -> ready_rollback_full_result(actual, history, view, F.Forest{Some{birth}, retained}, owner, index, name, symbol, address):
  match evidence:
    case (+slots, (+values, (replaced, (projected, semantic)))):
      +semantic: {F.replace(F.Forest{Some{birth}, retained}, address, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}) == F.Replaced{F.Forest{Some{birth}, values}} : F.Replacement} = semantic
      Tuple{slots, Tuple{F.Forest{Some{birth}, values}, Tuple{replaced, Tuple{
        ready_rollback_frame_complete(actual, history, view, F.Forest{Some{birth}, values}, slots, ready,
          ready_rollback_observed(S.frame_root(actual), S.frame_nodes(actual), slots, S.frame_artifacts(actual), ready_history_addresses(history), F.Forest{Some{birth}, retained}, F.Forest{Some{birth}, values}, ready_history_episode(history), address, index, symbol, name, projected, before, semantic)), semantic}}}}

def ready_rollback_root_type(value: Maybe<&2, F.Forest>) -> Type:
  match value:
    case Some{F.Forest{None{}, _}}: Empty
    case _: Unit

def ready_rollback_root_missing(+root: Maybe<&2, O.NodeAddress>, +items: Maybe<&2, List<&2, F.Node>>, +retained: List<&2, F.Node>, impossible: {P.forest(root, items) == Some{F.Forest{None{}, retained}} : Maybe<&2, F.Forest>}) -> Empty:
  match root items:
    case Some{birth} Some{values}: %impossible: ready_rollback_root_type(_)
      Unit{}
    case None{} _: Contents.none_some(F.Forest, F.Forest{None{}, retained}, impossible)
    case Some{_} None{}: Contents.none_some(F.Forest, F.Forest{None{}, retained}, impossible)

def ready_rollback_frame_total(+actual: T.ResolverFrame, +history: V.History, +view: V.Frame, +owner: Nat, +index: Nat, +name: String, +symbol: String, +address: O.NodeAddress, +ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, selected: {ActualReady.slot_count(S.frame_references(actual), owner, index, symbol) == 1n : Nat}, present: {F.address_at(ready_history_addresses(history), owner) == Some{address} : Maybe<&2, O.NodeAddress>}) -> ready_rollback_full_result(actual, history, view, ready_staged_forest(view), owner, index, name, symbol, address):
  match history view:
    case V.History{+addresses, +order, _, _, _, _, +episode}
      V.Frame{_, _, _, _, _, F.Forest{Some{+birth}, +retained}, _, _, _, _, _, _, _, _, _, _, _, _, _, _}:
      +projected: {ActualFrame.projected(actual, history) == Some{view} : Maybe<&2, V.Frame>} = Pair.snd({frame_checks(actual, history) == True{} : Bool}, {ActualFrame.projected(actual, history) == Some{view} : Maybe<&2, V.Frame>}, actual_frame_contents(actual, history, view, ready))
      checks = Pair.fst({frame_checks(actual, history) == True{} : Bool}, {ActualFrame.projected(actual, history) == Some{view} : Maybe<&2, V.Frame>}, actual_frame_contents(actual, history, view, ready))
      +original: {P.project(S.frame_root(actual), S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), addresses) == Some{F.Forest{Some{birth}, retained}} : Maybe<&2, F.Forest>} = Pair.fst({P.project(S.frame_root(actual), S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), addresses) == Some{F.Forest{Some{birth}, retained}} : Maybe<&2, F.Forest>}, {Relation.frame_forest(F.Forest{Some{birth}, retained}, episode) == True{} : Bool}, projected_frame_semantics(actual, history, view, projected))
      ready_rollback_full_witness(actual, history, view, birth, retained, owner, index, name, symbol, address, ready,
        Pair.snd({P.project(S.frame_root(actual), S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), addresses) == Some{F.Forest{Some{birth}, retained}} : Maybe<&2, F.Forest>}, {Relation.frame_forest(F.Forest{Some{birth}, retained}, episode) == True{} : Bool}, projected_frame_semantics(actual, history, view, projected)),
        ready_rollback_exact(S.frame_root(actual), S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), addresses, birth, retained, owner, index, symbol, name, address, original,
          BoolFacts.eq_true_of_and_left(ActualFrame.dense(S.frame_nodes(actual), 0n), Bool.and(Nat.is_eq(S.frame_next_node(actual), List.length(&2, Local.PlannedNode, S.frame_nodes(actual))), ActualFrame.catalog_valid(S.frame_artifacts(actual))), BoolFacts.eq_true_of_and_right(ActualFrame.coverage(order, actual), Bool.and(ActualFrame.dense(S.frame_nodes(actual), 0n), Bool.and(Nat.is_eq(S.frame_next_node(actual), List.length(&2, Local.PlannedNode, S.frame_nodes(actual))), ActualFrame.catalog_valid(S.frame_artifacts(actual)))), checks)), selected, present))
    case V.History{+addresses, _, _, _, _, _, +episode}
      V.Frame{_, _, _, _, _, F.Forest{None{}, +retained}, _, _, _, _, _, _, _, _, _, _, _, _, _, _}:
      projected = Pair.snd({frame_checks(actual, history) == True{} : Bool}, {ActualFrame.projected(actual, history) == Some{view} : Maybe<&2, V.Frame>}, actual_frame_contents(actual, history, view, ready))
      original = Pair.fst({P.project(S.frame_root(actual), S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), addresses) == Some{F.Forest{None{}, retained}} : Maybe<&2, F.Forest>}, {Relation.frame_forest(F.Forest{None{}, retained}, episode) == True{} : Bool}, projected_frame_semantics(actual, history, view, projected))
      Empty.absurd(ready_rollback_full_result(actual, history, view, ready_staged_forest(view), owner, index, name, symbol, address),
        ready_rollback_root_missing(F.address_at(addresses, S.frame_root(actual)), P.nodes(S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), addresses), retained,
          Pair.snd({Bool.and(P.aligned(S.frame_nodes(actual), addresses, S.frame_nodes(actual), addresses), Bool.and(P.catalog_unique(S.frame_artifacts(actual), S.frame_artifacts(actual)), Bool.and(P.slots_owned(S.frame_references(actual), S.frame_nodes(actual)), P.forward_nodes(S.frame_nodes(actual), S.frame_references(actual))))) == True{} : Bool},
            {P.forest(F.address_at(addresses, S.frame_root(actual)), P.nodes(S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), addresses)) == Some{F.Forest{None{}, retained}} : Maybe<&2, F.Forest>},
            Contents.project_contents(S.frame_root(actual), S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), addresses, F.Forest{None{}, retained}, original))))

def ready_rollback_after_graph(+actual: T.ResolverFrame, +history: V.History, +view: V.Frame, +step: G.Step, +after: Nat, +owner: Nat, +index: Nat, +name: String, +symbol: String, +address: O.NodeAddress, ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, selected: {ActualReady.slot_count(S.frame_references(actual), owner, index, symbol) == 1n : Nat}, present: {F.address_at(ready_history_addresses(history), owner) == Some{address} : Maybe<&2, O.NodeAddress>}) -> ready_rollback_full_result(PreparedRoot.frame_transition(actual, step), History.allowance(history, after), ready_graph_view(view, step, after), ready_staged_forest(ready_graph_view(view, step, after)), owner, index, name, symbol, address):
  match actual history step:
    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
      V.History{_, _, _, _, _, _, _} G.Step{_, _}:
      ready_rollback_frame_total(PreparedRoot.frame_transition(actual, step), History.allowance(history, after), ready_graph_view(view, step, after), owner, index, name, symbol, address,
        ready_graph_frame_complete(actual, history, view, step, after, ready), selected, present)

def ready_reference_replaced(+state: D.State, forest: F.Forest) -> D.State:
  match state:
    case D.State{config, X.Frame{graph, command, _, local, pending, captured, identities, edge, episode, artifact, dependencies, fingerprint}, targets, ids, next, request, stage, frame_history, python}:
      D.State{config, X.Frame{graph, command, forest, local, pending, captured, identities, edge, episode, artifact, dependencies, fingerprint}, targets, ids, next, request, stage, frame_history, python}

def ready_reference_rollback_rows(+state: D.State, +history: V.History, +targets_value: Maybe<&2, List<&2, V.TargetEntry>>, +captured_value: Maybe<&2, List<&2, V.CapturedEntry>>, +visited_value: Maybe<&2, List<&2, String>>, +view: V.Frame, +changed: F.Forest, ready: {ReferenceFrame.assembled(state, history, targets_value, captured_value, visited_value) == Some{view} : Maybe<&2, V.Frame>}, counted: {ReferenceFrame.node_count(changed) == ReferenceFrame.node_count(ready_reference_forest(D.frame(state))) : Nat}) -> {ReferenceFrame.assembled(ready_reference_replaced(state, changed), history, targets_value, captured_value, visited_value) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>}:
  match state history targets_value captured_value visited_value:
    case D.State{D.Config{_, _, _, +context, _, _}, X.Frame{G.Bounded{+graph, +remaining}, +command, +forest, Signed.State{Recursive.State{_, +budget, _, _}, +signed}, +edges, _, +artifacts_by_target, +next_edge, +episode, +next_artifact, +dependencies, _}, _, +target_ids, +next_target, _, _, _, _} V.History{_, _, _, _, +artifacts, _, _}
      Some{+targets} Some{+captures} Some{+seen}:
      %Count.some_equal(V.Frame, V.Frame{ReferenceFrame.branch(context), ReferenceFrame.graph_limits(graph), graph, command, dependencies, forest, ReferenceFrame.pending(edges), targets, ReferenceFrame.ids(target_ids), captures, ReferenceFrame.identities(artifacts_by_target), seen, V.budget(budget, signed), ReferenceFrame.node_count(forest), next_edge, next_target, next_artifact, artifacts, remaining, episode}, view, ready):
        {ReferenceFrame.assembled(ready_reference_replaced(state, changed), history, targets_value, captured_value, visited_value) == Some{ready_replaced_view(_, changed)} : Maybe<&2, V.Frame>}
      Equal.cong(Nat, Maybe<&2, V.Frame>, count => Some{V.Frame{ReferenceFrame.branch(context), ReferenceFrame.graph_limits(graph), graph, command, dependencies, changed, ReferenceFrame.pending(edges), targets, ReferenceFrame.ids(target_ids), captures, ReferenceFrame.identities(artifacts_by_target), seen, V.budget(budget, signed), count, next_edge, next_target, next_artifact, artifacts, remaining, episode}}, ReferenceFrame.node_count(changed), ReferenceFrame.node_count(forest), counted)
    case _ _ None{} _ _:
      Empty.absurd({ReferenceFrame.assembled(ready_reference_replaced(state, changed), history, targets_value, captured_value, visited_value) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))
    case _ _ Some{_} None{} _:
      Empty.absurd({ReferenceFrame.assembled(ready_reference_replaced(state, changed), history, targets_value, captured_value, visited_value) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))
    case _ _ Some{_} Some{_} None{}:
      Empty.absurd({ReferenceFrame.assembled(ready_reference_replaced(state, changed), history, targets_value, captured_value, visited_value) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))

def ready_reference_rollback_project(+state: D.State, +history: V.History, +view: V.Frame, +changed: F.Forest, ready: {ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>}, counted: {ReferenceFrame.node_count(changed) == ReferenceFrame.node_count(ready_reference_forest(D.frame(state))) : Nat}) -> {ReferenceFrame.project(ready_reference_replaced(state, changed), history) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>}:
  match state history:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{+values, _, _, _}, _}, _, +captures, _, _, _, _, _, _}, +target_values, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, +seen}, _, +sources, _, _, _}:
      ready_reference_rollback_rows(state, history, ReferenceFrame.targets(target_values), ReferenceFrame.captured(captures, sources), ReferenceFrame.visited(seen, values), view, changed, ready, counted)

# The reference node count is derived from the same actual nodes on both sides
# of replacement; it is not an extra frame-correspondence premise.
def ready_rollback_node_count(+root: Nat, +nodes: List<&2, Local.PlannedNode>, +before: List<&2, Local.ReferenceSlot>, +after: List<&2, Local.ReferenceSlot>, +catalog: List<&2, T.ArtifactEntry>, +addresses: List<&2, F.AddressEntry>, +forest: F.Forest, +changed: F.Forest, original: {P.project(root, nodes, before, catalog, addresses) == Some{forest} : Maybe<&2, F.Forest>}, updated: {P.project(root, nodes, after, catalog, addresses) == Some{changed} : Maybe<&2, F.Forest>}) -> {ReferenceFrame.node_count(changed) == ReferenceFrame.node_count(forest) : Nat}:
  Equal.trans(Nat, ReferenceFrame.node_count(changed), List.length(&2, Local.PlannedNode, nodes), ReferenceFrame.node_count(forest),
    Equal.sym(Nat, List.length(&2, Local.PlannedNode, nodes), ReferenceFrame.node_count(changed), ready_projected_node_count(root, nodes, after, catalog, addresses, changed, updated)),
    ready_projected_node_count(root, nodes, before, catalog, addresses, forest, original))

def ready_reference_forest_rows(+state: D.State, +history: V.History, +targets_value: Maybe<&2, List<&2, V.TargetEntry>>, +captured_value: Maybe<&2, List<&2, V.CapturedEntry>>, +visited_value: Maybe<&2, List<&2, String>>, +view: V.Frame, ready: {ReferenceFrame.assembled(state, history, targets_value, captured_value, visited_value) == Some{view} : Maybe<&2, V.Frame>}) -> {ready_reference_forest(D.frame(state)) == ready_staged_forest(view) : F.Forest}:
  match state history targets_value captured_value visited_value:
    case D.State{D.Config{_, _, _, +context, _, _}, X.Frame{G.Bounded{+graph, +remaining}, +command, +forest, Signed.State{Recursive.State{_, +budget, _, _}, +signed}, +edges, _, +artifacts_by_target, +next_edge, +episode, +next_artifact, +dependencies, _}, _, +target_ids, +next_target, _, _, _, _} V.History{_, _, _, _, +artifacts, _, _}
      Some{+targets} Some{+captures} Some{+seen}:
      Equal.cong(V.Frame, F.Forest, value => ready_staged_forest(value), V.Frame{ReferenceFrame.branch(context), ReferenceFrame.graph_limits(graph), graph, command, dependencies, forest, ReferenceFrame.pending(edges), targets, ReferenceFrame.ids(target_ids), captures, ReferenceFrame.identities(artifacts_by_target), seen, V.budget(budget, signed), ReferenceFrame.node_count(forest), next_edge, next_target, next_artifact, artifacts, remaining, episode}, view, Count.some_equal(V.Frame, V.Frame{ReferenceFrame.branch(context), ReferenceFrame.graph_limits(graph), graph, command, dependencies, forest, ReferenceFrame.pending(edges), targets, ReferenceFrame.ids(target_ids), captures, ReferenceFrame.identities(artifacts_by_target), seen, V.budget(budget, signed), ReferenceFrame.node_count(forest), next_edge, next_target, next_artifact, artifacts, remaining, episode}, view, ready))
    case _ _ None{} _ _:
      Empty.absurd({ready_reference_forest(D.frame(state)) == ready_staged_forest(view) : F.Forest}, Contents.none_some(V.Frame, view, ready))
    case _ _ Some{_} None{} _:
      Empty.absurd({ready_reference_forest(D.frame(state)) == ready_staged_forest(view) : F.Forest}, Contents.none_some(V.Frame, view, ready))
    case _ _ Some{_} Some{_} None{}:
      Empty.absurd({ready_reference_forest(D.frame(state)) == ready_staged_forest(view) : F.Forest}, Contents.none_some(V.Frame, view, ready))

def ready_reference_forest_project(+state: D.State, +history: V.History, +view: V.Frame, ready: {ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>}) -> {ready_reference_forest(D.frame(state)) == ready_staged_forest(view) : F.Forest}:
  match state history:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{+values, _, _, _}, _}, _, +captures, _, _, _, _, _, _}, +target_values, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, +seen}, _, +sources, _, _, _}:
      ready_reference_forest_rows(state, history, ReferenceFrame.targets(target_values), ReferenceFrame.captured(captures, sources), ReferenceFrame.visited(seen, values), view, ready)

def ready_full_projection_forest(+actual: T.ResolverFrame, +history: V.History, +view: V.Frame, ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}) -> {P.project(S.frame_root(actual), S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), ready_history_addresses(history)) == Some{ready_staged_forest(view)} : Maybe<&2, F.Forest>}:
  match history view:
    case V.History{+addresses, _, _, _, _, _, +episode} V.Frame{_, _, _, _, _, +forest, _, _, _, _, _, _, _, _, _, _, _, _, _, _}:
      Pair.fst({P.project(S.frame_root(actual), S.frame_nodes(actual), S.frame_references(actual), S.frame_artifacts(actual), addresses) == Some{forest} : Maybe<&2, F.Forest>},
        {Relation.frame_forest(forest, episode) == True{} : Bool},
        projected_frame_semantics(actual, history, view,
          Pair.snd({frame_checks(actual, history) == True{} : Bool}, {ActualFrame.projected(actual, history) == Some{view} : Maybe<&2, V.Frame>}, actual_frame_contents(actual, history, view, ready))))

def ready_rollback_both_result(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, +owner: Nat, +index: Nat, +name: String, +symbol: String, +address: O.NodeAddress) -> Type:
  Exists(List<&2, Local.ReferenceSlot>, slots => Exists(F.Forest, changed =>
    {Compose.replacement(Compose.replace_slot(S.frame_references(actual), owner, index, Local.Omitted{Local.ReferenceLimit{}, name})) == Some{slots} : Maybe<&2, List<&2, Local.ReferenceSlot>>} &
    {ActualFrame.project(S.with_frame_references(actual, slots), history) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>} &
    {ReferenceFrame.project(ready_reference_replaced(reference, changed), history) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>} &
    {F.replace(ready_staged_forest(view), address, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}) == F.Replaced{changed} : F.Replacement}))

def ready_rollback_both_witness(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, +owner: Nat, +index: Nat, +name: String, +symbol: String, +address: O.NodeAddress, +actual_ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, +reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, evidence: ready_rollback_full_result(actual, history, view, ready_staged_forest(view), owner, index, name, symbol, address)) -> ready_rollback_both_result(actual, reference, history, view, owner, index, name, symbol, address):
  match actual view evidence:
    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
      V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}
      (+slots, (+changed, (replaced, (projected, semantic)))):
      +projected: {ActualFrame.project(S.with_frame_references(actual, slots), history) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>} = projected
      Tuple{slots, Tuple{changed, Tuple{replaced, Tuple{projected, Tuple{
        ready_reference_rollback_project(reference, history, view, changed, reference_ready,
          Equal.trans(Nat, ReferenceFrame.node_count(changed), ReferenceFrame.node_count(ready_staged_forest(view)), ReferenceFrame.node_count(ready_reference_forest(D.frame(reference))),
            ready_rollback_node_count(S.frame_root(actual), S.frame_nodes(actual), S.frame_references(actual), slots, S.frame_artifacts(actual), ready_history_addresses(history), ready_staged_forest(view), changed,
              ready_full_projection_forest(actual, history, view, actual_ready),
              ready_full_projection_forest(S.with_frame_references(actual, slots), history, ready_replaced_view(view, changed), projected)),
            Equal.cong(F.Forest, Nat, forest => ReferenceFrame.node_count(forest), ready_staged_forest(view), ready_reference_forest(D.frame(reference)),
              Equal.sym(F.Forest, ready_reference_forest(D.frame(reference)), ready_staged_forest(view), ready_reference_forest_project(reference, history, view, reference_ready))))), semantic}}}}}

def ready_rollback_both_total(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, +owner: Nat, +index: Nat, +name: String, +symbol: String, +address: O.NodeAddress, +actual_ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, selected: {ActualReady.slot_count(S.frame_references(actual), owner, index, symbol) == 1n : Nat}, present: {F.address_at(ready_history_addresses(history), owner) == Some{address} : Maybe<&2, O.NodeAddress>}) -> ready_rollback_both_result(actual, reference, history, view, owner, index, name, symbol, address):
  ready_rollback_both_witness(actual, reference, history, view, owner, index, name, symbol, address, actual_ready, reference_ready,
    ready_rollback_frame_total(actual, history, view, owner, index, name, symbol, address, actual_ready, selected, present))

def ready_reference_rollback_applied(+state: D.State, +history: V.History, +view: V.Frame, +owner: O.NodeAddress, +index: Nat, +symbol: String, +name: String, +changed: F.Forest, ready: {ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>}, semantic: {F.replace(ready_staged_forest(view), owner, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}) == F.Replaced{changed} : F.Replacement}) -> {X.rolled_back(D.frame(state), F.replace(ready_reference_forest(D.frame(state)), owner, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}})) == X.TransactionFinished{D.frame(ready_reference_replaced(state, changed))} : X.Transaction}:
  match state:
    case D.State{_, X.Frame{_, _, _, _, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}:
      Equal.cong(F.Replacement, X.Transaction, replacement => X.rolled_back(D.frame(state), replacement),
        F.replace(ready_reference_forest(D.frame(state)), owner, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}), F.Replaced{changed},
        Equal.trans(F.Replacement, F.replace(ready_reference_forest(D.frame(state)), owner, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}), F.replace(ready_staged_forest(view), owner, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}), F.Replaced{changed},
          Equal.cong(F.Forest, F.Replacement, forest => F.replace(forest, owner, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}}), ready_reference_forest(D.frame(state)), ready_staged_forest(view), ready_reference_forest_project(state, history, view, ready)), semantic))

def ready_rollback_transaction_result(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, +owner: Nat, +index: Nat, +name: String, +symbol: String, +address: O.NodeAddress) -> Type:
  Exists(List<&2, Local.ReferenceSlot>, slots => Exists(F.Forest, changed =>
    {Compose.replacement(Compose.replace_slot(S.frame_references(actual), owner, index, Local.Omitted{Local.ReferenceLimit{}, name})) == Some{slots} : Maybe<&2, List<&2, Local.ReferenceSlot>>} &
    {ActualFrame.project(S.with_frame_references(actual, slots), history) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>} &
    {ReferenceFrame.project(ready_reference_replaced(reference, changed), history) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>} &
    {X.rolled_back(D.frame(reference), F.replace(ready_reference_forest(D.frame(reference)), address, index, F.Omitted{F.ReferenceSymbol{symbol}, F.ReferenceSymbol{name}, Local.ReferenceLimit{}})) == X.TransactionFinished{D.frame(ready_reference_replaced(reference, changed))} : X.Transaction}))

def ready_rollback_transaction_witness(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, +owner: Nat, +index: Nat, +name: String, +symbol: String, +address: O.NodeAddress, reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, evidence: ready_rollback_both_result(actual, reference, history, view, owner, index, name, symbol, address)) -> ready_rollback_transaction_result(actual, reference, history, view, owner, index, name, symbol, address):
  match evidence:
    case (+slots, (+changed, (replaced, (actual_projected, (reference_projected, semantic))))):
      Tuple{slots, Tuple{changed, Tuple{replaced, Tuple{actual_projected, Tuple{reference_projected,
        ready_reference_rollback_applied(reference, history, view, address, index, symbol, name, changed, reference_ready, semantic)}}}}}

def ready_rollback_transaction_total(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, +owner: Nat, +index: Nat, +name: String, +symbol: String, +address: O.NodeAddress, actual_ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, +reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, selected: {ActualReady.slot_count(S.frame_references(actual), owner, index, symbol) == 1n : Nat}, present: {F.address_at(ready_history_addresses(history), owner) == Some{address} : Maybe<&2, O.NodeAddress>}) -> ready_rollback_transaction_result(actual, reference, history, view, owner, index, name, symbol, address):
  ready_rollback_transaction_witness(actual, reference, history, view, owner, index, name, symbol, address, reference_ready,
    ready_rollback_both_total(actual, reference, history, view, owner, index, name, symbol, address, actual_ready, reference_ready, selected, present))

def ready_actual_rollback_applied(+state: T.ResolverState, +frame: T.ResolverFrame, +owner: Nat, +index: Nat, +name: String, +slots: List<&2, Local.ReferenceSlot>, replaced: {Compose.replacement(Compose.replace_slot(S.frame_references(frame), owner, index, Local.Omitted{Local.ReferenceLimit{}, name})) == Some{slots} : Maybe<&2, List<&2, Local.ReferenceSlot>>}) -> {Admission.rejected_slots(Compose.replacement(Compose.replace_slot(S.frame_references(frame), owner, index, Local.Omitted{Local.ReferenceLimit{}, name})), frame, state) == Resolve.progressed(False{}, state, S.with_frame_references(frame, slots)) : Loop.Continuation}:
  Equal.cong(Maybe<&2, List<&2, Local.ReferenceSlot>>, Loop.Continuation, result => Admission.rejected_slots(result, frame, state),
    Compose.replacement(Compose.replace_slot(S.frame_references(frame), owner, index, Local.Omitted{Local.ReferenceLimit{}, name})), Some{slots}, replaced)

# The reply history uses the same captured transition as the actual frame,
# including the full after_graph publication/rollback selector.
def ready_captured_history_result(+child: Phase.Child, +history: V.History, +graph: G.Graph, +remaining: Nat, +next_edge: Nat, +previous: Nat, +bytes: Nat) -> Type:
  match child:
    case Phase.Child{_, _, _, _, source_bytes, _, _, _, before, _, _, pending, _, V.Budget{_, _, _, work, _, _}, _, _}:
      {History.encoded_child(child, history, graph, remaining, next_edge, previous, bytes) ==
        History.after_graph(GraphReference.bounded_result(G.step(graph, G.Captured{source_bytes, Nat.sub(bytes, previous), Nat.sub(work, before), History.ids(pending, next_edge)}), Nat.sub(remaining, 1n)), child, history) : V.History}

def ready_captured_history(+child: Phase.Child, +history: V.History, +graph: G.Graph, +remaining: Nat, +next_edge: Nat, +previous: Nat, +bytes: Nat, positive: {Nat.is_gt(remaining, 0n) == True{} : Bool}) -> ready_captured_history_result(child, history, graph, remaining, next_edge, previous, bytes):
  match child:
    case Phase.Child{_, _, _, _, +source_bytes, _, _, _, +before, _, _, +pending, _, V.Budget{_, _, _, +work, _, _}, _, _}:
      Equal.cong(G.BoundedStep, V.History, step => History.after_graph(step, child, history),
        GraphReference.bounded_transition(G.Bounded{graph, remaining}, G.Captured{source_bytes, Nat.sub(bytes, previous), Nat.sub(work, before), History.ids(pending, next_edge)}),
        GraphReference.bounded_result(G.step(graph, G.Captured{source_bytes, Nat.sub(bytes, previous), Nat.sub(work, before), History.ids(pending, next_edge)}), Nat.sub(remaining, 1n)),
        ready_captured_allowance(graph, source_bytes, Nat.sub(bytes, previous), Nat.sub(work, before), History.ids(pending, next_edge), remaining, positive))

def ready_history_positive(history: V.History) -> Type:
  match history:
    case V.History{_, _, _, _, _, remaining, _}: {Nat.is_gt(remaining, 0n) == True{} : Bool}

def ready_product_history_result(+phase: Phase.Phase, +history: V.History, +previous: Nat, +request: T.Request, +invocation: Nat, +id: Nat, +bytes: Nat) -> Type:
  match phase:
    case Phase.Phase{V.Frame{_, _, graph, _, _, _, _, _, _, _, _, _, _, _, next_edge, _, _, _, _, _},
      +child, _}:
      match child history:
        case Phase.Child{_, _, _, _, source_bytes, _, _, _, before, _, _, pending, _, V.Budget{_, _, _, work, _, _}, _, _} V.History{_, _, _, _, _, remaining, _}:
          {History.reply(phase, history, previous, request, T.Reply{invocation, id, T.ProductEncoded{bytes}}) == History.after_graph(GraphReference.bounded_result(G.step(graph, G.Captured{source_bytes, Nat.sub(bytes, previous), Nat.sub(work, before), History.ids(pending, next_edge)}), Nat.sub(remaining, 1n)), child, history) : V.History}

def ready_product_history(+phase: Phase.Phase, +history: V.History, +previous: Nat, +request: T.Request, +invocation: Nat, +id: Nat, +bytes: Nat, positive: ready_history_positive(history), checked: {Boundary.check(request, T.Reply{invocation, id, T.ProductEncoded{bytes}}) == None{} : Maybe<&2, T.TechnicalFailure>}) -> ready_product_history_result(phase, history, previous, request, invocation, id, bytes):
  match phase:
    case Phase.Phase{V.Frame{_, _, +graph, _, _, _, _, _, _, _, _, _, _, _, +next_edge, _, _, _, _, _}, +child, _}:
      match child history:
        case Phase.Child{_, _, _, _, +source_bytes, _, _, _, +before, _, _, +pending, _, V.Budget{_, _, _, +work, _, _}, _, _} V.History{_, _, _, _, _, +remaining, _}:
          Equal.trans(V.History, History.reply(phase, history, previous, request, T.Reply{invocation, id, T.ProductEncoded{bytes}}), History.encoded(phase, history, previous, bytes),
            History.after_graph(GraphReference.bounded_result(G.step(graph, G.Captured{source_bytes, Nat.sub(bytes, previous), Nat.sub(work, before), History.ids(pending, next_edge)}), Nat.sub(remaining, 1n)), child, history),
            Equal.cong(Maybe<&2, T.TechnicalFailure>, V.History, validation => History.accepted(validation, phase, history, previous, T.Reply{invocation, id, T.ProductEncoded{bytes}}), Boundary.check(request, T.Reply{invocation, id, T.ProductEncoded{bytes}}), None{}, checked),
            ready_captured_history(child, history, graph, remaining, next_edge, previous, bytes, positive))

def ready_selected_allowance(+state: T.ResolverState, +frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, evidence: selected_phase_result(state, frame, child, edge, history, child_history, phase)) -> ready_history_positive(history):
  match history:
    case V.History{+addresses, _, _, _, _, +remaining, +episode}:
      BoolFacts.eq_true_of_and_left(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame)),
        BoolFacts.eq_true_of_and_right(ActualReady.fresh_registration(history, frame), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame))),
          BoolFacts.eq_true_of_and_right(ActualReady.mutable_maps_canonical(frame), Bool.and(ActualReady.fresh_registration(history, frame), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame)))),
            Pair.fst({Bool.and(ActualReady.mutable_maps_canonical(frame), Bool.and(ActualReady.fresh_registration(history, frame), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame))))) == True{} : Bool},
              assembled_result(ActualFrame.project(frame, history), ActualReady.child_project(child, edge, child_history, S.frame_artifacts(frame), episode), ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state), phase), evidence))))

def ready_original_allowance(+state: T.ResolverState, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> ready_history_positive(history):
  ready_actual_inputs(ready_history_positive(history), state, history, child_history, phase, ready,
    frame => child => edge => frame_present => child_present => edge_present => evidence =>
      ready_selected_allowance(state, frame, child, edge, history, child_history, phase, evidence))

def ready_original_product_history(+state: T.ResolverState, +phase: Phase.Phase, +history: V.History, +child_history: Phase.ChildHistory, +previous: Nat, +request: T.Request, +invocation: Nat, +id: Nat, +bytes: Nat, +ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, checked: {Boundary.check(request, T.Reply{invocation, id, T.ProductEncoded{bytes}}) == None{} : Maybe<&2, T.TechnicalFailure>}) -> ready_product_history_result(phase, history, previous, request, invocation, id, bytes):
  ready_product_history(phase, history, previous, request, invocation, id, bytes,
    ready_original_allowance(state, history, child_history, phase, ready), checked)

# Captured changes graph accounting/phase, never the configured limits used
# by the independent frame projection.  Derive this for the actual step.
def ready_capture_admission_limits(+result: Maybe<&2, G.Reason>, +state: G.Graph, +edge: G.Edge, +target: Nat, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>, +overflow: Bool) -> {ReferenceFrame.graph_limits(G.step_graph(GraphReference.admission(result, state, unused => GraphReference.accept_capture(overflow, state, edge, target, source, contribution, work, ids)))) == ReferenceFrame.graph_limits(state) : G.Limits}:
  match result state edge:
    case Some{_} G.Graph{_, _, _, _, _, _, _, _, _, _, _} _: {==}
    case None{} G.Graph{_, _, _, _, _, _, _, _, _, _, _} G.Edge{_, _}: {==}

def ready_reference_capture_limits(+state: G.Graph, +edge: G.Edge, +target: Nat, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>) -> {ReferenceFrame.graph_limits(G.step_graph(GraphReference.captured(state, edge, target, source, contribution, work, ids))) == ReferenceFrame.graph_limits(state) : G.Limits}:
  match state:
    case G.Graph{_, _, _, _, +read, +tree, +old_work, _, _, _, +limits}:
      match limits:
        case G.Limits{_, _, +tree_cap, _, _, _, _, _}:
          ready_capture_admission_limits(GraphReference.capture_budget(limits, source, work, List.length(&2, Nat, ids), read, old_work), state, edge, target, source, contribution, work, ids, Nat.is_gt((tree + contribution : Nat), tree_cap))

def ready_reference_captured_limits(+state: G.Graph, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>) -> {ReferenceFrame.graph_limits(G.step_graph(GraphReference.transition(state, G.Captured{source, contribution, work, ids}))) == ReferenceFrame.graph_limits(state) : G.Limits}:
  match state:
    case G.Graph{+phase, _, _, _, _, _, _, _, _, _, _}:
      match phase:
        case G.Capturing{+edge, +target}: ready_reference_capture_limits(state, edge, target, source, contribution, work, ids)
        case G.Idle{}: {==}
        case G.GraphReady{}: {==}
        case G.Resolving{_}: {==}
        case G.Checking{_, _}: {==}
        case G.Complete{}: {==}
        case G.Incomplete{_}: {==}

def ready_captured_limits(+state: G.Graph, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>) -> {ReferenceFrame.graph_limits(G.step_graph(G.step(state, G.Captured{source, contribution, work, ids}))) == ReferenceFrame.graph_limits(state) : G.Limits}:
  Equal.trans(G.Limits, ReferenceFrame.graph_limits(G.step_graph(G.step(state, G.Captured{source, contribution, work, ids}))), ReferenceFrame.graph_limits(G.step_graph(GraphReference.transition(state, G.Captured{source, contribution, work, ids}))), ReferenceFrame.graph_limits(state),
    Equal.cong(G.Step, G.Limits, step => ReferenceFrame.graph_limits(G.step_graph(step)), G.step(state, G.Captured{source, contribution, work, ids}), GraphReference.transition(state, G.Captured{source, contribution, work, ids}), ready_captured_graph(state, source, contribution, work, ids)),
    ready_reference_captured_limits(state, source, contribution, work, ids))

def ready_reference_graph_rows(+state: D.State, +history: V.History, +targets_value: Maybe<&2, List<&2, V.TargetEntry>>, +captured_value: Maybe<&2, List<&2, V.CapturedEntry>>, +visited_value: Maybe<&2, List<&2, String>>, +view: V.Frame, +step: G.Step, +after: Nat, ready: {ReferenceFrame.assembled(state, history, targets_value, captured_value, visited_value) == Some{view} : Maybe<&2, V.Frame>}, limits: {ReferenceFrame.graph_limits(G.step_graph(step)) == ReferenceFrame.graph_limits(ReferenceFrame.graph(D.frame(state))) : G.Limits}) -> {ReferenceFrame.assembled(D.with_frame(state, X.event_result(D.frame(state), GraphReference.bounded_result(step, after))), History.allowance(history, after), targets_value, captured_value, visited_value) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}:
  match state history targets_value captured_value visited_value step:
    case D.State{D.Config{_, _, _, +context, _, _}, X.Frame{G.Bounded{+graph, +remaining}, +command, +forest, Signed.State{Recursive.State{_, +budget, _, _}, +signed}, +edges, _, +artifacts_by_target, +next_edge, +episode, +next_artifact, +dependencies, _}, _, +target_ids, +next_target, _, _, _, _} V.History{_, _, _, _, +artifacts, _, _}
      Some{+targets} Some{+captures} Some{+seen} G.Step{+new_graph, +new_command}:
      %Count.some_equal(V.Frame, V.Frame{ReferenceFrame.branch(context), ReferenceFrame.graph_limits(graph), graph, command, dependencies, forest, ReferenceFrame.pending(edges), targets, ReferenceFrame.ids(target_ids), captures, ReferenceFrame.identities(artifacts_by_target), seen, V.budget(budget, signed), ReferenceFrame.node_count(forest), next_edge, next_target, next_artifact, artifacts, remaining, episode}, view, ready):
        {ReferenceFrame.assembled(D.with_frame(state, X.event_result(D.frame(state), GraphReference.bounded_result(step, after))), History.allowance(history, after), targets_value, captured_value, visited_value) == Some{ready_graph_view(_, step, after)} : Maybe<&2, V.Frame>}
      Equal.cong(G.Limits, Maybe<&2, V.Frame>, selected_limits => Some{V.Frame{ReferenceFrame.branch(context), selected_limits, new_graph, new_command, dependencies, forest, ReferenceFrame.pending(edges), targets, ReferenceFrame.ids(target_ids), captures, ReferenceFrame.identities(artifacts_by_target), seen, V.budget(budget, signed), ReferenceFrame.node_count(forest), next_edge, next_target, next_artifact, artifacts, after, episode}}, ReferenceFrame.graph_limits(new_graph), ReferenceFrame.graph_limits(graph), limits)
    case _ _ None{} _ _ _:
      Empty.absurd({ReferenceFrame.assembled(D.with_frame(state, X.event_result(D.frame(state), GraphReference.bounded_result(step, after))), History.allowance(history, after), targets_value, captured_value, visited_value) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))
    case _ _ Some{_} None{} _ _:
      Empty.absurd({ReferenceFrame.assembled(D.with_frame(state, X.event_result(D.frame(state), GraphReference.bounded_result(step, after))), History.allowance(history, after), targets_value, captured_value, visited_value) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))
    case _ _ Some{_} Some{_} None{} _:
      Empty.absurd({ReferenceFrame.assembled(D.with_frame(state, X.event_result(D.frame(state), GraphReference.bounded_result(step, after))), History.allowance(history, after), targets_value, captured_value, visited_value) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, ready))

def ready_reference_graph_complete(+state: D.State, +history: V.History, +view: V.Frame, +step: G.Step, +after: Nat, ready: {ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>}, limits: {ReferenceFrame.graph_limits(G.step_graph(step)) == ReferenceFrame.graph_limits(ReferenceFrame.graph(D.frame(state))) : G.Limits}) -> {ReferenceFrame.project(D.with_frame(state, X.event_result(D.frame(state), GraphReference.bounded_result(step, after))), History.allowance(history, after)) == Some{ready_graph_view(view, step, after)} : Maybe<&2, V.Frame>}:
  match state history step:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{+values, _, _, _}, _}, _, +captures, _, _, _, _, _, _}, +target_values, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, +seen}, _, +sources, _, _, _} G.Step{_, _}:
      ready_reference_graph_rows(state, history, ReferenceFrame.targets(target_values), ReferenceFrame.captured(captures, sources), ReferenceFrame.visited(seen, values), view, step, after, ready, limits)

def ready_reference_remaining(frame: X.Frame) -> Nat:
  match frame:
    case X.Frame{G.Bounded{_, remaining}, _, _, _, _, _, _, _, _, _, _, _}: remaining

def ready_reference_captured_frame(+state: D.State, +history: V.History, +view: V.Frame, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>, ready: {ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>}, positive: {Nat.is_gt(ready_reference_remaining(D.frame(state)), 0n) == True{} : Bool}) -> {ReferenceFrame.project(D.with_frame(state, X.event(D.frame(state), G.Captured{source, contribution, work, ids})), History.allowance(history, Nat.sub(ready_reference_remaining(D.frame(state)), 1n))) == Some{ready_graph_view(view, G.step(ReferenceFrame.graph(D.frame(state)), G.Captured{source, contribution, work, ids}), Nat.sub(ready_reference_remaining(D.frame(state)), 1n))} : Maybe<&2, V.Frame>}:
  match state:
    case D.State{_, X.Frame{G.Bounded{+graph, +remaining}, _, _, _, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}:
      Equal.trans(Maybe<&2, V.Frame>, ReferenceFrame.project(D.with_frame(state, X.event(D.frame(state), G.Captured{source, contribution, work, ids})), History.allowance(history, Nat.sub(remaining, 1n))),
        ReferenceFrame.project(D.with_frame(state, X.event_result(D.frame(state), GraphReference.bounded_result(G.step(graph, G.Captured{source, contribution, work, ids}), Nat.sub(remaining, 1n)))), History.allowance(history, Nat.sub(remaining, 1n))),
        Some{ready_graph_view(view, G.step(graph, G.Captured{source, contribution, work, ids}), Nat.sub(remaining, 1n))},
        Equal.cong(G.BoundedStep, Maybe<&2, V.Frame>, result => ReferenceFrame.project(D.with_frame(state, X.event_result(D.frame(state), result)), History.allowance(history, Nat.sub(remaining, 1n))), GraphReference.bounded_transition(G.Bounded{graph, remaining}, G.Captured{source, contribution, work, ids}), GraphReference.bounded_result(G.step(graph, G.Captured{source, contribution, work, ids}), Nat.sub(remaining, 1n)), ready_captured_allowance(graph, source, contribution, work, ids, remaining, positive)),
        ready_reference_graph_complete(state, history, view, G.step(graph, G.Captured{source, contribution, work, ids}), Nat.sub(remaining, 1n), ready, ready_captured_limits(graph, source, contribution, work, ids)))

def ready_view_graph(view: V.Frame) -> G.Graph:
  match view:
    case V.Frame{_, _, graph, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}: graph

def ready_view_remaining(view: V.Frame) -> Nat:
  match view:
    case V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, remaining, _}: remaining

def ready_history_remaining(history: V.History) -> Nat:
  match history:
    case V.History{_, _, _, _, _, remaining, _}: remaining

def ready_actual_graph_coordinates(+actual: T.ResolverFrame, +remaining: Nat, +view: V.Frame) -> Type:
  {S.frame_graph(actual) == ready_view_graph(view) : G.Graph} & {remaining == ready_view_remaining(view) : Nat}

def ready_actual_graph_rows(+forest: Maybe<&2, F.Forest>, +pending: Maybe<&2, List<&2, V.PendingEntry>>, +targets: Maybe<&2, List<&2, V.TargetEntry>>, +ids: Maybe<&2, List<&2, V.TargetId>>, +captured: Maybe<&2, List<&2, V.CapturedEntry>>, +identities: Maybe<&2, List<&2, V.TargetArtifact>>, +visited: Maybe<&2, List<&2, String>>, +actual: T.ResolverFrame, +remaining: Nat, +episode: Nat, +view: V.Frame, ready: {ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, actual, remaining, episode) == Some{view} : Maybe<&2, V.Frame>}) -> ready_actual_graph_coordinates(actual, remaining, view):
  match forest pending targets ids captured identities visited actual:
    case Some{+forest_value} Some{+pending_value} Some{+targets_value} Some{+ids_value} Some{+captured_value} Some{+identities_value} Some{+visited_value}
      T.ResolverFrame{branch, limits, graph, command, deps, _, _, _, _, budget, node, edge, target, artifact, _, _, _, _, _, artifacts}:
      %Count.some_equal(V.Frame, V.Frame{branch, limits, graph, command, deps, forest_value, pending_value, targets_value, ids_value, captured_value, identities_value, visited_value, V.actual_budget(budget), node, edge, target, artifact, artifacts, remaining, episode}, view, ready):
        ready_actual_graph_coordinates(actual, remaining, _)
      Tuple{{==}, {==}}
    case None{} _ _ _ _ _ _ _:
      Empty.absurd(ready_actual_graph_coordinates(actual, remaining, view), Contents.none_some(V.Frame, view, ready))
    case Some{_} None{} _ _ _ _ _ _:
      Empty.absurd(ready_actual_graph_coordinates(actual, remaining, view), Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} None{} _ _ _ _ _:
      Empty.absurd(ready_actual_graph_coordinates(actual, remaining, view), Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} None{} _ _ _ _:
      Empty.absurd(ready_actual_graph_coordinates(actual, remaining, view), Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} Some{_} None{} _ _ _:
      Empty.absurd(ready_actual_graph_coordinates(actual, remaining, view), Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} Some{_} Some{_} None{} _ _:
      Empty.absurd(ready_actual_graph_coordinates(actual, remaining, view), Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} Some{_} Some{_} Some{_} None{} _:
      Empty.absurd(ready_actual_graph_coordinates(actual, remaining, view), Contents.none_some(V.Frame, view, ready))

def ready_actual_graph_projected(+frame: T.ResolverFrame, +history: V.History, +view: V.Frame, ready: {ActualFrame.projected(frame, history) == Some{view} : Maybe<&2, V.Frame>}) -> ready_actual_graph_coordinates(frame, ready_history_remaining(history), view):
  match history:
    case V.History{+addresses, V.Order{+pending_order, +target_order, +id_order, +capture_order, +identity_order, +visited_order}, +sources, +captures, _, +remaining, +episode}:
      ready_actual_graph_rows(ActualFrame.forest_valid(P.project(S.frame_root(frame), S.frame_nodes(frame), S.frame_references(frame), S.frame_artifacts(frame), addresses), episode), ActualFrame.pending(pending_order, S.frame_pending(frame), sources, addresses), ActualFrame.targets(target_order, S.frame_target_paths(frame), addresses), ActualFrame.ids(id_order, S.frame_target_ids(frame)), ActualFrame.captured(capture_order, S.frame_captured(frame), captures), ActualFrame.identities(identity_order, S.frame_target_artifacts(frame)), ActualFrame.visited(visited_order, S.frame_visited(frame)), frame, remaining, episode, view, ready)

def ready_actual_graph_project(+actual: T.ResolverFrame, +history: V.History, +view: V.Frame, ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}) -> ready_actual_graph_coordinates(actual, ready_history_remaining(history), view):
  ready_actual_graph_projected(actual, history, view,
    Pair.snd({frame_checks(actual, history) == True{} : Bool}, {ActualFrame.projected(actual, history) == Some{view} : Maybe<&2, V.Frame>}, actual_frame_contents(actual, history, view, ready)))

def ready_reference_graph_coordinates(+state: D.State, +view: V.Frame) -> Type:
  {ReferenceFrame.graph(D.frame(state)) == ready_view_graph(view) : G.Graph} &
  {ready_reference_remaining(D.frame(state)) == ready_view_remaining(view) : Nat}

def ready_reference_graph_coordinate_rows(+state: D.State, +history: V.History, +targets_value: Maybe<&2, List<&2, V.TargetEntry>>, +captured_value: Maybe<&2, List<&2, V.CapturedEntry>>, +visited_value: Maybe<&2, List<&2, String>>, +view: V.Frame, ready: {ReferenceFrame.assembled(state, history, targets_value, captured_value, visited_value) == Some{view} : Maybe<&2, V.Frame>}) -> ready_reference_graph_coordinates(state, view):
  match state history targets_value captured_value visited_value:
    case D.State{D.Config{_, _, _, +context, _, _}, X.Frame{G.Bounded{+graph, +remaining}, +command, +forest, Signed.State{Recursive.State{_, +budget, _, _}, +signed}, +edges, _, +artifacts_by_target, +next_edge, +episode, +next_artifact, +dependencies, _}, _, +target_ids, +next_target, _, _, _, _} V.History{_, _, _, _, +artifacts, _, _}
      Some{+targets} Some{+captures} Some{+seen}:
      %Count.some_equal(V.Frame, V.Frame{ReferenceFrame.branch(context), ReferenceFrame.graph_limits(graph), graph, command, dependencies, forest, ReferenceFrame.pending(edges), targets, ReferenceFrame.ids(target_ids), captures, ReferenceFrame.identities(artifacts_by_target), seen, V.budget(budget, signed), ReferenceFrame.node_count(forest), next_edge, next_target, next_artifact, artifacts, remaining, episode}, view, ready): ready_reference_graph_coordinates(state, _)
      Tuple{{==}, {==}}
    case _ _ None{} _ _:
      Empty.absurd(ready_reference_graph_coordinates(state, view), Contents.none_some(V.Frame, view, ready))
    case _ _ Some{_} None{} _:
      Empty.absurd(ready_reference_graph_coordinates(state, view), Contents.none_some(V.Frame, view, ready))
    case _ _ Some{_} Some{_} None{}:
      Empty.absurd(ready_reference_graph_coordinates(state, view), Contents.none_some(V.Frame, view, ready))

def ready_reference_graph_project(+state: D.State, +history: V.History, +view: V.Frame, ready: {ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>}) -> ready_reference_graph_coordinates(state, view):
  match state history:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{+values, _, _, _}, _}, _, +captures, _, _, _, _, _, _}, +target_values, _, _, _, _, _, _}
      V.History{_, V.Order{_, _, _, _, _, +seen}, _, +sources, _, _, _}:
      ready_reference_graph_coordinate_rows(state, history, ReferenceFrame.targets(target_values), ReferenceFrame.captured(captures, sources), ReferenceFrame.visited(seen, values), view, ready)

def ready_captured_coordinate_pairs(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, actual_coordinates: ready_actual_graph_coordinates(actual, ready_history_remaining(history), view), reference_coordinates: ready_reference_graph_coordinates(reference, view)) -> {ReferenceFrame.graph(D.frame(reference)) == S.frame_graph(actual) : G.Graph} & {ready_reference_remaining(D.frame(reference)) == ready_history_remaining(history) : Nat}:
  match actual_coordinates reference_coordinates:
    case Tuple{actual_graph, actual_remaining} Tuple{reference_graph, reference_remaining}:
      Tuple{
        Equal.trans(G.Graph, ReferenceFrame.graph(D.frame(reference)), ready_view_graph(view), S.frame_graph(actual), reference_graph,
          Equal.sym(G.Graph, S.frame_graph(actual), ready_view_graph(view), actual_graph)),
        Equal.trans(Nat, ready_reference_remaining(D.frame(reference)), ready_view_remaining(view), ready_history_remaining(history), reference_remaining,
          Equal.sym(Nat, ready_history_remaining(history), ready_view_remaining(view), actual_remaining))}

def ready_captured_coordinates(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, +actual_ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, +reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}) -> {ReferenceFrame.graph(D.frame(reference)) == S.frame_graph(actual) : G.Graph} & {ready_reference_remaining(D.frame(reference)) == ready_history_remaining(history) : Nat}:
  ready_captured_coordinate_pairs(actual, reference, history, view,
    ready_actual_graph_project(actual, history, view, actual_ready),
    ready_reference_graph_project(reference, history, view, reference_ready))

def ready_reference_captured_at(+reference: D.State, +history: V.History, +view: V.Frame, +graph: G.Graph, +remaining: Nat, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>, ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, positive: {Nat.is_gt(remaining, 0n) == True{} : Bool}, graph_equal: {ReferenceFrame.graph(D.frame(reference)) == graph : G.Graph}, +remaining_equal: {ready_reference_remaining(D.frame(reference)) == remaining : Nat}) -> {ReferenceFrame.project(D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), History.allowance(history, Nat.sub(remaining, 1n))) == Some{ready_graph_view(view, G.step(graph, G.Captured{source, contribution, work, ids}), Nat.sub(remaining, 1n))} : Maybe<&2, V.Frame>}:
  ref_positive = Equal.trans(Bool, Nat.is_gt(ready_reference_remaining(D.frame(reference)), 0n), Nat.is_gt(remaining, 0n), True{},
    Equal.cong(Nat, Bool, value => Nat.is_gt(value, 0n), ready_reference_remaining(D.frame(reference)), remaining, remaining_equal), positive)
  %remaining_equal:
    {ReferenceFrame.project(D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), History.allowance(history, Nat.sub(_, 1n))) == Some{ready_graph_view(view, G.step(graph, G.Captured{source, contribution, work, ids}), Nat.sub(_, 1n))} : Maybe<&2, V.Frame>}
  %graph_equal:
    {ReferenceFrame.project(D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), History.allowance(history, Nat.sub(ready_reference_remaining(D.frame(reference)), 1n))) == Some{ready_graph_view(view, G.step(_, G.Captured{source, contribution, work, ids}), Nat.sub(ready_reference_remaining(D.frame(reference)), 1n))} : Maybe<&2, V.Frame>}
  ready_reference_captured_frame(reference, history, view, source, contribution, work, ids, ready, ref_positive)

def ready_reference_captured_coordinate_pair(+reference: D.State, +history: V.History, +view: V.Frame, +graph: G.Graph, +remaining: Nat, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>, ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, positive: {Nat.is_gt(remaining, 0n) == True{} : Bool}, coordinates: {ReferenceFrame.graph(D.frame(reference)) == graph : G.Graph} & {ready_reference_remaining(D.frame(reference)) == remaining : Nat}) -> {ReferenceFrame.project(D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), History.allowance(history, Nat.sub(remaining, 1n))) == Some{ready_graph_view(view, G.step(graph, G.Captured{source, contribution, work, ids}), Nat.sub(remaining, 1n))} : Maybe<&2, V.Frame>}:
  match coordinates:
    case (graph_equal, remaining_equal):
      ready_reference_captured_at(reference, history, view, graph, remaining, source, contribution, work, ids, ready, positive, graph_equal, remaining_equal)

def ready_captured_frames(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>, +actual_ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, +reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, positive: ready_history_positive(history)) -> {ActualFrame.project(S.advance(actual, G.Captured{source, contribution, work, ids}), History.allowance(history, Nat.sub(ready_history_remaining(history), 1n))) == Some{ready_graph_view(view, G.step(S.frame_graph(actual), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n))} : Maybe<&2, V.Frame>} & {ReferenceFrame.project(D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), History.allowance(history, Nat.sub(ready_history_remaining(history), 1n))) == Some{ready_graph_view(view, G.step(S.frame_graph(actual), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n))} : Maybe<&2, V.Frame>}:
  match history:
    case V.History{_, _, _, _, _, +remaining, _}:
      Tuple{
        ready_graph_frame_complete(actual, history, view, G.step(S.frame_graph(actual), G.Captured{source, contribution, work, ids}), Nat.sub(remaining, 1n), actual_ready),
        ready_reference_captured_coordinate_pair(reference, history, view, S.frame_graph(actual), remaining, source, contribution, work, ids, reference_ready, positive,
          ready_captured_coordinates(actual, reference, history, view, actual_ready, reference_ready))}

def ready_transition_selected(+actual: T.ResolverFrame, +step: G.Step, +owner: Nat, +index: Nat, +symbol: String, selected: {ActualReady.slot_count(S.frame_references(actual), owner, index, symbol) == 1n : Nat}) -> {ActualReady.slot_count(S.frame_references(PreparedRoot.frame_transition(actual, step)), owner, index, symbol) == 1n : Nat}:
  match actual step:
    case T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _} G.Step{_, _}: selected

def ready_captured_rollback_total(+actual: T.ResolverFrame, +reference: D.State, +history: V.History, +view: V.Frame, +source: Nat, +contribution: Nat, +work: Nat, +ids: List<&2, Nat>, +owner: Nat, +index: Nat, +name: String, +symbol: String, +address: O.NodeAddress, actual_ready: {ActualFrame.project(actual, history) == Some{view} : Maybe<&2, V.Frame>}, reference_ready: {ReferenceFrame.project(reference, history) == Some{view} : Maybe<&2, V.Frame>}, positive: ready_history_positive(history), selected: {ActualReady.slot_count(S.frame_references(actual), owner, index, symbol) == 1n : Nat}, present: {F.address_at(ready_history_addresses(history), owner) == Some{address} : Maybe<&2, O.NodeAddress>}) -> ready_rollback_transaction_result(S.advance(actual, G.Captured{source, contribution, work, ids}), D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), History.allowance(history, Nat.sub(ready_history_remaining(history), 1n)), ready_graph_view(view, G.step(S.frame_graph(actual), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n)), owner, index, name, symbol, address):
  match history:
    case V.History{_, _, _, _, _, _, _}:
      Parent.eliminate_pair({ActualFrame.project(S.advance(actual, G.Captured{source, contribution, work, ids}), History.allowance(history, Nat.sub(ready_history_remaining(history), 1n))) == Some{ready_graph_view(view, G.step(S.frame_graph(actual), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n))} : Maybe<&2, V.Frame>}, {ReferenceFrame.project(D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), History.allowance(history, Nat.sub(ready_history_remaining(history), 1n))) == Some{ready_graph_view(view, G.step(S.frame_graph(actual), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n))} : Maybe<&2, V.Frame>}, ready_rollback_transaction_result(S.advance(actual, G.Captured{source, contribution, work, ids}), D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), History.allowance(history, Nat.sub(ready_history_remaining(history), 1n)), ready_graph_view(view, G.step(S.frame_graph(actual), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n)), owner, index, name, symbol, address),
        ready_captured_frames(actual, reference, history, view, source, contribution, work, ids, actual_ready, reference_ready, positive),
        actual_captured => reference_captured =>
          ready_rollback_transaction_total(S.advance(actual, G.Captured{source, contribution, work, ids}), D.with_frame(reference, X.event(D.frame(reference), G.Captured{source, contribution, work, ids})), History.allowance(history, Nat.sub(ready_history_remaining(history), 1n)), ready_graph_view(view, G.step(S.frame_graph(actual), G.Captured{source, contribution, work, ids}), Nat.sub(ready_history_remaining(history), 1n)), owner, index, name, symbol, address,
            actual_captured, reference_captured,
            ready_transition_selected(actual, G.step(S.frame_graph(actual), G.Captured{source, contribution, work, ids}), owner, index, symbol, selected), present))

# Publication writes one existing target key. These rows are the identity
# component of the original successful captured-frame projection.
def ready_identity_lookup_set(+entries: Map<&2, Maybe<&2, String>>, +target: Nat, +query: Nat, +identity: String, valid: {Patricia.canonical(Maybe<&2, String>, entries) == True{} : Bool}) -> {ResolverCore.map_read(Maybe<&2, String>, None{}, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}), Nat.show(query)) == Bool.pick(Maybe<&2, String>, Nat.is_eq(query, target), Some{identity}, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(query))) : Maybe<&2, String>}:
  Equal.trans(Maybe<&2, String>,
    ResolverCore.map_read(Maybe<&2, String>, None{}, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}), Nat.show(query)),
    Bool.pick(Maybe<&2, String>, String.eq(Nat.show(query), Nat.show(target)), Some{identity},
      ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(query))),
    Bool.pick(Maybe<&2, String>, Nat.is_eq(query, target), Some{identity},
      ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(query))),
    Payload.lookup_after_set(Maybe<&2, String>, entries, Nat.show(target), Nat.show(query), Some{identity}, None{}, valid),
    Equal.cong(Bool, Maybe<&2, String>, same => Bool.pick(Maybe<&2, String>, same, Some{identity},
      ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(query))),
      String.eq(Nat.show(query), Nat.show(target)), Nat.is_eq(query, target), NaturalKeys.natural_key_equality(query, target)))

def ready_identity_unaffected_case(+head: Nat, +tail: List<&2, Nat>, +entries: Map<&2, Maybe<&2, String>>, +target: Nat, +identity: String, +same: Bool, selected: {Nat.is_eq(head, target) == same : Bool}, absent: {Bool.or(same, History.has_nat(tail, target)) == False{} : Bool}, lookup: {ResolverCore.map_read(Maybe<&2, String>, None{}, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}), Nat.show(head)) == Bool.pick(Maybe<&2, String>, same, Some{identity}, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(head))) : Maybe<&2, String>}, recurse: {History.has_nat(tail, target) == False{} : Bool} -> {ActualFrame.identities(tail, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == ActualFrame.identities(tail, entries) : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {ActualFrame.identities(head <> tail, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == ActualFrame.identities(head <> tail, entries) : Maybe<&2, List<&2, V.TargetArtifact>>}:
  match same:
    case True{}:
      Empty.absurd({ActualFrame.identities(head <> tail, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))
        == ActualFrame.identities(head <> tail, entries) : Maybe<&2, List<&2, V.TargetArtifact>>},
        NatFacts.internal_false_ne_true(Equal.sym(Bool, True{}, False{}, absent)))
    case False{}:
      %Equal.sym(Maybe<&2, String>, ResolverCore.map_read(Maybe<&2, String>, None{}, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}), Nat.show(head)),
        ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(head)), lookup):
        {ActualFrame.identities_prefix(ActualFrame.identity_entry(head, _),
        ActualFrame.identities(tail, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})))
        == ActualFrame.identities(head <> tail, entries) : Maybe<&2, List<&2, V.TargetArtifact>>}
      Equal.cong(Maybe<&2, List<&2, V.TargetArtifact>>, Maybe<&2, List<&2, V.TargetArtifact>>,
        rest => ActualFrame.identities_prefix(ActualFrame.identity_entry(head, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(head))), rest),
        ActualFrame.identities(tail, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})),
        ActualFrame.identities(tail, entries), recurse(absent))

def ready_identity_unaffected(+order: List<&2, Nat>, +entries: Map<&2, Maybe<&2, String>>, +target: Nat, +identity: String, +valid: {Patricia.canonical(Maybe<&2, String>, entries) == True{} : Bool}, absent: {History.has_nat(order, target) == False{} : Bool}) -> {ActualFrame.identities(order, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == ActualFrame.identities(order, entries) : Maybe<&2, List<&2, V.TargetArtifact>>}:
  match order:
    case []: {==}
    case +head <> +tail:
      ready_identity_unaffected_case(head, tail, entries, target, identity, Nat.is_eq(head, target), {==}, absent,
        ready_identity_lookup_set(entries, target, head, identity, valid),
        tail_absent => ready_identity_unaffected(tail, entries, target, identity, valid, tail_absent))

def ready_identity_selected_rows(+tail: List<&2, Nat>, +entries: Map<&2, Maybe<&2, String>>, +target: Nat, +identity: String, +valid: {Patricia.canonical(Maybe<&2, String>, entries) == True{} : Bool}, absent: {History.has_nat(tail, target) == False{} : Bool}) -> {ActualFrame.identities(target <> tail, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == ActualFrame.identities_prefix(Some{V.TargetArtifact{target, identity}}, ActualFrame.identities(tail, entries)) : Maybe<&2, List<&2, V.TargetArtifact>>}:
  %Equal.sym(Maybe<&2, String>,
    ResolverCore.map_read(Maybe<&2, String>, None{}, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}), Nat.show(target)), Some{identity},
    Equal.trans(Maybe<&2, String>,
      ResolverCore.map_read(Maybe<&2, String>, None{}, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}), Nat.show(target)),
      Bool.pick(Maybe<&2, String>, Nat.is_eq(target, target), Some{identity}, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(target))), Some{identity},
      ready_identity_lookup_set(entries, target, target, identity, valid),
      Equal.cong(Bool, Maybe<&2, String>, same => Bool.pick(Maybe<&2, String>, same, Some{identity},
        ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(target))),
        Nat.is_eq(target, target), True{}, NaturalKeys.nat_true_of_same(target, target, {==})))):
    {ActualFrame.identities_prefix(ActualFrame.identity_entry(target, _),
      ActualFrame.identities(tail, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})))
      == ActualFrame.identities_prefix(Some{V.TargetArtifact{target, identity}}, ActualFrame.identities(tail, entries))
      : Maybe<&2, List<&2, V.TargetArtifact>>}
  Equal.cong(Maybe<&2, List<&2, V.TargetArtifact>>, Maybe<&2, List<&2, V.TargetArtifact>>,
    rest => ActualFrame.identities_prefix(Some{V.TargetArtifact{target, identity}}, rest),
    ActualFrame.identities(tail, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})),
    ActualFrame.identities(tail, entries), ready_identity_unaffected(tail, entries, target, identity, valid, absent))

def ready_identity_selected_reference(+tail: List<&2, Nat>, +entries: Map<&2, Maybe<&2, String>>, +target: Nat, +identity: String, +reference: List<&2, X.TargetArtifact>, +old: String, valid: {Patricia.canonical(Maybe<&2, String>, entries) == True{} : Bool}, absent: {History.has_nat(tail, target) == False{} : Bool}, projected: {ActualFrame.identities(tail, entries) == Some{ReferenceFrame.identities(reference)} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {ActualFrame.identities(target <> tail, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == Some{ReferenceFrame.identities(X.store_identity(X.TargetArtifact{target, old} <> reference, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}:
  %Equal.sym(Bool, Nat.is_eq(target, target), True{}, NaturalKeys.nat_true_of_same(target, target, {==})):
    {ActualFrame.identities(target <> tail, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))
      == Some{ReferenceFrame.identities(Bool.pick(List<&2, X.TargetArtifact>, _,
        X.TargetArtifact{target, identity} <> reference,
        X.TargetArtifact{target, old} <> X.store_identity(reference, target, identity)))} : Maybe<&2, List<&2, V.TargetArtifact>>}
  Equal.trans(Maybe<&2, List<&2, V.TargetArtifact>>,
    ActualFrame.identities(target <> tail, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})),
    ActualFrame.identities_prefix(Some{V.TargetArtifact{target, identity}}, ActualFrame.identities(tail, entries)),
    Some{V.TargetArtifact{target, identity} <> ReferenceFrame.identities(reference)},
    ready_identity_selected_rows(tail, entries, target, identity, valid, absent),
    Equal.cong(Maybe<&2, List<&2, V.TargetArtifact>>, Maybe<&2, List<&2, V.TargetArtifact>>,
      rest => ActualFrame.identities_prefix(Some{V.TargetArtifact{target, identity}}, rest),
      ActualFrame.identities(tail, entries), Some{ReferenceFrame.identities(reference)}, projected))

def ready_nat_zero_absent_case(+same: Bool, +count: Nat, +present: Bool, zero: {(Bool.pick(Nat, same, 1n, 0n) + count : Nat) == 0n : Nat}, recurse: {count == 0n : Nat} -> {present == False{} : Bool}) -> {Bool.or(same, present) == False{} : Bool}:
  match same:
    case True{}: Empty.absurd({True{} == False{} : Bool}, Arithmetic.internal_succ_ne_zero(count, zero))
    case False{}: recurse(zero)

def ready_nat_zero_absent(+items: List<&2, Nat>, +query: Nat, zero: {ActualFrame.nat_count(items, query) == 0n : Nat}) -> {History.has_nat(items, query) == False{} : Bool}:
  match items:
    case []: {==}
    case +head <> +tail:
      ready_nat_zero_absent_case(Nat.is_eq(head, query), ActualFrame.nat_count(tail, query), History.has_nat(tail, query), zero,
        rest => ready_nat_zero_absent(tail, query, rest))

def ready_identity_unique_tail(+target: Nat, +tail: List<&2, Nat>, unique: {ActualFrame.nats_unique(target <> tail, target <> tail) == True{} : Bool}) -> {History.has_nat(tail, target) == False{} : Bool}:
  ready_nat_zero_absent(tail, target,
    Arithmetic.succ_inj(ActualFrame.nat_count(tail, target), 0n,
      Equal.trans(Nat, (1n + ActualFrame.nat_count(tail, target) : Nat), ActualFrame.nat_count(target <> tail, target), 1n,
        Equal.cong(Bool, Nat, same => (Bool.pick(Nat, same, 1n, 0n) + ActualFrame.nat_count(tail, target) : Nat),
          True{}, Nat.is_eq(target, target), Equal.sym(Bool, Nat.is_eq(target, target), True{}, NaturalKeys.nat_true_of_same(target, target, {==}))),
        NatFacts.eq_of_is_eq(ActualFrame.nat_count(target <> tail, target), 1n,
          BoolFacts.eq_true_of_and_left(Nat.is_eq(ActualFrame.nat_count(target <> tail, target), 1n),
            ActualFrame.nats_unique(tail, target <> tail), unique)))))

def ready_identity_unique_reference(+tail: List<&2, Nat>, +entries: Map<&2, Maybe<&2, String>>, +target: Nat, +identity: String, +reference: List<&2, X.TargetArtifact>, +old: String, valid: {Patricia.canonical(Maybe<&2, String>, entries) == True{} : Bool}, unique: {ActualFrame.nats_unique(target <> tail, target <> tail) == True{} : Bool}, projected: {ActualFrame.identities(tail, entries) == Some{ReferenceFrame.identities(reference)} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {ActualFrame.identities(target <> tail, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == Some{ReferenceFrame.identities(X.store_identity(X.TargetArtifact{target, old} <> reference, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}:
  ready_identity_selected_reference(tail, entries, target, identity, reference, old, valid,
    ready_identity_unique_tail(target, tail, unique), projected)

def ready_identity_concat(left: Maybe<&2, List<&2, V.TargetArtifact>>, right: Maybe<&2, List<&2, V.TargetArtifact>>) -> Maybe<&2, List<&2, V.TargetArtifact>>:
  match left right:
    case Some{items} Some{more}: Some{List.append(&2, V.TargetArtifact, items, more)}
    case _ _: None{}

def ready_identity_concat_empty(+items: Maybe<&2, List<&2, V.TargetArtifact>>) -> {items == ready_identity_concat(Some{[]}, items) : Maybe<&2, List<&2, V.TargetArtifact>>}:
  match items:
    case Some{_}: {==}
    case None{}: {==}

def ready_identity_concat_prefix(+head: Maybe<&2, V.TargetArtifact>, +tail: Maybe<&2, List<&2, V.TargetArtifact>>, +more: Maybe<&2, List<&2, V.TargetArtifact>>) -> {ActualFrame.identities_prefix(head, ready_identity_concat(tail, more)) == ready_identity_concat(ActualFrame.identities_prefix(head, tail), more) : Maybe<&2, List<&2, V.TargetArtifact>>}:
  match head tail more:
    case Some{_} Some{_} Some{_}: {==}
    case Some{_} Some{_} None{}: {==}
    case Some{_} None{} _: {==}
    case None{} Some{_} Some{_}: {==}
    case None{} Some{_} None{}: {==}
    case None{} None{} _: {==}

def ready_identity_appended_rows(+order: List<&2, Nat>, +more: List<&2, Nat>, +entries: Map<&2, Maybe<&2, String>>) -> {ActualFrame.identities(List.append(&2, Nat, order, more), entries) == ready_identity_concat(ActualFrame.identities(order, entries), ActualFrame.identities(more, entries)) : Maybe<&2, List<&2, V.TargetArtifact>>}:
  match order:
    case []: ready_identity_concat_empty(ActualFrame.identities(more, entries))
    case +head <> +tail:
      Equal.trans(Maybe<&2, List<&2, V.TargetArtifact>>,
        ActualFrame.identities(head <> List.append(&2, Nat, tail, more), entries),
        ActualFrame.identities_prefix(ActualFrame.identity_entry(head, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(head))),
          ready_identity_concat(ActualFrame.identities(tail, entries), ActualFrame.identities(more, entries))),
        ready_identity_concat(ActualFrame.identities(head <> tail, entries), ActualFrame.identities(more, entries)),
        Equal.cong(Maybe<&2, List<&2, V.TargetArtifact>>, Maybe<&2, List<&2, V.TargetArtifact>>,
          rest => ActualFrame.identities_prefix(ActualFrame.identity_entry(head, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(head))), rest),
          ActualFrame.identities(List.append(&2, Nat, tail, more), entries),
          ready_identity_concat(ActualFrame.identities(tail, entries), ActualFrame.identities(more, entries)),
          ready_identity_appended_rows(tail, more, entries)),
        ready_identity_concat_prefix(ActualFrame.identity_entry(head, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(head))),
          ActualFrame.identities(tail, entries), ActualFrame.identities(more, entries)))

def ready_identity_new_rows(+order: List<&2, Nat>, +entries: Map<&2, Maybe<&2, String>>, +target: Nat, +identity: String, +rows: List<&2, V.TargetArtifact>, +valid: {Patricia.canonical(Maybe<&2, String>, entries) == True{} : Bool}, +absent: {History.has_nat(order, target) == False{} : Bool}, projected: {ActualFrame.identities(order, entries) == Some{rows} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {ActualFrame.identities(History.retain_nat(order, target), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == Some{List.append(&2, V.TargetArtifact, rows, [V.TargetArtifact{target, identity}])} : Maybe<&2, List<&2, V.TargetArtifact>>}:
  %Equal.sym(Bool, History.has_nat(order, target), False{}, absent):
    {ActualFrame.identities(Bool.pick(List<&2, Nat>, _, order, List.append(&2, Nat, order, [target])),
      Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))
      == Some{List.append(&2, V.TargetArtifact, rows, [V.TargetArtifact{target, identity}])} : Maybe<&2, List<&2, V.TargetArtifact>>}
  Equal.trans(Maybe<&2, List<&2, V.TargetArtifact>>,
    ActualFrame.identities(List.append(&2, Nat, order, [target]), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})),
    ready_identity_concat(ActualFrame.identities(order, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})),
      ActualFrame.identities([target], Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))),
    Some{List.append(&2, V.TargetArtifact, rows, [V.TargetArtifact{target, identity}])},
    ready_identity_appended_rows(order, [target], Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})),
    Equal.trans(Maybe<&2, List<&2, V.TargetArtifact>>,
      ready_identity_concat(ActualFrame.identities(order, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})),
        ActualFrame.identities([target], Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))),
      ready_identity_concat(Some{rows}, ActualFrame.identities([target], Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))),
      Some{List.append(&2, V.TargetArtifact, rows, [V.TargetArtifact{target, identity}])},
      Equal.cong(Maybe<&2, List<&2, V.TargetArtifact>>, Maybe<&2, List<&2, V.TargetArtifact>>,
        old => ready_identity_concat(old, ActualFrame.identities([target], Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))),
        ActualFrame.identities(order, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})), Some{rows},
        Equal.trans(Maybe<&2, List<&2, V.TargetArtifact>>, ActualFrame.identities(order, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})),
          ActualFrame.identities(order, entries), Some{rows}, ready_identity_unaffected(order, entries, target, identity, valid, absent), projected)),
      Equal.cong(Maybe<&2, List<&2, V.TargetArtifact>>, Maybe<&2, List<&2, V.TargetArtifact>>,
        added => ready_identity_concat(Some{rows}, added),
        ActualFrame.identities([target], Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})),
        Some{[V.TargetArtifact{target, identity}]}, ready_identity_selected_rows([], entries, target, identity, valid, {==}))))

# Read the existing identity keys; no policy or runtime representation is added.
def ready_identity_row_ids(items: List<&2, V.TargetArtifact>) -> List<&2, Nat>:
  match items:
    case []: []
    case V.TargetArtifact{target, _} <> tail: target <> ready_identity_row_ids(tail)

def ready_identity_observed_ids(items: Maybe<&2, List<&2, V.TargetArtifact>>) -> List<&2, Nat>:
  match items:
    case Some{rows}: ready_identity_row_ids(rows)
    case None{}: []

def ready_identity_order_prefix(+head: Nat, +tail: List<&2, Nat>, +value: Maybe<&2, String>, +rest: Maybe<&2, List<&2, V.TargetArtifact>>, +rows: List<&2, V.TargetArtifact>, projected: {ActualFrame.identities_prefix(ActualFrame.identity_entry(head, value), rest) == Some{rows} : Maybe<&2, List<&2, V.TargetArtifact>>}, recurse: @retained: List<&2, V.TargetArtifact> -> {rest == Some{retained} : Maybe<&2, List<&2, V.TargetArtifact>>} -> {tail == ready_identity_row_ids(retained) : List<&2, Nat>}) -> {head <> tail == ready_identity_row_ids(rows) : List<&2, Nat>}:
  match value rest:
    case Some{+identity} Some{+retained}:
      Equal.trans(List<&2, Nat>, head <> tail, head <> ready_identity_row_ids(retained), ready_identity_row_ids(rows),
        Equal.cong(List<&2, Nat>, List<&2, Nat>, keys => head <> keys, tail, ready_identity_row_ids(retained), recurse(retained, {==})),
        Equal.cong(Maybe<&2, List<&2, V.TargetArtifact>>, List<&2, Nat>, ready_identity_observed_ids,
          Some{V.TargetArtifact{head, identity} <> retained}, Some{rows}, projected))
    case None{} _:
      Empty.absurd({head <> tail == ready_identity_row_ids(rows) : List<&2, Nat>}, Contents.none_some(List<&2, V.TargetArtifact>, rows, projected))
    case Some{_} None{}:
      Empty.absurd({head <> tail == ready_identity_row_ids(rows) : List<&2, Nat>}, Contents.none_some(List<&2, V.TargetArtifact>, rows, projected))

def ready_identity_order_exact(+order: List<&2, Nat>, +entries: Map<&2, Maybe<&2, String>>, +rows: List<&2, V.TargetArtifact>, projected: {ActualFrame.identities(order, entries) == Some{rows} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {order == ready_identity_row_ids(rows) : List<&2, Nat>}:
  match order:
    case []:
      Equal.cong(Maybe<&2, List<&2, V.TargetArtifact>>, List<&2, Nat>, ready_identity_observed_ids, Some{[]}, Some{rows}, projected)
    case +head <> +tail:
      ready_identity_order_prefix(head, tail, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(head)),
        ActualFrame.identities(tail, entries), rows, projected,
        retained => witness => ready_identity_order_exact(tail, entries, retained, witness))

def ready_reference_identity_new_case(+key: Nat, +old: String, +tail: List<&2, X.TargetArtifact>, +target: Nat, +identity: String, +same: Bool, selected: {Nat.is_eq(key, target) == same : Bool}, absent: {Bool.or(same, History.has_nat(ready_identity_row_ids(ReferenceFrame.identities(tail)), target)) == False{} : Bool}, recurse: {History.has_nat(ready_identity_row_ids(ReferenceFrame.identities(tail)), target) == False{} : Bool} -> {ReferenceFrame.identities(X.store_identity(tail, target, identity)) == List.append(&2, V.TargetArtifact, ReferenceFrame.identities(tail), [V.TargetArtifact{target, identity}]) : List<&2, V.TargetArtifact>}) -> {ReferenceFrame.identities(X.store_identity(X.TargetArtifact{key, old} <> tail, target, identity)) == List.append(&2, V.TargetArtifact, ReferenceFrame.identities(X.TargetArtifact{key, old} <> tail), [V.TargetArtifact{target, identity}]) : List<&2, V.TargetArtifact>}:
  match same:
    case True{}:
      Empty.absurd({ReferenceFrame.identities(X.store_identity(X.TargetArtifact{key, old} <> tail, target, identity))
        == List.append(&2, V.TargetArtifact, ReferenceFrame.identities(X.TargetArtifact{key, old} <> tail), [V.TargetArtifact{target, identity}]) : List<&2, V.TargetArtifact>},
        NatFacts.internal_false_ne_true(Equal.sym(Bool, True{}, False{}, absent)))
    case False{}:
      %Equal.sym(Bool, Nat.is_eq(key, target), False{}, selected):
        {ReferenceFrame.identities(Bool.pick(List<&2, X.TargetArtifact>, _, X.TargetArtifact{target, identity} <> tail,
          X.TargetArtifact{key, old} <> X.store_identity(tail, target, identity)))
          == V.TargetArtifact{key, old} <> List.append(&2, V.TargetArtifact, ReferenceFrame.identities(tail), [V.TargetArtifact{target, identity}])
          : List<&2, V.TargetArtifact>}
      Equal.cong(List<&2, V.TargetArtifact>, List<&2, V.TargetArtifact>, rows => V.TargetArtifact{key, old} <> rows,
        ReferenceFrame.identities(X.store_identity(tail, target, identity)),
        List.append(&2, V.TargetArtifact, ReferenceFrame.identities(tail), [V.TargetArtifact{target, identity}]), recurse(absent))

def ready_reference_identity_new(+items: List<&2, X.TargetArtifact>, +target: Nat, +identity: String, absent: {History.has_nat(ready_identity_row_ids(ReferenceFrame.identities(items)), target) == False{} : Bool}) -> {ReferenceFrame.identities(X.store_identity(items, target, identity)) == List.append(&2, V.TargetArtifact, ReferenceFrame.identities(items), [V.TargetArtifact{target, identity}]) : List<&2, V.TargetArtifact>}:
  match items:
    case []: {==}
    case X.TargetArtifact{+key, +old} <> +tail:
      ready_reference_identity_new_case(key, old, tail, target, identity, Nat.is_eq(key, target), {==}, absent,
        rest => ready_reference_identity_new(tail, target, identity, rest))

def ready_identity_new_reference(+order: List<&2, Nat>, +entries: Map<&2, Maybe<&2, String>>, +target: Nat, +identity: String, +reference: List<&2, X.TargetArtifact>, valid: {Patricia.canonical(Maybe<&2, String>, entries) == True{} : Bool}, +absent: {History.has_nat(order, target) == False{} : Bool}, +projected: {ActualFrame.identities(order, entries) == Some{ReferenceFrame.identities(reference)} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {ActualFrame.identities(History.retain_nat(order, target), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == Some{ReferenceFrame.identities(X.store_identity(reference, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}:
  Equal.trans(Maybe<&2, List<&2, V.TargetArtifact>>,
    ActualFrame.identities(History.retain_nat(order, target), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})),
    Some{List.append(&2, V.TargetArtifact, ReferenceFrame.identities(reference), [V.TargetArtifact{target, identity}])},
    Some{ReferenceFrame.identities(X.store_identity(reference, target, identity))},
    ready_identity_new_rows(order, entries, target, identity, ReferenceFrame.identities(reference), valid, absent, projected),
    Equal.cong(List<&2, V.TargetArtifact>, Maybe<&2, List<&2, V.TargetArtifact>>, rows => Some{rows},
      List.append(&2, V.TargetArtifact, ReferenceFrame.identities(reference), [V.TargetArtifact{target, identity}]),
      ReferenceFrame.identities(X.store_identity(reference, target, identity)),
      Equal.sym(List<&2, V.TargetArtifact>, ReferenceFrame.identities(X.store_identity(reference, target, identity)),
        List.append(&2, V.TargetArtifact, ReferenceFrame.identities(reference), [V.TargetArtifact{target, identity}]),
        ready_reference_identity_new(reference, target, identity,
          Equal.trans(Bool, History.has_nat(ready_identity_row_ids(ReferenceFrame.identities(reference)), target), History.has_nat(order, target), False{},
            Equal.cong(List<&2, Nat>, Bool, keys => History.has_nat(keys, target),
              ready_identity_row_ids(ReferenceFrame.identities(reference)), order,
              Equal.sym(List<&2, Nat>, order, ready_identity_row_ids(ReferenceFrame.identities(reference)),
                ready_identity_order_exact(order, entries, ReferenceFrame.identities(reference), projected))), absent)))))

def ready_identity_observed_head(rows: Maybe<&2, List<&2, V.TargetArtifact>>) -> Maybe<&2, String>:
  match rows:
    case Some{V.TargetArtifact{_, text} <> _}: Some{text}
    case _: None{}

def ready_identity_observed_tail(rows: Maybe<&2, List<&2, V.TargetArtifact>>) -> Maybe<&2, List<&2, V.TargetArtifact>>:
  match rows:
    case Some{_ <> tail}: Some{tail}
    case _: None{}

def ready_identity_projection_parts(+head: Nat, +value: Maybe<&2, String>, +rest: Maybe<&2, List<&2, V.TargetArtifact>>, +old: String, +rows: List<&2, V.TargetArtifact>, +projected: {ActualFrame.identities_prefix(ActualFrame.identity_entry(head, value), rest) == Some{V.TargetArtifact{head, old} <> rows} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {value == Some{old} : Maybe<&2, String>} & {rest == Some{rows} : Maybe<&2, List<&2, V.TargetArtifact>>}:
  match value rest:
    case Some{+text} Some{+tail}:
      Tuple{
        Equal.cong(Maybe<&2, List<&2, V.TargetArtifact>>, Maybe<&2, String>, ready_identity_observed_head,
          Some{V.TargetArtifact{head, text} <> tail}, Some{V.TargetArtifact{head, old} <> rows}, projected),
        Equal.cong(Maybe<&2, List<&2, V.TargetArtifact>>, Maybe<&2, List<&2, V.TargetArtifact>>, ready_identity_observed_tail,
          Some{V.TargetArtifact{head, text} <> tail}, Some{V.TargetArtifact{head, old} <> rows}, projected)}
    case None{} _:
      Empty.absurd({None{} == Some{old} : Maybe<&2, String>} & {rest == Some{rows} : Maybe<&2, List<&2, V.TargetArtifact>>},
        Contents.none_some(List<&2, V.TargetArtifact>, V.TargetArtifact{head, old} <> rows, projected))
    case Some{_} None{}:
      Empty.absurd({value == Some{old} : Maybe<&2, String>} & {None{} == Some{rows} : Maybe<&2, List<&2, V.TargetArtifact>>},
        Contents.none_some(List<&2, V.TargetArtifact>, V.TargetArtifact{head, old} <> rows, projected))

def ready_identity_existing_case(+key: Nat, +old: String, +tail: List<&2, X.TargetArtifact>, +entries: Map<&2, Maybe<&2, String>>, +target: Nat, +identity: String, +same: Bool, +selected: {Nat.is_eq(key, target) == same : Bool}, valid: {Patricia.canonical(Maybe<&2, String>, entries) == True{} : Bool}, count: {(Bool.pick(Nat, same, 1n, 0n) + ActualFrame.nat_count(ready_identity_row_ids(ReferenceFrame.identities(tail)), target) : Nat) == 1n : Nat}, head: {ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(key)) == Some{old} : Maybe<&2, String>}, tail_projected: {ActualFrame.identities(ready_identity_row_ids(ReferenceFrame.identities(tail)), entries) == Some{ReferenceFrame.identities(tail)} : Maybe<&2, List<&2, V.TargetArtifact>>}, recurse: {ActualFrame.nat_count(ready_identity_row_ids(ReferenceFrame.identities(tail)), target) == 1n : Nat} -> {ActualFrame.identities(ready_identity_row_ids(ReferenceFrame.identities(tail)), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == Some{ReferenceFrame.identities(X.store_identity(tail, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {ActualFrame.identities(key <> ready_identity_row_ids(ReferenceFrame.identities(tail)), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == Some{ReferenceFrame.identities(X.store_identity(X.TargetArtifact{key, old} <> tail, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}:
  match same:
    case True{}:
      %Equal.sym(Nat, key, target, NatFacts.eq_of_is_eq(key, target, selected)):
        {ActualFrame.identities(_ <> ready_identity_row_ids(ReferenceFrame.identities(tail)), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))
          == Some{ReferenceFrame.identities(X.store_identity(X.TargetArtifact{_, old} <> tail, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}
      ready_identity_selected_reference(ready_identity_row_ids(ReferenceFrame.identities(tail)), entries, target, identity, tail, old, valid,
        ready_nat_zero_absent(ready_identity_row_ids(ReferenceFrame.identities(tail)), target,
          Arithmetic.succ_inj(ActualFrame.nat_count(ready_identity_row_ids(ReferenceFrame.identities(tail)), target), 0n, count)), tail_projected)
    case False{}:
      %Equal.sym(Bool, Nat.is_eq(key, target), False{}, selected):
        {ActualFrame.identities(key <> ready_identity_row_ids(ReferenceFrame.identities(tail)), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))
          == Some{ReferenceFrame.identities(Bool.pick(List<&2, X.TargetArtifact>, _, X.TargetArtifact{target, identity} <> tail,
            X.TargetArtifact{key, old} <> X.store_identity(tail, target, identity)))} : Maybe<&2, List<&2, V.TargetArtifact>>}
      %Equal.sym(Maybe<&2, String>,
        ResolverCore.map_read(Maybe<&2, String>, None{}, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}), Nat.show(key)), Some{old},
        Equal.trans(Maybe<&2, String>,
          ResolverCore.map_read(Maybe<&2, String>, None{}, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}), Nat.show(key)),
          Bool.pick(Maybe<&2, String>, Nat.is_eq(key, target), Some{identity}, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(key))), Some{old},
          ready_identity_lookup_set(entries, target, key, identity, valid),
          Equal.trans(Maybe<&2, String>, Bool.pick(Maybe<&2, String>, Nat.is_eq(key, target), Some{identity}, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(key))),
            ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(key)), Some{old},
            Equal.cong(Bool, Maybe<&2, String>, test => Bool.pick(Maybe<&2, String>, test, Some{identity}, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(key))),
              Nat.is_eq(key, target), False{}, selected), head))):
        {ActualFrame.identities_prefix(ActualFrame.identity_entry(key, _),
          ActualFrame.identities(ready_identity_row_ids(ReferenceFrame.identities(tail)), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})))
          == Some{V.TargetArtifact{key, old} <> ReferenceFrame.identities(X.store_identity(tail, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}
      Equal.cong(Maybe<&2, List<&2, V.TargetArtifact>>, Maybe<&2, List<&2, V.TargetArtifact>>,
        rest => ActualFrame.identities_prefix(Some{V.TargetArtifact{key, old}}, rest),
        ActualFrame.identities(ready_identity_row_ids(ReferenceFrame.identities(tail)), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})),
        Some{ReferenceFrame.identities(X.store_identity(tail, target, identity))}, recurse(count))

def ready_identity_existing_rows(+items: List<&2, X.TargetArtifact>, +entries: Map<&2, Maybe<&2, String>>, +target: Nat, +identity: String, +valid: {Patricia.canonical(Maybe<&2, String>, entries) == True{} : Bool}, count: {ActualFrame.nat_count(ready_identity_row_ids(ReferenceFrame.identities(items)), target) == 1n : Nat}, +projected: {ActualFrame.identities(ready_identity_row_ids(ReferenceFrame.identities(items)), entries) == Some{ReferenceFrame.identities(items)} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {ActualFrame.identities(ready_identity_row_ids(ReferenceFrame.identities(items)), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == Some{ReferenceFrame.identities(X.store_identity(items, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}:
  match items:
    case []:
      Empty.absurd({ActualFrame.identities([], Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))
        == Some{ReferenceFrame.identities(X.store_identity([], target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>},
        Arithmetic.internal_succ_ne_zero(0n, Equal.sym(Nat, 0n, 1n, count)))
    case X.TargetArtifact{+key, +old} <> +tail:
      Parent.eliminate_pair(
        {ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(key)) == Some{old} : Maybe<&2, String>},
        {ActualFrame.identities(ready_identity_row_ids(ReferenceFrame.identities(tail)), entries)
          == Some{ReferenceFrame.identities(tail)} : Maybe<&2, List<&2, V.TargetArtifact>>},
        {ActualFrame.identities(key <> ready_identity_row_ids(ReferenceFrame.identities(tail)), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))
          == Some{ReferenceFrame.identities(X.store_identity(X.TargetArtifact{key, old} <> tail, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>},
        ready_identity_projection_parts(key, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(key)),
          ActualFrame.identities(ready_identity_row_ids(ReferenceFrame.identities(tail)), entries), old, ReferenceFrame.identities(tail), projected),
        head => rest => ready_identity_existing_case(key, old, tail, entries, target, identity, Nat.is_eq(key, target), {==}, valid, count, head, rest,
          tail_count => ready_identity_existing_rows(tail, entries, target, identity, valid, tail_count,
            Pair.snd(
              {ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(key)) == Some{old} : Maybe<&2, String>},
              {ActualFrame.identities(ready_identity_row_ids(ReferenceFrame.identities(tail)), entries)
                == Some{ReferenceFrame.identities(tail)} : Maybe<&2, List<&2, V.TargetArtifact>>},
              ready_identity_projection_parts(key, ResolverCore.map_read(Maybe<&2, String>, None{}, entries, Nat.show(key)),
                ActualFrame.identities(ready_identity_row_ids(ReferenceFrame.identities(tail)), entries), old, ReferenceFrame.identities(tail), projected)))))

def ready_identity_member_selected(+same: Bool, +head: Nat, +tail: List<&2, Nat>, +all: List<&2, Nat>, +query: Nat, same_key: {Nat.is_eq(head, query) == same : Bool}, head_count: {ActualFrame.nat_count(all, head) == 1n : Nat}, member: {Bool.or(same, History.has_nat(tail, query)) == True{} : Bool}, recurse: {History.has_nat(tail, query) == True{} : Bool} -> {ActualFrame.nat_count(all, query) == 1n : Nat}) -> {ActualFrame.nat_count(all, query) == 1n : Nat}:
  match same:
    case True{}:
      %NatFacts.eq_of_is_eq(head, query, same_key):
        {ActualFrame.nat_count(all, _) == 1n : Nat}
      head_count
    case False{}: recurse(member)

def ready_identity_member_count(items: List<&2, Nat>, +all: List<&2, Nat>, +query: Nat, +unique: {ActualFrame.nats_unique(items, all) == True{} : Bool}, member: {History.has_nat(items, query) == True{} : Bool}) -> {ActualFrame.nat_count(all, query) == 1n : Nat}:
  match items:
    case []:
      Empty.absurd({ActualFrame.nat_count(all, query) == 1n : Nat},
        NatFacts.internal_false_ne_true(member))
    case +head <> +tail:
      ready_identity_member_selected(Nat.is_eq(head, query), head, tail, all, query, {==},
        NatFacts.eq_of_is_eq(ActualFrame.nat_count(all, head), 1n,
          BoolFacts.eq_true_of_and_left(Nat.is_eq(ActualFrame.nat_count(all, head), 1n),
            ActualFrame.nats_unique(tail, all), unique)), member,
        tail_member => ready_identity_member_count(tail, all, query,
          BoolFacts.eq_true_of_and_right(Nat.is_eq(ActualFrame.nat_count(all, head), 1n),
            ActualFrame.nats_unique(tail, all), unique), tail_member))

def ready_identity_existing_order(+order: List<&2, Nat>, +entries: Map<&2, Maybe<&2, String>>, +target: Nat, +identity: String, +reference: List<&2, X.TargetArtifact>, valid: {Patricia.canonical(Maybe<&2, String>, entries) == True{} : Bool}, count: {ActualFrame.nat_count(order, target) == 1n : Nat}, +projected: {ActualFrame.identities(order, entries) == Some{ReferenceFrame.identities(reference)} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {ActualFrame.identities(order, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == Some{ReferenceFrame.identities(X.store_identity(reference, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}:
  %Equal.sym(List<&2, Nat>, order, ready_identity_row_ids(ReferenceFrame.identities(reference)),
    ready_identity_order_exact(order, entries, ReferenceFrame.identities(reference), projected)):
    {ActualFrame.identities(_, Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))
      == Some{ReferenceFrame.identities(X.store_identity(reference, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}
  ready_identity_existing_rows(reference, entries, target, identity, valid,
    Equal.trans(Nat, ActualFrame.nat_count(ready_identity_row_ids(ReferenceFrame.identities(reference)), target), ActualFrame.nat_count(order, target), 1n,
      Equal.cong(List<&2, Nat>, Nat, keys => ActualFrame.nat_count(keys, target), ready_identity_row_ids(ReferenceFrame.identities(reference)), order,
        Equal.sym(List<&2, Nat>, order, ready_identity_row_ids(ReferenceFrame.identities(reference)),
          ready_identity_order_exact(order, entries, ReferenceFrame.identities(reference), projected))), count),
    Equal.trans(Maybe<&2, List<&2, V.TargetArtifact>>, ActualFrame.identities(ready_identity_row_ids(ReferenceFrame.identities(reference)), entries),
      ActualFrame.identities(order, entries), Some{ReferenceFrame.identities(reference)},
      Equal.cong(List<&2, Nat>, Maybe<&2, List<&2, V.TargetArtifact>>, keys => ActualFrame.identities(keys, entries),
        ready_identity_row_ids(ReferenceFrame.identities(reference)), order,
        Equal.sym(List<&2, Nat>, order, ready_identity_row_ids(ReferenceFrame.identities(reference)),
          ready_identity_order_exact(order, entries, ReferenceFrame.identities(reference), projected))), projected))

def ready_identity_publication_case(+order: List<&2, Nat>, +entries: Map<&2, Maybe<&2, String>>, +target: Nat, +identity: String, +reference: List<&2, X.TargetArtifact>, +present: Bool, +presence: {History.has_nat(order, target) == present : Bool}, valid: {Patricia.canonical(Maybe<&2, String>, entries) == True{} : Bool}, unique: {ActualFrame.nats_unique(order, order) == True{} : Bool}, projected: {ActualFrame.identities(order, entries) == Some{ReferenceFrame.identities(reference)} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {ActualFrame.identities(History.retain_nat(order, target), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == Some{ReferenceFrame.identities(X.store_identity(reference, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}:
  match present:
    case False{}: ready_identity_new_reference(order, entries, target, identity, reference, valid, presence, projected)
    case True{}:
      %Equal.sym(Bool, History.has_nat(order, target), True{}, presence):
        {ActualFrame.identities(Bool.pick(List<&2, Nat>, _, order, List.append(&2, Nat, order, [target])),
          Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity}))
          == Some{ReferenceFrame.identities(X.store_identity(reference, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}
      ready_identity_existing_order(order, entries, target, identity, reference, valid,
        ready_identity_member_count(order, order, target, unique, presence), projected)

def ready_identity_publication(+order: List<&2, Nat>, +entries: Map<&2, Maybe<&2, String>>, +target: Nat, +identity: String, +reference: List<&2, X.TargetArtifact>, valid: {Patricia.canonical(Maybe<&2, String>, entries) == True{} : Bool}, unique: {ActualFrame.nats_unique(order, order) == True{} : Bool}, projected: {ActualFrame.identities(order, entries) == Some{ReferenceFrame.identities(reference)} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {ActualFrame.identities(History.retain_nat(order, target), Map.set(&2, Maybe<&2, String>, entries, Nat.show(target), Some{identity})) == Some{ReferenceFrame.identities(X.store_identity(reference, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}:
  ready_identity_publication_case(order, entries, target, identity, reference, History.has_nat(order, target), {==}, valid, unique, projected)

def ready_identity_order(order: V.Order) -> List<&2, Nat>:
  match order:
    case V.Order{_, _, _, _, identities, _}: identities

def ready_identity_unique_order(+order: V.Order, valid: {ActualFrame.order_valid(order) == True{} : Bool}) -> {ActualFrame.nats_unique(ready_identity_order(order), ready_identity_order(order)) == True{} : Bool}:
  match order:
    case V.Order{+pending, +targets, +ids, +captured, +identities, +visited}:
      BoolFacts.eq_true_of_and_left(ActualFrame.nats_unique(identities, identities), ActualFrame.strings_unique(visited, visited), BoolFacts.eq_true_of_and_right(ActualFrame.strings_unique(captured, captured), Bool.and(ActualFrame.nats_unique(identities, identities), ActualFrame.strings_unique(visited, visited)), BoolFacts.eq_true_of_and_right(ActualFrame.strings_unique(ids, ids), Bool.and(ActualFrame.strings_unique(captured, captured), Bool.and(ActualFrame.nats_unique(identities, identities), ActualFrame.strings_unique(visited, visited))), BoolFacts.eq_true_of_and_right(ActualFrame.nats_unique(targets, targets), Bool.and(ActualFrame.strings_unique(ids, ids), Bool.and(ActualFrame.strings_unique(captured, captured), Bool.and(ActualFrame.nats_unique(identities, identities), ActualFrame.strings_unique(visited, visited)))), BoolFacts.eq_true_of_and_right(ActualFrame.nats_unique(pending, pending), Bool.and(ActualFrame.nats_unique(targets, targets), Bool.and(ActualFrame.strings_unique(ids, ids), Bool.and(ActualFrame.strings_unique(captured, captured), Bool.and(ActualFrame.nats_unique(identities, identities), ActualFrame.strings_unique(visited, visited))))), valid)))))

def ready_identity_canonical(+frame: T.ResolverFrame, valid: {ActualReady.mutable_maps_canonical(frame) == True{} : Bool}) -> {Patricia.canonical(Maybe<&2, String>, S.frame_target_artifacts(frame)) == True{} : Bool}:
  BoolFacts.eq_true_of_and_right(Patricia.canonical(Maybe<&2, T.CapturedFacts>, S.frame_captured(frame)),
    Patricia.canonical(Maybe<&2, String>, S.frame_target_artifacts(frame)),
    BoolFacts.eq_true_of_and_right(Patricia.canonical(Maybe<&2, Local.Pending>, S.frame_pending(frame)),
      Bool.and(Patricia.canonical(Maybe<&2, T.CapturedFacts>, S.frame_captured(frame)),
        Patricia.canonical(Maybe<&2, String>, S.frame_target_artifacts(frame))), valid))

def ready_identity_publication_guarded(+frame: T.ResolverFrame, +order: V.Order, +target: Nat, +identity: String, +reference: List<&2, X.TargetArtifact>, canonical: {ActualReady.mutable_maps_canonical(frame) == True{} : Bool}, unique: {ActualFrame.order_valid(order) == True{} : Bool}, projected: {ActualFrame.identities(ready_identity_order(order), S.frame_target_artifacts(frame)) == Some{ReferenceFrame.identities(reference)} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {ActualFrame.identities(History.retain_nat(ready_identity_order(order), target), Map.set(&2, Maybe<&2, String>, S.frame_target_artifacts(frame), Nat.show(target), Some{identity})) == Some{ReferenceFrame.identities(X.store_identity(reference, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}:
  ready_identity_publication(ready_identity_order(order), S.frame_target_artifacts(frame), target, identity, reference,
    ready_identity_canonical(frame, canonical), ready_identity_unique_order(order, unique), projected)

def ready_identity_published_map(+bundled: Bool, +frame: T.ResolverFrame, +target: Nat, +path: String, +file: T.CapturedFacts, +identity: String, +plan: Local.Plan) -> {S.frame_target_artifacts(Admission.publish_child(bundled, frame, target, path, file, identity, plan)) == Map.set(&2, Maybe<&2, String>, S.frame_target_artifacts(frame), Nat.show(target), Some{identity}) : Map<&2, Maybe<&2, String>>}:
  match bundled frame:
    case False{} T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}: {==}
    case True{} T.ResolverFrame{_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}: {==}

def ready_identity_published_actual(+bundled: Bool, +frame: T.ResolverFrame, +target: Nat, +path: String, +file: T.CapturedFacts, +identity: String, +plan: Local.Plan, +order: V.Order, +reference: List<&2, X.TargetArtifact>, canonical: {ActualReady.mutable_maps_canonical(frame) == True{} : Bool}, unique: {ActualFrame.order_valid(order) == True{} : Bool}, projected: {ActualFrame.identities(ready_identity_order(order), S.frame_target_artifacts(frame)) == Some{ReferenceFrame.identities(reference)} : Maybe<&2, List<&2, V.TargetArtifact>>}) -> {ActualFrame.identities(History.retain_nat(ready_identity_order(order), target), S.frame_target_artifacts(Admission.publish_child(bundled, frame, target, path, file, identity, plan))) == Some{ReferenceFrame.identities(X.store_identity(reference, target, identity))} : Maybe<&2, List<&2, V.TargetArtifact>>}:
  Equal.trans(Maybe<&2, List<&2, V.TargetArtifact>>,
    ActualFrame.identities(History.retain_nat(ready_identity_order(order), target),
      S.frame_target_artifacts(Admission.publish_child(bundled, frame, target, path, file, identity, plan))),
    ActualFrame.identities(History.retain_nat(ready_identity_order(order), target),
      Map.set(&2, Maybe<&2, String>, S.frame_target_artifacts(frame), Nat.show(target), Some{identity})),
    Some{ReferenceFrame.identities(X.store_identity(reference, target, identity))},
    Equal.cong(Map<&2, Maybe<&2, String>>, Maybe<&2, List<&2, V.TargetArtifact>>,
      entries => ActualFrame.identities(History.retain_nat(ready_identity_order(order), target), entries),
      S.frame_target_artifacts(Admission.publish_child(bundled, frame, target, path, file, identity, plan)),
      Map.set(&2, Maybe<&2, String>, S.frame_target_artifacts(frame), Nat.show(target), Some{identity}),
      ready_identity_published_map(bundled, frame, target, path, file, identity, plan)),
    ready_identity_publication_guarded(frame, order, target, identity, reference, canonical, unique, projected))

# Successful capture publication must update the source/catalog witness at the
# same path as the actual Map. Other provenance observations are unchanged.
def ready_capture_provenance_selected(+key: String, +old: T.SourceFacts, +old_catalog: RootSpec.Source, +tail: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source, same: Bool, selected: {String.eq(path, key) == same : Bool}, recurse: {V.capture_at(History.store_capture(tail, path, source, catalog), path) == Some{V.CaptureSource{path, source, catalog}} : Maybe<&2, V.CaptureSource>}) -> {V.capture_at(Bool.pick(List<&2, V.CaptureSource>, same, V.CaptureSource{path, source, catalog} <> tail, V.CaptureSource{key, old, old_catalog} <> History.store_capture(tail, path, source, catalog)), path) == Some{V.CaptureSource{path, source, catalog}} : Maybe<&2, V.CaptureSource>}:
  match same:
    case True{}:
      Equal.cong(Bool, Maybe<&2, V.CaptureSource>, test => Bool.pick(Maybe<&2, V.CaptureSource>, test,
        Some{V.CaptureSource{path, source, catalog}}, V.capture_at(tail, path)), String.eq(path, path), True{}, StringFacts.eq_refl(path))
    case False{}:
      %Equal.sym(Bool, String.eq(path, key), False{}, selected):
        {Bool.pick(Maybe<&2, V.CaptureSource>, _, Some{V.CaptureSource{key, old, old_catalog}},
          V.capture_at(History.store_capture(tail, path, source, catalog), path)) == Some{V.CaptureSource{path, source, catalog}} : Maybe<&2, V.CaptureSource>}
      recurse

def ready_capture_provenance_at(+items: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source) -> {V.capture_at(History.store_capture(items, path, source, catalog), path) == Some{V.CaptureSource{path, source, catalog}} : Maybe<&2, V.CaptureSource>}:
  match items:
    case []:
      Equal.cong(Bool, Maybe<&2, V.CaptureSource>, test => Bool.pick(Maybe<&2, V.CaptureSource>, test,
        Some{V.CaptureSource{path, source, catalog}}, None{}), String.eq(path, path), True{}, StringFacts.eq_refl(path))
    case V.CaptureSource{+key, +old, +old_catalog} <> +tail:
      ready_capture_provenance_selected(key, old, old_catalog, tail, path, source, catalog, String.eq(path, key), {==},
        ready_capture_provenance_at(tail, path, source, catalog))

def ready_capture_provenance_other_case(+key: String, +old: T.SourceFacts, +old_catalog: RootSpec.Source, +tail: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source, +query: String, same: Bool, selected: {String.eq(path, key) == same : Bool}, +absent: {String.eq(query, path) == False{} : Bool}, recurse: {V.capture_at(History.store_capture(tail, path, source, catalog), query) == V.capture_at(tail, query) : Maybe<&2, V.CaptureSource>}) -> {V.capture_at(Bool.pick(List<&2, V.CaptureSource>, same, V.CaptureSource{path, source, catalog} <> tail, V.CaptureSource{key, old, old_catalog} <> History.store_capture(tail, path, source, catalog)), query) == V.capture_at(V.CaptureSource{key, old, old_catalog} <> tail, query) : Maybe<&2, V.CaptureSource>}:
  match same:
    case True{}:
      %StringFacts.eq_of_eq_true(path, key, selected):
        {V.capture_at(V.CaptureSource{path, source, catalog} <> tail, query)
          == V.capture_at(V.CaptureSource{_, old, old_catalog} <> tail, query) : Maybe<&2, V.CaptureSource>}
      %Equal.sym(Bool, String.eq(query, path), False{}, absent):
        {Bool.pick(Maybe<&2, V.CaptureSource>, _, Some{V.CaptureSource{path, source, catalog}}, V.capture_at(tail, query))
          == Bool.pick(Maybe<&2, V.CaptureSource>, _, Some{V.CaptureSource{path, old, old_catalog}}, V.capture_at(tail, query)) : Maybe<&2, V.CaptureSource>}
      {==}
    case False{}:
      Equal.cong(Maybe<&2, V.CaptureSource>, Maybe<&2, V.CaptureSource>, rest =>
        Bool.pick(Maybe<&2, V.CaptureSource>, String.eq(query, key), Some{V.CaptureSource{key, old, old_catalog}}, rest),
        V.capture_at(History.store_capture(tail, path, source, catalog), query), V.capture_at(tail, query), recurse)

def ready_capture_provenance_other(+items: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source, +query: String, +absent: {String.eq(query, path) == False{} : Bool}) -> {V.capture_at(History.store_capture(items, path, source, catalog), query) == V.capture_at(items, query) : Maybe<&2, V.CaptureSource>}:
  match items:
    case []:
      Equal.cong(Bool, Maybe<&2, V.CaptureSource>, test => Bool.pick(Maybe<&2, V.CaptureSource>, test,
        Some{V.CaptureSource{path, source, catalog}}, None{}), String.eq(query, path), False{}, absent)
    case V.CaptureSource{+key, +old, +old_catalog} <> +tail:
      ready_capture_provenance_other_case(key, old, old_catalog, tail, path, source, catalog, query, String.eq(path, key), {==}, absent,
        ready_capture_provenance_other(tail, path, source, catalog, query, absent))

def ready_capture_actual_other_row(+entries: Map<&2, Maybe<&2, T.CapturedFacts>>, +sources: List<&2, V.CaptureSource>, +path: String, +file: T.CapturedFacts, +source: T.SourceFacts, +catalog: RootSpec.Source, +query: String, valid: {Patricia.canonical(Maybe<&2, T.CapturedFacts>, entries) == True{} : Bool}, +absent: {String.eq(query, path) == False{} : Bool}) -> {ActualFrame.captured_entry(query, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{file}), query), V.capture_at(History.store_capture(sources, path, source, catalog), query)) == ActualFrame.captured_entry(query, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, entries, query), V.capture_at(sources, query)) : Maybe<&2, V.CapturedEntry>}:
  %Equal.sym(Maybe<&2, T.CapturedFacts>,
    ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{file}), query),
    ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, entries, query),
    Equal.trans(Maybe<&2, T.CapturedFacts>,
      ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{file}), query),
      Bool.pick(Maybe<&2, T.CapturedFacts>, String.eq(query, path), Some{file}, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, entries, query)),
      ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, entries, query),
      Payload.lookup_after_set(Maybe<&2, T.CapturedFacts>, entries, path, query, Some{file}, None{}, valid),
      Equal.cong(Bool, Maybe<&2, T.CapturedFacts>, same => Bool.pick(Maybe<&2, T.CapturedFacts>, same, Some{file},
        ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, entries, query)), String.eq(query, path), False{}, absent))):
    {ActualFrame.captured_entry(query, _, V.capture_at(History.store_capture(sources, path, source, catalog), query))
      == ActualFrame.captured_entry(query, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, entries, query), V.capture_at(sources, query))
      : Maybe<&2, V.CapturedEntry>}
  Equal.cong(Maybe<&2, V.CaptureSource>, Maybe<&2, V.CapturedEntry>, provenance =>
    ActualFrame.captured_entry(query, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, entries, query), provenance),
    V.capture_at(History.store_capture(sources, path, source, catalog), query), V.capture_at(sources, query),
    ready_capture_provenance_other(sources, path, source, catalog, query, absent))

def ready_capture_actual_selected_row(+entries: Map<&2, Maybe<&2, T.CapturedFacts>>, +sources: List<&2, V.CaptureSource>, +path: String, +file: T.CapturedFacts, +source: T.SourceFacts, +catalog: RootSpec.Source, valid: {Patricia.canonical(Maybe<&2, T.CapturedFacts>, entries) == True{} : Bool}) -> {ActualFrame.captured_entry(path, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{file}), path), V.capture_at(History.store_capture(sources, path, source, catalog), path)) == Some{V.CapturedEntry{path, file, source}} : Maybe<&2, V.CapturedEntry>}:
  %Equal.sym(Maybe<&2, T.CapturedFacts>,
    ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{file}), path), Some{file},
    Equal.trans(Maybe<&2, T.CapturedFacts>,
      ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{file}), path),
      Bool.pick(Maybe<&2, T.CapturedFacts>, String.eq(path, path), Some{file}, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, entries, path)), Some{file},
      Payload.lookup_after_set(Maybe<&2, T.CapturedFacts>, entries, path, path, Some{file}, None{}, valid),
      Equal.cong(Bool, Maybe<&2, T.CapturedFacts>, same => Bool.pick(Maybe<&2, T.CapturedFacts>, same, Some{file},
        ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, entries, path)), String.eq(path, path), True{}, StringFacts.eq_refl(path)))):
    {ActualFrame.captured_entry(path, _, V.capture_at(History.store_capture(sources, path, source, catalog), path))
      == Some{V.CapturedEntry{path, file, source}} : Maybe<&2, V.CapturedEntry>}
  Equal.cong(Maybe<&2, V.CaptureSource>, Maybe<&2, V.CapturedEntry>, provenance => ActualFrame.captured_entry(path, Some{file}, provenance),
    V.capture_at(History.store_capture(sources, path, source, catalog), path), Some{V.CaptureSource{path, source, catalog}},
    ready_capture_provenance_at(sources, path, source, catalog))

def ready_capture_reference_selected_row(+sources: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source, +bytes: Nat) -> {ReferenceFrame.captured_entry(path, source, bytes, V.capture_at(History.store_capture(sources, path, source, catalog), path)) == Some{V.CapturedEntry{path, T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceFrame.source_exports(source), bytes}, source}} : Maybe<&2, V.CapturedEntry>}:
  Equal.cong(Maybe<&2, V.CaptureSource>, Maybe<&2, V.CapturedEntry>, provenance => ReferenceFrame.captured_entry(path, source, bytes, provenance),
    V.capture_at(History.store_capture(sources, path, source, catalog), path), Some{V.CaptureSource{path, source, catalog}},
    ready_capture_provenance_at(sources, path, source, catalog))

def ready_capture_selected_correspondence(+entries: Map<&2, Maybe<&2, T.CapturedFacts>>, +sources: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source, +bytes: Nat, valid: {Patricia.canonical(Maybe<&2, T.CapturedFacts>, entries) == True{} : Bool}) -> {ActualFrame.captured_entry(path, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceFrame.source_exports(source), bytes}}), path), V.capture_at(History.store_capture(sources, path, source, catalog), path)) == ReferenceFrame.captured_entry(path, source, bytes, V.capture_at(History.store_capture(sources, path, source, catalog), path)) : Maybe<&2, V.CapturedEntry>}:
  Equal.trans(Maybe<&2, V.CapturedEntry>,
    ActualFrame.captured_entry(path,
      ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path,
        Some{T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceFrame.source_exports(source), bytes}}), path),
      V.capture_at(History.store_capture(sources, path, source, catalog), path)),
    Some{V.CapturedEntry{path, T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceFrame.source_exports(source), bytes}, source}},
    ReferenceFrame.captured_entry(path, source, bytes, V.capture_at(History.store_capture(sources, path, source, catalog), path)),
    ready_capture_actual_selected_row(entries, sources, path, T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceFrame.source_exports(source), bytes}, source, catalog, valid),
    Equal.sym(Maybe<&2, V.CapturedEntry>, ReferenceFrame.captured_entry(path, source, bytes, V.capture_at(History.store_capture(sources, path, source, catalog), path)),
      Some{V.CapturedEntry{path, T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceFrame.source_exports(source), bytes}, source}},
      ready_capture_reference_selected_row(sources, path, source, catalog, bytes)))

def ready_capture_prefix_absent(+same: Bool, +present: Bool, +head: Maybe<&2, V.CapturedEntry>, +old_head: Maybe<&2, V.CapturedEntry>, +tail: Maybe<&2, List<&2, V.CapturedEntry>>, +old_tail: Maybe<&2, List<&2, V.CapturedEntry>>, absent: {Bool.or(same, present) == False{} : Bool}, retain_head: {same == False{} : Bool} -> {head == old_head : Maybe<&2, V.CapturedEntry>}, retain_tail: {present == False{} : Bool} -> {tail == old_tail : Maybe<&2, List<&2, V.CapturedEntry>>}) -> {ActualFrame.captured_prefix(head, tail) == ActualFrame.captured_prefix(old_head, old_tail) : Maybe<&2, List<&2, V.CapturedEntry>>}:
  match same:
    case True{}:
      Empty.absurd({ActualFrame.captured_prefix(head, tail) == ActualFrame.captured_prefix(old_head, old_tail) : Maybe<&2, List<&2, V.CapturedEntry>>},
        NatFacts.internal_false_ne_true(Equal.sym(Bool, True{}, False{}, absent)))
    case False{}:
      Equal.trans(Maybe<&2, List<&2, V.CapturedEntry>>, ActualFrame.captured_prefix(head, tail),
        ActualFrame.captured_prefix(old_head, tail), ActualFrame.captured_prefix(old_head, old_tail),
        Equal.cong(Maybe<&2, V.CapturedEntry>, Maybe<&2, List<&2, V.CapturedEntry>>, row => ActualFrame.captured_prefix(row, tail),
          head, old_head, retain_head({==})),
        Equal.cong(Maybe<&2, List<&2, V.CapturedEntry>>, Maybe<&2, List<&2, V.CapturedEntry>>, rest => ActualFrame.captured_prefix(old_head, rest),
          tail, old_tail, retain_tail(absent)))

def ready_capture_actual_unaffected(+order: List<&2, String>, +entries: Map<&2, Maybe<&2, T.CapturedFacts>>, +sources: List<&2, V.CaptureSource>, +path: String, +file: T.CapturedFacts, +source: T.SourceFacts, +catalog: RootSpec.Source, +valid: {Patricia.canonical(Maybe<&2, T.CapturedFacts>, entries) == True{} : Bool}, absent: {History.has_string(order, path) == False{} : Bool}) -> {ActualFrame.captured(order, Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{file}), History.store_capture(sources, path, source, catalog)) == ActualFrame.captured(order, entries, sources) : Maybe<&2, List<&2, V.CapturedEntry>>}:
  match order:
    case []: {==}
    case +head <> +tail:
      ready_capture_prefix_absent(String.eq(head, path), History.has_string(tail, path),
        ActualFrame.captured_entry(head, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{file}), head),
          V.capture_at(History.store_capture(sources, path, source, catalog), head)),
        ActualFrame.captured_entry(head, ResolverCore.map_read(Maybe<&2, T.CapturedFacts>, None{}, entries, head), V.capture_at(sources, head)),
        ActualFrame.captured(tail, Map.set(&2, Maybe<&2, T.CapturedFacts>, entries, path, Some{file}), History.store_capture(sources, path, source, catalog)),
        ActualFrame.captured(tail, entries, sources), absent,
        different => ready_capture_actual_other_row(entries, sources, path, file, source, catalog, head, valid, different),
        rest => ready_capture_actual_unaffected(tail, entries, sources, path, file, source, catalog, valid, rest))

def ready_capture_reference_paths(items: List<&2, X.Captured>) -> List<&2, String>:
  match items:
    case []: []
    case X.Captured{path, _, _} <> tail: path <> ready_capture_reference_paths(tail)

def ready_capture_prefix_reference(+head: Maybe<&2, V.CapturedEntry>, +tail: Maybe<&2, List<&2, V.CapturedEntry>>) -> {ActualFrame.captured_prefix(head, tail) == ReferenceFrame.prefix(V.CapturedEntry, head, tail) : Maybe<&2, List<&2, V.CapturedEntry>>}:
  match head tail:
    case Some{_} Some{_}: {==}
    case Some{_} None{}: {==}
    case None{} _: {==}

def ready_capture_prefix_reference_transport(+head: Maybe<&2, V.CapturedEntry>, +tail: Maybe<&2, List<&2, V.CapturedEntry>>, +old_head: Maybe<&2, V.CapturedEntry>, +old_tail: Maybe<&2, List<&2, V.CapturedEntry>>, rows: {ActualFrame.captured_prefix(head, tail) == ActualFrame.captured_prefix(old_head, old_tail) : Maybe<&2, List<&2, V.CapturedEntry>>}) -> {ReferenceFrame.prefix(V.CapturedEntry, head, tail) == ReferenceFrame.prefix(V.CapturedEntry, old_head, old_tail) : Maybe<&2, List<&2, V.CapturedEntry>>}:
  Equal.trans(Maybe<&2, List<&2, V.CapturedEntry>>, ReferenceFrame.prefix(V.CapturedEntry, head, tail), ActualFrame.captured_prefix(head, tail),
    ReferenceFrame.prefix(V.CapturedEntry, old_head, old_tail),
    Equal.sym(Maybe<&2, List<&2, V.CapturedEntry>>, ActualFrame.captured_prefix(head, tail), ReferenceFrame.prefix(V.CapturedEntry, head, tail), ready_capture_prefix_reference(head, tail)),
    Equal.trans(Maybe<&2, List<&2, V.CapturedEntry>>, ActualFrame.captured_prefix(head, tail), ActualFrame.captured_prefix(old_head, old_tail),
      ReferenceFrame.prefix(V.CapturedEntry, old_head, old_tail), rows, ready_capture_prefix_reference(old_head, old_tail)))

def ready_capture_reference_unaffected(+items: List<&2, X.Captured>, +sources: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source, absent: {History.has_string(ready_capture_reference_paths(items), path) == False{} : Bool}) -> {ReferenceFrame.captured(items, History.store_capture(sources, path, source, catalog)) == ReferenceFrame.captured(items, sources) : Maybe<&2, List<&2, V.CapturedEntry>>}:
  match items:
    case []: {==}
    case X.Captured{+key, +old, +bytes} <> +tail:
      ready_capture_prefix_reference_transport(
        ReferenceFrame.captured_entry(key, old, bytes, V.capture_at(History.store_capture(sources, path, source, catalog), key)),
        ReferenceFrame.captured(tail, History.store_capture(sources, path, source, catalog)),
        ReferenceFrame.captured_entry(key, old, bytes, V.capture_at(sources, key)), ReferenceFrame.captured(tail, sources),
ready_capture_prefix_absent(String.eq(key, path), History.has_string(ready_capture_reference_paths(tail), path),
        ReferenceFrame.captured_entry(key, old, bytes, V.capture_at(History.store_capture(sources, path, source, catalog), key)),
        ReferenceFrame.captured_entry(key, old, bytes, V.capture_at(sources, key)),
        ReferenceFrame.captured(tail, History.store_capture(sources, path, source, catalog)), ReferenceFrame.captured(tail, sources), absent,
        different => Equal.cong(Maybe<&2, V.CaptureSource>, Maybe<&2, V.CapturedEntry>, provenance => ReferenceFrame.captured_entry(key, old, bytes, provenance),
          V.capture_at(History.store_capture(sources, path, source, catalog), key), V.capture_at(sources, key),
          ready_capture_provenance_other(sources, path, source, catalog, key, different)),
        rest => ready_capture_reference_unaffected(tail, sources, path, source, catalog, rest)))

def ready_capture_observed_head(rows: Maybe<&2, List<&2, V.CapturedEntry>>) -> Maybe<&2, V.CapturedEntry>:
  match rows:
    case Some{head <> _}: Some{head}
    case _: None{}

def ready_capture_observed_tail(rows: Maybe<&2, List<&2, V.CapturedEntry>>) -> Maybe<&2, List<&2, V.CapturedEntry>>:
  match rows:
    case Some{_ <> tail}: Some{tail}
    case _: None{}

def ready_capture_prefix_parts(+head: Maybe<&2, V.CapturedEntry>, +tail: Maybe<&2, List<&2, V.CapturedEntry>>, +row: V.CapturedEntry, +rows: List<&2, V.CapturedEntry>, +projected: {ReferenceFrame.prefix(V.CapturedEntry, head, tail) == Some{row <> rows} : Maybe<&2, List<&2, V.CapturedEntry>>}) -> {head == Some{row} : Maybe<&2, V.CapturedEntry>} & {tail == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}:
  match head tail:
    case Some{+value} Some{+rest}:
      Tuple{Equal.cong(Maybe<&2, List<&2, V.CapturedEntry>>, Maybe<&2, V.CapturedEntry>, ready_capture_observed_head,
        Some{value <> rest}, Some{row <> rows}, projected),
        Equal.cong(Maybe<&2, List<&2, V.CapturedEntry>>, Maybe<&2, List<&2, V.CapturedEntry>>, ready_capture_observed_tail,
          Some{value <> rest}, Some{row <> rows}, projected)}
    case None{} _:
      Empty.absurd({None{} == Some{row} : Maybe<&2, V.CapturedEntry>} & {tail == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>},
        Contents.none_some(List<&2, V.CapturedEntry>, row <> rows, projected))
    case Some{_} None{}:
      Empty.absurd({head == Some{row} : Maybe<&2, V.CapturedEntry>} & {None{} == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>},
        Contents.none_some(List<&2, V.CapturedEntry>, row <> rows, projected))

def ready_capture_common_cons(-Result: Type, +actual_head: Maybe<&2, V.CapturedEntry>, +actual_tail: Maybe<&2, List<&2, V.CapturedEntry>>, +reference_head: Maybe<&2, V.CapturedEntry>, +reference_tail: Maybe<&2, List<&2, V.CapturedEntry>>, +rows: List<&2, V.CapturedEntry>, actual: {ActualFrame.captured_prefix(actual_head, actual_tail) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}, reference: {ReferenceFrame.prefix(V.CapturedEntry, reference_head, reference_tail) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}, continue: @row: V.CapturedEntry -> @rest: List<&2, V.CapturedEntry> -> {actual_head == Some{row} : Maybe<&2, V.CapturedEntry>} -> {actual_tail == Some{rest} : Maybe<&2, List<&2, V.CapturedEntry>>} -> {reference_head == Some{row} : Maybe<&2, V.CapturedEntry>} -> {reference_tail == Some{rest} : Maybe<&2, List<&2, V.CapturedEntry>>} -> Result) -> Result:
  match actual_head actual_tail:
    case Some{+row} Some{+rest}:
      Parent.eliminate_pair({reference_head == Some{row} : Maybe<&2, V.CapturedEntry>},
        {reference_tail == Some{rest} : Maybe<&2, List<&2, V.CapturedEntry>>}, Result,
        ready_capture_prefix_parts(reference_head, reference_tail, row, rest,
          Equal.trans(Maybe<&2, List<&2, V.CapturedEntry>>, ReferenceFrame.prefix(V.CapturedEntry, reference_head, reference_tail), Some{rows}, Some{row <> rest},
            reference, Equal.sym(Maybe<&2, List<&2, V.CapturedEntry>>, Some{row <> rest}, Some{rows}, actual))),
        head => tail => continue(row)(rest)({==})({==})(head)(tail))
    case None{} _: Empty.absurd(Result, Contents.none_some(List<&2, V.CapturedEntry>, rows, actual))
    case Some{_} None{}: Empty.absurd(Result, Contents.none_some(List<&2, V.CapturedEntry>, rows, actual))

def ready_capture_tail_zero(+count: Nat, bound: NatFacts.le((1n + count : Nat), 1n)) -> {count == 0n : Nat}:
  match count:
    case 0n: {==}
    case 1n+more: Empty.absurd({(1n + more : Nat) == 0n : Nat}, NatFacts.internal_false_ne_true(bound))

def ready_string_zero_absent(+items: List<&2, String>, +query: String, zero: {ActualFrame.string_count(items, query) == 0n : Nat}) -> {History.has_string(items, query) == False{} : Bool}:
  match items:
    case []: {==}
    case +head <> +tail:
      ready_nat_zero_absent_case(String.eq(head, query), ActualFrame.string_count(tail, query), History.has_string(tail, query), zero,
        rest => ready_string_zero_absent(tail, query, rest))

def ready_capture_retain_selected(+head: String, +tail: List<&2, String>, +path: String, present: Bool) -> {Bool.pick(List<&2, String>, present, head <> tail, head <> List.append(&2, String, tail, [path])) == head <> Bool.pick(List<&2, String>, present, tail, List.append(&2, String, tail, [path])) : List<&2, String>}:
  match present:
    case True{}: {==}
    case False{}: {==}

def ready_capture_retain_false(+head: String, +tail: List<&2, String>, +path: String, different: {String.eq(head, path) == False{} : Bool}) -> {History.retain_string(head <> tail, path) == head <> History.retain_string(tail, path) : List<&2, String>}:
  %Equal.sym(Bool, String.eq(head, path), False{}, different):
    {Bool.pick(List<&2, String>, Bool.or(_, History.has_string(tail, path)), head <> tail, head <> List.append(&2, String, tail, [path]))
      == head <> Bool.pick(List<&2, String>, History.has_string(tail, path), tail, List.append(&2, String, tail, [path])) : List<&2, String>}
  ready_capture_retain_selected(head, tail, path, History.has_string(tail, path))

def ready_capture_prefix_join(+actual: Maybe<&2, V.CapturedEntry>, +actual_tail: Maybe<&2, List<&2, V.CapturedEntry>>, +reference: Maybe<&2, V.CapturedEntry>, +reference_tail: Maybe<&2, List<&2, V.CapturedEntry>>, head: {actual == reference : Maybe<&2, V.CapturedEntry>}, tail: {actual_tail == reference_tail : Maybe<&2, List<&2, V.CapturedEntry>>}) -> {ActualFrame.captured_prefix(actual, actual_tail) == ReferenceFrame.prefix(V.CapturedEntry, reference, reference_tail) : Maybe<&2, List<&2, V.CapturedEntry>>}:
