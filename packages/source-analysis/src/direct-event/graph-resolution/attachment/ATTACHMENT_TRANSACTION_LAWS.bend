          visited_positive(order, entries, observed, ready), observed_lookup_positive(entries, query, lookup)))

def visited_absent_lookup(+order: List<&2, String>, +entries: Map<&2, Bool>, +observed: List<&2, String>, +query: String, ready: {ActualFrame.visited(order, entries) == Some{observed} : Maybe<&2, List<&2, String>>}, unique: {ActualFrame.strings_unique(order, order) == True{} : Bool}, same_size: {Nat.is_eq(List.length(&2, String, order), List.length(&2, String, Map.keys(&2, Bool, entries))) == True{} : Bool}, absent: {List.contains(String, String.eq, order, query) == False{} : Bool}) -> {Local.map_result(Bool, Map.get(Bool, False{}, entries, query)) == False{} : Bool}:
  visited_absent_selected(Local.map_result(Bool, Map.get(Bool, False{}, entries, query)), order, entries, observed, query,
