def ready_attachment_witness(+state: T.ResolverState, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase) -> Type:
  Exists(T.ResolverFrame, frame => Exists(T.TentativeChild, child => Exists(Local.Pending, edge =>
    {S.state_frame(state) == Some{frame} : Maybe<&2, T.ResolverFrame>} &
    {S.scratch_tentative(S.state_scratch(state)) == Some{child} : Maybe<&2, T.TentativeChild>} &
    {S.scratch_pending_edge(S.state_scratch(state)) == Some{edge} : Maybe<&2, Local.Pending>} &
    ready_selected_parent_result(child, history, child_history, phase, frame, edge, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(child))))) &
    ready_selected_pending_result(child, history, child_history, phase, frame))))

def ready_attachment_from_original(+state: T.ResolverState, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +ready: {ActualReady.project(state, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> ready_attachment_witness(state, history, child_history, phase):
  ready_actual_inputs(ready_attachment_witness(state, history, child_history, phase), state, history, child_history, phase, ready,
    frame => child => edge => frame_present => child_present => edge_present => selected =>
    +frame = frame
    +child = child
    +edge = edge
    +frame_present = frame_present
    +child_present = child_present
    +edge_present = edge_present
    +installed: {ActualReady.parts(state, Some{frame}, Some{child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>} =
      ready_actual_parts_installed(state, history, child_history, phase, frame, child, edge, frame_present, child_present, edge_present, ready)
    Tuple{frame, Tuple{child, Tuple{edge, Tuple{frame_present, Tuple{child_present, Tuple{edge_present, Tuple{
      ready_selected_parent(child, history, child_history, phase, state, frame, edge, Bool.and(Bool.not(Attach.bundled_edge(edge)), Local.map_result(Bool, Map.get(Bool, False{}, S.frame_visited(frame), ready_actual_identity(child)))), installed),
      ready_selected_pending(child, history, child_history, phase, state, frame, edge, installed)}}}}}}})

def ready_frame_coordinates(+actual: T.ResolverFrame, view: V.Frame) -> Type:
  match view:
    case V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, budget, node, edge, _, _, _, _, _}:
      {V.actual_budget(S.frame_budget(actual)) == budget : V.Budget} &
      {S.frame_next_node(actual) == node : Nat} &
      {S.frame_next_edge(actual) == edge : Nat}

def ready_frame_view_coordinates(+forest: Maybe<&2, F.Forest>, +pending: Maybe<&2, List<&2, V.PendingEntry>>, +targets: Maybe<&2, List<&2, V.TargetEntry>>, +ids: Maybe<&2, List<&2, V.TargetId>>, +captured: Maybe<&2, List<&2, V.CapturedEntry>>, +identities: Maybe<&2, List<&2, V.TargetArtifact>>, +visited: Maybe<&2, List<&2, String>>, +actual: T.ResolverFrame, +remaining: Nat, +episode: Nat, +view: V.Frame, ready: {ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, actual, remaining, episode) == Some{view} : Maybe<&2, V.Frame>}) -> ready_frame_coordinates(actual, view):
  match forest pending targets ids captured identities visited actual:
    case Some{+forest_value} Some{+pending_value} Some{+targets_value} Some{+ids_value} Some{+captured_value} Some{+identities_value} Some{+visited_value}
      T.ResolverFrame{branch, limits, graph, command, deps, _, _, _, _, budget, node, edge, target, artifact, _, _, _, _, _, artifacts}:
      %Count.some_equal(V.Frame, V.Frame{branch, limits, graph, command, deps, forest_value, pending_value, targets_value, ids_value, captured_value, identities_value, visited_value, V.actual_budget(budget), node, edge, target, artifact, artifacts, remaining, episode}, view, ready):
        ready_frame_coordinates(actual, _)
      Tuple{{==}, Tuple{{==}, {==}}}
    case None{} _ _ _ _ _ _ _:
      Empty.absurd(ready_frame_coordinates(actual, view), Contents.none_some(V.Frame, view, ready))
    case Some{_} None{} _ _ _ _ _ _:
      Empty.absurd(ready_frame_coordinates(actual, view), Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} None{} _ _ _ _ _:
      Empty.absurd(ready_frame_coordinates(actual, view), Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} None{} _ _ _ _:
      Empty.absurd(ready_frame_coordinates(actual, view), Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} Some{_} None{} _ _ _:
      Empty.absurd(ready_frame_coordinates(actual, view), Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} Some{_} Some{_} None{} _ _:
      Empty.absurd(ready_frame_coordinates(actual, view), Contents.none_some(V.Frame, view, ready))
    case Some{_} Some{_} Some{_} Some{_} Some{_} Some{_} None{} _:
      Empty.absurd(ready_frame_coordinates(actual, view), Contents.none_some(V.Frame, view, ready))

def ready_child_coordinates(child: T.TentativeChild, history: Phase.ChildHistory, view: Phase.Child) -> Type:
  match child history view:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, budget}, _, _, _}
        Phase.ChildHistory{F.Created{_, _, addresses}, source, catalog, _, _}
        Phase.Child{_, _, _, _, _, _, _, _, _, _, observed_addresses, _, _, observed_budget, observed_source, observed_catalog}:
      {V.actual_budget(budget) == observed_budget : V.Budget} &
      {addresses == observed_addresses : List<&2, F.AddressEntry>} &
      {source == observed_source : T.SourceFacts} &
      {catalog == observed_catalog : RootSpec.Source}

def ready_child_view_coordinates(+forest: Maybe<&2, F.Forest>, +pending: Maybe<&2, List<&2, V.PendingPayload>>, +visited: Maybe<&2, List<&2, String>>, +child: T.TentativeChild, +edge: Local.Pending, +history: Phase.ChildHistory, +view: Phase.Child, ready: {ActualReady.child_view(forest, pending, visited, child, edge, history) == Some{view} : Maybe<&2, Phase.Child>}) -> ready_child_coordinates(child, history, view):
  match forest pending visited child history:
    case Some{+forest_value} Some{+pending_value} Some{+visited_value}
      T.TentativeChild{target, +path, capture, bytes, file, artifact, identity, before, Local.Plan{_, _, _, _, _, budget}, _, _, _}
      Phase.ChildHistory{F.Created{_, _, addresses}, source, catalog, _, _}:
      %Count.some_equal(Phase.Child, Phase.Child{target, path, ActualReady.edge_kind(edge, path), capture, bytes, file,
          artifact, identity, before, forest_value, addresses, pending_value, visited_value, V.actual_budget(budget), source, catalog}, view, ready):
        ready_child_coordinates(child, history, _)
      Tuple{{==}, Tuple{{==}, Tuple{{==}, {==}}}}
    case None{} _ _ _ _:
      Empty.absurd(ready_child_coordinates(child, history, view), Contents.none_some(Phase.Child, view, ready))
    case Some{_} None{} _ _ _:
      Empty.absurd(ready_child_coordinates(child, history, view), Contents.none_some(Phase.Child, view, ready))
    case Some{_} Some{_} None{} _ _:
      Empty.absurd(ready_child_coordinates(child, history, view), Contents.none_some(Phase.Child, view, ready))

def ready_projected_frame_coordinates(+frame: T.ResolverFrame, +history: V.History, +view: V.Frame, ready: {ActualFrame.projected(frame, history) == Some{view} : Maybe<&2, V.Frame>}) -> ready_frame_coordinates(frame, view):
  match history:
    case V.History{+addresses, V.Order{+pending_order, +target_order, +id_order, +capture_order, +identity_order, +visited_order}, +sources, +captures, _, +remaining, +episode}:
      ready_frame_view_coordinates(ActualFrame.forest_valid(P.project(S.frame_root(frame), S.frame_nodes(frame), S.frame_references(frame), S.frame_artifacts(frame), addresses), episode), ActualFrame.pending(pending_order, S.frame_pending(frame), sources, addresses), ActualFrame.targets(target_order, S.frame_target_paths(frame), addresses), ActualFrame.ids(id_order, S.frame_target_ids(frame)), ActualFrame.captured(capture_order, S.frame_captured(frame), captures), ActualFrame.identities(identity_order, S.frame_target_artifacts(frame)), ActualFrame.visited(visited_order, S.frame_visited(frame)), frame, remaining, episode, view, ready)

def ready_projected_child_coordinates(+child: T.TentativeChild, +edge: Local.Pending, +history: Phase.ChildHistory, +artifacts: List<&2, T.ArtifactEntry>, +episode: Nat, +view: Phase.Child, ready: {ActualReady.child_projected(child, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}) -> ready_child_coordinates(child, history, view):
  match child history:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{+root, +nodes, +slots, +items, +visited, _}, _, _, _}
        Phase.ChildHistory{F.Created{_, _, +addresses}, _, _, _, +order}:
      ready_child_view_coordinates(ActualReady.valid_forest(P.project(root, nodes, slots, artifacts, addresses), episode),
        ActualReady.pending(items, addresses), ActualReady.visited_complete(order, visited), child, edge, history, view, ready)

def ready_selected_coordinates(+child: T.TentativeChild, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +state: T.ResolverState, +frame: T.ResolverFrame, +edge: Local.Pending, +ready: {ActualReady.parts(state, Some{frame}, Some{child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> (ready_frame_coordinates(frame, ready_phase_frame(phase)) & ready_child_coordinates(child, child_history, ready_phase_child(phase))):
  match child history child_history phase:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{+child_root, +child_nodes, +child_slots, +items, +child_visited, +child_budget}, _, _, _} V.History{+addresses, V.Order{+order, +targets, +ids, +captures, +identities, +visited}, +sources, +capture_sources, _, +remaining, +episode} Phase.ChildHistory{F.Created{_, _, +child_addresses}, +source, +catalog, _, +child_order} Phase.Phase{V.Frame{_, _, _, _, _, +parent_forest, +old_rows, +target_rows, +id_rows, +captured_rows, +identity_rows, +visited_rows, _, _, _, _, _, _, _, _}, Phase.Child{_, _, _, _, _, _, _, _, _, +child_forest, _, +payloads, _, _, _, _}, _}:
      Parent.eliminate_pair({Bool.and(ActualReady.mutable_maps_canonical(frame), Bool.and(ActualReady.fresh_registration(history, frame), Bool.and(Nat.is_gt(remaining, 0n), ActualReady.selected_slot(edge, S.frame_references(frame))))) == True{} : Bool}, {ActualFrame.project(frame, history) == Some{ready_phase_frame(phase)} : Maybe<&2, V.Frame>} & {ActualReady.child_project(child, edge, child_history, S.frame_artifacts(frame), episode) == Some{ready_phase_child(phase)} : Maybe<&2, Phase.Child>} & {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{ready_phase_capsule(phase)} : Maybe<&2, Phase.Capsule>}, (ready_frame_coordinates(frame, ready_phase_frame(phase)) & ready_child_coordinates(child, child_history, ready_phase_child(phase))),
        selected_phase_contents(state, frame, child, edge, history, child_history, phase, ready),
        valid => observations =>
        +valid = valid
        Parent.eliminate_pair({ActualFrame.project(frame, history) == Some{ready_phase_frame(phase)} : Maybe<&2, V.Frame>}, {ActualReady.child_project(child, edge, child_history, S.frame_artifacts(frame), episode) == Some{ready_phase_child(phase)} : Maybe<&2, Phase.Child>} & {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{ready_phase_capsule(phase)} : Maybe<&2, Phase.Capsule>}, (ready_frame_coordinates(frame, ready_phase_frame(phase)) & ready_child_coordinates(child, child_history, ready_phase_child(phase))), observations,
          frame_ready => child_observations =>
          Parent.eliminate_pair({ActualReady.child_project(child, edge, child_history, S.frame_artifacts(frame), episode) == Some{ready_phase_child(phase)} : Maybe<&2, Phase.Child>}, {ActualReady.capsule(S.state_clock(state), S.state_language(state), S.scratch_active_target(S.state_scratch(state)), V.pending_payload(edge, addresses), state) == Some{ready_phase_capsule(phase)} : Maybe<&2, Phase.Capsule>}, (ready_frame_coordinates(frame, ready_phase_frame(phase)) & ready_child_coordinates(child, child_history, ready_phase_child(phase))), child_observations,
            child_ready => capsule_ready =>
            Parent.eliminate_pair({frame_checks(frame, history) == True{} : Bool},
              {ActualFrame.projected(frame, history) == Some{ready_phase_frame(phase)} : Maybe<&2, V.Frame>}, (ready_frame_coordinates(frame, ready_phase_frame(phase)) & ready_child_coordinates(child, child_history, ready_phase_child(phase))),
              actual_frame_contents(frame, history, ready_phase_frame(phase), frame_ready),
              checks => frame_projected =>
              +checks = checks
              +frame_projected = frame_projected
              Parent.eliminate_pair({child_checks(child) == True{} : Bool},
                {ActualReady.child_projected(child, edge, child_history, S.frame_artifacts(frame), episode) == Some{ready_phase_child(phase)} : Maybe<&2, Phase.Child>}, (ready_frame_coordinates(frame, ready_phase_frame(phase)) & ready_child_coordinates(child, child_history, ready_phase_child(phase))),
                actual_child_contents(child, edge, child_history, S.frame_artifacts(frame), episode, ready_phase_child(phase), child_ready),
                child_checks => child_projected =>
                +child_checks = child_checks
                +child_projected = child_projected
                Tuple{ready_projected_frame_coordinates(frame, history, ready_phase_frame(phase), frame_projected),
                  ready_projected_child_coordinates(child, edge, child_history, S.frame_artifacts(frame), episode, ready_phase_child(phase), child_projected)})))))

def ready_history_coordinate_transport(+history: V.History, +addresses: List<&2, F.AddressEntry>, +observed_addresses: List<&2, F.AddressEntry>, +node: Nat, +observed_node: Nat, +edge: Nat, +observed_edge: Nat, +pending: List<&2, V.PendingPayload>, +source: T.SourceFacts, +observed_source: T.SourceFacts, +catalog: RootSpec.Source, +observed_catalog: RootSpec.Source, addresses_equal: {addresses == observed_addresses : List<&2, F.AddressEntry>}, node_equal: {node == observed_node : Nat}, edge_equal: {edge == observed_edge : Nat}, source_equal: {source == observed_source : T.SourceFacts}, catalog_equal: {catalog == observed_catalog : RootSpec.Source}) -> {History.extend(history, observed_addresses, observed_node, History.ids(pending, observed_edge), observed_source, observed_catalog) == History.extend(history, addresses, node, History.ids(pending, edge), source, catalog) : V.History}:
  %addresses_equal: {History.extend(history, _, observed_node, History.ids(pending, observed_edge), observed_source, observed_catalog) == History.extend(history, addresses, node, History.ids(pending, edge), source, catalog) : V.History}
  %node_equal: {History.extend(history, addresses, _, History.ids(pending, observed_edge), observed_source, observed_catalog) == History.extend(history, addresses, node, History.ids(pending, edge), source, catalog) : V.History}
  %edge_equal: {History.extend(history, addresses, node, History.ids(pending, _), observed_source, observed_catalog) == History.extend(history, addresses, node, History.ids(pending, edge), source, catalog) : V.History}
  %source_equal: {History.extend(history, addresses, node, History.ids(pending, edge), _, observed_catalog) == History.extend(history, addresses, node, History.ids(pending, edge), source, catalog) : V.History}
  %catalog_equal: {History.extend(history, addresses, node, History.ids(pending, edge), source, _) == History.extend(history, addresses, node, History.ids(pending, edge), source, catalog) : V.History}
  {==}

def ready_measurement_history_result(+frame: T.ResolverFrame, +history: V.History, child_history: Phase.ChildHistory, +phase: Phase.Phase) -> Type:
  match child_history phase:
    case Phase.ChildHistory{F.Created{_, _, addresses}, source, catalog, _, _}
        Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, _, _, pending, _, _, _, _}, _}:
      {History.measurement(phase, history) == History.extend(history, addresses, S.frame_next_node(frame), History.ids(pending, S.frame_next_edge(frame)), source, catalog) : V.History}

def ready_measurement_history_coordinates(+frame: T.ResolverFrame, +child: T.TentativeChild, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, coordinates: ready_frame_coordinates(frame, ready_phase_frame(phase)) & ready_child_coordinates(child, child_history, ready_phase_child(phase))) -> ready_measurement_history_result(frame, history, child_history, phase):
  match child child_history phase:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, +budget}, _, _, _}
        Phase.ChildHistory{F.Created{_, _, +addresses}, +source, +catalog, _, _}
        Phase.Phase{V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, +frame_budget, +node, +edge, _, _, _, _, _},
          Phase.Child{_, _, _, _, _, _, _, _, _, _, +observed_addresses, +pending, _, +child_budget, +observed_source, +observed_catalog}, _}:
      match coordinates:
        case ((_, (node_equal, edge_equal)), (_, (addresses_equal, (source_equal, catalog_equal)))):
          ready_history_coordinate_transport(history, addresses, observed_addresses, S.frame_next_node(frame), node, S.frame_next_edge(frame), edge,
            pending, source, observed_source, catalog, observed_catalog, addresses_equal, node_equal, edge_equal, source_equal, catalog_equal)

def ready_selected_measurement_history(+child: T.TentativeChild, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +state: T.ResolverState, +frame: T.ResolverFrame, +edge: Local.Pending, ready: {ActualReady.parts(state, Some{frame}, Some{child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> ready_measurement_history_result(frame, history, child_history, phase):
  ready_measurement_history_coordinates(frame, child, history, child_history, phase,
    ready_selected_coordinates(child, history, child_history, phase, state, frame, edge, ready))

def ready_retained_budget_result(+frame: T.ResolverFrame, child: T.TentativeChild) -> Type:
  match child:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, budget}, _, _, _}:
      {V.actual_budget(budget) == V.actual_budget(S.frame_budget(frame)) : V.Budget}

def ready_retained_budget_coordinates(+frame: T.ResolverFrame, +child: T.TentativeChild, +child_history: Phase.ChildHistory, +phase: Phase.Phase, coordinates: ready_frame_coordinates(frame, ready_phase_frame(phase)) & ready_child_coordinates(child, child_history, ready_phase_child(phase)), coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> ready_retained_budget_result(frame, child):
  match child child_history phase:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, +budget}, _, _, _}
        Phase.ChildHistory{F.Created{_, _, _}, _, _, _, _}
        Phase.Phase{V.Frame{_, _, _, _, _, _, _, _, _, _, _, _, +frame_budget, _, _, _, _, _, _, _},
          Phase.Child{_, _, _, _, _, _, _, _, _, _, _, _, _, +child_budget, _, _}, _}:
      match coordinates:
        case ((frame_equal, _), (child_equal, _)):
          Equal.trans(V.Budget, V.actual_budget(budget), child_budget, V.actual_budget(S.frame_budget(frame)), child_equal,
            Equal.trans(V.Budget, child_budget, frame_budget, V.actual_budget(S.frame_budget(frame)),
              Equal.sym(V.Budget, frame_budget, child_budget, coherent),
              Equal.sym(V.Budget, V.actual_budget(S.frame_budget(frame)), frame_budget, frame_equal)))

def ready_selected_retained_budget(+child: T.TentativeChild, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +state: T.ResolverState, +frame: T.ResolverFrame, +edge: Local.Pending, ready: {ActualReady.parts(state, Some{frame}, Some{child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}, coherent: {Contract.phase_frame_budget(phase) == Contract.phase_child_budget(phase) : V.Budget}) -> ready_retained_budget_result(frame, child):
  ready_retained_budget_coordinates(frame, child, child_history, phase,
    ready_selected_coordinates(child, history, child_history, phase, state, frame, edge, ready), coherent)

def ready_selected_frame_contents(+child: T.TentativeChild, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +state: T.ResolverState, +frame: T.ResolverFrame, +edge: Local.Pending, evidence: selected_phase_result(state, frame, child, edge, history, child_history, phase)) -> {frame_checks(frame, history) == True{} : Bool} & {ActualFrame.projected(frame, history) == Some{ready_phase_frame(phase)} : Maybe<&2, V.Frame>}:
  match history phase:
    case V.History{_, _, _, _, _, _, _} Phase.Phase{_, _, _}:
      match evidence:
        case (_, (frame_ready, _)):
          actual_frame_contents(frame, history, ready_phase_frame(phase), frame_ready)

def ready_selected_frame_observed(+child: T.TentativeChild, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +state: T.ResolverState, +frame: T.ResolverFrame, +edge: Local.Pending, ready: {ActualReady.parts(state, Some{frame}, Some{child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {frame_checks(frame, history) == True{} : Bool} & {ActualFrame.projected(frame, history) == Some{ready_phase_frame(phase)} : Maybe<&2, V.Frame>}:
  ready_selected_frame_contents(child, history, child_history, phase, state, frame, edge,
    selected_phase_contents(state, frame, child, edge, history, child_history, phase, ready))

def ready_frame_checked_offset(+frame: T.ResolverFrame, +history: V.History, checks: {frame_checks(frame, history) == True{} : Bool}) -> {S.frame_next_node(frame) == List.length(&2, Local.PlannedNode, S.frame_nodes(frame)) : Nat}:
  match history:
    case V.History{_, +order, _, _, _, _, _}:
      NatFacts.eq_of_is_eq(S.frame_next_node(frame), List.length(&2, Local.PlannedNode, S.frame_nodes(frame)),
        BoolFacts.eq_true_of_and_left(Nat.is_eq(S.frame_next_node(frame), List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), ActualFrame.catalog_valid(S.frame_artifacts(frame)),
          BoolFacts.eq_true_of_and_right(ActualFrame.dense(S.frame_nodes(frame), 0n), Bool.and(Nat.is_eq(S.frame_next_node(frame), List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), ActualFrame.catalog_valid(S.frame_artifacts(frame))),
            BoolFacts.eq_true_of_and_right(ActualFrame.coverage(order, frame), Bool.and(ActualFrame.dense(S.frame_nodes(frame), 0n), Bool.and(Nat.is_eq(S.frame_next_node(frame), List.length(&2, Local.PlannedNode, S.frame_nodes(frame))), ActualFrame.catalog_valid(S.frame_artifacts(frame)))), checks))))

def ready_selected_offset(+child: T.TentativeChild, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +state: T.ResolverState, +frame: T.ResolverFrame, +edge: Local.Pending, ready: {ActualReady.parts(state, Some{frame}, Some{child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {S.frame_next_node(frame) == List.length(&2, Local.PlannedNode, S.frame_nodes(frame)) : Nat}:
  ready_frame_checked_offset(frame, history,
    Pair.fst({frame_checks(frame, history) == True{} : Bool}, {ActualFrame.projected(frame, history) == Some{ready_phase_frame(phase)} : Maybe<&2, V.Frame>},
      ready_selected_frame_observed(child, history, child_history, phase, state, frame, edge, ready)))

def ready_registration_history_result(+frame: T.ResolverFrame, +history: V.History, child_history: Phase.ChildHistory, +phase: Phase.Phase) -> Type:
  match child_history phase:
    case Phase.ChildHistory{F.Created{_, _, addresses}, source, catalog, _, _}
        Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, _, _, pending, _, _, _, _}, _}:
      {History.measurement(phase, history) == History.extend(history, addresses, List.length(&2, Local.PlannedNode, S.frame_nodes(frame)), History.ids(pending, S.frame_next_edge(frame)), source, catalog) : V.History}

def ready_selected_registration_history(+child: T.TentativeChild, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, +state: T.ResolverState, +frame: T.ResolverFrame, +edge: Local.Pending, +ready: {ActualReady.parts(state, Some{frame}, Some{child}, Some{edge}, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> ready_registration_history_result(frame, history, child_history, phase):
  match child_history phase:
    case Phase.ChildHistory{F.Created{_, _, +addresses}, +source, +catalog, _, _}
        Phase.Phase{_, Phase.Child{_, _, _, _, _, _, _, _, _, _, _, +pending, _, _, _, _}, _}:
