      ready_reference_capture_prefix_some(ReferenceFrame.captured_entry(key, old, old_bytes, V.capture_at(History.store_capture(sources, path, source, catalog), key)), ReferenceFrame.captured(X.store_capture(tail, path, source, bytes), History.store_capture(sources, path, source, catalog)),
