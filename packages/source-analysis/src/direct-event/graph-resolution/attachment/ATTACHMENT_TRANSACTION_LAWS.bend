def ready_reference_projected(+state: D.State, +history: V.History, +view: V.Frame, ready: {ReferenceFrame.project(state, history) == Some{view} : Maybe<&2, V.Frame>}) -> {ReferenceFrame.visited(ready_history_visited(history), ready_reference_visited(state)) == Some{ready_view_visited(view)} : Maybe<&2, List<&2, String>>}:
