def ready_visited_validated_projection(+valid: Bool, +order: List<&2, String>, +entries: Map<&2, Bool>, +rows: List<&2, String>, projected: {ActualReady.visited_validated(valid, order, entries) == Some{rows} : Maybe<&2, List<&2, String>>}) -> {ActualFrame.visited(order, entries) == Some{rows} : Maybe<&2, List<&2, String>>}:
  match valid:
    case True{}: projected
    case False{}: Empty.absurd({ActualFrame.visited(order, entries) == Some{rows} : Maybe<&2, List<&2, String>>}, Contents.none_some(List<&2, String>, rows, projected))

def ready_visited_completed_rows(+order: List<&2, String>, +entries: Map<&2, Bool>, +rows: List<&2, String>, projected: {ActualReady.visited_complete(order, entries) == Some{rows} : Maybe<&2, List<&2, String>>}) -> {ActualFrame.visited(rows, entries) == Some{rows} : Maybe<&2, List<&2, String>>}:
  +observed: {ActualFrame.visited(order, entries) == Some{rows} : Maybe<&2, List<&2, String>>} =
    ready_visited_validated_projection(Bool.and(ActualFrame.strings_unique(order, order), Nat.is_eq(List.length(&2, String, order), List.length(&2, String, Map.keys(&2, Bool, entries)))), order, entries, rows, projected)
  Equal.trans(Maybe<&2, List<&2, String>>, ActualFrame.visited(rows, entries), ActualFrame.visited(order, entries), Some{rows},
    Equal.cong(List<&2, String>, Maybe<&2, List<&2, String>>, values => ActualFrame.visited(values, entries), rows, order, Equal.sym(List<&2, String>, order, rows, ready_visited_order_exact(order, entries, rows, observed))), observed)


