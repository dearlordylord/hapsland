def ready_child_view_visited(view: Phase.Child) -> List<&2, String>:
  ready_child_visited(view)

def ready_reference_child_visited(child: X.Child) -> Map<&2, Bool>:
  match child:
    case X.Child{_, _, Signed.State{Recursive.State{values, _, _, _}, _}, _}: values

def ready_reference_child_visited_rows(+child: X.Child, +history: Phase.ChildHistory, +visited: Maybe<&2, List<&2, String>>, +view: Phase.Child, ready: {ReferenceReady.child_view(child, history, visited) == Some{view} : Maybe<&2, Phase.Child>}) -> {visited == Some{ready_child_view_visited(view)} : Maybe<&2, List<&2, String>>}:
  match child history visited:
    case X.Child{
      X.Attempt{
        +target,
        edge,
        +kind,
        +source,
        +bytes,
        name,
        expected,
        Local.Declaration{+handle, +identity, function, bundled, references, +source_path},
        +catalog,
        +before
      },
      F.Created{root, nodes, addresses},
      Signed.State{Recursive.State{_, budget, _, _}, signed},
      edges
    }
      Phase.ChildHistory{_, _, _, capture, _} Some{+visited}:
      %Count.some_equal(Phase.Child,
        Phase.Child{
          target,
          X.attempt_path(
            X.Attempt{
              target,
              edge,
              kind,
              source,
              bytes,
              name,
              expected,
              Local.Declaration{handle, identity, function, bundled, references, source_path},
              catalog,
              before
            }
          ),
          kind,
          capture,
          bytes,
          T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceReady.file_exports(kind, source), bytes},
          handle,
          identity,
          before,
          F.Forest{Some{root}, nodes},
          addresses,
          ReferenceReady.pending(edges),
          visited,
          V.budget(budget, signed),
          source,
          catalog
        }, view, ready):
        {Some{visited} == Some{ready_child_view_visited(_)} : Maybe<&2, List<&2, String>>}
      {==}
    case _ _ None{}:
      Empty.absurd({visited == Some{ready_child_view_visited(view)} : Maybe<&2, List<&2, String>>}, Contents.none_some(Phase.Child, view, ready))

def ready_reference_visited_self(+order: List<&2, String>, +values: Map<&2, Bool>, +rows: List<&2, String>, +ready: {ReferenceFrame.visited(order, values) == Some{rows} : Maybe<&2, List<&2, String>>}) -> {ReferenceFrame.visited(rows, values) == Some{rows} : Maybe<&2, List<&2, String>>}:
  Equal.trans(Maybe<&2, List<&2, String>>, ReferenceFrame.visited(rows, values), ReferenceFrame.visited(order, values), Some{rows},
    Equal.cong(List<&2, String>, Maybe<&2, List<&2, String>>, items => ReferenceFrame.visited(items, values), rows, order,
      Equal.sym(List<&2, String>, order, rows, ready_visited_order_exact(order, values, rows, reference_visited_contents(order, values, rows, ready)))), ready)

def ready_reference_child_visited_project(+child: X.Child, +history: Phase.ChildHistory, +view: Phase.Child, ready: {ReferenceReady.child_project(child, history) == Some{view} : Maybe<&2, Phase.Child>}) -> {ReferenceFrame.visited(ready_child_view_visited(view), ready_reference_child_visited(child)) == Some{ready_child_view_visited(view)} : Maybe<&2, List<&2, String>>}:
  match child history:
    case X.Child{_, _, Signed.State{Recursive.State{+values, _, _, _}, _}, _} Phase.ChildHistory{_, _, _, _, +order}:
      ready_reference_visited_self(order, values, ready_child_view_visited(view),
        ready_reference_child_visited_rows(child, history, ReferenceFrame.visited(order, values), view, ready))

def ready_original_reference_published_visited(+state: D.State, +child: X.Child, +history: V.History, +child_history: Phase.ChildHistory, +phase: Phase.Phase, ready: {ReferenceReady.project(state, child, history, child_history) == Some{phase} : Maybe<&2, Phase.Phase>}) -> {ReferenceFrame.visited(ready_child_view_visited(ready_phase_child(phase)), ready_reference_visited(ready_reference_published(state, child, ready_reference_child_local(child)))) == Some{ready_child_view_visited(ready_phase_child(phase))} : Maybe<&2, List<&2, String>>}:
  match state child phase:
    case D.State{_, X.Frame{_, _, _, Signed.State{Recursive.State{_, _, _, _}, _}, _, _, _, _, _, _, _, _}, _, _, _, _, _, _, _}
      X.Child{X.Attempt{_, _, _, _, _, _, _, _, _, _}, _, Signed.State{Recursive.State{_, _, _, _}, _}, _}
      Phase.Phase{+frame, +child_view, +capsule}:
      ready_reference_child_visited_project(child, child_history, child_view,
        Pair.fst({ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>}, {Some{ReferenceReady.capsule(state, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>},
          Pair.snd({ReferenceFrame.project(state, history) == Some{frame} : Maybe<&2, V.Frame>}, {ReferenceReady.child_project(child, child_history) == Some{child_view} : Maybe<&2, Phase.Child>} & {Some{ReferenceReady.capsule(state, child)} == Some{capsule} : Maybe<&2, Phase.Capsule>}, reference_ready_contents(state, child, history, child_history, phase, ready))))

# Read the publication arguments from the existing shared child view.
def ready_phase_publication(+frame: T.ResolverFrame, +plan: Local.Plan, child: Phase.Child) -> T.ResolverFrame:
  match child:
    case Phase.Child{target, path, kind, _, _, file, _, identity, _, _, _, _, _, _, _, _}:
      match kind:
        case X.FileChild{_}: Admission.publish_child(False{}, frame, target, path, file, identity, plan)
        case X.BundledChild{}: Admission.publish_child(True{}, frame, target, path, file, identity, plan)

def ready_tentative_publication(+frame: T.ResolverFrame, child: T.TentativeChild, +edge: Local.Pending) -> T.ResolverFrame:
  match child:
    case T.TentativeChild{target, path, _, _, file, _, identity, _, plan, _, _, _}:
      Admission.publish_child(Attach.bundled_edge(edge), frame, target, path, file, identity, plan)

def ready_tentative_publication_value(+frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +history: Phase.ChildHistory, +forest: F.Forest, +pending: List<&2, V.PendingPayload>, +visited: List<&2, String>) -> {Some{ready_tentative_publication(frame, child, edge)} == Maybe.map(&2, Phase.Child, T.ResolverFrame, view => ready_phase_publication(frame, ready_actual_child_plan(child), view), ActualReady.child_view(Some{forest}, Some{pending}, Some{visited}, child, edge, history)) : Maybe<&2, T.ResolverFrame>}:
  match child edge history:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Local.Pending{_, _, _, _, _, _, _, Local.Imported{_, _}} Phase.ChildHistory{F.Created{_, _, _}, _, _, _, _}: {==}
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{_, _, _, _, _, _}, _, _, _}
      Local.Pending{_, _, _, _, _, _, _, Local.BundledTarget{_}} Phase.ChildHistory{F.Created{_, _, _}, _, _, _, _}: {==}

def ready_actual_child_publication_rows(+frame: T.ResolverFrame, +forest: Maybe<&2, F.Forest>, +pending: Maybe<&2, List<&2, V.PendingPayload>>, +visited: Maybe<&2, List<&2, String>>, +child: T.TentativeChild, +edge: Local.Pending, +history: Phase.ChildHistory, +view: Phase.Child, ready: {ActualReady.child_view(forest, pending, visited, child, edge, history) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_tentative_publication(frame, child, edge) == ready_phase_publication(frame, ready_actual_child_plan(child), view) : T.ResolverFrame}:
  match forest pending visited:
    case Some{+f} Some{+p} Some{+v}:
      Count.some_equal(T.ResolverFrame, ready_tentative_publication(frame, child, edge), ready_phase_publication(frame, ready_actual_child_plan(child), view),
        Equal.trans(Maybe<&2, T.ResolverFrame>, Some{ready_tentative_publication(frame, child, edge)}, Maybe.map(&2, Phase.Child, T.ResolverFrame, item => ready_phase_publication(frame, ready_actual_child_plan(child), item), ActualReady.child_view(Some{f}, Some{p}, Some{v}, child, edge, history)), Some{ready_phase_publication(frame, ready_actual_child_plan(child), view)},
          ready_tentative_publication_value(frame, child, edge, history, f, p, v),
          Equal.cong(Maybe<&2, Phase.Child>, Maybe<&2, T.ResolverFrame>, value => Maybe.map(&2, Phase.Child, T.ResolverFrame, item => ready_phase_publication(frame, ready_actual_child_plan(child), item), value), ActualReady.child_view(Some{f}, Some{p}, Some{v}, child, edge, history), Some{view}, ready)))
    case None{} _ _:
      Empty.absurd({ready_tentative_publication(frame, child, edge) == ready_phase_publication(frame, ready_actual_child_plan(child), view) : T.ResolverFrame}, Contents.none_some(Phase.Child, view, ready))
    case Some{_} None{} _:
      Empty.absurd({ready_tentative_publication(frame, child, edge) == ready_phase_publication(frame, ready_actual_child_plan(child), view) : T.ResolverFrame}, Contents.none_some(Phase.Child, view, ready))
    case Some{_} Some{_} None{}:
      Empty.absurd({ready_tentative_publication(frame, child, edge) == ready_phase_publication(frame, ready_actual_child_plan(child), view) : T.ResolverFrame}, Contents.none_some(Phase.Child, view, ready))

def ready_actual_child_publication(+frame: T.ResolverFrame, +child: T.TentativeChild, +edge: Local.Pending, +history: Phase.ChildHistory, +artifacts: List<&2, T.ArtifactEntry>, +episode: Nat, +view: Phase.Child, ready: {ActualReady.child_project(child, edge, history, artifacts, episode) == Some{view} : Maybe<&2, Phase.Child>}) -> {ready_tentative_publication(frame, child, edge) == ready_phase_publication(frame, ready_actual_child_plan(child), view) : T.ResolverFrame}:
  match child history:
    case T.TentativeChild{_, _, _, _, _, _, _, _, Local.Plan{+root, +nodes, +slots, +edges, +visited, _}, _, _, _}
      Phase.ChildHistory{F.Created{_, _, +addresses}, _, _, _, +order}:
      ready_actual_child_publication_rows(frame, ActualReady.valid_forest(P.project(root, nodes, slots, artifacts, addresses), episode), ActualReady.pending(edges, addresses), ActualReady.visited_complete(order, visited), child, edge, history, view,
