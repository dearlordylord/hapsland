def ready_reference_capture_retained_step(+key: String, +old: T.SourceFacts, +bytes: Nat, +tail: List<&2, X.Captured>, +sources: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source, +provenance: Maybe<&2, V.CaptureSource>, +rest: Maybe<&2, List<&2, V.CapturedEntry>>, +rows: List<&2, V.CapturedEntry>, lookup: {V.capture_at(sources, key) == provenance : Maybe<&2, V.CaptureSource>}, projected: {ReferenceFrame.prefix(V.CapturedEntry, ReferenceFrame.captured_entry(key, old, bytes, provenance), rest) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}, recurse: @retained: List<&2, V.CapturedEntry> -> {rest == Some{retained} : Maybe<&2, List<&2, V.CapturedEntry>>} -> {Maybe.is_some(&2, List<&2, V.CapturedEntry>, ReferenceFrame.captured(tail, History.store_capture(sources, path, source, catalog))) == True{} : Bool}) -> {Maybe.is_some(&2, List<&2, V.CapturedEntry>, ReferenceFrame.captured(X.Captured{key, old, bytes} <> tail, History.store_capture(sources, path, source, catalog))) == True{} : Bool}:
