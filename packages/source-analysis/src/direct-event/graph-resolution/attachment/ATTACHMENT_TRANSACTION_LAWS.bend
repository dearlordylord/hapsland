def ready_rollback_projected_frame(+actual: T.ResolverFrame, +history: V.History, +view: V.Frame, +changed: F.Forest, +slots: List<&2, Local.ReferenceSlot>, ready: {ActualFrame.projected(actual, history) == Some{view} : Maybe<&2, V.Frame>}, observed: {ActualFrame.forest_valid(P.project(S.frame_root(actual), S.frame_nodes(actual), slots, S.frame_artifacts(actual), ready_history_addresses(history)), ready_history_episode(history)) == Some{changed} : Maybe<&2, F.Forest>}) -> {ActualFrame.projected(S.with_frame_references(actual, slots), history) == Some{ready_replaced_view(view, changed)} : Maybe<&2, V.Frame>}:
