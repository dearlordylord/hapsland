        retained => found => ready_reference_capture_retained_total(tail, sources, path, source, catalog, retained, found),
        retained => found => ready_reference_capture_store_total(tail, sources, path, source, catalog, bytes, retained, found))


def ready_capture_common_witness(+actual: Maybe<&2, List<&2, V.CapturedEntry>>, +reference: Maybe<&2, List<&2, V.CapturedEntry>>, same: {actual == reference : Maybe<&2, List<&2, V.CapturedEntry>>}, present: {Maybe.is_some(&2, List<&2, V.CapturedEntry>, reference) == True{} : Bool}) -> Exists(List<&2, V.CapturedEntry>, rows => {actual == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>} & {reference == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}):
  match reference:
    case Some{rows}: Tuple{rows, Tuple{same, {==}}}
    case None{}:
      Empty.absurd(Exists(List<&2, V.CapturedEntry>, rows => {actual == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>} & {None{} == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}), NatFacts.internal_false_ne_true(present))

def ready_capture_published_common(+frame: T.ResolverFrame, +order: V.Order, +items: List<&2, X.Captured>, +sources: List<&2, V.CaptureSource>, +path: String, +source: T.SourceFacts, +catalog: RootSpec.Source, +bytes: Nat, +target: Nat, +identity: String, +plan: Local.Plan, +rows: List<&2, V.CapturedEntry>, canonical: {ActualReady.mutable_maps_canonical(frame) == True{} : Bool}, coverage: {ActualFrame.coverage(order, frame) == True{} : Bool}, actual: {ActualFrame.captured(ready_capture_order(order), S.frame_captured(frame), sources) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}, +reference: {ReferenceFrame.captured(items, sources) == Some{rows} : Maybe<&2, List<&2, V.CapturedEntry>>}) -> Exists(List<&2, V.CapturedEntry>, updated => {ActualFrame.captured(History.retain_string(ready_capture_order(order), path), S.frame_captured(Admission.publish_child(False{}, frame, target, path, T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceFrame.source_exports(source), bytes}, identity, plan)), History.store_capture(sources, path, source, catalog)) == Some{updated} : Maybe<&2, List<&2, V.CapturedEntry>>} & {ReferenceFrame.captured(X.publish_capture(X.FileChild{path}, items, source, bytes), History.store_capture(sources, path, source, catalog)) == Some{updated} : Maybe<&2, List<&2, V.CapturedEntry>>}):
  ready_capture_common_witness(ActualFrame.captured(History.retain_string(ready_capture_order(order), path), S.frame_captured(Admission.publish_child(False{}, frame, target, path, T.CapturedFacts{ReferenceFrame.facts(catalog), ReferenceFrame.source_exports(source), bytes}, identity, plan)), History.store_capture(sources, path, source, catalog)), ReferenceFrame.captured(X.publish_capture(X.FileChild{path}, items, source, bytes), History.store_capture(sources, path, source, catalog)),
    ready_capture_published_actual(frame, order, items, sources, path, source, catalog, bytes, target, identity, plan, rows, canonical, coverage, actual, reference),
    ready_reference_capture_store_total(items, sources, path, source, catalog, bytes, rows, reference))


def ready_publication_view(view: V.Frame, captured: List<&2, V.CapturedEntry>, identities: List<&2, V.TargetArtifact>, visited: List<&2, String>, remaining: Nat) -> V.Frame:
  match view:
    case V.Frame{branch, limits, graph, command, deps, forest, pending, targets, ids, _, _, _, budget, node, edge, target, artifact, catalog, _, episode}:
      V.Frame{branch, limits, graph, command, deps, forest, pending, targets, ids, captured, identities, visited, budget, node, edge, target, artifact, catalog, remaining, episode}

def ready_publication_frame_rows(+forest: Maybe<&2, F.Forest>, +pending: Maybe<&2, List<&2, V.PendingEntry>>, +targets: Maybe<&2, List<&2, V.TargetEntry>>, +ids: Maybe<&2, List<&2, V.TargetId>>, +captured: Maybe<&2, List<&2, V.CapturedEntry>>, +identities: Maybe<&2, List<&2, V.TargetArtifact>>, +visited: Maybe<&2, List<&2, String>>, +actual: T.ResolverFrame, +bundled: Bool, +target: Nat, +path: String, +file: T.CapturedFacts, +identity: String, +plan: Local.Plan, +before: Nat, +episode: Nat, +view: V.Frame, +after: Nat, +new_captures: List<&2, V.CapturedEntry>, +new_identities: List<&2, V.TargetArtifact>, +new_visited: List<&2, String>, projected: {ActualFrame.frame_view(forest, pending, targets, ids, captured, identities, visited, actual, before, episode) == Some{view} : Maybe<&2, V.Frame>}) -> {ActualFrame.frame_view(forest, pending, targets, ids, Some{new_captures}, Some{new_identities}, Some{new_visited}, Admission.publish_child(bundled, actual, target, path, file, identity, plan), after, episode) == Some{ready_publication_view(view, new_captures, new_identities, new_visited, after)} : Maybe<&2, V.Frame>}:
  match forest pending targets ids captured identities visited actual bundled:
    case Some{+old_forest} Some{+old_pending} Some{+old_targets} Some{+old_ids} Some{+old_captures} Some{+old_identities} Some{+old_visited}
      T.ResolverFrame{branch, limits, graph, command, deps, _, _, _, _, budget, node, edge, next_target, artifact, _, _, _, _, _, artifacts} False{}:
      %Count.some_equal(V.Frame, V.Frame{branch, limits, graph, command, deps, old_forest, old_pending, old_targets, old_ids, old_captures, old_identities, old_visited, V.actual_budget(budget), node, edge, next_target, artifact, artifacts, before, episode}, view, projected):
        {ActualFrame.frame_view(Some{old_forest}, Some{old_pending}, Some{old_targets}, Some{old_ids}, Some{new_captures}, Some{new_identities}, Some{new_visited}, Admission.publish_child(False{}, actual, target, path, file, identity, plan), after, episode) == Some{ready_publication_view(_, new_captures, new_identities, new_visited, after)} : Maybe<&2, V.Frame>}
      {==}
    case Some{+old_forest} Some{+old_pending} Some{+old_targets} Some{+old_ids} Some{+old_captures} Some{+old_identities} Some{+old_visited}
      T.ResolverFrame{branch, limits, graph, command, deps, _, _, _, _, budget, node, edge, next_target, artifact, _, _, _, _, _, artifacts} True{}:
      %Count.some_equal(V.Frame, V.Frame{branch, limits, graph, command, deps, old_forest, old_pending, old_targets, old_ids, old_captures, old_identities, old_visited, V.actual_budget(budget), node, edge, next_target, artifact, artifacts, before, episode}, view, projected):
        {ActualFrame.frame_view(Some{old_forest}, Some{old_pending}, Some{old_targets}, Some{old_ids}, Some{new_captures}, Some{new_identities}, Some{new_visited}, Admission.publish_child(True{}, actual, target, path, file, identity, plan), after, episode) == Some{ready_publication_view(_, new_captures, new_identities, new_visited, after)} : Maybe<&2, V.Frame>}
      {==}
    case None{} _ _ _ _ _ _ _ _:
      Empty.absurd({ActualFrame.frame_view(forest, pending, targets, ids, Some{new_captures}, Some{new_identities}, Some{new_visited}, Admission.publish_child(bundled, actual, target, path, file, identity, plan), after, episode) == Some{ready_publication_view(view, new_captures, new_identities, new_visited, after)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, projected))
    case Some{_} None{} _ _ _ _ _ _ _:
      Empty.absurd({ActualFrame.frame_view(forest, pending, targets, ids, Some{new_captures}, Some{new_identities}, Some{new_visited}, Admission.publish_child(bundled, actual, target, path, file, identity, plan), after, episode) == Some{ready_publication_view(view, new_captures, new_identities, new_visited, after)} : Maybe<&2, V.Frame>}, Contents.none_some(V.Frame, view, projected))
    case Some{_} Some{_} None{} _ _ _ _ _ _:
