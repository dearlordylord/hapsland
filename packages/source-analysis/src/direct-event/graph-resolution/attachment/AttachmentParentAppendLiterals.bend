# One coupled internal cut, extracted from the original ready phase.
# All success observations below are conclusions, not successful-attachment premises.
# Existing data owners only; no new runtime representation or attachment implementation.
def attachment_nodes(value: Compose.Attachment) -> List<&2, Local.PlannedNode>:
  match value:
    case Compose.Attachment{_, _, _, nodes, _, _, _, _, _}: nodes

def attachment_slots(value: Compose.Attachment) -> List<&2, Local.ReferenceSlot>:
  match value:
    case Compose.Attachment{_, _, _, _, slots, _, _, _, _}: slots

def attachment_next_node(value: Compose.Attachment) -> Nat:
  match value:
    case Compose.Attachment{_, node, _, _, _, _, _, _, _}: node

def attachment_root(value: Compose.Attachment) -> Nat:
  match value:
    case Compose.Attachment{root, _, _, _, _, _, _, _, _}: root

def expanded_ready() -> {P.project(0n, [Local.PlannedNode{0n, 0n}, Local.PlannedNode{1n, 1n}], [Local.ReferenceSlot{0n, 0n, "Child", Local.Omitted{Local.Unresolved{}, "Child"}}], [T.ArtifactEntry{0n, T.Artifact{None{}, Some{"Root.ts"}, "Root", T.InterfaceArtifact{}, "Root", "interface Root {}", "h", []}}, T.ArtifactEntry{1n, T.Artifact{None{}, Some{"Detached.ts"}, "Detached", T.InterfaceArtifact{}, "Detached", "interface Detached {}", "h", []}}, T.ArtifactEntry{2n, T.Artifact{None{}, Some{"Child.ts"}, "Child", T.InterfaceArtifact{}, "Child", "interface Child {}", "h", []}}], [F.AddressEntry{0n, O.NodeAddress{0n, []}}, F.AddressEntry{1n, O.NodeAddress{1n, []}}]) == Some{F.Forest{Some{O.NodeAddress{0n, []}}, [F.Node{O.NodeAddress{0n, []}, T.Artifact{None{}, Some{"Root.ts"}, "Root", T.InterfaceArtifact{}, "Root", "interface Root {}", "h", []}, [F.Omitted{F.ReferenceSymbol{"Child"}, F.ReferenceSymbol{"Child"}, Local.Unresolved{}}]}, F.Node{O.NodeAddress{1n, []}, T.Artifact{None{}, Some{"Detached.ts"}, "Detached", T.InterfaceArtifact{}, "Detached", "interface Detached {}", "h", []}, []}]}} : Maybe<&2, F.Forest>} &
    {Frame.dense([Local.PlannedNode{0n, 0n}, Local.PlannedNode{1n, 1n}], 0n) == True{} : Bool} &
    {Relation.frame_forest(F.Forest{Some{O.NodeAddress{0n, []}}, [F.Node{O.NodeAddress{0n, []}, T.Artifact{None{}, Some{"Root.ts"}, "Root", T.InterfaceArtifact{}, "Root", "interface Root {}", "h", []}, [F.Omitted{F.ReferenceSymbol{"Child"}, F.ReferenceSymbol{"Child"}, Local.Unresolved{}}]}, F.Node{O.NodeAddress{1n, []}, T.Artifact{None{}, Some{"Detached.ts"}, "Detached", T.InterfaceArtifact{}, "Detached", "interface Detached {}", "h", []}, []}]}, 2n) == True{} : Bool} &
    {P.project(0n, [Local.PlannedNode{0n, 2n}], [], [T.ArtifactEntry{0n, T.Artifact{None{}, Some{"Root.ts"}, "Root", T.InterfaceArtifact{}, "Root", "interface Root {}", "h", []}}, T.ArtifactEntry{1n, T.Artifact{None{}, Some{"Detached.ts"}, "Detached", T.InterfaceArtifact{}, "Detached", "interface Detached {}", "h", []}}, T.ArtifactEntry{2n, T.Artifact{None{}, Some{"Child.ts"}, "Child", T.InterfaceArtifact{}, "Child", "interface Child {}", "h", []}}], [F.AddressEntry{0n, O.NodeAddress{2n, []}}]) == Some{F.Forest{Some{O.NodeAddress{2n, []}}, [F.Node{O.NodeAddress{2n, []}, T.Artifact{None{}, Some{"Child.ts"}, "Child", T.InterfaceArtifact{}, "Child", "interface Child {}", "h", []}, []}]}} : Maybe<&2, F.Forest>} &
    {Frame.dense([Local.PlannedNode{0n, 2n}], 0n) == True{} : Bool} &
    {Ready.fresh_forest(F.Forest{Some{O.NodeAddress{2n, []}}, [F.Node{O.NodeAddress{2n, []}, T.Artifact{None{}, Some{"Child.ts"}, "Child", T.InterfaceArtifact{}, "Child", "interface Child {}", "h", []}, []}]}, 2n) == True{} : Bool} &
    {Nat.is_eq(Ready.slot_count([Local.ReferenceSlot{0n, 0n, "Child", Local.Omitted{Local.Unresolved{}, "Child"}}], 0n, 0n, "Child"), 1n) == True{} : Bool} &
    {F.address_at([F.AddressEntry{0n, O.NodeAddress{0n, []}}, F.AddressEntry{1n, O.NodeAddress{1n, []}}], 0n) == Some{O.NodeAddress{0n, []}} : Maybe<&2, O.NodeAddress>}:
  Tuple{{==}, Tuple{{==}, Tuple{{==}, Tuple{{==}, Tuple{{==}, Tuple{{==}, Tuple{{==}, {==}}}}}}}}

def expanded_claim() -> Exists(Compose.Attachment, attachment => Exists(F.Forest, updated =>
    {Compose.replacement(Compose.replace_slot([Local.ReferenceSlot{0n, 0n, "Child", Local.Omitted{Local.Unresolved{}, "Child"}}], 0n, 0n, Local.Expanded{2n})) == Some{[Local.ReferenceSlot{0n, 0n, "Child", Local.Expanded{2n}}]} : Maybe<&2, List<&2, Local.ReferenceSlot>>} &
    {Compose.tentative_attachment(Compose.remap(Local.Plan{0n, [Local.PlannedNode{0n, 2n}], [], [], MTip{}, Local.Budget{Local.LocalLimits{10n, 10n, 10n}, MTip{}, 0n, 0n, 0n, 0n}}, 2n), [Local.PlannedNode{0n, 0n}, Local.PlannedNode{1n, 1n}], [Local.ReferenceSlot{0n, 0n, "Child", Local.Omitted{Local.Unresolved{}, "Child"}}], 0n, 0n, None{}, 7n, MTip{}) == Some{attachment} : Maybe<&2, Compose.Attachment>} &
    {attachment == Compose.attachment_registered(Compose.register_pending(Compose.shift_pending([], 2n), 7n, MTip{}), Compose.remap(Local.Plan{0n, [Local.PlannedNode{0n, 2n}], [], [], MTip{}, Local.Budget{Local.LocalLimits{10n, 10n, 10n}, MTip{}, 0n, 0n, 0n, 0n}}, 2n), [Local.PlannedNode{0n, 0n}, Local.PlannedNode{1n, 1n}], [Local.ReferenceSlot{0n, 0n, "Child", Local.Expanded{2n}}]) : Compose.Attachment} &
    {F.replace(F.append(F.Forest{Some{O.NodeAddress{0n, []}}, [F.Node{O.NodeAddress{0n, []}, T.Artifact{None{}, Some{"Root.ts"}, "Root", T.InterfaceArtifact{}, "Root", "interface Root {}", "h", []}, [F.Omitted{F.ReferenceSymbol{"Child"}, F.ReferenceSymbol{"Child"}, Local.Unresolved{}}]}, F.Node{O.NodeAddress{1n, []}, T.Artifact{None{}, Some{"Detached.ts"}, "Detached", T.InterfaceArtifact{}, "Detached", "interface Detached {}", "h", []}, []}]}, F.Created{O.NodeAddress{2n, []}, [F.Node{O.NodeAddress{2n, []}, T.Artifact{None{}, Some{"Child.ts"}, "Child", T.InterfaceArtifact{}, "Child", "interface Child {}", "h", []}, []}], [F.AddressEntry{0n, O.NodeAddress{2n, []}}]}), O.NodeAddress{0n, []}, 0n, X.attachment_reference(False{}, F.Created{O.NodeAddress{2n, []}, [F.Node{O.NodeAddress{2n, []}, T.Artifact{None{}, Some{"Child.ts"}, "Child", T.InterfaceArtifact{}, "Child", "interface Child {}", "h", []}, []}], [F.AddressEntry{0n, O.NodeAddress{2n, []}}]}, "Child", "Child")) == F.Replaced{updated} : F.Replacement} &
    {P.project(0n, attachment_nodes(attachment), attachment_slots(attachment), [T.ArtifactEntry{0n, T.Artifact{None{}, Some{"Root.ts"}, "Root", T.InterfaceArtifact{}, "Root", "interface Root {}", "h", []}}, T.ArtifactEntry{1n, T.Artifact{None{}, Some{"Detached.ts"}, "Detached", T.InterfaceArtifact{}, "Detached", "interface Detached {}", "h", []}}, T.ArtifactEntry{2n, T.Artifact{None{}, Some{"Child.ts"}, "Child", T.InterfaceArtifact{}, "Child", "interface Child {}", "h", []}}], Mapping.extended([F.AddressEntry{0n, O.NodeAddress{0n, []}}, F.AddressEntry{1n, O.NodeAddress{1n, []}}], 2n, F.Created{O.NodeAddress{2n, []}, [F.Node{O.NodeAddress{2n, []}, T.Artifact{None{}, Some{"Child.ts"}, "Child", T.InterfaceArtifact{}, "Child", "interface Child {}", "h", []}, []}], [F.AddressEntry{0n, O.NodeAddress{2n, []}}]})) == Some{updated} : Maybe<&2, F.Forest>} &
    {Relation.frame_forest(updated, 3n) == True{} : Bool} &
    {attachment_next_node(attachment) == 3n : Nat} &
    {Frame.dense(attachment_nodes(attachment), 0n) == True{} : Bool})):
  Tuple{Compose.attachment_registered(Compose.register_pending(Compose.shift_pending([], 2n), 7n, MTip{}), Compose.remap(Local.Plan{0n, [Local.PlannedNode{0n, 2n}], [], [], MTip{}, Local.Budget{Local.LocalLimits{10n, 10n, 10n}, MTip{}, 0n, 0n, 0n, 0n}}, 2n), [Local.PlannedNode{0n, 0n}, Local.PlannedNode{1n, 1n}], [Local.ReferenceSlot{0n, 0n, "Child", Local.Expanded{2n}}]), Tuple{F.Forest{Some{O.NodeAddress{0n, []}}, [F.Node{O.NodeAddress{0n, []}, T.Artifact{None{}, Some{"Root.ts"}, "Root", T.InterfaceArtifact{}, "Root", "interface Root {}", "h", []}, [F.Expanded{F.ReferenceSymbol{"Child"}, O.NodeAddress{2n, []}}]}, F.Node{O.NodeAddress{1n, []}, T.Artifact{None{}, Some{"Detached.ts"}, "Detached", T.InterfaceArtifact{}, "Detached", "interface Detached {}", "h", []}, []}, F.Node{O.NodeAddress{2n, []}, T.Artifact{None{}, Some{"Child.ts"}, "Child", T.InterfaceArtifact{}, "Child", "interface Child {}", "h", []}, []}]}, Tuple{{==}, Tuple{{==}, Tuple{{==}, Tuple{{==}, Tuple{{==}, Tuple{{==}, Tuple{{==}, {==}}}}}}}}}}

