{
  "name": "@hapsland/agent-flow-viz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node --experimental-strip-types scripts/build-capacity-inventory.mjs && npm --prefix ../agent-flow-projection run typecheck && tsc --noEmit && node scripts/check-flow-inference.mjs && node scripts/check-projection.mjs && vite build",
    "test:browser": "node scripts/check-browser.mjs",
    "test:simulation-browser": "node scripts/check-simulation-browser.mjs",
    "test:replay-browser": "node scripts/check-replay-navigation.mjs",
    "test:usability": "node scripts/check-usability.mjs",
    "test:site": "node --experimental-strip-types scripts/check-site-scenarios.mjs && node scripts/check-site-browser.mjs"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-rc.116",
    "@hapsland/agent-flow-projection": "file:../agent-flow-projection",
    "effect": "4.0.0-rc.116",
    "foldkit": "0.163.0"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
