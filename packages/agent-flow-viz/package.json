{
  "name": "@hapsland/agent-flow-viz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:pages": "npm run build && node scripts/prepare-pages.mjs",
    "deploy:pages": "npm run build:pages && npx --yes wrangler@4.146.0 pages deploy dist --project-name hapsland --branch master",
    "build": "node --experimental-strip-types scripts/build-capacity-inventory.mjs && npm --prefix ../agent-flow-projection run typecheck && tsc --noEmit && node scripts/check-flow-inference.mjs && node scripts/check-projection.mjs && vite build",
    "test:browser": "node scripts/check-browser.mjs",
    "test:simulation-browser": "node scripts/check-simulation-browser.mjs",
    "test:replay-browser": "node scripts/check-replay-navigation.mjs",
    "test:usability": "node scripts/check-usability.mjs",
    "test:ensemble-browser": "node scripts/check-ensemble-browser.mjs",
    "test:resource-browser": "node scripts/check-resource-browser.mjs",
    "test:execution-pools-browser": "node scripts/check-execution-pools-browser.mjs",
    "test:site": "node --experimental-strip-types scripts/check-site-scenarios.mjs && node scripts/check-site-browser.mjs",
    "test:render-browser": "node scripts/check-render-browser.mjs",
    "test:camera-browser": "node scripts/check-camera-browser.mjs",
    "test:resident-capacity-browser": "node scripts/check-resident-capacity-browser.mjs",
    "test:edit-permits-browser": "node scripts/check-edit-permits-browser.mjs",
    "test:edit-duration-browser": "node scripts/check-edit-duration-browser.mjs",
    "test:resident-liveness-browser": "node scripts/check-resident-liveness-browser.mjs",
    "test:timeline-browser": "node scripts/check-timeline-browser.mjs",
    "test:live-drafts-browser": "node scripts/check-live-drafts-browser.mjs",
    "test:collectors-browser": "node scripts/check-collectors-browser.mjs",
    "test:stop-slot-browser": "node scripts/check-stop-slot-browser.mjs",
    "test:inspection-browser": "node scripts/check-inspection-browser.mjs",
    "test:pi-inspection-browser": "node scripts/check-pi-inspection-browser.mjs",
    "test:inspection-outcomes-browser": "node scripts/check-inspection-outcomes-browser.mjs",
    "test:inspection-reuse-browser": "node scripts/check-inspection-reuse-browser.mjs"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0",
    "@hapsland/agent-flow-projection": "file:../agent-flow-projection",
    "effect": "4.0.0",
    "foldkit": "0.165.0"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
