{
  "name": "@hapsland/doctor-entry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package-doctor": {
      "types": "./dist/package-doctor.d.ts",
      "default": "./dist/package-doctor.js"
    }
  },
  "dependencies": {
    "@hapsland/administration": "workspace:*",
    "@hapsland/runtime-environment": "workspace:*",
    "effect": "catalog:"
  },
  "scripts": {
    "build": "node ../../scripts/compile-package.mjs",
    "assemble:linux-arm64": "node ../../scripts/assemble-entry.mjs linux-arm64",
    "assemble:darwin-arm64": "node ../../scripts/assemble-entry.mjs darwin-arm64",
    "clean:compiler": "node ../../scripts/clean-compiler-output.mjs"
  },
  "hapsland": {
    "domain": "doctor-entry",
    "host": "bun",
    "capabilities": [],
    "role": "doctor",
    "executable": "hapsland-doctor",
    "entry": "src/package-doctor.ts",
    "assembly": {
      "profiles": [
        "linux-arm64",
        "darwin-arm64"
      ]
    }
  }
}
