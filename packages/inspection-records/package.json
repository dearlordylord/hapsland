{
  "name": "@hapsland/inspection-records",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./inspection/contract": {
      "types": "./dist/inspection/contract.d.ts",
      "default": "./dist/inspection/contract.js"
    },
    "./inspection/native-lock": {
      "types": "./dist/inspection/native-lock.d.ts",
      "default": "./dist/inspection/native-lock.js"
    },
    "./inspection/recorder": {
      "types": "./dist/inspection/recorder.d.ts",
      "default": "./dist/inspection/recorder.js"
    },
    "./inspection/replay": {
      "types": "./dist/inspection/replay.d.ts",
      "default": "./dist/inspection/replay.js"
    },
    "./inspection/settings": {
      "types": "./dist/inspection/settings.d.ts",
      "default": "./dist/inspection/settings.js"
    },
    "./inspection/storage": {
      "types": "./dist/inspection/storage.d.ts",
      "default": "./dist/inspection/storage.js"
    },
    "./inspection/transport": {
      "types": "./dist/inspection/transport.d.ts",
      "default": "./dist/inspection/transport.js"
    }
  },
  "dependencies": {
    "@hapsland/runtime-environment": "workspace:*",
    "@hapsland/runtime-inputs": "workspace:*",
    "effect": "catalog:"
  },
  "scripts": {
    "build": "node ../../scripts/compile-package.mjs",
    "native:linux-arm64": "node ../../scripts/native-task.mjs linux-arm64",
    "native:darwin-arm64": "node ../../scripts/native-task.mjs darwin-arm64",
    "clean:compiler": "node ../../scripts/clean-compiler-output.mjs"
  },
  "hapsland": {
    "domain": "inspection-records",
    "host": "bun",
    "capabilities": [],
    "loaderPolicies": {
      "src/inspection/native-lock.ts": "inspection-native-lock"
    },
    "nativeAssets": [
      {
        "source": "src/inspection/native-lock.ts",
        "path": "native/prebuilt/{profile}/inspection-lock.node",
        "producer": {
          "kind": "c",
          "profiles": {
            "linux-arm64": {
              "source": "native/src/inspection-lock.c",
              "compileFlags": [
                "-O2",
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-fPIC"
              ],
              "linkFlags": [
                "-shared"
              ],
              "nodeApiHeaders": true
            },
            "darwin-arm64": {
              "source": "native/src/inspection-lock.c",
              "compileFlags": [
                "-O2",
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-Werror"
              ],
              "linkFlags": [
                "-bundle",
                "-undefined",
                "dynamic_lookup"
              ],
              "nodeApiHeaders": true
            }
          }
        }
      }
    ]
  }
}
