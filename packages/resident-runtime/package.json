{
  "name": "@hapsland/resident-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./resident/advice-records": {
      "types": "./dist/resident/state/advice-records.d.ts",
      "default": "./dist/resident/state/advice-records.js"
    },
    "./resident/bend-work": {
      "types": "./dist/resident/bend-work.d.ts",
      "default": "./dist/resident/bend-work.js"
    },
    "./resident/capacity": {
      "types": "./dist/resident/state/capacity.d.ts",
      "default": "./dist/resident/state/capacity.js"
    },
    "./resident/collection-decisions": {
      "types": "./dist/resident/advice-delivery/collection-decisions.d.ts",
      "default": "./dist/resident/advice-delivery/collection-decisions.js"
    },
    "./resident/collection": {
      "types": "./dist/resident/advice-delivery/collection.d.ts",
      "default": "./dist/resident/advice-delivery/collection.js"
    },
    "./resident/composed-delivery": {
      "types": "./dist/resident/state/composed-delivery.d.ts",
      "default": "./dist/resident/state/composed-delivery.js"
    },
    "./resident/dispatch-controls": {
      "types": "./dist/resident/execution-controls/dispatch-controls.d.ts",
      "default": "./dist/resident/execution-controls/dispatch-controls.js"
    },
    "./resident/dispatch": {
      "types": "./dist/resident/state/dispatch.d.ts",
      "default": "./dist/resident/state/dispatch.js"
    },
    "./resident/evaluation-reuse": {
      "types": "./dist/resident/state/evaluation-reuse.d.ts",
      "default": "./dist/resident/state/evaluation-reuse.js"
    },
    "./resident/ownership": {
      "types": "./dist/resident/ownership.d.ts",
      "default": "./dist/resident/ownership.js"
    },
    "./resident/preparation-controls": {
      "types": "./dist/resident/execution-controls/preparation-controls.d.ts",
      "default": "./dist/resident/execution-controls/preparation-controls.js"
    },
    "./resident/preparation-workspace": {
      "types": "./dist/resident/work-ownership/workspace.d.ts",
      "default": "./dist/resident/work-ownership/workspace.js"
    },
    "./resident/review-controls": {
      "types": "./dist/resident/execution-controls/review-controls.d.ts",
      "default": "./dist/resident/execution-controls/review-controls.js"
    },
    "./resident/round-records": {
      "types": "./dist/resident/state/round-records.d.ts",
      "default": "./dist/resident/state/round-records.js"
    },
    "./resident/runtime-configuration": {
      "types": "./dist/resident/runtime-configuration.d.ts",
      "default": "./dist/resident/runtime-configuration.js"
    },
    "./resident/server": {
      "types": "./dist/resident/server.d.ts",
      "default": "./dist/resident/server.js"
    }
  },
  "dependencies": {
    "@hapsland/activity-observation": "workspace:*",
    "@hapsland/canonical-policy": "workspace:*",
    "@hapsland/delivery-output": "workspace:*",
    "@hapsland/inspection-records": "workspace:*",
    "@hapsland/native-observation": "workspace:*",
    "@hapsland/resident-transport": "workspace:*",
    "@hapsland/review-definition": "workspace:*",
    "@hapsland/review-execution": "workspace:*",
    "@hapsland/runtime-environment": "workspace:*",
    "@hapsland/runtime-inputs": "workspace:*",
    "@hapsland/source-analysis": "workspace:*",
    "effect": "catalog:",
    "@hapsland/credential-storage": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/compile-package.mjs",
    "clean:compiler": "node ../../scripts/clean-compiler-output.mjs"
  },
  "hapsland": {
    "domain": "resident-runtime",
    "host": "bun",
    "capabilities": [
      "review-orchestration"
    ]
  }
}
