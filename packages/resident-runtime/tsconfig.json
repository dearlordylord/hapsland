    {
      "path": "../review-execution/tsconfig.json"
    },
    {
      "path": "../runtime-environment/tsconfig.json"
    },
    {
      "path": "../runtime-inputs/tsconfig.json"
    },
    {
      "path": "../source-analysis/tsconfig.json"
    },
    {
      "path": "../source-artifacts/tsconfig.json"
