{
  "name": "@hapsland/pi-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./pi/extension": {
      "types": "./dist/pi/extension.d.ts",
      "default": "./dist/pi/extension.js"
    }
  },
  "dependencies": {
    "@hapsland/runtime-environment": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/compile-package.mjs",
    "assemble:host": "node ../../scripts/assemble-host-modules.mjs",
    "clean:compiler": "node ../../scripts/clean-compiler-output.mjs"
  },
  "hapsland": {
    "domain": "pi-extension",
    "host": "node",
    "hostOutputDirectory": "dist",
    "capabilities": [],
    "surface": "pi-extension",
    "entry": "src/pi/extension.ts",
    "assembly": {
      "profiles": [
        "host"
      ]
    }
  }
}
