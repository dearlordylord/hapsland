theorem travel_reaches_close_horizontal_target (x : U32) (target : U32) (y : U32) : ((BitVec.ule (Map.distance x target) (4 : U32)) = true) → ((Motion.travel (Point.mk x y) (Point.mk target y)) = (Point.mk target y)) := by
