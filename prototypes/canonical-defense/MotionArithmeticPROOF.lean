theorem coordinate_toNat (a b p : U32) :
    (Map.travel_coordinate a b p).toNat =
      if a.toNat ≤ b.toNat then a.toNat + min p.toNat (b.toNat - a.toNat)
      else a.toNat - min p.toNat (a.toNat - b.toNat) := by
