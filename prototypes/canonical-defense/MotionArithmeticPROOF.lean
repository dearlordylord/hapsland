  deriving DecidableEq
def min32 (a b : U32) : U32 := if a.ult b then a else b
def max32 (a b : U32) : U32 := if a.ult b then b else a
def eq32 (a b : U32) : Bool := a == b


def Map.distance_order (a : U32) (b : U32) (up : Bool) : U32 := (if up then (b - a) else (a - b))

def Map.distance (a : U32) (b : U32) : U32 := (Map.distance_order a b (BitVec.ule a b))

def Map.travel_coordinate_order (a : U32) (b : U32) (pixels : U32) (up : Bool) : U32 := (if up then (a + (min32 pixels (b - a))) else (a - (min32 pixels (a - b))))

def Map.travel_coordinate (a : U32) (b : U32) (pixels : U32) : U32 := (Map.travel_coordinate_order a b pixels (BitVec.ule a b))

def Motion.travel (start : Point) (target : Point) : Point := (if (eq32 (Point.x start) (Point.x target)) then (Point.mk (Point.x start) (Map.travel_coordinate (Point.y start) (Point.y target) (4 : U32))) else (Point.mk (Map.travel_coordinate (Point.x start) (Point.x target) (4 : U32)) (Point.y start)))

