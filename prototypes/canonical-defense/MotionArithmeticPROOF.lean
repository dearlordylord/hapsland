theorem coordinate_no_overshoot (start : U32) (target : U32) (pixels : U32) : (((BitVec.ule (min32 start target) (Map.travel_coordinate start target pixels)) && (BitVec.ule (Map.travel_coordinate start target pixels) (max32 start target))) = true) := by
