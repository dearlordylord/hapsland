{
  "name": "representative-interface-and-alias",
  "workspace": "workspace",
  "before": "before",
  "evaluationMarker": ".module-init.marker",
  "defaultEdit": "interface",
  "edits": {
    "interface": {
      "path": "src/target.ts",
      "beforeRange": { "start": { "line": 8, "character": 1 }, "end": { "line": 8, "character": 30 } },
      "afterRange": { "start": { "line": 8, "character": 1 }, "end": { "line": 8, "character": 31 } }
    },
    "alias": {
      "path": "src/target.ts",
      "beforeRange": { "start": { "line": 18, "character": 1 }, "end": { "line": 18, "character": 22 } },
      "afterRange": { "start": { "line": 18, "character": 1 }, "end": { "line": 18, "character": 23 } }
    }
  }
}
