{
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@fixture/*": ["src/*"]
    },
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "es2022",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
