{
  "name": "zod-schema-roots",
  "workspace": "workspace",
  "before": "before",
  "evaluationMarker": ".module-init.marker",
  "defaultEdit": "composed",
  "edits": {
    "composed": {
      "path": "src/target.ts",
      "beforeRange": { "start": { "line": 12, "character": 0 }, "end": { "line": 12, "character": 80 } },
      "afterRange": { "start": { "line": 12, "character": 0 }, "end": { "line": 12, "character": 100 } }
    },
    "transformed": {
      "path": "src/target.ts",
      "beforeRange": { "start": { "line": 18, "character": 0 }, "end": { "line": 21, "character": 60 } },
      "afterRange": { "start": { "line": 18, "character": 0 }, "end": { "line": 21, "character": 60 } }
    }
  }
}
