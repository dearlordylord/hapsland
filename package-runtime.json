{
  "schemaVersion": 1,
  "runtime": {
    "name": "bun",
    "version": "1.3.14",
    "distribution": "shared-embedded-runtime"
  },
  "codex": {
    "testedVersions": [
      "0.155.1",
      "0.156.0"
    ]
  },
  "profiles": [
    {
      "operatingSystem": "linux",
      "architecture": "arm64",
      "descriptorFacility": "/proc/self/fd",
      "verification": "pending-standalone-validation"
    },
    {
      "operatingSystem": "darwin",
      "architecture": "arm64",
      "descriptorFacility": "/dev/fd",
      "verification": "cross-built-format-only"
    }
  ],
  "requiredCommands": [
    "git"
  ],
  "linuxCredentialStore": {
    "implementation": "Secret Service through libsecret",
    "releaseBuildDependency": "C compiler, pkg-config, and libsecret-1 development files",
    "lookupDeadlineMs": 750,
    "backgroundUnlockPrompts": false
  },
  "macOSCredentialStore": {
    "implementation": "Keychain generic password through Security.framework",
    "releaseBuildDependency": "Xcode Command Line Tools (cc)",
    "service": "dev.typesafe.realtime-review-tool",
    "account": "default",
    "lookupDeadlineMs": 750,
    "backgroundAuthenticationUI": "fail-without-prompt"
  },
  "parser": {
    "implementation": "tree-sitter",
    "languages": [
      "typescript",
      "tsx"
    ]
  },
  "residentProtocol": 1
}
