        { "kind": "ticketStepUnit", "id": 1, "unit": 11, "event": "failUnit", "reason": "backend", "expect": "ticketUnitUpdated" },
        { "kind": "ticketUnitCheck", "id": 1, "unit": 11, "expect": "ticketUnitSnapshot:unavailable:backend" },
        { "kind": "ticketClose", "id": 1, "expect": "ticketClosed" },
        { "kind": "ticketTerminal", "id": 1, "expired": false, "credentialValid": true, "liveAdvice": false, "pendingNotice": false, "expect": "ticketUnavailable:backend" }
