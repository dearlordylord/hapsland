        { "kind": "ticketOpen", "id": 1, "expect": "ticketOpened" },
        { "kind": "ticketAddUnit", "id": 1, "unit": 10, "expect": "ticketUnitAdded" },
        { "kind": "ticketAddUnit", "id": 1, "unit": 11, "expect": "ticketUnitAdded" },
