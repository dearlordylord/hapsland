{
  "traces": [
    {
      "name": "clear and backend unavailable units remain distinct",
      "events": [
        { "kind": "ticketOpen", "id": 1, "expect": "ticketOpened" },
        { "kind": "ticketAddUnit", "id": 1, "unit": 10, "expect": "ticketUnitAdded" },
        { "kind": "ticketAddUnit", "id": 1, "unit": 11, "expect": "ticketUnitAdded" },
        { "kind": "ticketUnitCheck", "id": 1, "unit": 10, "expect": "ticketUnitSnapshot:pending" },
        { "kind": "ticketStepUnit", "id": 1, "unit": 10, "event": "clearResult", "reason": "lost", "expect": "ticketUnitUpdated" },
        { "kind": "ticketStepUnit", "id": 1, "unit": 11, "event": "failUnit", "reason": "backend", "expect": "ticketUnitUpdated" },
        { "kind": "ticketUnitCheck", "id": 1, "unit": 11, "expect": "ticketUnitSnapshot:unavailable:backend" }
      ],
      "tickets": [{ "id": 1, "units": [
        { "id": 10, "stage": "clear" },
        { "id": 11, "stage": "unavailable", "reason": "backend" }
      ] }]
    },
    {
      "name": "finding delivery mark follows acknowledgment",
      "events": [
        { "kind": "ticketOpen", "id": 2, "expect": "ticketOpened" },
        { "kind": "ticketAddUnit", "id": 2, "unit": 20, "expect": "ticketUnitAdded" },
        { "kind": "ticketStepUnit", "id": 2, "unit": 20, "event": "findingResult", "reason": "lost", "expect": "ticketUnitUpdated" },
        { "kind": "ticketStepUnit", "id": 2, "unit": 20, "event": "markDelivered", "reason": "lost", "expect": "ticketUnitUpdated" },
        { "kind": "ticketStepUnit", "id": 2, "unit": 20, "event": "markDelivered", "reason": "lost", "expect": "ticketRefused" },
        { "kind": "ticketUnitCheck", "id": 2, "unit": 20, "expect": "ticketUnitSnapshot:finding:delivered" }
      ],
      "tickets": [{ "id": 2, "units": [
        { "id": 20, "stage": "finding", "delivered": true }
      ] }]
    },
    {
      "name": "superseded unit cannot revive from a late finding",
      "events": [
        { "kind": "ticketOpen", "id": 3, "expect": "ticketOpened" },
        { "kind": "ticketAddUnit", "id": 3, "unit": 30, "expect": "ticketUnitAdded" },
        { "kind": "ticketStepUnit", "id": 3, "unit": 30, "event": "failUnit", "reason": "stale", "expect": "ticketUnitUpdated" },
        { "kind": "ticketStepUnit", "id": 3, "unit": 30, "event": "findingResult", "reason": "lost", "expect": "ticketRefused" },
        { "kind": "ticketForget", "id": 3, "expect": "ticketForgotten" },
        { "kind": "ticketUnitCheck", "id": 3, "unit": 30, "expect": "ticketUnitMissing" }
      ],
      "tickets": []
    },
    {
      "name": "an empty admission has no aggregate phase; gates still order authority",
      "events": [
        { "kind": "ticketOpen", "id": 4, "expect": "ticketOpened" },
        { "kind": "ticketCollectGateCheck", "expired": true, "credentialValid": false, "expect": "ticketCollectUnavailable:expired" },
        { "kind": "ticketFinalAuthorityCheck", "admittedBlock": true, "currentBlock": false, "expect": "ticketFinalRelease" },
        { "kind": "ticketJoinedCheck", "state": "finding", "staleUnavailable": true, "hasRevision": true, "hasAdviceId": true, "expect": "ticketKeepJoined" }
      ],
      "tickets": [{ "id": 4, "units": [] }]
    },
    {
      "name": "flat unit provenance prevents another admission from reading or settling it",
      "events": [
        { "kind": "ticketOpen", "id": 5, "expect": "ticketOpened" },
        { "kind": "ticketOpen", "id": 6, "expect": "ticketOpened" },
        { "kind": "ticketAddUnit", "id": 5, "unit": 50, "expect": "ticketUnitAdded" },
        { "kind": "ticketUnitCheck", "id": 6, "unit": 50, "expect": "ticketUnitMissing" },
        { "kind": "ticketStepUnit", "id": 6, "unit": 50, "event": "clearResult", "reason": "lost", "expect": "ticketRefused" },
        { "kind": "ticketUnitCheck", "id": 5, "unit": 50, "expect": "ticketUnitSnapshot:pending" },
        { "kind": "ticketForget", "id": 5, "expect": "ticketForgotten" },
        { "kind": "ticketUnitCheck", "id": 5, "unit": 50, "expect": "ticketUnitMissing" }
      ],
      "tickets": [{ "id": 6, "units": [] }]
    }
  ]
}
