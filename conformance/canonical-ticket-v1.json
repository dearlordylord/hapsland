        { "kind": "ticketClose", "id": 3, "expect": "ticketClosed" },
        { "kind": "ticketTerminal", "id": 3, "expired": false, "credentialValid": true, "liveAdvice": false, "pendingNotice": false, "expect": "ticketUnavailable:stale" },
        { "kind": "ticketForget", "id": 3, "expect": "ticketForgotten" },
        { "kind": "ticketUnitCheck", "id": 3, "unit": 30, "expect": "ticketUnitMissing" },
        { "kind": "ticketTerminal", "id": 3, "expired": false, "credentialValid": true, "liveAdvice": false, "pendingNotice": false, "expect": "ticketRefused" }
