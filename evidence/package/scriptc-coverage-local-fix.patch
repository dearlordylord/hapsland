@@ -0,0 +1,39 @@
+import { expect, test, vi } from "vitest";
+import { BOOL, JSVAL, type IrExpr } from "../../ir/ir.js";
+import {
+  SyntaxKind,
+  type Expression,
+  type PropertyAccessExpression,
+  type Type,
+} from "../ts7/adapter.js";
+import { lowerUnionProperty } from "./lower-exprs.js";
+import { Lowerer } from "./lowerer.js";
+
+test.each([false, true])(
+  "union-declared island property reads preserve runtime dispatch (optional=%s)",
+  (optional) => {
+    const loc = { file: "island.ts", start: 0, end: 20 };
+    const receiver = { kind: SyntaxKind.PropertyAccessExpression } as Expression;
+    const expr = {
+      expression: receiver,
+      name: { text: "exists" },
+      questionDotToken: optional ? {} : undefined,
+      getSourceFile: () => ({ fileName: loc.file }),
+      getStart: () => loc.start,
+      getEnd: () => loc.end,
+    } as unknown as PropertyAccessExpression;
+    const lowerer = Object.create(Lowerer.prototype) as Lowerer;
+    vi.spyOn(lowerer, "chainBlocked").mockReturnValue(false);
+    vi.spyOn(lowerer, "typeOf").mockImplementation((node) => node as unknown as Type);
+    vi.spyOn(lowerer, "mapTypeOf").mockImplementation((type) =>
+      type === (receiver as unknown as Type) ? { kind: "union", unionId: "optional-record" } : BOOL,
+    );
+    const value: IrExpr = { kind: "chainRecv", id: "chain.0", type: JSVAL, loc };
+    vi.spyOn(lowerer, "lowerExpr").mockReturnValue(value);
+    const read = { kind: "jsOp", op: "getProp", name: "exists", args: [value], type: JSVAL, loc };
+    expect(lowerUnionProperty(lowerer, expr)).toEqual(
+      optional ? read : { kind: "jsExit", value: read, type: BOOL, loc },
+    );
+    expect(lowerer.lowerExpr).toHaveBeenCalledTimes(1);
+  },
+);
