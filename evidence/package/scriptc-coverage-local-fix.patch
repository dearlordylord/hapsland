+test("optional-chain receiver overrides dispatch by their runtime representation", () => {
+  const lowerer = context(true);
+  const receiver = { kind: SyntaxKind.PropertyAccessExpression } as Expression;
+  vi.spyOn(lowerer, "typeOf").mockReturnValue({} as Type);
+  vi.spyOn(lowerer, "mapTypeOf").mockReturnValue({ kind: "union", unionId: "optional-record" });
+  const loc = { file: "island.ts", start: 0, end: 1 };
+  lowerer.chainRecvByNode.set(receiver, { kind: "chainRecv", id: "chain.0", type: JSVAL, loc });
+  expect(isIslandExpr(lowerer, receiver)).toBe(true);
+  lowerer.chainRecvByNode.set(receiver, { kind: "chainRecv", id: "chain.0", type: F64, loc });
+  expect(isIslandExpr(lowerer, receiver)).toBe(false);
+  lowerer.chainRecvByNode.delete(receiver);
+  expect(isIslandExpr(lowerer, receiver)).toBe(false);
+});
